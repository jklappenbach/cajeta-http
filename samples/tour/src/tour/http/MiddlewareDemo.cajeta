package tour.http;

import dev.cajeta.http.Bytes;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.coding.ContentCoding;
import dev.cajeta.http.middleware.Middleware;
import dev.cajeta.http.middleware.MiddlewareChain;
import dev.cajeta.http.middleware.MiddlewareConfig;
import dev.cajeta.http.middleware.Logging;
import dev.cajeta.http.middleware.LogSink;
import dev.cajeta.http.middleware.RequestId;
import dev.cajeta.http.middleware.Recover;
import dev.cajeta.http.middleware.Timeout;
import dev.cajeta.http.middleware.Cors;
import dev.cajeta.http.middleware.BasicAuth;
import dev.cajeta.http.middleware.BearerAuth;
import dev.cajeta.http.middleware.Credentials;
import dev.cajeta.http.middleware.RateLimit;
import dev.cajeta.http.middleware.TokenBucket;
import dev.cajeta.http.middleware.Compression;
import dev.cajeta.http.middleware.Decompression;
import dev.cajeta.http.middleware.ETag;
import dev.cajeta.http.middleware.StaticFile;
import dev.cajeta.http.middleware.StaticPath;
import dev.cajeta.http.middleware.ProxyHeaders;
import cajeta.codec.Base64;
import cajeta.concurrent.Tasks;
import cajeta.io.file.File;
import cajeta.io.file.Path;

// support: a configurable middleware of our own. Its config implements
// MiddlewareConfig so the Middleware can own it, and the lambda reads it from there.
final class ApiVersion implements MiddlewareConfig {
    String version;

    ApiVersion(String version) {
        this.version #= version.substring(0, version.byteLength());
    }

    static #Middleware middleware(#ApiVersion cfg) {
        (HttpRequest, HttpResponse, (HttpRequest, HttpResponse) -> void) -> void f =
            (HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> ApiVersion.apply(cfg, q, r, next);
        return Middleware.owning(#f, #cfg);
    }

    static void apply(ApiVersion cfg, HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) {
        next(q, r);
        r.header("X-Api-Version", cfg.version);
    }
}

// The middleware stack — dev.cajeta.http.middleware. A middleware is a
// function around the rest of the chain:
//
//   (q, r, next) -> void        // observe/modify the request, call next,
//                               // observe/modify the response
//
// MiddlewareChain.use(...) stacks them (first use() = outermost),
// build(handler) composes them once around the terminal handler, and
// run(q, r) enters the outermost layer. Running allocates nothing: the
// composition is made at build time and kept by the chain. A config object
// (Cors, BasicAuth, ...) is handed over with `#` and owned by the middleware
// built from it, so it lives exactly as long as the chain.
//
// Every exchange here is a scripted request served through a real HTTP/1.1
// connection (Served.run), so what is checked is the actual wire. ServerDemo
// then puts a chain behind a live server.
//
// The scenario: the orders API's production stack — recovery, request ids,
// auth, rate limiting, timeouts, CORS, caching, compression, static files.
public class MiddlewareDemo extends DemoClass {

    // support: terminal handlers (static, capture-free). Compression skips
    // bodies under its 256-byte minSize, so this one is comfortably larger.
    public static #String ordersJson() {
        String body = "{\"status\":\"accepted\",\"queue\":\"orders-v2\",\"fills\":[";
        int32 fi = 0;
        while (fi < 12) {
            body = body + "{\"seq\":" + fi + ",\"symbol\":\"ACME\",\"state\":\"filled\"},";
            fi = fi + 1;
        }
        return body + "{}]}";
    }

    public static void okJson(HttpRequest q, HttpResponse r) {
        r.header("Content-Type", "application/json");
        r.body(MiddlewareDemo.ordersJson());
    }

    public static void boom(HttpRequest q, HttpResponse r) {
        throw heap Exception("orders db unreachable");
    }

    public static void slow(HttpRequest q, HttpResponse r) {
        Tasks.sleepMillis((int64) 300);
        r.body("late");
    }

    public static void echoIp(HttpRequest q, HttpResponse r) {
        if (q.hasHeader("X-Real-IP")) {
            r.bodyBytes(q.header("X-Real-IP"));
        } else {
            r.body("-");
        }
    }

    public static void notFound(HttpRequest q, HttpResponse r) {
        r.status(404);
    }

    // support: a hand-written layer. It stamps a header on the way in and
    // reads the status on the way out.
    static void stampApi(HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) {
        next(q, r);
        r.header("X-Api-Status", "" + r.status());
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- Middleware: the chain and the production catalogue --");
        (HttpRequest, HttpResponse) -> void term = (HttpRequest q, HttpResponse r) -> MiddlewareDemo.okJson(q, r);

        // 1. The mechanics: Recover outermost, then RequestId, then Logging
        //    into a capturing sink, then a hand-written layer.
        LogSink sink #= LogSink.capturing();
        (HttpRequest, HttpResponse, (HttpRequest, HttpResponse) -> void) -> void stampFn =
            (HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> MiddlewareDemo.stampApi(q, r, next);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#Recover.middleware()).use(#RequestId.middleware())
             .use(#Logging.middleware(sink)).use(#Middleware.of(#stampFn));
        chain.build(term);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String w1 #= Served.run("GET /orders HTTP/1.1\r\nHost: orders\r\n\r\n", app);
        String rid #= Served.header(w1, RequestId.HEADER);
        String stamped #= Served.header(w1, "X-Api-Status");
        this.check(Served.status(w1) == 200 && rid.byteLength() > 0 && stamped.equals("200")
            && chain.size() == 4,
            "four layers run; RequestId stamps X-Request-Id; the custom layer saw 200");
        this.check(sink.count() == 1 && sink.at(0).contains("GET /orders 200"),
            "Logging wrote one access line into the capturing sink");
        MiddlewareChain versioned = heap MiddlewareChain();
        versioned.use(#ApiVersion.middleware(heap ApiVersion("2026-09")));
        versioned.build(term);
        (HttpRequest, HttpResponse) -> void vApp = (HttpRequest q, HttpResponse r) -> versioned.run(q, r);
        String vw #= Served.run("GET /orders HTTP/1.1\r\n\r\n", vApp);
        String stampedVersion #= Served.header(vw, "X-Api-Version");
        this.check(stampedVersion.equals("2026-09"),
            "a middleware of our own owns its config through Middleware.owning");
        // Recover turns a handler throw into a 500 instead of a dead fiber.
        (HttpRequest, HttpResponse) -> void boomT = (HttpRequest q, HttpResponse r) -> MiddlewareDemo.boom(q, r);
        MiddlewareChain crash = heap MiddlewareChain();
        crash.use(#Recover.middleware());
        crash.build(boomT);
        (HttpRequest, HttpResponse) -> void crashApp = (HttpRequest q, HttpResponse r) -> crash.run(q, r);
        String crashed #= Served.run("GET /orders HTTP/1.1\r\n\r\n", crashApp);
        this.check(Served.status(crashed) == 500,
            "Recover converts a handler throw into a 500");

        // 2. Auth. BasicAuth splits on the FIRST colon (passwords may
        //    contain colons) and compares in constant time; BearerAuth
        //    checks a token. Both challenge with WWW-Authenticate on 401.
        BasicAuth ba #= BasicAuth.create("orders");
        (String, String) -> boolean verify = (String u, String pw) ->
            u.equals("ada") && Credentials.constantTimeEquals(pw, "s3cr:et");
        ba.verifier(#verify);
        MiddlewareChain auth = heap MiddlewareChain();
        auth.use(#BasicAuth.middleware(#ba));
        auth.build(term);
        (HttpRequest, HttpResponse) -> void authApp = (HttpRequest q, HttpResponse r) -> auth.run(q, r);
        String creds = "ada:s3cr:et";
        String good #= Base64.encode(creds.toBytes(), (int64) creds.byteLength());
        String admitted #= Served.run(
            "GET /orders HTTP/1.1\r\nAuthorization: Basic " + good + "\r\n\r\n", authApp);
        this.check(Served.status(admitted) == 200,
            "BasicAuth admits valid credentials (colon in the password)");
        String denied #= Served.run("GET /orders HTTP/1.1\r\n\r\n", authApp);
        String chal #= Served.header(denied, "WWW-Authenticate");
        this.check(Served.status(denied) == 401 && chal.startsWith("Basic realm="),
            "missing credentials answer 401 with the realm challenge");
        BearerAuth bt #= BearerAuth.create("orders");
        (String) -> boolean tok = (String t) -> Credentials.constantTimeEquals(t, "tok-live-42");
        bt.verifier(#tok);
        MiddlewareChain bearer = heap MiddlewareChain();
        bearer.use(#BearerAuth.middleware(#bt));
        bearer.build(term);
        (HttpRequest, HttpResponse) -> void bearerApp = (HttpRequest q, HttpResponse r) -> bearer.run(q, r);
        String btOk #= Served.run(
            "GET /orders HTTP/1.1\r\nAuthorization: Bearer tok-live-42\r\n\r\n", bearerApp);
        String btNo #= Served.run("GET /orders HTTP/1.1\r\n\r\n", bearerApp);
        this.check(Served.status(btOk) == 200 && Served.status(btNo) == 401,
            "BearerAuth: right token 200, missing token 401");

        // 3. Rate limiting: a token bucket per client key (default
        //    X-Forwarded-For). Burst 2, refill 1/s: the third rapid call
        //    429s with Retry-After.
        RateLimit rl #= RateLimit.create((int64) 2, (int64) 1);
        MiddlewareChain limited = heap MiddlewareChain();
        limited.use(#RateLimit.middleware(#rl));
        limited.build(term);
        (HttpRequest, HttpResponse) -> void limApp = (HttpRequest q, HttpResponse r) -> limited.run(q, r);
        String fromClient = "GET /orders HTTP/1.1\r\nX-Forwarded-For: 10.0.0.9\r\n\r\n";
        String lim1 #= Served.run(fromClient, limApp);
        String lim2 #= Served.run(fromClient, limApp);
        String throttled #= Served.run(fromClient, limApp);
        String retry #= Served.header(throttled, "Retry-After");
        this.check(Served.status(lim1) == 200 && Served.status(lim2) == 200
            && Served.status(throttled) == 429 && retry.byteLength() > 0,
            "burst of 2 admitted; the third answers 429 + Retry-After");
        // The bucket itself, directly: deterministic clock arithmetic.
        TokenBucket bucket = heap TokenBucket((int64) 2, (int64) 1, (int64) 1000);
        boolean t1 = bucket.tryAcquire((int64) 1000);
        boolean t2 = bucket.tryAcquire((int64) 1000);
        boolean t3 = bucket.tryAcquire((int64) 1000);
        boolean t4 = bucket.tryAcquire((int64) 2100);
        this.check(t1 && t2 && !t3 && t4,
            "TokenBucket: capacity 2 drains, 1/s refill readmits");

        // 4. Timeout: a handler over budget becomes 504, the server-side
        //    answer to a stuck downstream (ClientDemo's exchangeTimeout is
        //    the client side of the same story).
        (HttpRequest, HttpResponse) -> void slowT = (HttpRequest q, HttpResponse r) -> MiddlewareDemo.slow(q, r);
        MiddlewareChain slowChain = heap MiddlewareChain();
        slowChain.use(#Timeout.middleware((int64) 60));
        slowChain.build(slowT);
        (HttpRequest, HttpResponse) -> void slowApp = (HttpRequest q, HttpResponse r) -> slowChain.run(q, r);
        String late #= Served.run("GET /orders HTTP/1.1\r\n\r\n", slowApp);
        this.check(Served.status(late) == 504,
            "a 300ms handler against a 60ms budget answers 504");

        // 5. CORS: the browser's preflight OPTIONS answered from config,
        //    without running the handler.
        Cors cors #= Cors.create();
        cors.allowOrigin("https://app.example").allowMethods("GET, POST");
        MiddlewareChain corsChain = heap MiddlewareChain();
        corsChain.use(#Cors.middleware(#cors));
        corsChain.build(term);
        (HttpRequest, HttpResponse) -> void corsApp = (HttpRequest q, HttpResponse r) -> corsChain.run(q, r);
        String pre #= Served.run("OPTIONS /orders HTTP/1.1\r\nOrigin: https://app.example\r\n"
            + "Access-Control-Request-Method: POST\r\n\r\n", corsApp);
        String allowed #= Served.header(pre, "Access-Control-Allow-Origin");
        String preBody #= Served.body(pre);
        this.check(Served.status(pre) == 204 && allowed.equals("https://app.example")
            && preBody.byteLength() == 0,
            "preflight answers 204 with the allowed origin echoed");

        // 6. Caching + bandwidth: ETag hashes the body and honors
        //    If-None-Match with 304; Compression gzips when the client
        //    accepts it and adds Vary.
        MiddlewareChain etagChain = heap MiddlewareChain();
        etagChain.use(#ETag.middleware());
        etagChain.build(term);
        (HttpRequest, HttpResponse) -> void etagApp = (HttpRequest q, HttpResponse r) -> etagChain.run(q, r);
        String first #= Served.run("GET /orders HTTP/1.1\r\n\r\n", etagApp);
        String tag #= Served.header(first, "ETag");
        String notMod #= Served.run(
            "GET /orders HTTP/1.1\r\nIf-None-Match: " + tag + "\r\n\r\n", etagApp);
        String notModBody #= Served.body(notMod);
        this.check(tag.byteLength() > 0 && Served.status(notMod) == 304 && notModBody.byteLength() == 0,
            "ETag: matching If-None-Match answers a bodyless 304");
        Compression comp #= Compression.create();
        MiddlewareChain zipChain = heap MiddlewareChain();
        zipChain.use(#Compression.middleware(#comp));
        zipChain.build(term);
        (HttpRequest, HttpResponse) -> void zipApp = (HttpRequest q, HttpResponse r) -> zipChain.run(q, r);
        String zipped #= Served.run("GET /orders HTTP/1.1\r\nAccept-Encoding: gzip\r\n\r\n", zipApp);
        String zbody #= Served.body(zipped);
        int8[] zb #= zbody.toBytes();
        int8[] unzipped #= ContentCoding.decode("gzip", zb, zbody.byteLength(), (int64) 65536);
        String plain #= MiddlewareDemo.ordersJson();
        int8[] pb #= plain.toBytes();
        String ce #= Served.header(zipped, "Content-Encoding");
        String vary #= Served.header(zipped, "Vary");
        this.check(ce.equals("gzip") && vary.byteLength() > 0
            && this.sameBytes(unzipped, (int32) unzipped.count(), pb, plain.byteLength()),
            "Compression gzips, adds Vary, and round-trips the body");
        // Decompression is the inbound mirror: a gzip REQUEST body is
        // inflated before the handler sees it, under a bomb cap.
        (HttpRequest, HttpResponse) -> void echo = (HttpRequest q, HttpResponse r) -> {
            r.bodyBytes(q.body());
        };
        Decompression dz #= Decompression.create();
        dz.maxSize((int64) 65536);
        MiddlewareChain dzChain = heap MiddlewareChain();
        dzChain.use(#Decompression.middleware(#dz));
        dzChain.build(echo);
        (HttpRequest, HttpResponse) -> void dzApp = (HttpRequest q, HttpResponse r) -> dzChain.run(q, r);
        int8[] gz #= ContentCoding.encode("gzip", pb, plain.byteLength());
        String upload #= "POST /orders HTTP/1.1\r\nContent-Encoding: gzip\r\nContent-Length: "
            + gz.count() + "\r\n\r\n" + Bytes.toString(gz[0:gz.count()]);
        String inflated #= Served.run(upload, dzApp);
        String seen #= Served.body(inflated);
        this.check(Served.status(inflated) == 200 && seen.equals(plain),
            "Decompression inflates a gzip upload before the handler reads it");

        // 7. Static files, jailed. StaticPath.jail is the traversal guard
        //    the file middleware applies to every URL path.
        String root = "build/tour-static";
        Path.of(root).mkdirs();
        String page = "<h1>orders console</h1>";
        File.writeAllBytes(root + "/index.html", page.toBytes(), page.byteLength());
        StaticFile sf #= StaticFile.create(root);
        (HttpRequest, HttpResponse) -> void missing = (HttpRequest q, HttpResponse r) -> MiddlewareDemo.notFound(q, r);
        MiddlewareChain fileChain = heap MiddlewareChain();
        fileChain.use(#StaticFile.middleware(#sf));
        fileChain.build(missing);
        (HttpRequest, HttpResponse) -> void fileApp = (HttpRequest q, HttpResponse r) -> fileChain.run(q, r);
        String idx #= Served.run("GET / HTTP/1.1\r\n\r\n", fileApp);
        String idxBody #= Served.body(idx);
        this.check(Served.status(idx) == 200 && idxBody.equals(page),
            "StaticFile serves index.html for the directory root");
        String gone #= Served.run("GET /missing.css HTTP/1.1\r\n\r\n", fileApp);
        this.check(Served.status(gone) == 404, "a file that is not there falls through to the handler");
        String escaped #= StaticPath.jail("/../etc/passwd");
        String normal #= StaticPath.jail("/css/site.css");
        this.check(escaped == null && normal != null,
            "StaticPath.jail rejects traversal, admits normal paths");

        // 8. ProxyHeaders: behind a TRUSTED load balancer, the first
        //    X-Forwarded-For hop becomes X-Real-IP; in untrusted mode the
        //    spoofable headers are stripped instead.
        (HttpRequest, HttpResponse) -> void ipT = (HttpRequest q, HttpResponse r) -> MiddlewareDemo.echoIp(q, r);
        ProxyHeaders ph #= ProxyHeaders.trusted();
        MiddlewareChain proxied = heap MiddlewareChain();
        proxied.use(#ProxyHeaders.middleware(#ph));
        proxied.build(ipT);
        (HttpRequest, HttpResponse) -> void ipApp = (HttpRequest q, HttpResponse r) -> proxied.run(q, r);
        String fwd #= Served.run(
            "GET /ip HTTP/1.1\r\nX-Forwarded-For: 203.0.113.7, 10.1.1.1\r\n\r\n", ipApp);
        String realIp #= Served.body(fwd);
        this.check(realIp.equals("203.0.113.7"),
            "trusted ProxyHeaders resolves the client IP from hop 0");
        ProxyHeaders open #= ProxyHeaders.untrusted();
        MiddlewareChain stripped = heap MiddlewareChain();
        stripped.use(#ProxyHeaders.middleware(#open));
        stripped.build(ipT);
        (HttpRequest, HttpResponse) -> void stripApp = (HttpRequest q, HttpResponse r) -> stripped.run(q, r);
        String spoof #= Served.run("GET /ip HTTP/1.1\r\nX-Real-IP: 1.2.3.4\r\n\r\n", stripApp);
        String spoofBody #= Served.body(spoof);
        this.check(spoofBody.equals("-"), "untrusted ProxyHeaders strips a spoofed X-Real-IP");

        Path.of(root + "/index.html").delete();
    }
}
