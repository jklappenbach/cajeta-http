package tour.http;

import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.PathParams;
import dev.cajeta.http.routing.Router;
import dev.cajeta.http.routing.Route;

// The Router — method + pattern dispatch with typed path parameters:
//
//   router.route("GET", "/orders/{id:int64}", handler)
//
// Patterns: literal segments, {name} (string), {name:int64|int32|bool|...}
// (typed, canonical-decimal only), {name:*} (any one segment), {rest:**}
// (rest of the path, terminal). Precedence: literal > param > * > ** —
// so /orders/latest can coexist with /orders/{id}. Defaults are correct
// HTTP, not just misses: unknown path -> 404, known path with the wrong
// method -> 405 + Allow, an over-cap body on a routeLimited route -> 413.
//
// Handlers are capture-free lambdas over statics ((req) -> Cls.h(req)) —
// escaping closures are a pending runtime item, so the router hands you
// dispatch() and you write the forwarding lambda at the call site (that
// is also why every server demo writes b.handler that way).
//
// The scenario: the orders service's route table.
public class RoutingDemo extends DemoClass {

    // support: the route handlers — static and capture-free by convention.
    public static #HttpResponse getOrder(HttpRequest req) {
        int64 id = req.pathParamInt64("id", (int64) 0 - (int64) 1);
        String body = "order " + id;
        return HttpResponse.ok().body(body.toBytes(), body.byteLength());
    }

    public static #HttpResponse latestOrder(HttpRequest req) {
        String body = "latest";
        return HttpResponse.ok().body(body.toBytes(), body.byteLength());
    }

    public static #HttpResponse getReport(HttpRequest req) {
        String path = req.pathParam("rest");
        String body = "report:" + path;
        return HttpResponse.ok().body(body.toBytes(), body.byteLength());
    }

    public static #HttpResponse createOrder(HttpRequest req) {
        return HttpResponse.of(201);
    }

    public static #HttpResponse tenantUser(HttpRequest req) {
        String body = req.pathParam("tid") + ":" + req.pathParam("uid");
        return HttpResponse.ok().body(body.toBytes(), body.byteLength());
    }

    // support: read a dispatched response body as a String.
    static #String bodyOf(HttpResponse resp) {
        return DemoClass.bodyString(resp.body, resp.bodyLength());
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- The Router: typed path params, precedence, HTTP-correct defaults --");

        Router router = heap Router();
        router.route("GET", "/orders/latest", (req) -> RoutingDemo.latestOrder(req));
        router.route("GET", "/orders/{id:int64}", (req) -> RoutingDemo.getOrder(req));
        router.route("POST", "/orders", (req) -> RoutingDemo.createOrder(req));
        router.route("GET", "/reports/{rest:**}", (req) -> RoutingDemo.getReport(req));
        router.route("GET", "/health", (req) -> HttpResponse.of(204));
        this.check(router.size() == 5, "five routes registered");

        // 1. Typed binding: {id:int64} decodes the segment to an int64 —
        //    and REJECTS non-canonical decimals ("007" is not an id).
        HttpResponse hit = router.dispatch(HttpRequest.of("GET", "/orders/9001"));
        this.check(hit.statusCode() == 200
            && RoutingDemo.bodyOf(hit).equals("order 9001"),
            "{id:int64} binds and converts the segment");
        HttpResponse padded = router.dispatch(HttpRequest.of("GET", "/orders/007"));
        this.check(padded.statusCode() == 404,
            "non-canonical decimal fails the typed match (404, not a bad bind)");

        // 2. Precedence: the literal /orders/latest wins over {id:int64}.
        HttpResponse latest = router.dispatch(HttpRequest.of("GET", "/orders/latest"));
        this.check(RoutingDemo.bodyOf(latest).equals("latest"),
            "literal segment outranks the typed param");

        // 3. {rest:**} captures the remaining path — the file-serving shape.
        HttpResponse rep = router.dispatch(
            HttpRequest.of("GET", "/reports/2026/07/daily.csv"));
        this.check(RoutingDemo.bodyOf(rep).equals("report:2026/07/daily.csv"),
            "{rest:**} captures the joined tail segments");

        // 4. The defaults are real HTTP: 404 for an unknown path, 405 with
        //    an Allow header naming the methods that WOULD match.
        this.check(router.dispatch(HttpRequest.of("GET", "/nope")).statusCode() == 404,
            "unknown path answers 404");
        HttpResponse wrong = router.dispatch(HttpRequest.of("DELETE", "/orders"));
        String allow = wrong.getHeaders().get("Allow");
        this.check(wrong.statusCode() == 405 && allow != null
            && allow.contains("POST"),
            "wrong method answers 405 with Allow: POST");

        // 5. mount(): compose a sub-router under a prefix — prefix params
        //    and sub params both bind. The admin API mounts per-tenant.
        Router sub = heap Router();
        sub.route("GET", "/users/{uid}", (req) -> RoutingDemo.tenantUser(req));
        Router root = heap Router();
        root.mount("/tenants/{tid}", sub);
        HttpResponse tu = root.dispatch(
            HttpRequest.of("GET", "/tenants/acme/users/ada"));
        this.check(RoutingDemo.bodyOf(tu).equals("acme:ada"),
            "mounted routes bind prefix and sub params together");

        // 6. Per-route body caps: a tight routeLimited cap 413s an over-cap
        //    request before the handler ever runs.
        Router capped = heap Router();
        capped.routeLimited("POST", "/upload", (int64) 100,
            (req) -> RoutingDemo.createOrder(req));
        HttpRequest bigPost = HttpRequest.post("/upload");
        String blob = "";
        int32 i = 0;
        while (i < 20) {
            blob = blob + "0123456789";
            i = i + 1;
        }
        bigPost.body(blob.toBytes(), blob.byteLength());
        this.check(capped.dispatch(bigPost).statusCode() == 413,
            "routeLimited: a 200-byte body against a 100-byte cap answers 413");

        // 7. Pattern hygiene: patternError validates BEFORE registration
        //    (registering a malformed pattern is a fatal error by design).
        this.check(Router.patternError("/orders/{id:int64}") == null,
            "a well-formed pattern validates clean");
        this.check(Router.patternError("/orders/{id:bogus}") != null
            && Router.patternError("/a/{rest:**}/b") != null,
            "unknown param types and non-terminal ** are rejected");

        // 8. Route is the unit under the table: it parses its pattern into
        //    segments up front, so match time is a segment walk.
        Route route = heap Route("GET", "/orders/{id:int64}",
            (req) -> RoutingDemo.getOrder(req));
        this.check(route.methodMatches("GET") && !route.methodMatches("PUT")
            && route.patternSegmentCount() == 2 && route.isParam(1)
            && route.paramName(1).equals("id"),
            "Route pre-parses method, segments, and param names");

        // 9. PathParams itself — what bindPathParams hands the handler:
        //    ordered, typed reads with fallbacks.
        PathParams pp = heap PathParams();
        pp.put(DemoClass.own("id"), DemoClass.own("42"));
        pp.put(DemoClass.own("flag"), DemoClass.own("true"));
        this.check(pp.size() == 2 && pp.getInt64("id", (int64) 0) == (int64) 42
            && pp.getBool("flag", false)
            && pp.getInt32("missing", 7) == 7,
            "PathParams: typed getters convert, fallbacks cover absence");
    }
}
