package tour.http;

import cajeta.lang.String;

// The cajeta-http tour — one self-checking demo per layer of the library,
// ordered as a learning path:
//
//   WireDemo        the message model + HTTP/1.1 wire codec + content coding
//   RoutingDemo     the Router: typed path params, precedence, defaults
//   MiddlewareDemo  the chain and the production middleware catalogue
//   ServerDemo      a live server the public way: builder -> serve -> shutdown
//   ClientDemo      the client's operational surface (timeouts, retries,
//                   redirects, cookies, pool, JSON, download)
//   BodiesDemo      the body model: form, multipart, streaming, gzip
//   TlsDemo         the same exchange, TLS-terminated
//   Http2Demo       HTTP/2: prior-knowledge server, Http2Client, HPACK, frames
//   SseDemo         Server-Sent Events with resume-on-reconnect
//   WebSocketDemo   RFC 6455: handshake to permessage-deflate
//
// (HTTP/3 is intentionally absent: it requires QUIC, which the stdlib does
// not ship yet — the library no longer advertises it.)
//
// Every demo asserts what it demonstrates via DemoClass.check(); the exit
// code is the number of failed checks (0 = tour passed). Adding a demo:
// extend DemoClass in this package, then add one block below.
public final class HttpTour {

    public static int32 main(String[] args) {
        System.stdout.println("=== cajeta-http tour ===");

        WireDemo wire = heap WireDemo();
        wire.execute();

        RoutingDemo routing = heap RoutingDemo();
        routing.execute();

        MiddlewareDemo middleware = heap MiddlewareDemo();
        middleware.execute();

        ServerDemo server = heap ServerDemo();
        server.execute();

        ClientDemo client = heap ClientDemo();
        client.execute();

        BodiesDemo bodies = heap BodiesDemo();
        bodies.execute();

        TlsDemo tls = heap TlsDemo();
        tls.execute();

        Http2Demo http2 = heap Http2Demo();
        http2.execute();

        SseDemo sse = heap SseDemo();
        sse.execute();

        WebSocketDemo websocket = heap WebSocketDemo();
        websocket.execute();

        System.stdout.println("");
        System.stdout.println("=== tour complete: {} checks passed, {} failed ===",
                              DemoClass.checks - DemoClass.failures,
                              DemoClass.failures);
        return DemoClass.failures;
    }
}
