package tour.http;

import cajeta.lang.Slice;
import cajeta.io.net.ByteBuffer;
import dev.cajeta.http.BodySink;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.Http1ClientConnection;
import dev.cajeta.http.ResponseTransport;
import dev.cajeta.http.ClientRequest;
import dev.cajeta.http.HeadScanner;
import dev.cajeta.http.HeaderTable;
import dev.cajeta.http.Http;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.Method;
import dev.cajeta.http.Status;
import dev.cajeta.http.Version;
import dev.cajeta.http.MediaType;
import dev.cajeta.http.HttpException;
import dev.cajeta.http.MalformedMessageException;
import dev.cajeta.http.HeadersTooLargeException;
import dev.cajeta.http.InvalidChunkEncodingException;
import dev.cajeta.http.PayloadTooLargeException;
import dev.cajeta.http.UnexpectedEofException;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.h1.BodyReader;
import dev.cajeta.http.h1.BodyFraming;
import dev.cajeta.http.coding.ContentCoding;
import dev.cajeta.http.coding.AcceptEncoding;
import dev.cajeta.http.coding.ContentCodingException;
import dev.cajeta.http.coding.Crc32;
import dev.cajeta.http.server.ConnectionBuffers;
import cajeta.io.net.BufferPool;

// support: a BodySink that checksums a download as it streams past,
// holding none of it.
final class ChecksumSink implements BodySink {
    public int64 bytes;
    public int64 sum;

    public ChecksumSink() {
        this.bytes = (int64) 0;
        this.sum = (int64) 0;
    }

    public void accept(int8[] a, int32 off, int32 len) {
        int32 i = 0;
        while (i < len) {
            this.sum = this.sum + (int64) (((int32) a[off + i]) & 255);
            i = i + 1;
        }
        this.bytes = this.bytes + (int64) len;
    }
}

// support: a ResponseTransport that records what it was asked to send. The
// h2 connection plugs in exactly here, turning the head into HEADERS and the
// pieces into DATA frames.
final class RecordingTransport implements ResponseTransport {
    public int32 status;
    public int64 bodyBytes;
    public int32 pieces;
    public boolean ended;

    public RecordingTransport() {
        this.status = 0;
        this.bodyBytes = (int64) 0;
        this.pieces = 0;
        this.ended = false;
    }

    public void head(HttpResponse r, boolean endStream) {
        this.status = r.status();
        this.ended = endStream;
    }

    public void data(int8[] a, int32 off, int32 len, boolean endStream) {
        this.bodyBytes = this.bodyBytes + (int64) len;
        this.pieces = this.pieces + 1;
        this.ended = endStream;
    }
}

// The message model and the HTTP/1.1 wire layer, the vocabulary every later
// chapter uses:
//
//   HttpRequest              a VIEW over the bytes a head arrived in, with typed
//                            reads: Method, Version, MediaType, HeaderTable
//   HeadScanner              finds a head in a buffer and parses it in place
//   HttpResponse             a WRITER that composes head and body straight into
//                            the connection's output buffer
//   ClientRequest            the client's reusable request writer
//   BodyReader / BodyFraming content-length vs chunked vs close-delimited
//   ContentCoding / AcceptEncoding / Crc32   gzip bodies and the q-value pick
//   HttpParserLimits         the caps that make parsing hostile input safe
//
// Nothing is copied until a caller asks for a String: every read is a
// Slice<int8> into the buffer the bytes arrived in.
public class WireDemo extends DemoClass {
    // The readable bytes of `out` as a String.
    static #String readable(ByteBuffer out) {
        int32 n = out.readable();
        int8[] copy = heap int8[n];
        int8[] a = out.array();
        int32 i = 0;
        while (i < n) {
            copy[i] = a[out.readPosition() + i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    // Appends `text` to `buf`.
    static void fill(ByteBuffer buf, String text) {
        int8[] b #= text.toBytes();
        int32 i = 0;
        while (i < text.byteLength()) {
            buf.put(b[i]);
            i = i + 1;
        }
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- The message model + HTTP/1.1 wire layer (dev.cajeta.http v"
            + Http.version() + ") --");

        // 1. Typed views. Method and Version are enums, MediaType parses its
        //    parameters. String compares are for the wire, not for code.
        this.check(Method.POST.allowsBody() && !Method.POST.isIdempotent()
            && Method.GET.isSafe(),
            "Method: POST allows a body and is not idempotent; GET is safe");
        this.check(Method.of("BREW") == Method.EXTENSION && !Method.isRegistered("get"),
            "unknown tokens map to EXTENSION; lookup is case-sensitive");
        this.check(Version.of("HTTP/1.1").supportsKeepAlive()
            && Version.HTTP_1_1.wireString().equals("HTTP/1.1"),
            "Version: 1.1 defaults to keep-alive");
        MediaType mt #= MediaType.parse("application/json; charset=utf-8");
        String charset #= mt.parameter("charset");
        this.check(mt.is("application", "json") && charset.equals("utf-8"),
            "MediaType parses the essence and its parameters");

        // 2. Parse a head IN PLACE. The request is a view: header() and path()
        //    are windows into these bytes, and headerString() is the copy.
        String order = "POST /api/orders?dry=1 HTTP/1.1\r\nHost: orders.internal\r\n"
            + "Content-Type: application/json\r\nContent-Length: 27\r\n\r\n";
        int8[] wire #= order.toBytes();
        HttpParserLimits limits = heap HttpParserLimits();
        HttpRequest q = heap HttpRequest(limits.maxHeaderCount);
        HeadScanner.parseRequest(wire, 0, order.byteLength(), q);
        this.check(q.method() == Method.POST && Bytes.equals(q.path(), "/api/orders")
            && Bytes.equals(q.query(), "dry=1"),
            "the request line splits into method, path and query");
        this.check(q.hasHeader("HOST") && q.headerIs("host", "orders.internal")
            && q.contentLength() == (int64) 27,
            "header lookup is case-insensitive; Content-Length reads typed");
        HeaderTable table = q.headers();
        this.check(table.count() == 3 && table.has("content-type"),
            "HeaderTable indexes every field without copying it");
        String host #= q.headerString("Host");
        this.check(host.equals("orders.internal"), "headerString is the owned copy");

        // 3. The scanner survives arbitrary packet boundaries: a head split
        //    mid-header-name completes on the second fill.
        HeadScanner scanner = heap HeadScanner(limits);
        ByteBuffer in = heap ByteBuffer(256);
        String partA = "GET /api/orders/7 HTTP/1.1\r\nHo";
        String partB = "st: orders.internal\r\n\r\n";
        WireDemo.fill(in, partA);
        int32 early = scanner.scan(in);
        WireDemo.fill(in, partB);
        int32 late = scanner.scan(in);
        this.check(early < 0 && late == partA.byteLength() + partB.byteLength(),
            "a head spanning a fill boundary completes on the second scan");

        // 4. The response WRITER: status, repeated headers and body go straight
        //    into the output buffer, and finish() frames them. Two Set-Cookie
        //    lines stay separate (RFC 6265 forbids folding them).
        ByteBuffer out = heap ByteBuffer(8192);
        HttpResponse r = heap HttpResponse(out, null, 1024, 32);
        r.status(201).header("Set-Cookie", "sid=abc; Path=/")
            .header("Set-Cookie", "theme=dark; Path=/")
            .header("Content-Type", "application/json");
        r.body("{\"id\":9001}");
        r.finish(true, Version.HTTP_1_1, false);
        String sent #= WireDemo.readable(out);
        this.check(sent.startsWith("HTTP/1.1 201 Created\r\n")
            && sent.contains("Set-Cookie: sid=abc; Path=/\r\n")
            && sent.contains("Set-Cookie: theme=dark; Path=/\r\n")
            && sent.contains("content-length: 11\r\n")
            && sent.endsWith("{\"id\":9001}"),
            "the writer frames status, both cookies and the exact length");
        this.check(Status.of(201).reason().equals("Created") && Status.of(404).isClientError()
            && Status.of(499, "Client Closed Request").reason().equals("Client Closed Request"),
            "Status supplies canonical reasons and classes; custom reasons stick");

        // The client writes requests with the same discipline.
        ClientRequest cr #= ClientRequest.post("http://orders.internal/api/orders");
        cr.header("Accept", "application/json").body("{\"qty\":1}");
        this.check(cr.method() == Method.POST && Bytes.equals(cr.target(), "/api/orders")
            && cr.bodyLength() == 9,
            "ClientRequest holds method, origin-form target and body");

        // 5. Chunked transfer: the RFC's own worked example decodes, and
        //    trailers are consumed rather than surfaced into the payload.
        String chunks = "4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n";
        BodyFraming cf #= BodyFraming.chunked(true);
        BodyReader cbody #= BodyReader.forFraming(cf);
        cbody.feed(chunks.toBytes(), chunks.byteLength());
        int32 decLen = cbody.decodedLength();
        int8[] dec #= cbody.drain();
        String wiki = "Wikipedia in\r\n\r\nchunks.";
        this.check(cf.isChunked() && cbody.isComplete()
            && this.sameBytes(dec, decLen, wiki.toBytes(), wiki.byteLength()),
            "chunked decode matches the RFC 9112 worked example");
        String trailered = "4\r\ndata\r\n0\r\nX-Checksum: abc\r\n\r\n";
        BodyReader tb #= BodyReader.forChunked();
        tb.feed(trailered.toBytes(), trailered.byteLength());
        int32 tlen = tb.decodedLength();
        int8[] tdec #= tb.drain();
        String data = "data";
        this.check(tb.isComplete() && this.sameBytes(tdec, tlen, data.toBytes(), data.byteLength()),
            "trailers are consumed, not decoded into the body");

        // 6. Content coding: gzip a JSON body and negotiate from q-values.
        String big = "";
        int32 k = 0;
        while (k < 20) {
            big = big + "{\"seq\":" + k + ",\"status\":\"filled\"},";
            k = k + 1;
        }
        int8[] plain #= big.toBytes();
        int8[] gz #= ContentCoding.encode("gzip", plain, big.byteLength());
        int8[] inflated #= ContentCoding.decode("gzip", gz, (int32) gz.count(), (int64) 65536);
        System.stdout.println("  gzip content-coding: {} -> {} bytes", big.byteLength(), gz.count());
        this.check((int32) gz.count() < big.byteLength()
            && this.sameBytes(inflated, (int32) inflated.count(), plain, big.byteLength()),
            "gzip coding round-trips the response body");
        this.check(AcceptEncoding.best("deflate, gzip;q=0.5").equals("deflate")
            && AcceptEncoding.best("gzip;q=0, deflate;q=0").equals("identity"),
            "Accept-Encoding negotiation honors q-values, falls back to identity");
        Crc32 crc = heap Crc32();
        String probe = "hello world";
        crc.update(probe.toBytes(), probe.byteLength());
        this.check(crc.value() == (int64) 222957957,
            "Crc32 matches the reference value for \"hello world\"");

        // 7. Hostile input fails loud, with a typed exception per failure class.
        String garbage = "GARBAGE\r\n\r\n";
        int8[] gb #= garbage.toBytes();
        boolean malformed = false;
        int32 status = 0;
        try {
            HttpRequest bad = heap HttpRequest(limits.maxHeaderCount);
            HeadScanner.parseRequest(gb, 0, garbage.byteLength(), bad);
        } catch (MalformedMessageException me) {
            malformed = true;
            status = me.httpStatus();
        }
        this.check(malformed && status == 400,
            "a garbage start line raises MalformedMessageException, a 400");

        HttpParserLimits tight #= HttpParserLimits.of(0, 64, 0);
        HeadScanner strict = heap HeadScanner(tight);
        ByteBuffer longIn = heap ByteBuffer(1024);
        String longLine = "GET / HTTP/1.1\r\nX-Padding: ";
        int32 j = 0;
        while (j < 30) {
            longLine = longLine + "aaaaaaaaaa";
            j = j + 1;
        }
        WireDemo.fill(longIn, longLine);
        boolean tooLarge = false;
        try {
            int32 never = strict.scan(longIn);
        } catch (HeadersTooLargeException he) {
            tooLarge = true;
        }
        this.check(tooLarge, "an over-cap header line raises HeadersTooLargeException");

        boolean badChunk = false;
        try {
            BodyReader cr2 #= BodyReader.forChunked();
            String zz = "zz\r\ndata\r\n";
            cr2.feed(zz.toBytes(), zz.byteLength());
        } catch (InvalidChunkEncodingException ce) {
            badChunk = true;
        }
        this.check(badChunk, "a non-hex chunk size raises InvalidChunkEncodingException");

        boolean eof = false;
        try {
            BodyReader partial #= BodyReader.forContentLength((int64) 10);
            String half = "abc";
            partial.feed(half.toBytes(), half.byteLength());
            partial.endInput();
        } catch (UnexpectedEofException ue) {
            eof = true;
        }
        this.check(eof, "a body cut short raises UnexpectedEofException");

        boolean badCoding = false;
        try {
            int8[] cut #= ContentCoding.decode("gzip", gz, 10, (int64) 65536);
        } catch (ContentCodingException xe) {
            badCoding = true;
        }
        this.check(badCoding, "a truncated gzip body raises ContentCodingException");

        PayloadTooLargeException big413 = heap PayloadTooLargeException(
            "body over the limit", (int64) 1048576, (int64) 2000000);
        this.check(big413.httpStatus() == 413,
            "every failure is an HttpException carrying its status (413 here)");
        boolean asRoot = false;
        try {
            throw big413;
        } catch (HttpException he2) {
            asRoot = he2.httpStatus() == 413;
        }
        this.check(asRoot, "the family root HttpException catches them all");

        // 7. The connections underneath. Http1ClientConnection is one client
        //    connection over any channel: it writes the request into its
        //    output buffer and reads the answer as a view. Here the channel
        //    is a script, so the whole exchange is visible.
        String reply = "HTTP/1.1 200 OK\r\nContent-Length: 11\r\n\r\nfill report";
        int8[] rb #= reply.toBytes();
        ScriptChannel wireCh = heap ScriptChannel(#rb, reply.byteLength());
        ConnectionBuffers cbufs = heap ConnectionBuffers(heap BufferPool(8192, 4));
        HttpParserLimits cl = heap HttpParserLimits();
        Http1ClientConnection cc = heap Http1ClientConnection(wireCh, cbufs, cl);
        ClientRequest ask #= ClientRequest.get("http://orders.internal/fills");
        ask.header("Host", "orders.internal");
        ClientResponse got = heap ClientResponse();
        cc.exchange(ask, got, (int64) 0, cbufs);
        String asked #= Bytes.toString(wireCh.buf[0:wireCh.len]);
        String report #= got.bodyString();
        this.check(asked.equals("GET /fills HTTP/1.1\r\nHost: orders.internal\r\n\r\n")
            && got.status() == 200 && report.equals("fill report"),
            "Http1ClientConnection writes the request and reads the response view");
        // exchangeInto streams a 2xx body to a BodySink instead of holding it:
        // the download path, where the body never sits in memory whole.
        int8[] rb2 #= reply.toBytes();
        ScriptChannel wireCh2 = heap ScriptChannel(#rb2, reply.byteLength());
        Http1ClientConnection cc2 = heap Http1ClientConnection(wireCh2, cbufs, cl);
        ChecksumSink sink = heap ChecksumSink();
        ClientResponse streamed = heap ClientResponse();
        cc2.exchangeInto(ask, streamed, (int64) 0, cbufs, sink);
        String fr = "fill report";
        int8[] frb #= fr.toBytes();
        int64 want = (int64) 0;
        int32 k = 0;
        while (k < fr.byteLength()) {
            want = want + (int64) (((int32) frb[k]) & 255);
            k = k + 1;
        }
        this.check(sink.bytes == (int64) 11 && sink.sum == want && !streamed.hasBody(),
            "a BodySink receives the body in pieces; the response holds none of it");

        // ResponseTransport carries a response somewhere other than an h1
        // byte stream: the head once, then body pieces, the last one ending
        // the stream. attach() routes a response writer through it.
        ByteBuffer tout = heap ByteBuffer(4096);
        HttpResponse viaT = heap HttpResponse(tout, null, 1024, 32);
        RecordingTransport rec = heap RecordingTransport();
        viaT.attach(rec);
        viaT.status(202);
        viaT.body("queued");
        viaT.finishStream();
        this.check(rec.status == 202 && rec.bodyBytes == (int64) 6 && rec.ended,
            "a ResponseTransport gets the head, the body and the end of stream");
    }
}
