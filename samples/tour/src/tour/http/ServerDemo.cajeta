package tour.http;

import dev.cajeta.http.ClientRequest;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.coding.ContentCoding;
import dev.cajeta.http.routing.Router;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.server.ServerLimits;
import dev.cajeta.http.middleware.MiddlewareChain;
import dev.cajeta.http.middleware.Recover;
import dev.cajeta.http.middleware.RequestId;
import dev.cajeta.http.middleware.Decompression;
import dev.cajeta.http.middleware.BearerAuth;
import dev.cajeta.http.middleware.Credentials;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.time.Duration;

// A live HttpServer, assembled the way a production service is:
//
//   Router  ->  MiddlewareChain.build(dispatch)  ->  HttpServer.builder()
//               .bind(...).handler(app).serverLimits(...).build()
//   scope { spawn serve; ... clients ...; srv.shutdown(deadline); }
//
// serve() runs the accept loop on a fiber; shutdown(deadline) stops
// accepting and drains in-flight connections, the orderly teardown pair.
//
// ServerLimits is the hostile-input armor: body caps (413), head caps
// (431), read timeouts, and the Expect: 100-continue decision, all enforced
// BEFORE the handler runs.
//
// The scenario: the orders service from RoutingDemo, now on a real socket,
// with recovery, request ids, and inbound-gzip decompression in front, and
// one admin route behind its own auth chain.
public class ServerDemo extends DemoClass {

    public static void getOrder(HttpRequest q, HttpResponse r) {
        r.body("order " + q.paramInt64("id", (int64) 0 - (int64) 1));
    }

    // Decompression already inflated a gzip body; report what arrived.
    public static void createOrder(HttpRequest q, HttpResponse r) {
        r.status(201);
        r.body("stored " + q.bodyLength() + " bytes");
    }

    public static void purge(HttpRequest q, HttpResponse r) {
        r.body("purged");
    }

    public static async int32 serveLoop(HttpServer srv) {
        srv.serve();
        return 1;
    }

    // One client drives the API over ONE keep-alive connection, the shape
    // real callers use. Return value = how many steps passed (expect 5).
    public static async int32 driveApi(int32 port) {
        HttpClient client #= heap HttpClient();
        client.exchangeTimeout(15000);
        String base = "http://127.0.0.1:" + port;
        int32 passed = 0;

        ClientResponse r1 #= client.get(base + "/orders/7");
        String b1 #= r1.bodyString();
        if (r1.status() == 200 && b1.equals("order 7") && r1.hasHeader("X-Request-Id")) {
            passed = passed + 1;
        }

        ClientRequest post #= ClientRequest.post(base + "/orders");
        post.body("{\"symbol\":\"ACME\",\"qty\":250}");
        ClientResponse r2 #= client.send(post);
        if (r2.status() == 201) {
            passed = passed + 1;
        }

        ClientResponse r3 #= client.get(base + "/nope");
        if (r3.status() == 404) {
            passed = passed + 1;
        }

        ClientRequest admin #= ClientRequest.of("DELETE", base + "/admin/cache");
        ClientResponse r4 #= client.send(admin);
        ClientRequest adminOk #= ClientRequest.of("DELETE", base + "/admin/cache");
        adminOk.header("Authorization", "Bearer ops-token");
        ClientResponse r5 #= client.send(adminOk);
        if (r4.status() == 401 && r5.status() == 200) {
            passed = passed + 1;
        }

        // Last request: close the keep-alive connection politely, so the
        // server has no parked connection fiber when shutdown() drains.
        client.defaultHeader("Connection", "close");
        ClientResponse r6 #= client.get(base + "/orders/7x");
        if (r6.status() == 404) {
            passed = passed + 1;
        }
        return passed;
    }

    // The armor: a Content-Length beyond ServerLimits' cap answers 413
    // before the handler runs, and the server then closes, so this speaks
    // raw bytes (one write, then read to EOF). 1 = saw the 413.
    public static async int32 overCapPost(int32 port) {
        IpAddress ca #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#ca, port);
        TcpStream sock #= TcpStream.connectAsync(#addr);
        AsyncWriter w = heap AsyncWriter(sock);
        AsyncReader r = heap AsyncReader(sock);
        String blob = "";
        int32 i = 0;
        while (i < 80) {
            blob = blob + "0123456789";
            i = i + 1;
        }
        String wire = "POST /orders HTTP/1.1\r\nhost: orders\r\n"
            + "connection: close\r\ncontent-length: " + blob.byteLength()
            + "\r\n\r\n" + blob;
        int8[] wb #= wire.toBytes();
        w.writeAll(wb, 0, wire.byteLength());
        w.flush();
        int8[] buf = heap int8[4096];
        int32 total = 0;
        boolean going = true;
        while (going) {
            int32 got = r.read(buf, total, 4096 - total);
            if (got <= 0) {
                going = false;
            } else {
                total = total + got;
            }
        }
        sock.close();
        String resp #= DemoClass.bodyString(buf, total);
        if (resp.startsWith("HTTP/1.1 413")) {
            return 1;
        }
        return 0 - 1;
    }

    // Inbound gzip: Content-Encoding: gzip + compressed body; the
    // Decompression middleware inflates before the handler. 1 = the
    // handler saw the PLAIN byte count.
    public static async int32 gzipPost(int32 port) {
        HttpClient client #= heap HttpClient();
        client.exchangeTimeout(15000);
        client.defaultHeader("Connection", "close");
        String order = "{\"symbol\":\"GLOBEX\",\"qty\":75,\"note\":\"gzip inbound\"}";
        int8[] gz #= ContentCoding.encode("gzip", order.toBytes(), order.byteLength());
        ClientRequest req #= ClientRequest.post("http://127.0.0.1:" + port + "/orders");
        req.header("Content-Encoding", "gzip");
        req.body(gz, (int32) gz.count());
        ClientResponse resp #= client.send(req);
        if (resp.status() != 201) {
            return 0 - 1;
        }
        String body #= resp.bodyString();
        String want = "stored " + order.byteLength() + " bytes";
        if (body.equals(want)) {
            return 1;
        }
        return 0 - 2;
    }

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- A live HttpServer: builder -> serve -> shutdown, limits enforced --");

        scope {
            // The route table, dispatched behind middleware. The admin route
            // carries its own chain via routeMw.
            Router router = heap Router();
            router.route("GET", "/orders/{id:int64}",
                (HttpRequest q, HttpResponse r) -> ServerDemo.getOrder(q, r));
            router.route("POST", "/orders",
                (HttpRequest q, HttpResponse r) -> ServerDemo.createOrder(q, r));
            BearerAuth ops #= BearerAuth.create("admin");
            (String) -> boolean opsToken = (String t) -> Credentials.constantTimeEquals(t, "ops-token");
            ops.verifier(#opsToken);
            MiddlewareChain adminChain = heap MiddlewareChain();
            adminChain.use(#BearerAuth.middleware(ops));
            router.routeMw("DELETE", "/admin/cache", #adminChain,
                (HttpRequest q, HttpResponse r) -> ServerDemo.purge(q, r));

            Decompression dz #= Decompression.create();
            MiddlewareChain chain = heap MiddlewareChain();
            chain.use(#Recover.middleware()).use(#RequestId.middleware())
                 .use(#Decompression.middleware(dz));
            (HttpRequest, HttpResponse) -> void dispatch =
                (HttpRequest q, HttpResponse r) -> router.dispatch(q, r);
            chain.build(dispatch);
            (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);

            // ServerLimits: 5s read timeouts, 512-byte body cap, and
            // Expect: 100-continue honoured.
            ServerLimits limits #= ServerLimits.of(5000, 5000, (int64) 512, true);
            this.check(limits.hasBodyCap() && limits.bodyWithinCap((int64) 512)
                && !limits.bodyWithinCap((int64) 513),
                "ServerLimits: a 512-byte cap admits 512 and refuses 513");

            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler(app);
            b.serverLimits(#limits);
            HttpServer srv #= b.build();
            int32 port = srv.server.listener.boundPort();
            System.stdout.println("  serving 127.0.0.1:{} (ephemeral)", port);
            Task<int32> sv = spawn serveLoop(srv);

            Task<int32> api = spawn driveApi(port);
            this.check(await api == 5,
                "one connection: typed GET, POST 201, 404, routeMw auth 401/200, typed-miss");

            Task<int32> cap = spawn overCapPost(port);
            this.check(await cap == 1,
                "an 800-byte body against the 512-byte cap answers 413 pre-handler");

            Task<int32> gz = spawn gzipPost(port);
            this.check(await gz == 1,
                "Content-Encoding: gzip request is inflated before the handler");

            // Teardown: stop accepting, drain in-flight, join serve.
            boolean drained #= srv.shutdown(Duration.ofSeconds(2));
            int32 sret = await sv;
            this.check(drained && sret == 1,
                "shutdown(deadline) drained clean and the accept loop exited");
        }

        // Expect: 100-continue is decided from the head alone. A polite
        // client declaring too large a body is refused before it sends a
        // byte of it, and an expectation the server does not know is 417.
        (HttpRequest, HttpResponse) -> void accept = (HttpRequest q, HttpResponse r) -> ServerDemo.createOrder(q, r);
        String refused #= Served.runLimited("POST /orders HTTP/1.1\r\nExpect: 100-continue\r\n"
            + "Content-Length: 4096\r\n\r\n", (int64) 512, accept);
        this.check(Served.status(refused) == 413,
            "Expect: 100-continue over the cap is refused 413 from the head");
        String odd #= Served.runLimited("POST /orders HTTP/1.1\r\nExpect: teapot\r\n"
            + "Content-Length: 2\r\n\r\nhi", (int64) 512, accept);
        this.check(Served.status(odd) == 417, "an unknown expectation answers 417");
        String fine #= Served.runLimited("POST /orders HTTP/1.1\r\nExpect: 100-continue\r\n"
            + "Content-Length: 2\r\n\r\nhi", (int64) 512, accept);
        this.check(Served.status(fine) == 201, "a body within the cap reaches the handler");
    }
}
