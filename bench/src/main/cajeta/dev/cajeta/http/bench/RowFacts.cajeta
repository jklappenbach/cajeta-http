package dev.cajeta.http.bench;

import cajeta.collection.ArrayList;
import cajeta.io.file.File;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import dev.cajeta.bench.report.Csv;

/**
 * Writes each row's Fact into the results CSV the harness wrote: language,
 * language_version, library, library_version, throughput, the plain variant,
 * and (start-up) the timing columns. A row is keyed by (benchmark, the
 * harness's variant label). Every other column is the harness's, untouched.
 *
 * This exists because dev.cajeta.bench 0.1.1's Benchmark has no hook for
 * those columns on a cpu row (the harness writes language=cajeta and leaves
 * library, library_version and throughput empty); it belongs in the library.
 */
public final class RowFacts {

    public static int32 apply(String path, Ctx ctx) {
        int8[] raw #= File.readAllBytes(path);
        int32 n = (int32) raw.count();
        String text = heap String(#raw, n);
        ArrayList<String> lines #= RowFacts.lines(text);
        String out = "";
        int32 rewritten = 0;
        int32 i = 0;
        int32 ln = lines.count();
        while (i < ln) {
            String line = lines.get(i);
            if (i == 0 || line.isEmpty()) {
                out = out + line + "\n";
            } else {
                ArrayList<String> f #= RowFacts.fields(line);
                if (f.count() == 37) {
                    String bench = f.get(3);
                    String label = f.get(30);
                    Fact fact = ctx.findFact(bench, label);
                    if (fact != null) {
                        RowFacts.fill(f, fact);
                        rewritten = rewritten + 1;
                    }
                }
                out = out + RowFacts.join(f) + "\n";
            }
            i = i + 1;
        }
        FileWriter w #= File.openWrite(path, OpenMode.WRITE);
        if (w.fd < 0) {
            System.stdout.println("bench: could not rewrite " + path);
            return 0;
        }
        w.writeString(out);
        w.close();
        return rewritten;
    }

    public static void fill(ArrayList<String> f, Fact fact) {
        RowFacts.put(f, 9, fact.language);
        RowFacts.put(f, 10, fact.languageVersion);
        RowFacts.put(f, 11, fact.library);
        RowFacts.put(f, 12, fact.libraryVersion);
        RowFacts.put(f, 20, fact.throughput);
        RowFacts.put(f, 30, fact.variant);
        if (fact.timed) {
            RowFacts.put(f, 16, "" + fact.minNs);
            RowFacts.put(f, 17, "" + fact.medianNs);
            RowFacts.put(f, 18, "" + fact.meanNs);
            RowFacts.put(f, 19, "" + fact.p95Ns);
        }
    }

    public static void put(ArrayList<String> f, int32 i, String v) {
        f.set(i, "" + v);
    }

    /** The lines of `text` without their "\n". */
    public static #ArrayList<String> lines(String text) {
        ArrayList<String> out = heap ArrayList<String>();
        int32 n = text.byteLength();
        int32 start = 0;
        int32 i = 0;
        boolean quoted = false;
        while (i < n) {
            int8 c = text.byteAt(i);
            if (c == 34) {
                quoted = !quoted;
            }
            if (c == 10 && !quoted) {
                out.add(text.substring(start, i));
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < n) {
            out.add(text.substring(start, n));
        }
        return out;
    }

    /** The fields of one CSV line, unquoted (RFC 4180: "" inside quotes is "). */
    public static #ArrayList<String> fields(String line) {
        ArrayList<String> out = heap ArrayList<String>();
        int32 n = line.byteLength();
        int32 i = 0;
        String cur = "";
        boolean quoted = false;
        while (i <= n) {
            if (i == n) {
                out.add(cur + "");
                i = i + 1;
            } else {
                int8 c = line.byteAt(i);
                if (quoted) {
                    if (c == 34) {
                        if (i + 1 < n && line.byteAt(i + 1) == 34) {
                            cur = cur + "\"";
                            i = i + 1;
                        } else {
                            quoted = false;
                        }
                    } else {
                        cur = cur + line.substring(i, i + 1);
                    }
                } else if (c == 34) {
                    quoted = true;
                } else if (c == 44) {
                    out.add(cur + "");
                    cur = "";
                } else {
                    cur = cur + line.substring(i, i + 1);
                }
                i = i + 1;
            }
        }
        return out;
    }

    public static #String join(ArrayList<String> f) {
        String s = "";
        int32 i = 0;
        int32 n = f.count();
        while (i < n) {
            if (i > 0) {
                s = s + ",";
            }
            String v = f.get(i);
            s = s + Csv.field(v);
            i = i + 1;
        }
        return s;
    }
}
