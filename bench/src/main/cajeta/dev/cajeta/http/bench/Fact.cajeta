package dev.cajeta.http.bench;

/**
 * What a row needs that the harness's Benchmark contract cannot carry
 * (dev.cajeta.bench 0.1.1): the competitor's language and library on a cpu
 * row, the measured throughput, the plain variant label, and, for a row whose
 * metric is a time the child reports itself (start-up), the timing columns.
 * RowFacts rewrites the harness's CSV with these after BenchMain returns.
 */
public class Fact {
    public String benchmark;
    public String label;          // the harness variant label, `<stack>|<variant>`
    public String variant;        // what the variant column becomes
    public String language;
    public String languageVersion;
    public String library;
    public String libraryVersion;
    public String throughput;
    public boolean timed;
    public int64 minNs;
    public int64 medianNs;
    public int64 meanNs;
    public int64 p95Ns;

    public Fact(String benchmark, String label) {
        this.benchmark = "" + benchmark;
        this.label = "" + label;
        this.variant = "";
        this.language = "";
        this.languageVersion = "";
        this.library = "";
        this.libraryVersion = "";
        this.throughput = "";
        this.timed = false;
        this.minNs = (int64) -1;
        this.medianNs = (int64) -1;
        this.meanNs = (int64) -1;
        this.p95Ns = (int64) -1;
    }
}
