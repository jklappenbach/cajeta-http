package dev.cajeta.http.bench;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import dev.cajeta.bench.detect.Sys;

/**
 * The server rows `oha` drives: plaintext and JSON over HTTP/1.1 keep-alive
 * (`-z <s> -c <conns> -w`) and HTTP/2 prior knowledge (`--http2 -c 64 -p 8`, HTTP_BENCH_H2_STREAMS sets -p),
 * and the TLS handshake rate (`-n <N> -c 64 --disable-keepalive` over https:
 * every request a fresh TLS 1.3 handshake). Before any load the stack's
 * response is byte-compared with cajeta-http's.
 *
 * The variant `64-wrk` (cajeta-http only, on plaintext-h1) runs `wrk -t4 -c64`
 * instead, and records the ratio of its rate to oha's 64-connection row as
 * the cross-check.
 */
public class OhaBench extends StackBench {
    public String target;
    public String mode;
    public String fetchFlavor;
    public boolean wrkRow;
    public String bodyNote;
    public int64 deadlineAborts;

    public OhaBench(^Ctx ctx, String id, String feature, String unitText, String variantsCsv,
                    String target, String mode) {
        super(ctx, id, feature, unitText, variantsCsv);
        this.target = "" + target;
        this.mode = "" + mode;
        this.fetchFlavor = "" + mode;
        this.wrkRow = false;
        this.bodyNote = "";
        this.deadlineAborts = (int64) 0;
        this.serverMode = "" + mode;
        this.timeoutMillis((int64) 120000);
    }

    public #String unsupported(Stack s, String variant) {
        if (variant.endsWith("-wrk") && !s.ours) {
            return "the wrk cross-check runs on cajeta-http only";
        }
        return "";
    }

    public void prepareStack(Stack s) {
        this.wrkRow = this.curVariant.endsWith("-wrk");
        this.deadlineAborts = (int64) 0;
        this.timeoutMillis((int64) (this.ctx.seconds + 60) * 1000);
        this.bodyNote #= this.ctx.byteCheck(s, this.fetchFlavor, this.port(), this.target);
    }

    public int32 tlsRequests() {
        if (this.ctx.smoke) {
            return 1000;
        }
        return 10000;
    }

    public #String[] argvFor(String label) {
        int32 conns = this.variantInt(64);
        String scheme = "http";
        if (this.mode.equals("tls")) {
            scheme = "https";
        }
        String url = scheme + "://127.0.0.1:" + this.port() + this.target;
        if (this.wrkRow) {
            String[] w = heap String[10];
            w[0] = "" + this.ctx.wrk;
            w[1] = "-t";
            w[2] = "4";
            w[3] = "-c";
            w[4] = "" + conns;
            w[5] = "-d";
            w[6] = "" + this.ctx.seconds + "s";
            w[7] = "--timeout";
            w[8] = "10s";
            w[9] = "" + url;
            return w;
        }
        if (this.mode.equals("tls")) {
            String[] t = heap String[14];
            t[0] = "" + this.ctx.oha;
            t[1] = "-n";
            t[2] = "" + this.tlsRequests();
            t[3] = "-c";
            t[4] = "" + conns;
            t[5] = "--disable-keepalive";
            t[6] = "--insecure";
            t[7] = "--no-tui";
            t[8] = "--output-format";
            t[9] = "json";
            t[10] = "--no-color";
            t[11] = "-t";
            t[12] = "10s";
            t[13] = "" + url;
            return t;
        }
        if (this.mode.equals("h2c")) {
            String[] h = heap String[15];
            h[0] = "" + this.ctx.oha;
            h[1] = "--http2";
            h[2] = "-z";
            h[3] = "" + this.ctx.seconds + "s";
            h[4] = "-c";
            h[5] = "" + conns;
            h[6] = "-p";
            h[7] = "" + this.ctx.h2Streams;
            h[8] = "--no-tui";
            h[9] = "--output-format";
            h[10] = "json";
            h[11] = "--no-color";
            h[12] = "-t";
            h[13] = "10s";
            h[14] = "" + url;
            return h;
        }
        String[] a = heap String[14];
        a[0] = "" + this.ctx.oha;
        a[1] = "-z";
        a[2] = "" + this.ctx.seconds + "s";
        a[3] = "-c";
        a[4] = "" + conns;
        a[5] = "-w";
        a[6] = "--no-tui";
        a[7] = "--output-format";
        a[8] = "json";
        a[9] = "--no-color";
        a[10] = "--disable-compression";
        a[11] = "-t";
        a[12] = "10s";
        a[13] = "" + url;
        return a;
    }

    public void absorb(String out) {
        if (this.wrkRow) {
            this.absorbWrk(out);
            return;
        }
        JsonValue root #= Json.parse(out);
        JsonObject o = root.object();
        JsonValue summary = o.get("summary");
        float64 total = summary.object().get("total").asFloat64();
        JsonObject codes = o.get("statusCodeDistribution").object();
        int64 all = (int64) 0;
        int64 ok = (int64) 0;
        int32 i = 0;
        int32 n = codes.count();
        while (i < n) {
            JsonValue v = codes.valueAt(i);
            int64 c = v.asInt64();
            all = all + c;
            int8[] kb = codes.keyAt(i);
            int32 kl = codes.keyLenAt(i);
            if (kl == 3 && kb[0] == 50 && kb[1] == 48 && kb[2] == 48) {
                ok = ok + c;
            }
            i = i + 1;
        }
        JsonObject errs = o.get("errorDistribution").object();
        int64 transport = (int64) 0;
        int32 j = 0;
        int32 en = errs.count();
        int64 deadline = (int64) 0;
        while (j < en) {
            int64 c = errs.valueAt(j).asInt64();
            int8[] kb = errs.keyAt(j);
            int32 kl = errs.keyLenAt(j);
            String k = heap String(#Bytes0.copy(kb, kl), kl);
            // oha -z over HTTP/2 cuts the streams still in flight at the deadline and
            // files them as "aborted due to deadline" (measured: about -c x -p of them,
            // on every stack). They are the load generator stopping, not server errors.
            if (this.mode.equals("h2c") && k.equals("aborted due to deadline")) {
                deadline = deadline + c;
            } else {
                transport = transport + c;
            }
            j = j + 1;
        }
        this.deadlineAborts = this.deadlineAborts + deadline;
        this.trialRequests = all;
        this.trialErrors = (all - ok) + transport;
        if (total > 0.0) {
            this.trialValueMilli = (int64) ((float64) ok / total * 1000.0);
        }
        this.trialNote = "status!=200: " + (all - ok) + ", transport errors: " + transport;
        if (this.mode.equals("tls") && all != (int64) this.tlsRequests()) {
            this.trialOk = false;
            this.trialNote = "completed " + all + " of " + this.tlsRequests() + " handshakes";
        }
    }

    // wrk's text summary: "N requests in 2.00s", "Requests/sec: X",
    // "Socket errors: connect a, read b, write c, timeout d", "Non-2xx or 3xx responses: n".
    public void absorbWrk(String out) {
        int64 inAt = out.indexOf(" requests in ");
        int64 requests = (int64) -1;
        if (inAt > 0) {
            int32 b = (int32) inAt - 1;
            while (b > 0 && out.byteAt(b - 1) >= 48 && out.byteAt(b - 1) <= 57) {
                b = b - 1;
            }
            String num #= out.substring(b, (int32) inAt);
            requests = Num.parse(num, (int64) -1);
        }
        String rate #= Sys.tokenAfter(out, "Requests/sec:");
        float64 rps = Num.parseFloat(rate);
        int64 sockErr = (int64) 0;
        if (out.contains("Socket errors:")) {
            sockErr = Num.parse(Sys.tokenAfter(out, "connect"), (int64) 0)
                + Num.parse(Sys.tokenAfter(out, "read"), (int64) 0)
                + Num.parse(Sys.tokenAfter(out, "write"), (int64) 0)
                + Num.parse(Sys.tokenAfter(out, "timeout"), (int64) 0);
        }
        int64 non2xx = (int64) 0;
        if (out.contains("Non-2xx or 3xx responses:")) {
            non2xx = Num.parse(Sys.tokenAfter(out, "Non-2xx or 3xx responses:"), (int64) 0);
        }
        this.trialRequests = requests;
        this.trialErrors = sockErr + non2xx;
        if (requests <= 0 || rps <= 0.0) {
            this.trialOk = false;
            this.trialNote = "could not read wrk's summary";
        }
        this.trialValueMilli = (int64) (rps * 1000.0);
    }

    public boolean extraCheck() {
        if (!this.wrkRow) {
            return true;
        }
        // The cross-check: wrk's rate against oha's on the same server and connection count.
        String base = "cajeta-http|" + this.curVariant.substring(0, this.curVariant.byteLength() - 4);
        float64 o = (float64) this.medianOf(base);
        float64 w = (float64) this.medianOf(this.curLabel);
        if (o <= 0.0 || w <= 0.0) {
            this.note = this.note + "; crosscheck=unavailable (no oha row)";
            return false;
        }
        float64 ratio = w / o;
        this.note = this.note + "; crosscheck=wrk/oha " + Num.fixed(ratio, 2);
        return ratio > 0.25 && ratio < 4.0;
    }

    public #String details() {
        String s = "";
        if (this.wrkRow) {
            s = "loadgen=" + this.ctx.wrkVersion + "; wrk -t4 -c" + this.variantInt(64);
        } else if (this.mode.equals("tls")) {
            s = "loadgen=" + this.ctx.ohaVersion + "; " + this.tlsRequests()
                + " fresh TLS 1.3 handshakes per trial, -c " + this.variantInt(64);
        } else if (this.mode.equals("h2c")) {
            s = "loadgen=" + this.ctx.ohaVersion + "; h2c prior knowledge, -c " + this.variantInt(64) + " -p " + this.ctx.h2Streams
                + "; in-flight-at-deadline=" + this.deadlineAborts + " (not counted)";
        } else {
            s = "loadgen=" + this.ctx.ohaVersion + "; -c " + this.variantInt(64) + " keep-alive";
        }
        if (!this.mode.equals("tls")) {
            s = s + "; " + this.ctx.seconds + "s";
        }
        if (!this.bodyNote.isEmpty()) {
            s = s + "; " + this.bodyNote;
        }
        return s;
    }
}
