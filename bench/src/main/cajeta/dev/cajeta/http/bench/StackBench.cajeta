package dev.cajeta.http.bench;

import cajeta.collection.ArrayList;
import cajeta.io.file.Path;
import cajeta.process.ProcessResult;
import dev.cajeta.bench.ExternalBenchmark;
import dev.cajeta.bench.ServiceBenchmark;
import dev.cajeta.bench.detect.Sys;

/**
 * One page id measured on every selected stack, on dev.cajeta.bench's
 * ServiceBenchmark. The harness sees one Benchmark whose variant keys are
 * `<stack>|<variant>` (cajeta-http first); each is one row. Every column is
 * the harness's: the identity hooks answer per variant from the stack's
 * facts (platform the stack, language and its version, library and version
 * of the feature the row measures, the variant column the page's variant),
 * each trial reports its throughput (reportedThroughput, the row's figure the
 * median trial), and peak_rss_kb is the server's VmHWM sampled by
 * ServiceBenchmark after every trial and before the stop.
 *
 * Per variant, in the harness's order:
 *   supportsVariant  a stack without the feature is a skipped row with its reason (skipReasonFor)
 *   prepare          start the stack's server (ServiceBenchmark: a free port, ready, PID recorded)
 *                    and byte-compare it with cajeta-http (subclass)
 *   runPhase         one trial: run the command(s), absorb their output; errors fail the row
 *   checkResult      the trials' checks
 *   finishVariant    stop the server by its PID (ServiceBenchmark)
 *
 * A subclass names its server with serverMode (h1, h2c, tls) or "" for a row
 * with no server of its own (start-up, idle RSS: loadgen launches those).
 */
public class StackBench extends ServiceBenchmark {
    public Ctx ctx;
    public String id;
    public String feature;
    public String unitText;
    public String variantsCsv;
    public String serverMode;
    public String curLabel;
    public String curStack;
    public String curVariant;
    public String note;
    public String trialNote;
    public int32 svcPort;
    public int64[] trialMilli;
    public int32 trialN;
    public int64 requests;
    public int64 errors;
    public int64 warmErrors;
    public int64 trialRequests;
    public int64 trialErrors;
    public int64 trialValueMilli;
    public boolean trialOk;
    public boolean allOk;
    public int32 step;
    public ArrayList<String> medLabels;
    public ArrayList<int64> medMilli;

    public StackBench(^Ctx ctx, String id, String feature, String unitText, String variantsCsv) {
        super();
        this.ctx = ctx;
        this.id = "" + id;
        this.feature = "" + feature;
        this.unitText = "" + unitText;
        this.variantsCsv = "" + variantsCsv;
        this.serverMode = "";
        this.curLabel = "";
        this.curStack = "";
        this.curVariant = "";
        this.note = "";
        this.trialNote = "";
        this.svcPort = 0;
        this.trialMilli = heap int64[64];
        this.trialN = 0;
        this.requests = (int64) 0;
        this.errors = (int64) 0;
        this.warmErrors = (int64) 0;
        this.trialRequests = (int64) 0;
        this.trialErrors = (int64) 0;
        this.trialValueMilli = (int64) 0;
        this.trialOk = true;
        this.allOk = true;
        this.step = 0;
        this.medLabels = heap ArrayList<String>();
        this.medMilli = heap ArrayList<int64>();
        this.describe(id, "http");
        this.iterations(1, 5);
        this.readyTimeoutMillis((int64) 30000);
        this.readyPollMillis(1);
    }

    // ---- identity (dev.cajeta.bench's per-variant hooks) -------------------

    public #ArrayList<String> variants() {
        return this.ctx.labels(this.variantsCsv);
    }

    public static #String stackOf(String label) {
        int64 bar = label.indexOf("|");
        return label.substring(0, (int32) bar);
    }

    public static #String variantOf(String label) {
        int64 bar = label.indexOf("|");
        return label.substring((int32) bar + 1, label.byteLength());
    }

    public Stack stackFor(String label) {
        String name #= StackBench.stackOf(label);
        return this.ctx.findStack(name);
    }

    public String platformFor(String label) {
        return StackBench.stackOf(label);
    }

    public String languageFor(String label) {
        Stack s = this.stackFor(label);
        return s.language();
    }

    public String languageVersionFor(String label) {
        Stack s = this.stackFor(label);
        return s.languageVersion();
    }

    public String libraryFor(String label) {
        Stack s = this.stackFor(label);
        return s.libName(this.feature);
    }

    public String libraryVersionFor(String label) {
        Stack s = this.stackFor(label);
        return s.libVersion(this.feature);
    }

    public String variantLabel(String label) {
        return StackBench.variantOf(label);
    }

    public String unit() {
        return this.unitText;
    }

    /** The row's notes: this variant's, never another's. */
    public String noteFor(String label) {
        if (label.equals(this.curLabel)) {
            return this.note;
        }
        return "";
    }

    // ---- skips -------------------------------------------------------------

    /** Why `label` cannot run here, or "" when it can. */
    public #String whyNot(String label) {
        Stack s = this.stackFor(label);
        if (s.facts.isEmpty()) {
            return s.name + ": competitors/" + s.name + "/versions.sh printed nothing (run competitors/build.sh)";
        }
        if (!s.has(this.feature)) {
            return s.name + " has no " + this.feature + " implementation (versions.sh: " + this.feature + "=none)";
        }
        String v #= StackBench.variantOf(label);
        return this.unsupported(s, v);
    }

    /** Subclass hook: why stack `s` cannot run `variant`, or "". */
    public #String unsupported(Stack s, String variant) {
        return "";
    }

    public boolean supportsVariant(String label) {
        String why #= this.whyNot(label);
        return why.isEmpty();
    }

    public String skipReasonFor(String label) {
        return this.whyNot(label);
    }

    public Stack current() {
        return this.ctx.findStack(this.curStack);
    }

    // ---- the server (ServiceBenchmark) ----------------------------------------

    public #String[] serviceArgvFor(String label) {
        Stack s = this.stackFor(label);
        return this.ctx.serverArgv(s, this.serverMode, this.svcPort);
    }

    /** A free port in 20100..20199, readiness for the mode, then the start; the PID goes to build/pids. */
    public void startService(String label) {
        this.svcPort = this.ctx.freePort();
        if (this.serverMode.equals("h1")) {
            this.readyOnUrl(this.svcPort, "/plaintext", 200);
        } else {
            this.readyOnPort(this.svcPort);
        }
        this.serviceLog(this.ctx.root + "/build/servers.log");
        super.startService(label);
        this.ctx.recordPid(this.lastServicePid);
    }

    // ---- lifecycle --------------------------------------------------------

    public void prepare(String label) {
        this.curLabel = "" + label;
        this.curStack #= StackBench.stackOf(label);
        this.curVariant #= StackBench.variantOf(label);
        this.trialN = 0;
        this.requests = (int64) 0;
        this.errors = (int64) 0;
        this.warmErrors = (int64) 0;
        this.allOk = true;
        this.note = "";
        this.svcPort = 0;
        if (this.serverMode.isEmpty()) {
            this.peakKb = (int64) -1;
            this.lastExitCode = -1;
            this.lastStdout = "";
        } else {
            super.prepare(label);
        }
        this.prepareStack(this.current());
    }

    /** Subclass hook: after the server is up (byte comparison, parameters). */
    public void prepareStack(Stack s) {
    }

    /** How many commands make one trial (client-connection-reuse runs two). */
    public int32 stepsPerTrial() {
        return 1;
    }

    /** One trial: the commands, their output absorbed; an error fails the row. */
    public void runPhase(String label) {
        this.lastVariant = "" + label;
        this.trialRequests = (int64) 0;
        this.trialErrors = (int64) 0;
        this.trialValueMilli = (int64) 0;
        this.trialOk = true;
        this.trialNote = "";
        int32 k = 0;
        int32 steps = this.stepsPerTrial();
        while (k < steps) {
            this.step = k;
            this.execute(label);
            this.absorb(this.stdout());
            k = k + 1;
        }
        this.endTrial();
        if (this.isWarmup()) {
            this.warmErrors = this.warmErrors + this.trialErrors;
        } else {
            this.requests = this.requests + this.trialRequests;
            this.errors = this.errors + this.trialErrors;
            if (this.trialN < 64) {
                this.trialMilli[this.trialN] = this.trialValueMilli;
                this.trialN = this.trialN + 1;
            }
            if (!this.trialOk) {
                this.allOk = false;
            }
            this.note #= this.composeNote();
            if (this.trialErrors > 0) {
                throw heap Exception(this.curStack + ": " + this.trialErrors + " error(s) in a trial; "
                    + this.trialNote);
            }
            if (!this.trialOk) {
                throw heap Exception(this.curStack + ": trial check failed; " + this.trialNote);
            }
            this.reportTrial();
        }
        if (this.svc != null && !StackBench.pidAlive(this.lastServicePid)) {
            throw heap Exception(this.curStack + ": the server (pid " + this.lastServicePid + ") died under load");
        }
    }

    /** Subclass hook: a measured trial's figure to the harness. Default: its throughput. */
    public void reportTrial() {
        this.reportedThroughput((float64) this.trialValueMilli / 1000.0, this.unitText);
    }

    /** Subclass hook: read one command's stdout into trialRequests/Errors/ValueMilli/Ok/Note. */
    public void absorb(String out) {
    }

    /** Subclass hook: after all steps of a trial. */
    public void endTrial() {
    }

    public boolean checkResult() {
        if (this.lastExitCode != 0 || this.trialN == 0 || this.errors != 0 || !this.allOk) {
            return false;
        }
        int64[] copy = heap int64[this.trialN];
        int32 i = 0;
        while (i < this.trialN) {
            copy[i] = this.trialMilli[i];
            i = i + 1;
        }
        int64 med = Num.median(copy, this.trialN);
        this.medLabels.add(this.curLabel + "");
        this.medMilli.add(med);
        this.note #= this.composeNote();
        return this.extraCheck();
    }

    /** The median trial value (thousandths) a row of this benchmark recorded, or -1. */
    public int64 medianOf(String label) {
        int32 i = 0;
        while (i < this.medLabels.count()) {
            String l = this.medLabels.get(i);
            if (l.equals(label)) {
                return this.medMilli.get(i);
            }
            i = i + 1;
        }
        return (int64) -1;
    }

    public boolean extraCheck() {
        return true;
    }

    /** The row's notes: requests, errors, the subclass's details. */
    public #String composeNote() {
        String s = "requests=" + this.requests + "; errors=" + this.errors;
        if (this.warmErrors > 0) {
            s = s + "; warmup-errors=" + this.warmErrors;
        }
        String extra #= this.details();
        if (!extra.isEmpty()) {
            s = s + "; " + extra;
        }
        return s;
    }

    /** Subclass hook: the rest of the notes (load generator, byte check, parameters). */
    public #String details() {
        return "";
    }

    // ---- helpers ----------------------------------------------------------

    public int32 port() {
        return this.svcPort;
    }

    public int32 variantInt(int32 fallback) {
        return (int32) Num.parse(this.curVariant, (int64) fallback);
    }

    /** True while `pid` is a running process (not gone, not a zombie). */
    public static boolean pidAlive(int32 pid) {
        String st #= Sys.readText("/proc/" + pid + "/stat");
        if (st.isEmpty()) {
            return false;
        }
        int64 close = st.indexOf(") ");
        if (close < 0) {
            return false;
        }
        int8 state = st.byteAt((int32) close + 2);
        return state != 90 && state != 88;   // 'Z' zombie, 'X' dead
    }

    /**
     * The phase command's own peak RSS in KiB from one untimed run under GNU
     * time, or -1: ExternalBenchmark's measurement, for a row whose figure is
     * the client's (ServiceBenchmark's measuredPeakRssKb is the service's).
     */
    public int64 childPeakKb() {
        Path gt #= Path.of("/usr/bin/time");
        if (!gt.exists()) {
            return (int64) -1;
        }
        String[] inner #= this.argvFor(this.lastVariant);
        int32 n = (int32) inner.count();
        if (n == 0) {
            return (int64) -1;
        }
        String[] argv = heap String[n + 3];
        argv[0] = "/usr/bin/time";
        argv[1] = "-f";
        argv[2] = "CAJETA_BENCH_MAXRSS=%M";
        int32 i = 0;
        while (i < n) {
            argv[i + 3] = "" + inner[i];
            i = i + 1;
        }
        ProcessResult r #= this.launch(#argv);
        if (!r.launched()) {
            return (int64) -1;
        }
        String err #= Sys.copyText(r.stderr());
        String v #= Sys.tokenAfter(err, "CAJETA_BENCH_MAXRSS=");
        return ExternalBenchmark.parseKb(v);
    }
}
