package dev.cajeta.http.test;

import cajeta.io.net.AsyncReader;
import cajeta.io.net.Server;
import cajeta.io.net.TcpStream;
import cajeta.io.net.uri.Uri;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.body.Body;
import dev.cajeta.http.body.BytesChannel;
import dev.cajeta.http.body.StreamBody;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.server.ServerLimits;

/**
 * http:1.3e — the deferred STREAMING legs, now wired into the serve
 * loop:
 *
 *   - **streamed response**: a handler attaches an unknown-length
 *     `Body` (`bodyModel` set, raw path empty) and the server frames
 *     it CHUNKED on the wire through `ResponseBodyWriter` — the
 *     shipped client de-chunks it transparently, and the connection
 *     stays reusable (chunked self-terminates);
 *   - **streaming request** (opt-in via
 *     `ServerLimits.streamRequestBody`): the handler reads the request
 *     body INCREMENTALLY through `request.getBody().reader()` — the
 *     body is never buffered ahead of the handler;
 *   - **implicit drain-on-return**: a handler that IGNORES its
 *     streamed body leaves the connection reusable — the loop drains
 *     the remainder before the next exchange.
 *
 * Accept accounting proves reuse: each scenario is exactly ONE
 * accepted connection carrying two exchanges.
 */
public final class ServerStreamingTests {

    /**
     * The streamed-response source (payload + channel), held in a
     * class-typed static: it must outlive both the handler frame (the
     * pump runs after the handler returns) and the borrowing
     * `BytesChannel`.
     */
    public static final class Holder {
        public int8[] data;
        public BytesChannel chan;

        public Holder(int32 n) {
            int8[] p #= ServerStreamingTests.pattern(n);
            this.data = #p;
            BytesChannel c = heap BytesChannel(this.data, (int64) n);
            this.chan = #c;
        }
    }

    static Holder src = null;

    public static void run(Check c) {
        System.stdout.println("-- server streaming: chunked response --");
        streamedResponse(c);
        System.stdout.println("-- server streaming: handler reads the body --");
        handlerReads(c);
        System.stdout.println("-- server streaming: ignored body drained --");
        ignoredDrained(c);
    }

    static #int8[] pattern(int32 n) {
        int8[] p = heap int8[n];
        int32 i = 0;
        while (i < n) {
            p[i] = (int8) ((i * 31 + 7) & 0xFF);
            i = i + 1;
        }
        return #p;
    }

    // ---- handlers --------------------------------------------------------

    public static #HttpResponse handleStream(HttpRequest req) {
        String t #= req.getTarget();
        if (t.equals("/stream")) {
            // The source channel lives in a static (it must outlive
            // this frame — the loop pumps it AFTER the handler returns).
            AsyncReader r = heap AsyncReader(ServerStreamingTests.src.chan);
            StreamBody b #= StreamBody.of(#r);
            HttpResponse resp #= HttpResponse.ok();
            resp.body(#b);
            return #resp;
        }
        String ok = "plain";
        return HttpResponse.ok().body(ok.toBytes(), ok.byteLength());
    }

    public static #HttpResponse handleCount(HttpRequest req) {
        String t #= req.getTarget();
        if (t.equals("/count")) {
            Body b = req.getBody();
            if (b == null) {
                String none = "-1";
                return HttpResponse.ok().body(none.toBytes(), none.byteLength());
            }
            AsyncReader r = b.reader();
            int8[] scratch = heap int8[2048];
            int32 total = 0;
            boolean going = true;
            while (going) {
                int32 got = r.read(scratch, 0, 2048);
                if (got <= 0) {
                    going = false;
                } else {
                    total = total + got;
                }
            }
            String out = "" + total;
            return HttpResponse.ok().body(out.toBytes(), out.byteLength());
        }
        // /ignore (and anything else): never touches the body.
        String ig = "IGNORED";
        return HttpResponse.ok().body(ig.toBytes(), ig.byteLength());
    }

    /** Accept one connection and dispatch it (local copy — bare-spawn rule). */
    public static async int32 acceptAndDispatch(Server core) {
        TcpStream conn #= core.acceptNext();
        core.dispatch(#conn);
        return 1;
    }

    static #String respText(HttpResponse resp) {
        int32 n = resp.bodyLength();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = resp.body[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    // ---- client fibers ---------------------------------------------------

    /** GET the streamed route; bytes must match; then a plain GET reuses. */
    public static async int32 getStreamed(int32 port, int32 n) {
        HttpClient client #= heap HttpClient();
        String url = "http://127.0.0.1:" + port + "/stream";
        HttpResponse resp #= client.get(url);
        if (resp.statusCode() != 200) { return -1; }
        if (resp.bodyLength() != n) {
            System.stdout.println("  (streamed body length: {})", resp.bodyLength());
            return -2;
        }
        int8[] want #= ServerStreamingTests.pattern(n);
        int32 i = 0;
        while (i < n) {
            if (resp.body[i] != want[i]) { return -3; }
            i = i + 1;
        }
        String p2 #= ServerStreamingTests.respTextOf(client, port, "/plain");
        if (p2 == null || !p2.equals("plain")) { return -4; }
        return 1;
    }

    static #String respTextOf(HttpClient client, int32 port, String path) {
        String url = "http://127.0.0.1:" + port + path;
        HttpResponse resp #= client.get(url);
        if (resp.statusCode() != 200) {
            return null;
        }
        return ServerStreamingTests.respText(resp);
    }

    /** POST `n` bytes to `path`; return the response text (null on !200). */
    static #String postBytes(HttpClient client, int32 port, String path, int32 n) {
        Uri uri #= Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path(path)
            .build();
        HttpRequest req #= HttpRequest.fromUri("POST", uri);
        int8[] data #= ServerStreamingTests.pattern(n);
        req.body(data, n);
        HttpResponse resp #= client.send(uri, req);
        if (resp.statusCode() != 200) {
            return null;
        }
        return ServerStreamingTests.respText(resp);
    }

    /** Two counted POSTs on one connection — the handler saw every byte. */
    public static async int32 countTwice(int32 port) {
        HttpClient client #= heap HttpClient();
        String c1 #= ServerStreamingTests.postBytes(client, port, "/count", 8000);
        if (c1 == null || !c1.equals("8000")) {
            System.stdout.println("  (count 1: '{}')", c1);
            return -1;
        }
        String c2 #= ServerStreamingTests.postBytes(client, port, "/count", 300);
        if (c2 == null || !c2.equals("300")) {
            System.stdout.println("  (count 2: '{}')", c2);
            return -2;
        }
        return 1;
    }

    /** Ignore a body, then count one — same connection stays framed. */
    public static async int32 ignoreThenCount(int32 port) {
        HttpClient client #= heap HttpClient();
        String i1 #= ServerStreamingTests.postBytes(client, port, "/ignore", 8000);
        if (i1 == null || !i1.equals("IGNORED")) {
            System.stdout.println("  (ignore: '{}')", i1);
            return -1;
        }
        String c1 #= ServerStreamingTests.postBytes(client, port, "/count", 500);
        if (c1 == null || !c1.equals("500")) {
            System.stdout.println("  (post-ignore count: '{}')", c1);
            return -2;
        }
        return 1;
    }

    // ---- scenarios -------------------------------------------------------

    static void streamedResponse(Check c) {
        scope {
            int32 N = 10000;
            Holder hold = heap Holder(N);
            ServerStreamingTests.src #= hold;

            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse h =
                (req) -> ServerStreamingTests.handleStream(req);
            b.handler(h);
            HttpServer srv #= b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn getStreamed(port, N);
            c.eqInt((int64) await t1, 1,
                    "unknown-length Body streams chunked; client re-reads it");
            c.eqInt((int64) await s1, 1,
                    "streamed + plain exchanges rode one connection");
        }
    }

    static #HttpServer streamingServer() {
        ServerLimits l #= ServerLimits.of(5000, 5000, (int64) 0, true);
        l.streamRequestBody = true;
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        (HttpRequest) -> #HttpResponse h =
            (req) -> ServerStreamingTests.handleCount(req);
        b.handler(h);
        b.serverLimits(#l);
        return b.build();
    }

    static void handlerReads(Check c) {
        scope {
            HttpServer srv #= ServerStreamingTests.streamingServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn countTwice(port);
            c.eqInt((int64) await t1, 1,
                    "handler reads the streamed request body incrementally");
            c.eqInt((int64) await s1, 1, "two counted POSTs rode one connection");
        }
    }

    static void ignoredDrained(Check c) {
        scope {
            HttpServer srv #= ServerStreamingTests.streamingServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn ignoreThenCount(port);
            c.eqInt((int64) await t1, 1,
                    "ignored streamed body is drained; framing survives");
            c.eqInt((int64) await s1, 1, "ignore + count rode one connection");
        }
    }
}
