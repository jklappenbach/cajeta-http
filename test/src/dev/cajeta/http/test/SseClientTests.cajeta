package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.io.net.ByteBuffer;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HeadScanner;
import dev.cajeta.http.sse.SseClient;
import dev.cajeta.http.sse.SseDecoder;
import dev.cajeta.http.sse.SseEvent;

/**
 * http:4.4c — the **SSE client**, exercised socket-free: the
 * [`SseDecoder`](../../../sse/SseDecoder.cajeta) folds `id`/`retry` into the
 * reconnection state as events drain, and the [`SseClient`](../../../sse/SseClient.cajeta)
 * policy — the resume request it builds, the response heads it accepts or
 * rejects, and the reconnection delay it computes — is pinned without a
 * transport. The live subscribe/reconnect loop rides these and is smoke-tested
 * over loopback in `SseClientLoopbackTests`.
 */
public final class SseClientTests {

    static void decoderTracksState(Check c) {
        SseDecoder d = heap SseDecoder();
        // Feed a two-event stream in two arbitrary byte splits.
        String part1 = "retry: 4000\ndata: hello\nid: 7\n\ndata: wor";
        String part2 = "ld\nid: 8\n\n";
        int8[] b1 #= part1.toBytes();
        d.feed(b1, (int32) b1.count());
        int8[] b2 #= part2.toBytes();
        d.feed(b2, (int32) b2.count());

        c.that(d.hasEvent(), "decoder: first event dispatched across a split");
        SseEvent e1 #= d.nextEvent();
        c.that(e1.data.equals("hello"), "decoder: event 1 data 'hello'");
        String id1 #= d.lastEventId();
        c.that(id1 != null && id1.equals("7"), "decoder: lastEventId tracks '7'");
        c.eqInt((int64) d.retryMillis(), (int64) 4000,
                "decoder: retry: folds into retryMillis");

        SseEvent e2 #= d.nextEvent();
        c.that(e2.data.equals("world"), "decoder: event 2 data 'world'");
        String id2 #= d.lastEventId();
        c.that(id2 != null && id2.equals("8"), "decoder: lastEventId advances to '8'");
    }

    static void decoderSeed(Check c) {
        SseDecoder d = heap SseDecoder();
        c.that(d.lastEventId() == null, "decoder: no id before any event");
        d.seedLastId("42");
        String id #= d.lastEventId();
        c.that(id != null && id.equals("42"), "decoder: seedLastId sets the resume id");
    }

    static void buildRequest(Check c) {
        SseClient sc = heap SseClient("http://events.test/stream");
        String head #= sc.requestHead();
        c.that(head.startsWith("GET /stream HTTP/1.1\r\n"), "request: GET with an origin-form target");
        c.that(head.contains("\r\nAccept: text/event-stream\r\n"), "request: Accept: text/event-stream");
        c.that(head.contains("\r\nCache-Control: no-cache\r\n"), "request: Cache-Control: no-cache");
        c.that(head.contains("\r\nHost: events.test\r\n"), "request: Host from the URL, no default port");
        c.that(!head.contains("Last-Event-ID"), "request: no Last-Event-ID on the first connect");
        c.that(head.endsWith("\r\n\r\n"), "request: the head ends with a blank line");
        sc.resumeFrom("99");
        String head2 #= sc.requestHead();
        c.that(head2.contains("\r\nLast-Event-ID: 99\r\n"), "request: Last-Event-ID replayed on resume");
    }

    // A response view over `head`, which it owns.
    static #ClientResponse response(String head) {
        int8[] bytes #= head.toBytes();
        ByteBuffer buf = heap ByteBuffer(4096);
        int32 i = 0;
        while (i < head.byteLength()) {
            buf.put(bytes[i]);
            i = i + 1;
        }
        ClientResponse r = heap ClientResponse();
        HeadScanner.parseResponse(buf.array(), 0, head.byteLength(), r);
        r.adopt(#buf);
        return #r;
    }

    static boolean refused(SseClient sc, String head) {
        ClientResponse r #= SseClientTests.response(head);
        try {
            sc.checkHead(r);
        } catch (Exception e) {
            return true;
        }
        return false;
    }

    static void checkHead(Check c) {
        SseClient sc = heap SseClient("http://events.test/stream");
        c.that(!SseClientTests.refused(sc,
                "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n\r\n"),
               "checkHead: 200 text/event-stream accepted");
        c.that(SseClientTests.refused(sc,
                "HTTP/1.1 404 Not Found\r\nContent-Type: text/event-stream\r\n\r\n"),
               "checkHead: non-200 is a terminal SseException");
        c.that(SseClientTests.refused(sc,
                "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\n"),
               "checkHead: wrong content-type is a terminal SseException");
        c.that(!SseClientTests.refused(sc,
                "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream; charset=utf-8\r\n\r\n"),
               "checkHead: essence match ignores the charset param");
    }

    static void reconnectDelay(Check c) {
        SseClient sc = heap SseClient("http://events.test/stream");
        c.eqInt((int64) sc.reconnectDelayMillis(), (int64) 3000,
                "delay: WHATWG default 3000ms before any retry:");
        sc.defaultRetryMillis(250);
        c.eqInt((int64) sc.reconnectDelayMillis(), (int64) 250,
                "delay: defaultRetryMillis override applies");
    }

    public static void run(Check c) {
        System.stdout.println("-- sse client: decoder tracks id/retry --");
        SseClientTests.decoderTracksState(c);
        System.stdout.println("-- sse client: decoder seed --");
        SseClientTests.decoderSeed(c);
        System.stdout.println("-- sse client: request builder --");
        SseClientTests.buildRequest(c);
        System.stdout.println("-- sse client: head validation --");
        SseClientTests.checkHead(c);
        System.stdout.println("-- sse client: reconnect delay --");
        SseClientTests.reconnectDelay(c);
    }
}
