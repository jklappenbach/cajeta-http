package dev.cajeta.http.test;

import dev.cajeta.http.h2.Http2;
import dev.cajeta.http.h2.Http2FlowWindow;
import dev.cajeta.http.h2.Http2FlowController;
import dev.cajeta.http.h2.Http2Exception;
import dev.cajeta.http.h2.Http2SendGate;

/**
 * http:3.3c — HTTP/2 **flow control** (RFC 9113 §5.2, §6.9): the directional
 * window primitive (consume / WINDOW_UPDATE increase with overflow →
 * FLOW_CONTROL_ERROR / negative window via a SETTINGS reduction) and the
 * connection controller that bounds a DATA send by min(connection, stream,
 * max-frame) and computes the §6.9.2 initial-window-size delta.
 */
public final class Http2FlowTests {

    public static void run(Check c) {
        System.stdout.println("-- h2 flow: window primitive --");
        Http2FlowTests.window(c);
        System.stdout.println("-- h2 flow: controller --");
        Http2FlowTests.controller(c);
        System.stdout.println("-- h2 flow: receive credit stays bounded --");
        Http2FlowTests.recvCredit(c);
        System.stdout.println("-- h2 flow: send-gate slots are reused --");
        Http2FlowTests.gateSlots(c);
    }

    /**
     * Receive credit must be accounted as it is consumed. Handing it back
     * without consuming it walks the window past MAX_WINDOW_SIZE, where
     * `increase` throws, so a long-lived connection dies on a FLOW_CONTROL_ERROR
     * of its own making.
     */
    static void recvCredit(Check c) {
        int32 chunk = 32768;

        // Consume then credit, which is what replenish does: bounded forever.
        Http2FlowWindow w = heap Http2FlowWindow(65535);
        int32 i = 0;
        while (i < 200000) {
            w.consume(chunk);
            w.increase(chunk, 0);
            i = i + 1;
        }
        c.eqInt(w.available(), (int64) 65535, "credit returns to the window");

        // Crediting without consuming is the defect, and it is fatal.
        Http2FlowWindow u = heap Http2FlowWindow(65535);
        boolean blew = false;
        int32 k = 0;
        while (k < 200000 && !blew) {
            try {
                u.increase(chunk, 0);
            } catch (Http2Exception e) {
                blew = e.errorCode == Http2.FLOW_CONTROL_ERROR;
            }
            k = k + 1;
        }
        c.that(blew, "unaccounted credit overflows the window");
    }

    /** A gate slot is released with its stream and reused by the next one. */
    static void gateSlots(Check c) {
        Http2SendGate g = heap Http2SendGate(65535);
        g.openStream(1, 65535);
        g.openStream(3, 65535);
        c.eqInt((int64) g.slotCount(), (int64) 2, "two live streams, two slots");

        g.closeStream(1);
        g.closeStream(3);
        int32 id = 5;
        int32 n = 0;
        while (n < 500) {
            g.openStream(id, 65535);
            g.closeStream(id);
            id = id + 2;
            n = n + 1;
        }
        c.eqInt((int64) g.slotCount(), (int64) 2, "500 more streams reuse them");

        // A released stream is unknown to the gate, so a late grant is a no-op
        // rather than credit handed to whoever took the slot.
        g.grantStream(1, 1000);
        c.that(!g.isCancelled(1), "a released stream is not tracked");

        // Live streams still hold their own slots.
        Http2SendGate h = heap Http2SendGate(65535);
        int32 j = 1;
        int32 m = 0;
        while (m < 40) {
            h.openStream(j, 65535);
            j = j + 2;
            m = m + 1;
        }
        c.eqInt((int64) h.slotCount(), (int64) 40, "live streams keep slots");
    }

    static void window(Check c) {
        Http2FlowWindow w = heap Http2FlowWindow(65535);
        c.eqInt(w.available(), (int64) 65535, "initial 65535");
        w.consume(1000);
        c.eqInt(w.available(), (int64) 64535, "after consume 1000");
        w.increase(2000, 0);
        c.eqInt(w.available(), (int64) 66535, "after WINDOW_UPDATE 2000");

        // A SETTINGS reduction can drive the window negative.
        Http2FlowWindow n = heap Http2FlowWindow(65535);
        n.adjust((int64) -70000);
        c.eqInt(n.available(), (int64) -4465, "negative window allowed");
        // ... and a later WINDOW_UPDATE brings it back positive.
        n.increase(10000, 1);
        c.eqInt(n.available(), (int64) 5535, "WINDOW_UPDATE recovers negative");

        // Overflow past 2^31-1 -> FLOW_CONTROL_ERROR.
        boolean e = false;
        Http2FlowWindow big = heap Http2FlowWindow(2147483637);   // 2^31-1 - 10
        try {
            big.increase(20, 7);
        } catch (Http2Exception ex) {
            e = ex.errorCode == Http2.FLOW_CONTROL_ERROR;
        }
        c.that(e, "WINDOW_UPDATE overflow -> FLOW_CONTROL_ERROR");
    }

    static void controller(Check c) {
        Http2FlowController fc = heap Http2FlowController(65535, 65535);
        c.eqInt((int64) fc.initialStreamSendWindow(), (int64) 65535,
                "new stream send window 65535");

        Http2FlowWindow streamSend = heap Http2FlowWindow(65535);
        // Bounded by the default max frame size 16384.
        c.eqInt((int64) fc.sendable(streamSend), (int64) 16384,
                "sendable bounded by max frame 16384");

        // A larger peer max frame lifts that bound.
        fc.setPeerMaxFrame(32768);
        c.eqInt((int64) fc.sendable(streamSend), (int64) 32768,
                "sendable bounded by 32768 after setPeerMaxFrame");

        // The connection window can be the binding constraint.
        fc.connSend.consume(64535);   // conn now 1000
        c.eqInt((int64) fc.sendable(streamSend), (int64) 1000,
                "sendable bounded by connection window");

        // Account a send against both windows.
        fc.afterSend(streamSend, 1000);
        c.eqInt(fc.connSend.available(), (int64) 0, "conn window drained");
        c.eqInt(streamSend.available(), (int64) 64535, "stream window debited");
        c.eqInt((int64) fc.sendable(streamSend), (int64) 0,
                "sendable 0 when connection exhausted (park)");

        // A negative stream window yields 0 sendable.
        Http2FlowController fc2 = heap Http2FlowController(65535, 65535);
        Http2FlowWindow neg = heap Http2FlowWindow(0);
        neg.adjust((int64) -100);
        c.eqInt((int64) fc2.sendable(neg), (int64) 0,
                "negative stream window -> 0 sendable");

        // INITIAL_WINDOW_SIZE change delta (§6.9.2).
        Http2FlowController fc3 = heap Http2FlowController(65535, 65535);
        int64 delta = fc3.initialWindowDelta(131072);
        c.eqInt(delta, (int64) 65537, "initial-window delta 131072-65535");
        c.eqInt((int64) fc3.initialStreamSendWindow(), (int64) 131072,
                "peer initial window updated");
        // Applying the delta to an existing stream window grows it.
        Http2FlowWindow existing = heap Http2FlowWindow(65535);
        existing.adjust(delta);
        c.eqInt(existing.available(), (int64) 131072,
                "existing stream window shifted by delta");
        // A reduction produces a negative delta.
        int64 delta2 = fc3.initialWindowDelta(1024);
        c.eqInt(delta2, (int64) -130048, "reduction delta negative");
    }
}
