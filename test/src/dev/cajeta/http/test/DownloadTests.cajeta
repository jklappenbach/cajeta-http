package dev.cajeta.http.test;

import cajeta.hash.Sha256;
import cajeta.io.file.File;
import cajeta.io.file.FileReader;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.BufferPool;
import cajeta.io.net.Server;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpListener;
import cajeta.io.net.TcpStream;
import cajeta.lang.Slice;
import cajeta.lang.String;
import cajeta.time.Duration;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientRequest;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HttpException;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.body.BytesChannel;
import dev.cajeta.http.body.StreamBody;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;

/**
 * `downloadTo` streams a 2xx body to a file with a running Sha256, over
 * content-length, server-chunked, redirected and raw chunked responses, and
 * a streamed upload goes out chunked and arrives intact.
 */
public final class DownloadTests {

    static final int32 DL_SIZE = 4194304;
    static final int32 UP_SIZE = 1048576;

    public static void run(Check c) {
        System.stdout.println("-- download: content-length body --");
        downloadKnownLength(c);
        System.stdout.println("-- download: server-chunked body --");
        downloadServerChunked(c);
        System.stdout.println("-- download: via redirect --");
        downloadViaRedirect(c);
        System.stdout.println("-- download: chunked wire --");
        downloadChunkedWire(c);
        System.stdout.println("-- download: 404 raises --");
        downloadNotFoundRaises(c);
        System.stdout.println("-- upload: streamed chunked request --");
        uploadStreamed(c);
    }

    /** Deterministic payload, byte i = (i*31+7) & 0xff. */
    static #int8[] pattern(int32 n) {
        int8[] out = heap int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = (int8) ((i * 31 + 7) % 256);
            i = i + 1;
        }
        return #out;
    }

    static #String hashOf(int8[] data, int32 n) {
        return Sha256.hashHex(data, (int64) n);
    }

    /** Sha256 hex of a file's contents, read back in 8 KiB pieces. */
    static #String hashFile(String path) {
        FileReader r #= File.openRead(path);
        Sha256 h = heap Sha256();
        int8[] buf = heap int8[8192];
        boolean going = true;
        while (going) {
            int32 got = r.read(buf, 8192);
            if (got <= 0) {
                going = false;
            } else {
                h.update(buf, (int64) got);
            }
        }
        r.close();
        return h.hex();
    }

    /** `/big` declares its length, `/bigchunked` does not, `/hop` 302s to `/big`, `/upload` echoes. */
    static void serveHandle(HttpRequest q, HttpResponse r) {
        Slice<int8> t = q.target();
        if (Bytes.equals(t, "/big")) {
            int8[] data #= DownloadTests.pattern(DownloadTests.DL_SIZE);
            r.headerInt("Content-Length", (int64) DownloadTests.DL_SIZE);
            r.body(data, DownloadTests.DL_SIZE);
            return;
        }
        if (Bytes.equals(t, "/bigchunked")) {
            int8[] data #= DownloadTests.pattern(DownloadTests.DL_SIZE);
            r.body(data, DownloadTests.DL_SIZE);
            return;
        }
        if (Bytes.equals(t, "/hop")) {
            r.status(302);
            r.setHeader("Location", "/big");
            r.body("moved");
            return;
        }
        if (Bytes.equals(t, "/upload")) {
            int32 n = q.bodyLength();
            int8[] got = heap int8[n];
            int32 off = 0;
            while (off < n) {
                int32 end = off + 8192;
                if (end > n) { end = n; }
                DownloadTests.copyPiece(q.body(), got, off, end);
                off = end;
            }
            String bodyHash #= Sha256.hashHex(got, (int64) n);
            r.write(bodyHash);
            r.write("|");
            if (q.hasHeader("transfer-encoding")) {
                r.writeBytes(q.header("transfer-encoding"));
            } else {
                r.write("none");
            }
            return;
        }
        r.status(404);
    }

    /**
     * Copies `s[from .. to)` into `dst`. Each window index costs stack until
     * its frame returns, so a large body is copied one bounded piece per call.
     */
    static void copyPiece(Slice<int8> s, int8[] dst, int32 from, int32 to) {
        int32 i = from;
        while (i < to) {
            dst[i] = s[(int64) i];
            i = i + 1;
        }
    }

    static #HttpServer startServer() {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> DownloadTests.serveHandle(q, r));
        return b.build();
    }

    /**
     * Accepts and dispatches until the listener closes, returning how many
     * connections were served. Await it only after closing the listener.
     */
    public static async int32 acceptLoop(Server core) {
        int32 n = 0;
        boolean going = true;
        while (going) {
            TcpStream conn #= core.acceptNext();
            if (conn == null) {
                going = false;
            } else {
                core.dispatch(#conn);
                n = n + 1;
            }
        }
        return n;
    }

    /** Downloads `path` to `dest`, then checks the returned digest and the re-hashed file against `want`. */
    public static async int32 dl(int32 port, String path, String dest, String want) {
        HttpClient client = heap HttpClient();
        String url = "http://127.0.0.1:" + port + path;
        Sha256 h #= client.downloadTo(url, dest);
        String got #= h.hex();
        if (!got.equals(want)) { return -1; }
        String fileHash #= DownloadTests.hashFile(dest);
        if (!fileHash.equals(want)) { return -2; }
        return 1;
    }

    static void downloadKnownLength(Check c) {
        int8[] data #= DownloadTests.pattern(DownloadTests.DL_SIZE);
        String want #= DownloadTests.hashOf(data, DownloadTests.DL_SIZE);
        scope {
            HttpServer srv #= DownloadTests.startServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> svc = spawn acceptLoop(core);
            Task<int32> t = spawn dl(port, "/big", "build/test/dl-known.bin", want);
            c.eqInt((int64) await t, 1,
                "downloadTo: digest and re-hashed file both match the payload");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "download connection drained");
            core.listener.close();
            c.eqInt((int64) await svc, 1, "download rode one connection");
        }
    }

    static void downloadServerChunked(Check c) {
        int8[] data #= DownloadTests.pattern(DownloadTests.DL_SIZE);
        String want #= DownloadTests.hashOf(data, DownloadTests.DL_SIZE);
        scope {
            HttpServer srv #= DownloadTests.startServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> svc = spawn acceptLoop(core);
            Task<int32> t = spawn dl(port, "/bigchunked", "build/test/dl-srvchunked.bin", want);
            c.eqInt((int64) await t, 1,
                "downloadTo streams a server-chunked 4 MiB body: digest and file match");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "server-chunked connection drained");
            core.listener.close();
            c.eqInt((int64) await svc, 1, "server-chunked download rode one connection");
        }
    }

    static void downloadViaRedirect(Check c) {
        int8[] data #= DownloadTests.pattern(DownloadTests.DL_SIZE);
        String want #= DownloadTests.hashOf(data, DownloadTests.DL_SIZE);
        scope {
            HttpServer srv #= DownloadTests.startServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> svc = spawn acceptLoop(core);
            Task<int32> t = spawn dl(port, "/hop", "build/test/dl-hop.bin", want);
            c.eqInt((int64) await t, 1,
                "downloadTo follows the redirect and streams only the final body");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "redirect-download connection drained");
            core.listener.close();
            c.eqInt((int64) await svc, 1, "redirect download rode one connection");
        }
    }

    /** Lowercase hex of a positive `v`. */
    static #String hex(int32 v) {
        String digits = "0123456789abcdef";
        String out = "";
        int32 x = v;
        while (x > 0) {
            int32 d = x % 16;
            out = digits.substring(d, d + 1) + out;
            x = x / 16;
        }
        return #out;
    }

    /** A raw one-shot server that answers any request with the pattern as a chunked body in 64 KiB pieces, then closes. */
    public static async int32 chunkedOneShot(TcpListener lst, int32 size) {
        scope {
            TcpStream s #= lst.acceptAsync();
            int8[] reqBuf = heap int8[4096];
            int64 n = s.readAsync(reqBuf, (int64) 0, (int64) 4096);
            String head = "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n";
            int8[] hb #= head.toBytes();
            s.writeAllAsync(hb, (int64) 0, (int64) head.byteLength());
            int8[] data #= DownloadTests.pattern(size);
            String crlf = "\r\n";
            int8[] cr #= crlf.toBytes();
            int32 off = 0;
            while (off < size) {
                int32 piece = 65536;
                if (size - off < piece) { piece = size - off; }
                String line = DownloadTests.hex(piece) + "\r\n";
                int8[] lb #= line.toBytes();
                s.writeAllAsync(lb, (int64) 0, (int64) line.byteLength());
                s.writeAllAsync(data, (int64) off, (int64) piece);
                s.writeAllAsync(cr, (int64) 0, (int64) 2);
                off = off + piece;
            }
            String last = "0\r\n\r\n";
            int8[] lastb #= last.toBytes();
            s.writeAllAsync(lastb, (int64) 0, (int64) last.byteLength());
            s.close();
        }
        return 1;
    }

    static void downloadChunkedWire(Check c) {
        int8[] data #= DownloadTests.pattern(DownloadTests.DL_SIZE);
        String want #= DownloadTests.hashOf(data, DownloadTests.DL_SIZE);
        scope {
            SocketAddress addr #= SocketAddress.parse("127.0.0.1:0");
            TcpListener lst #= TcpListener.bind(addr);
            int32 port = lst.boundPort();

            Task<int32> s1 = spawn chunkedOneShot(lst, DownloadTests.DL_SIZE);
            Task<int32> t = spawn dl(port, "/c", "build/test/dl-chunked.bin", want);
            c.eqInt((int64) await t, 1,
                "downloadTo decodes a chunked body to identical bytes + digest");
            c.eqInt((int64) await s1, 1, "chunked one-shot served");
            lst.close();
        }
    }

    public static async int32 dlMissing(int32 port, String dest) {
        HttpClient client = heap HttpClient();
        String url = "http://127.0.0.1:" + port + "/nope";
        try {
            Sha256 h #= client.downloadTo(url, dest);
            return -1;
        } catch (HttpException e) {
            return 1;
        }
    }

    static void downloadNotFoundRaises(Check c) {
        scope {
            HttpServer srv #= DownloadTests.startServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> svc = spawn acceptLoop(core);
            Task<int32> t = spawn dlMissing(port, "build/test/dl-missing.bin");
            c.eqInt((int64) await t, 1, "downloadTo raises HttpException on 404");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "404 connection drained");
            core.listener.close();
            c.eqInt((int64) await svc, 1, "404 exchange served");
        }
    }

    public static async int32 upStreamed(int32 port, String want) {
        HttpClient client = heap HttpClient();
        ClientRequest req #= ClientRequest.post("http://127.0.0.1:" + port + "/upload");
        int8[] data #= DownloadTests.pattern(DownloadTests.UP_SIZE);
        BytesChannel ch = heap BytesChannel(data, (int64) DownloadTests.UP_SIZE);
        AsyncReader r = heap AsyncReader(ch);
        StreamBody sb #= StreamBody.of(#r);
        req.body(#sb);
        ClientResponse resp #= client.send(req);
        if (resp.status() != 200) {
            System.stdout.println("  (upload status: {})", resp.status());
            return -1;
        }
        String got #= resp.bodyString();
        String expect = want + "|chunked";
        if (!got.equals(expect)) {
            System.stdout.println("  (upload echo: '{}')", got);
            return -2;
        }
        return 1;
    }

    /** The server holds a request body in its connection buffer, so this one gets 2 MiB buffers. */
    static void uploadStreamed(Check c) {
        int8[] data #= DownloadTests.pattern(DownloadTests.UP_SIZE);
        String want #= DownloadTests.hashOf(data, DownloadTests.UP_SIZE);
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.bufferPool(heap BufferPool(2097152, 4));
            b.handler((HttpRequest q, HttpResponse r) -> DownloadTests.serveHandle(q, r));
            HttpServer srv #= b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> svc = spawn acceptLoop(core);
            Task<int32> t = spawn upStreamed(port, want);
            c.eqInt((int64) await t, 1,
                "streamed chunked upload arrives intact (digest + framing echo)");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "upload connection drained");
            core.listener.close();
            c.eqInt((int64) await svc, 1, "upload rode one connection");
        }
        c.skip("Bytes.copyOf of the 1 MiB upload body on a server fiber",
            "compiler defect: the operator[] result slot is allocated inside the loop and overflows the fiber stack");
    }
}
