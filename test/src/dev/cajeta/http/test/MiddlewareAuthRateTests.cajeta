package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.codec.Base64;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.middleware.MiddlewareChain;
import dev.cajeta.http.middleware.RateLimit;
import dev.cajeta.http.middleware.TokenBucket;
import dev.cajeta.http.middleware.BasicAuth;
import dev.cajeta.http.middleware.BearerAuth;
import dev.cajeta.http.middleware.Credentials;

/** Token buckets, the rate limiter, and Basic and Bearer authentication. */
public final class MiddlewareAuthRateTests {
    public static void run(Check c) {
        System.stdout.println("-- rate limit: token bucket --");
        MiddlewareAuthRateTests.bucketRefill(c);
        MiddlewareAuthRateTests.bucketNeverRefills(c);
        System.stdout.println("-- rate limit: middleware --");
        MiddlewareAuthRateTests.rateLimitMiddleware(c);
        System.stdout.println("-- auth: constant-time compare --");
        MiddlewareAuthRateTests.constantTime(c);
        System.stdout.println("-- auth: Basic --");
        MiddlewareAuthRateTests.basicAuth(c);
        System.stdout.println("-- auth: Bearer --");
        MiddlewareAuthRateTests.bearerAuth(c);
    }

    static void ok(HttpRequest q, HttpResponse r) {
        r.body("ok");
    }

    static void bucketRefill(Check c) {
        TokenBucket b = heap TokenBucket((int64) 2, (int64) 1, (int64) 0);
        c.that(b.tryAcquire((int64) 0), "bucket: first token");
        c.that(b.tryAcquire((int64) 0), "bucket: second token (burst)");
        c.that(!b.tryAcquire((int64) 0), "bucket: empty after burst");
        c.eqInt(b.retryAfterSecs((int64) 0), 1, "bucket: 1s until a token frees");
        c.that(b.tryAcquire((int64) 1000), "bucket: one token refilled after 1s");
        c.that(!b.tryAcquire((int64) 1000), "bucket: only one token refilled");
        c.that(b.tryAcquire((int64) 3000), "bucket: refill accrues over elapsed time");
    }

    static void bucketNeverRefills(Check c) {
        TokenBucket b = heap TokenBucket((int64) 2, (int64) 0, (int64) 0);
        c.that(b.tryAcquire((int64) 0), "hard quota: first token");
        c.that(b.tryAcquire((int64) 0), "hard quota: second token (burst)");
        c.that(!b.tryAcquire((int64) 0), "hard quota: empty after burst");
        c.eqInt(b.retryAfterSecs((int64) 0), TokenBucket.NEVER_SECS,
                "hard quota: retryAfter reports never, and does not divide by zero");
        c.eqInt(b.retryAfterSecs((int64) 60000), TokenBucket.NEVER_SECS, "hard quota: still never, a minute later");
        c.that(!b.tryAcquire((int64) 3600000), "hard quota: an hour later, still empty");
    }

    static void rateLimitMiddleware(Check c) {
        RateLimit rl #= RateLimit.create((int64) 1, (int64) 1);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#RateLimit.middleware(#rl));
        (HttpRequest, HttpResponse) -> void term = (HttpRequest q, HttpResponse r) -> MiddlewareAuthRateTests.ok(q, r);
        chain.build(term);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String got #= Wire.serve("GET /x HTTP/1.1\r\nX-Forwarded-For: 1.1.1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 200, "ratelimit: the first request is admitted");
        got #= Wire.serve("GET /x HTTP/1.1\r\nX-Forwarded-For: 1.1.1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 429, "ratelimit: an exhausted burst is 429");
        c.that(Wire.header(got, "Retry-After").byteLength() > 0, "ratelimit: 429 carries Retry-After");
        got #= Wire.serve("GET /x HTTP/1.1\r\nX-Forwarded-For: 2.2.2.2\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 200, "ratelimit: a different key has its own bucket");
        got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 200, "ratelimit: requests without the key share one bucket");
        got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 429, "ratelimit: and that bucket runs out too");

        RateLimit wide #= RateLimit.create((int64) 1000000, (int64) 1000000);
        MiddlewareChain wc = heap MiddlewareChain();
        wc.use(#RateLimit.middleware(#wide));
        wc.build(term);
        (HttpRequest, HttpResponse) -> void wapp = (HttpRequest q, HttpResponse r) -> wc.run(q, r);
        String one = "GET /x HTTP/1.1\r\nX-Forwarded-For: 3.3.3.3\r\n\r\n";
        Wire.measure(one, 1, wapp);
        int64 small = Wire.measure(one, 100, wapp);
        int64 large = Wire.measure(one, 1100, wapp);
        c.that(large - small == 0,
            "ratelimit: 1000 more requests from a known key allocate nothing (" + small + " then " + large + ")");
    }

    static void constantTime(Check c) {
        c.that(Credentials.constantTimeEquals("hunter2", "hunter2"), "ct-equals: equal secrets match");
        c.that(!Credentials.constantTimeEquals("hunter2", "hunter3"), "ct-equals: a single-byte difference is rejected");
        c.that(!Credentials.constantTimeEquals("hunter2", "hunter22"), "ct-equals: a length difference is rejected");
    }

    static #String basicHeader(String userPass) {
        int8[] b #= userPass.toBytes();
        String enc #= Base64.encode(b, (int64) userPass.byteLength());
        return "GET /x HTTP/1.1\r\nAuthorization: Basic " + enc + "\r\n\r\n";
    }

    static void basicAuth(Check c) {
        BasicAuth ba #= BasicAuth.create("api");
        (String, String) -> boolean verify = (String u, String p) ->
            u.equals("alice") && Credentials.constantTimeEquals(p, "s3cr:et");
        ba.verifier(#verify);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#BasicAuth.middleware(#ba));
        (HttpRequest, HttpResponse) -> void term = (HttpRequest q, HttpResponse r) -> MiddlewareAuthRateTests.ok(q, r);
        chain.build(term);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String got #= Wire.serve(MiddlewareAuthRateTests.basicHeader("alice:s3cr:et"), app);
        c.eqInt((int64) Wire.status(got), 200, "basic: valid credentials with a colon in the password are admitted");
        got #= Wire.serve(MiddlewareAuthRateTests.basicHeader("alice:wrong"), app);
        c.eqInt((int64) Wire.status(got), 401, "basic: a wrong password is 401");
        got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 401, "basic: a missing header is 401");
        c.that(Wire.header(got, "WWW-Authenticate").startsWith("Basic realm="), "basic: the challenge names the realm");
        got #= Wire.serve("GET /x HTTP/1.1\r\nAuthorization: Basic @@@not-base64@@@\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 401, "basic: base64 garbage is 401, not 500");
    }

    static void bearerAuth(Check c) {
        BearerAuth ba #= BearerAuth.create("api");
        (String) -> boolean verify = (String t) -> Credentials.constantTimeEquals(t, "tok-abc");
        ba.verifier(#verify);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#BearerAuth.middleware(#ba));
        (HttpRequest, HttpResponse) -> void term = (HttpRequest q, HttpResponse r) -> MiddlewareAuthRateTests.ok(q, r);
        chain.build(term);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String got #= Wire.serve("GET /x HTTP/1.1\r\nAuthorization: Bearer tok-abc\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 200, "bearer: a valid token is admitted");
        got #= Wire.serve("GET /x HTTP/1.1\r\nAuthorization: Bearer nope\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 401, "bearer: a bad token is 401");
        got #= Wire.serve("GET /x HTTP/1.1\r\nAuthorization: Basic abc\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 401, "bearer: the wrong scheme is 401");
        got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.that(Wire.header(got, "WWW-Authenticate").startsWith("Bearer realm="), "bearer: the challenge names the realm");
    }
}
