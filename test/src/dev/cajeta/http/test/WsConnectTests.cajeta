package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpListener;
import cajeta.io.net.TcpStream;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.uri.Uri;
import dev.cajeta.http.ws.WebSocket;
import dev.cajeta.http.ws.WsMessage;
import dev.cajeta.http.ws.WsUpgrade;
import dev.cajeta.http.ws.HandshakeRejectedException;

/**
 * http:4.2a — the **one-line client connect** `WebSocket.connect(url)`: parse
 * `ws://…`, dial + upgrade, and return a ready socket that **owns** its
 * transport. A loopback echo against the extracted `WsUpgrade` server proves
 * the whole dial→handshake→frame path, and a staged bad handshake response
 * proves the `HandshakeRejected` contract (socket-free).
 */
public final class WsConnectTests {

    public static async int32 echoServer(#TcpListener listener) {
        TcpStream sock #= listener.acceptAsync();
        AsyncReader reader = heap AsyncReader(sock);
        AsyncWriter writer = heap AsyncWriter(sock);
        WebSocket ws #= WsUpgrade.acceptServer(reader, writer);
        WsMessage m #= ws.receive();
        String t #= m.text();
        ws.send(t);
        sock.close();
        return 1;
    }

    static void connectEcho(Check c) {
        scope {
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener = TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            Task<int32> sv #= spawn echoServer(#listener);

            String url = "ws://127.0.0.1:" + port + "/chat";
            WebSocket client #= WebSocket.connect(url);
            client.send("hello via connect");
            WsMessage reply #= client.receive();
            String back #= reply.text();
            c.that(back.equals("hello via connect"),
                   "WebSocket.connect dials, upgrades, and echoes");
            int32 r = await sv;
            c.eqInt((int64) r, 1, "connect echo: server served one exchange");
        }
    }

    static void handshakeRejected(Check c) {
        // A non-101 handshake reply must raise HandshakeRejected.
        String bad = "HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n";
        int8[] bb #= bad.toBytes();
        MemChannel rin = heap MemChannel();
        AsyncReader reader = heap AsyncReader(rin);
        reader.stage(bb, bad.byteLength());
        reader.markEof();
        MemChannel rout = heap MemChannel();
        AsyncWriter writer = heap AsyncWriter(rout);
        Uri uri #= Uri.builder()
            .scheme("ws").host("127.0.0.1").port(80).path("/").build();

        boolean threw = false;
        try {
            WebSocket ws #= WsUpgrade.connectClient(reader, writer, uri, 123);
        } catch (HandshakeRejectedException e) {
            threw = true;
        }
        c.that(threw, "a non-101 handshake response raises HandshakeRejected");
    }

    public static void run(Check c) {
        System.stdout.println("-- ws connect: bad handshake rejected --");
        WsConnectTests.handshakeRejected(c);
        System.stdout.println("-- ws connect: loopback echo --");
        WsConnectTests.connectEcho(c);
    }
}
