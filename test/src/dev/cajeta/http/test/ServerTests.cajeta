package dev.cajeta.http.test;

import dev.cajeta.http.h1.HttpParser;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.h1.HttpSerializer;
import dev.cajeta.http.h1.BodyReader;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.routing.Router;
import cajeta.io.net.IpAddress;
import cajeta.io.net.Server;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.time.Duration;

/**
 * http:0.3 — server + router suite. The router half is pure dispatch
 * over the message model; the live half binds an ephemeral loopback
 * server and drives it with a RAW TcpStream client (request bytes from
 * our HttpSerializer, response parsed with our HttpParser/BodyReader) —
 * HttpClient arrives in http:0.4. Accept iterations are driven by hand
 * through acceptNext()/dispatch(), the same seam the tour uses (server
 * shutdown cannot yet wake a parked accept fiber).
 */
public final class ServerTests {

    public static void run(Check c) {
        System.stdout.println("-- server: router --");
        routerDispatch(c);
        System.stdout.println("-- server: loopback --");
        liveServer(c);
    }

    static void routerDispatch(Check c) {
        (HttpRequest) -> #HttpResponse userRoute = (req) -> {
            String id #= req.pathParam("id");
            if (id == null) {
                return HttpResponse.of(500);
            }
            String body = "id=" + id;
            return HttpResponse.ok().body(body.toBytes(), body.byteLength());
        };
        Router router = heap Router();
        router.route("GET", "/users/{id}", userRoute);
        router.route("GET", "/health", (req) -> HttpResponse.of(204));

        HttpResponse hit #= router.dispatch(HttpRequest.of("GET", "/users/42"));
        c.eqInt((int64) hit.statusCode(), 200, "param route matches");
        c.eqBytes(hit.body, hit.bodyLength(), "id=42", "path param bound");

        HttpResponse health #= router.dispatch(HttpRequest.of("GET", "/health"));
        c.eqInt((int64) health.statusCode(), 204, "literal route matches");

        HttpResponse miss #= router.dispatch(HttpRequest.of("GET", "/nope"));
        c.eqInt((int64) miss.statusCode(), 404, "unknown path is 404");

        HttpResponse wrong #= router.dispatch(HttpRequest.of("POST", "/health"));
        c.eqInt((int64) wrong.statusCode(), 405, "wrong method is 405");
        String allow #= wrong.getHeaders().get("Allow");
        c.that(allow != null && allow.equals("GET"), "405 carries Allow: GET");
    }

    // Raw one-shot exchange: connect, write the serialized request
    // (stamped Connection: close so one accept iteration serves it),
    // parse the response head + body off the socket. Returns
    // status * 1000 + decoded body length, or a negative sentinel.
    public static async int32 rawExchange(int32 port, HttpRequest req) {
        req.setHeader("Connection", "close");
        HttpSerializer s = heap HttpSerializer();
        s.writeRequest(req);
        int32 wireLen = s.size();
        int8[] wire #= s.toBytes();

        IpAddress ip #= IpAddress.loopbackV4();
        SocketAddress addr #= SocketAddress.of(#ip, port);
        TcpStream client #= TcpStream.connect(#addr);
        client.write(wire, (int64) 0, (int64) wireLen);

        HttpParser parser #= HttpParser.forResponse();
        int8[] scratch = heap int8[4096];
        boolean headDone = false;
        while (!headDone) {
            int64 got = client.readAsync(scratch, (int64) 0, (int64) 4096);
            if (got <= (int64) 0) {
                client.close();
                return -1;
            }
            headDone = parser.feed(scratch, (int32) got);
        }
        HttpResponse resp #= parser.takeResponse();
        BodyReader body #= BodyReader.forFraming(parser.getFraming());
        body.feed(parser.leftover(), parser.leftoverLength());
        while (!body.isComplete()) {
            int64 got = client.readAsync(scratch, (int64) 0, (int64) 4096);
            if (got <= (int64) 0) {
                body.endInput();
            } else {
                body.feed(scratch, (int32) got);
            }
            if (got <= (int64) 0 && !body.isComplete()) {
                client.close();
                return -2;
            }
        }
        client.close();
        return resp.statusCode() * 1000 + body.decodedLength();
    }

    // The live server's handler — static and capture-free (a handler
    // lambda that captures a local currently double-frees the captured
    // object via the drop chain; the tour dodges the same way). GET
    // /hello answers a 5-byte body, POST echoes, anything else is 404.
    public static #HttpResponse liveHandle(HttpRequest req) {
        if (req.getMethod().equals("POST")) {
            return HttpResponse.ok().body(req.body, req.bodyLength());
        }
        if (req.getTarget().equals("/hello")) {
            String hello = "hello";
            return HttpResponse.ok().body(hello.toBytes(), hello.byteLength());
        }
        // Body the 404 so it frames as Content-Length. A bodyless
        // handler response serializes with no framing header, which a
        // raw client can only read to EOF — and the connection loop
        // decides reuse before the client sees a close (v1 wrinkle).
        String nf = "nf";
        return HttpResponse.of(404).body(nf.toBytes(), nf.byteLength());
    }

    static void liveServer(Check c) {
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse h = (req) -> ServerTests.liveHandle(req);
            b.handler(h);
            HttpServer srv #= b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            c.that(port > 0, "server bound an ephemeral port");

            // GET /hello -> 200, body "hello" (5 bytes).
            Task<int32> tg #= spawn rawExchange(port, HttpRequest.get("/hello"));
            TcpStream c1 #= core.acceptNext();
            core.dispatch(#c1);
            int32 got = await tg;
            c.eqInt((int64) got, 200005, "GET /hello over loopback");

            // POST /echo with a 4-byte body -> 200, 4 bytes back.
            HttpRequest post #= HttpRequest.post("/echo");
            String ping = "ping";
            post.body(ping.toBytes(), ping.byteLength());
            Task<int32> tp = spawn rawExchange(port, #post);
            TcpStream c2 #= core.acceptNext();
            core.dispatch(#c2);
            int32 gotPost = await tp;
            c.eqInt((int64) gotPost, 200004, "POST /echo over loopback");

            // Unknown path -> 404 (body may be empty or a reason string).
            Task<int32> tn #= spawn rawExchange(port, HttpRequest.get("/nope"));
            TcpStream c3 #= core.acceptNext();
            core.dispatch(#c3);
            int32 gotMiss = await tn;
            c.eqInt((int64) (gotMiss / 1000), 404, "unknown path is 404 over loopback");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "connection fibers drained");
            core.listener.close();
        }
    }
}
