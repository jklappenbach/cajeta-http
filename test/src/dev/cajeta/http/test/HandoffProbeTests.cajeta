package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.concurrent.Tasks;

/**
 * Opt-in probe (`--handoffprobe=N`): whether the ownership shapes the h2 server
 * uses on every stream free what they hand off. A plain store and take-back of a
 * slot, a bare unawaited spawn, and the stream table's array reap.
 */
public final class HandoffProbeTests {

    /** Two tracked allocations: the object and its array. */
    public static final class Cell {
        public static int32 made;
        public static int32 gone;
        public int8[] data;
        public Cell() {
            this.data = heap int8[64];
            Cell.made = Cell.made + 1;
        }
        public ~Cell() {
            Cell.gone = Cell.gone + 1;
        }
    }

    Cell ready;
    boolean has;

    public HandoffProbeTests() {
        this.ready = null;
        this.has = false;
    }

    // The h2 spelling: a plain `=` store of a transferred formal.
    void markReadyPlain(#Cell c) {
        this.ready = #c;
        this.has = true;
    }

    public static async int32 consume(#Cell c) {
        Cell q #= c;
        return (int32) q.data.count();
    }

    public static void run(Check c, int32 rounds) {
        System.stdout.println("-- handoff probe: " + rounds + " rounds per variant --");
        HandoffProbeTests.report(c, "5 field plain= + take #= + spawn #, NO await",
                                 HandoffProbeTests.fieldPlainSpawnNoAwait(rounds), rounds);
        HandoffProbeTests.report(c, "6 no field              + spawn #, NO await",
                                 HandoffProbeTests.noFieldSpawnNoAwait(rounds), rounds);
        HandoffProbeTests.report(c, "10 BARE spawn statement, no Task binding    ",
                                 HandoffProbeTests.bareSpawn(rounds), rounds);
        HandoffProbeTests.report(c, "10p the same, parking 1 ms each round       ",
                                 HandoffProbeTests.bareSpawnParked(rounds), rounds);
        HandoffProbeTests.report(c, "10b the same, read after the scope exits    ",
                                 HandoffProbeTests.bareSpawnAfterScope(rounds), rounds);
        HandoffProbeTests.reportDrops("15 array dropped: elements freed?  ",
                                      HandoffProbeTests.arrayDrop(rounds), rounds * 2);
        HandoffProbeTests.reportDrops("16 slot overwritten: old freed?     ",
                                      HandoffProbeTests.slotOverwrite(rounds), rounds);
        HandoffProbeTests.reportDrops("17 slot nulled: old freed?          ",
                                      HandoffProbeTests.slotNull(rounds), rounds);
        HandoffProbeTests.reportDrops("18 reap idiom: all four freed each round",
                                      HandoffProbeTests.reapIdiom(rounds), rounds * 4);
        int64 ctl = HandoffProbeTests.deliberateLeak(rounds);
        HandoffProbeTests.report(c, "C control: a retained Cell per round        ",
                                 ctl, rounds);
        c.that(ctl / (int64) (rounds - 50) == (int64) 2,
               "handoff probe: the control leak is seen as 2 per round");
    }

    // The baseline is taken at round 50, so the measured span is rounds - 50.
    // `undropped` is the direct question: was the payload's destructor run?
    static void report(Check c, String label, int64 delta, int32 rounds) {
        int64 span = (int64) (rounds - 50);
        int32 undropped = Cell.made - Cell.gone;
        System.stdout.println("   " + label + "   live delta " + delta
                              + "  (" + (delta / span) + " per round)"
                              + "  undropped " + undropped);
        Cell.made = 0;
        Cell.gone = 0;
    }

    static int64 fieldPlainSpawnNoAwait(int32 rounds) {
        HandoffProbeTests h = heap HandoffProbeTests();
        int64 before = 0;
        int64 after = 0;
        scope {
            int32 i = 0;
            while (i < rounds) {
                Cell c = heap Cell();
                h.markReadyPlain(#c);
                Cell got #= h.ready;
                h.ready = null;
                h.has = false;
                Task<int32> t = spawn consume(#got);
                i = i + 1;
                if (i == 50) { before = Cajeta.liveCount(); }
            }
            after = Cajeta.liveCount();
        }
        return after - before;
    }

    static int64 noFieldSpawnNoAwait(int32 rounds) {
        int64 before = 0;
        int64 after = 0;
        scope {
            int32 i = 0;
            while (i < rounds) {
                Cell c = heap Cell();
                Task<int32> t = spawn consume(#c);
                i = i + 1;
                if (i == 50) { before = Cajeta.liveCount(); }
            }
            after = Cajeta.liveCount();
        }
        return after - before;
    }

    static int64 bareSpawnParked(int32 rounds) {
        int64 before = 0;
        scope {
            int32 i = 0;
            while (i < rounds) {
                Cell c = heap Cell();
                spawn consume(#c);
                Tasks.sleepMillis((int64) 1);
                i = i + 1;
                if (i == 50) { before = Cajeta.liveCount(); }
            }
            return Cajeta.liveCount() - before;
        }
    }

    static int64 bareSpawnAfterScope(int32 rounds) {
        int64 before = Cajeta.liveCount();
        scope {
            int32 i = 0;
            while (i < rounds) {
                Cell c = heap Cell();
                spawn consume(#c);
                i = i + 1;
            }
        }
        return Cajeta.liveCount() - before;
    }

    static int64 bareSpawn(int32 rounds) {
        int64 before = 0;
        scope {
            int32 i = 0;
            while (i < rounds) {
                Cell c = heap Cell();
                spawn consume(#c);
                i = i + 1;
                if (i == 50) { before = Cajeta.liveCount(); }
            }
            return Cajeta.liveCount() - before;
        }
    }

    static void reportDrops(String label, int32 freed, int32 expected) {
        System.stdout.println("   " + label + "  freed " + freed
                              + " of " + expected);
    }

    /** Does dropping an array free the elements it owns? */
    static int32 arrayDrop(int32 rounds) {
        int32 before = Cell.gone;
        int32 i = 0;
        while (i < rounds) {
            {
                Cell[] a = heap Cell[2];
                Cell c0 = heap Cell();
                Cell c1 = heap Cell();
                a[0] #= c0;
                a[1] #= c1;
            }
            i = i + 1;
        }
        return Cell.gone - before;
    }

    /** Does storing over an owned slot free what was there? */
    static int32 slotOverwrite(int32 rounds) {
        Cell[] a = heap Cell[1];
        int32 before = Cell.gone;
        int32 i = 0;
        while (i < rounds) {
            Cell c = heap Cell();
            a[0] #= c;
            i = i + 1;
        }
        return Cell.gone - before;
    }

    /** Does nulling an owned slot free what was there? */
    static int32 slotNull(int32 rounds) {
        Cell[] a = heap Cell[1];
        int32 before = Cell.gone;
        int32 i = 0;
        while (i < rounds) {
            Cell c = heap Cell();
            a[0] #= c;
            a[0] = null;
            i = i + 1;
        }
        return Cell.gone - before;
    }

    /**
     * Exactly what Http2StreamTable.reap does: move the survivors into a fresh
     * array with `#=` from an element read, then replace the old array. Each
     * round should free the two it did NOT move.
     */
    static int32 reapIdiom(int32 rounds) {
        int32 before = Cell.gone;
        int32 i = 0;
        while (i < rounds) {
            Cell[] a = heap Cell[4];
            int32 k = 0;
            while (k < 4) {
                Cell c = heap Cell();
                a[k] #= c;
                k = k + 1;
            }
            Cell[] ne = heap Cell[4];
            ne[0] #= a[0];
            ne[1] #= a[1];
            a #= ne;
            i = i + 1;
        }
        return Cell.gone - before;
    }

    static Cell[] keep;
    static int32 keptN;

    // Deliberate retention, to prove the probe is not blind.
    static int64 deliberateLeak(int32 rounds) {
        HandoffProbeTests.keep = heap Cell[rounds + 8];
        HandoffProbeTests.keptN = 0;
        int64 before = 0;
        int32 i = 0;
        while (i < rounds) {
            Cell c = heap Cell();
            HandoffProbeTests.keep[HandoffProbeTests.keptN] #= c;
            HandoffProbeTests.keptN = HandoffProbeTests.keptN + 1;
            i = i + 1;
            if (i == 50) { before = Cajeta.liveCount(); }
        }
        return Cajeta.liveCount() - before;
    }

}
