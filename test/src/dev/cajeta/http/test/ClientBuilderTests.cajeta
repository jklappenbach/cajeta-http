package dev.cajeta.http.test;

import cajeta.io.net.IpAddress;
import cajeta.io.net.Server;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpListener;
import cajeta.io.net.TcpStream;
import cajeta.io.net.tls.TlsStream;
import cajeta.io.net.uri.Uri;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.TooManyRedirectsException;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.client.HttpClientBuilder;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;

/**
 * http:1.4f — `HttpClient.builder()` + HTTP proxy. Wire-observable
 * builder config (a default header the caller can still override, the
 * version pin, the redirect cap), then the two proxy forms against
 * minimal in-test proxies:
 *
 *   - **absolute-form** (`http://` via proxy): the client dials the
 *     PROXY and sends `GET http://origin:port/path HTTP/1.1` — proven
 *     by a "proxy" that is just an HttpServer echoing the target it
 *     received (the named origin never exists).
 *   - **CONNECT tunnel** (`https://` via proxy): a raw loopback proxy
 *     validates the `CONNECT host:port HTTP/1.1` head, answers 200,
 *     and blind-relays bytes to a raw TLS origin (self-signed P-256
 *     cert, SAN IP:127.0.0.1, embedded below; the client pins it via
 *     `trustAnchor`). The exchange succeeding proves the tunnel: the
 *     TLS handshake + HTTP exchange ran end-to-end THROUGH the relay.
 */
public final class ClientBuilderTests {

    public static void run(Check c) {
        System.stdout.println("-- client builder: wire-observable config --");
        defaultsOnTheWire(c);
        versionPin(c);
        redirectCap(c);
        System.stdout.println("-- client proxy: absolute-form --");
        absoluteForm(c);
        System.stdout.println("-- client proxy: CONNECT tunnel --");
        connectTunnel(c);
    }

    // ---- the loopback HTTP server (config + absolute-form scenarios) ----

    public static #HttpResponse handle(HttpRequest req) {
        String t = req.getTarget();
        if (t.equals("/hdr")) {
            String v = req.getHeaders().get("x-app");
            String out = "-";
            if (v != null) {
                out = v;
            }
            return HttpResponse.ok().body(out.toBytes(), out.byteLength());
        }
        if (t.equals("/ver")) {
            String v = req.getVersion();
            return HttpResponse.ok().body(v.toBytes(), v.byteLength());
        }
        if (t.equals("/chain/1")) {
            String moved = "moved";
            return HttpResponse.of(302).setHeader("Location", "/chain/2")
                .body(moved.toBytes(), moved.byteLength());
        }
        if (t.equals("/chain/2")) {
            String moved = "moved";
            return HttpResponse.of(302).setHeader("Location", "/final")
                .body(moved.toBytes(), moved.byteLength());
        }
        if (t.equals("/final")) {
            String done = "done";
            return HttpResponse.ok().body(done.toBytes(), done.byteLength());
        }
        // Absolute-form targets land here: echo exactly what arrived.
        if (t.startsWith("http://")) {
            String h = req.getHeaders().get("host");
            String hv = "-";
            if (h != null) {
                hv = h;
            }
            String out = t + "|" + hv;
            return HttpResponse.ok().body(out.toBytes(), out.byteLength());
        }
        return HttpResponse.notFound();
    }

    /** Accept one connection and dispatch it (local copy — bare-spawn rule). */
    public static async int32 acceptAndDispatch(Server core) {
        TcpStream conn #= core.acceptNext();
        core.dispatch(#conn);
        return 1;
    }

    static #String respText(HttpResponse resp) {
        int32 n = resp.bodyLength();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = resp.body[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    static #HttpServer echoServer() {
        HttpServerBuilder b = HttpServer.builder();
        b.bind("127.0.0.1:0");
        (HttpRequest) -> #HttpResponse h =
            (req) -> ClientBuilderTests.handle(req);
        b.handler(h);
        return b.build();
    }

    // ---- builder config fibers ------------------------------------------

    /** Default header rides every request; a caller-set one wins. */
    public static async int32 defaultHeaderPair(int32 port) {
        HttpClient client = HttpClient.builder()
            .defaultHeader("x-app", "juju")
            .build();
        String url = "http://127.0.0.1:" + port + "/hdr";
        HttpResponse d = client.get(url);
        String def = ClientBuilderTests.respText(d);
        if (!def.equals("juju")) {
            System.stdout.println("  (default header echo: '{}')", def);
            return -1;
        }
        Uri uri = Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path("/hdr")
            .build();
        HttpRequest req = HttpRequest.fromUri("GET", uri);
        req.setHeader("x-app", "own");
        HttpResponse o = client.send(uri, req);
        String ovr = ClientBuilderTests.respText(o);
        if (!ovr.equals("own")) {
            System.stdout.println("  (override echo: '{}')", ovr);
            return -2;
        }
        return 1;
    }

    /** The version pin is what hits the wire. */
    public static async int32 pinnedVersion(int32 port) {
        HttpClient client = HttpClient.builder()
            .version("HTTP/1.0")
            .build();
        String url = "http://127.0.0.1:" + port + "/ver";
        HttpResponse resp = client.get(url);
        String got = ClientBuilderTests.respText(resp);
        if (!got.equals("HTTP/1.0")) {
            System.stdout.println("  (version echo: '{}')", got);
            return -1;
        }
        return 1;
    }

    /** redirectLimit(2) follows a 2-hop chain; redirectLimit(1) trips. */
    public static async int32 twoHopsUnderCapTwo(int32 port) {
        HttpClient client = HttpClient.builder().redirectLimit(2).build();
        String url = "http://127.0.0.1:" + port + "/chain/1";
        HttpResponse resp = client.get(url);
        if (resp.statusCode() != 200) { return -1; }
        String got = ClientBuilderTests.respText(resp);
        if (!got.equals("done")) { return -2; }
        return 1;
    }

    public static async int32 twoHopsOverCapOne(int32 port) {
        HttpClient client = HttpClient.builder().redirectLimit(1).build();
        String url = "http://127.0.0.1:" + port + "/chain/1";
        try {
            HttpResponse resp = client.get(url);
            return -1;
        } catch (TooManyRedirectsException e) {
            return 1;
        }
    }

    // ---- absolute-form proxy fiber --------------------------------------

    /**
     * The proxy is an ordinary HttpServer; the ORIGIN in the URL is a
     * port nobody listens on. The exchange succeeding at all proves the
     * client dialed the proxy; the echoed target proves absolute-form.
     */
    public static async int32 absoluteThroughProxy(int32 proxyPort) {
        HttpClient client = HttpClient.builder()
            .proxy("127.0.0.1", proxyPort)
            .build();
        String url = "http://127.0.0.1:59151/hello";
        HttpResponse resp = client.get(url);
        if (resp.statusCode() != 200) { return -1; }
        String got = ClientBuilderTests.respText(resp);
        if (!got.equals("http://127.0.0.1:59151/hello|127.0.0.1:59151")) {
            System.stdout.println("  (proxy echo: '{}')", got);
            return -2;
        }
        return 1;
    }

    // ---- CONNECT tunnel: raw proxy + raw TLS origin ----------------------

    /** Self-signed P-256 cert, CN=127.0.0.1, SAN IP:127.0.0.1 (test-only). */
    static #String certPem() {
        String s = "-----BEGIN CERTIFICATE-----\n"
            + "MIIBjjCCATSgAwIBAgIUG3tfsEcGGASfxB4YMpdd0NHD0xwwCgYIKoZIzj0EAwIw\n"
            + "FDESMBAGA1UEAwwJMTI3LjAuMC4xMB4XDTI2MDcyMTE0MjU1MFoXDTM2MDcxODE0\n"
            + "MjU1MFowFDESMBAGA1UEAwwJMTI3LjAuMC4xMFkwEwYHKoZIzj0CAQYIKoZIzj0D\n"
            + "AQcDQgAEZLO33nsUaLPOrTdA1Qsugw7hJSvkPyBXYRDXrCCVp+UMRAaMA3po2ylC\n"
            + "cSbipB2XqJZkNPFKfSU/HMFY8WmnIaNkMGIwHQYDVR0OBBYEFKWc9dLR6ZtiyziA\n"
            + "6wi/WAS/LynCMB8GA1UdIwQYMBaAFKWc9dLR6ZtiyziA6wi/WAS/LynCMA8GA1Ud\n"
            + "EwEB/wQFMAMBAf8wDwYDVR0RBAgwBocEfwAAATAKBggqhkjOPQQDAgNIADBFAiEA\n"
            + "j38aD2Gc+SW19AjGNd8dYx9xB1ayoM7Sft14+vtFlvQCIDcawNickiIPu8OvLe3S\n"
            + "9C1P6pu4xxUcLaIfZUv6Tb7F\n"
            + "-----END CERTIFICATE-----\n";
        return s.substring(0, s.byteLength());
    }

    static #String keyPem() {
        String s = "-----BEGIN PRIVATE KEY-----\n"
            + "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgWi6Npf2wrpH2sHdS\n"
            + "HFt2FAwbM7E7VJKm9a7HCFI/amqhRANCAARks7feexRos86tN0DVCy6DDuElK+Q/\n"
            + "IFdhENesIJWn5QxEBowDemjbKUJxJuKkHZeolmQ08Up9JT8cwVjxaach\n"
            + "-----END PRIVATE KEY-----\n";
        return s.substring(0, s.byteLength());
    }

    /**
     * Read from `s` into `buf` until a blank line terminates the head;
     * returns the byte count (or -1 on EOF/overflow). The head is all a
     * CONNECT/plain-HTTP peer sends before the turn passes.
     */
    static int32 readHead(TcpStream s, int8[] buf) {
        int32 have = 0;
        while (true) {
            int64 n = s.readAsync(buf, (int64) have, (int64) (4096 - have));
            if (n <= (int64) 0) { return -1; }
            have = have + (int32) n;
            int32 i = 3;
            while (i < have) {
                if (buf[i - 3] == (int8) 13 && buf[i - 2] == (int8) 10
                    && buf[i - 1] == (int8) 13 && buf[i] == (int8) 10) {
                    return have;
                }
                i = i + 1;
            }
            if (have >= 4096) { return -1; }
        }
    }

    /** One-way byte pump; ends on EOF or a raise from either side. */
    public static async int32 pump(TcpStream from, TcpStream to) {
        int8[] buf = heap int8[4096];
        int32 moved = 0;
        try {
            while (true) {
                int64 n = from.readAsync(buf, (int64) 0, (int64) 4096);
                if (n <= (int64) 0) { break; }
                to.writeAllAsync(buf, (int64) 0, n);
                moved = moved + (int32) n;
            }
        } catch (Exception e) {
            return moved;
        }
        return moved;
    }

    /**
     * Raw TLS origin: accept one connection, complete the server-side
     * handshake with the embedded cert, read the request head, answer a
     * fixed 200 with body "tunnel", close.
     */
    public static async int32 tlsOrigin(#TcpListener lst) {
        TcpStream sock = lst.acceptAsync();
        String cp = ClientBuilderTests.certPem();
        String kp = ClientBuilderTests.keyPem();
        int8[] cert = cp.toBytes();
        int8[] key = kp.toBytes();
        TlsStream tls = TlsStream.server(#sock, cert, cp.byteLength(),
                                         key, kp.byteLength());
        tls.handshake();
        int8[] buf = heap int8[4096];
        int32 have = 0;
        while (true) {
            int64 n = tls.readAsync(buf, (int64) have, (int64) (4096 - have));
            if (n <= (int64) 0) { return -1; }
            have = have + (int32) n;
            int32 i = 3;
            boolean done = false;
            while (i < have) {
                if (buf[i - 3] == (int8) 13 && buf[i - 2] == (int8) 10
                    && buf[i - 1] == (int8) 13 && buf[i] == (int8) 10) {
                    done = true;
                }
                i = i + 1;
            }
            if (done) { break; }
        }
        String resp = "HTTP/1.1 200 OK\r\ncontent-length: 6\r\n\r\ntunnel";
        int8[] rb = resp.toBytes();
        tls.writeAllAsync(rb, (int64) 0, (int64) resp.byteLength());
        tls.close();
        return 1;
    }

    /**
     * Raw CONNECT proxy: accept one connection, validate the CONNECT
     * head against `originPort`, answer 200, then blind-relay both ways
     * until both sides hang up. Returns 1 iff the head was well-formed.
     */
    public static async int32 connectProxy(#TcpListener lst, int32 originPort) {
        TcpStream cli = lst.acceptAsync();
        int8[] buf = heap int8[4096];
        int32 n = ClientBuilderTests.readHead(cli, buf);
        if (n <= 0) { return -1; }
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = buf[i];
            i = i + 1;
        }
        String head = heap String(#copy, n);
        String wantLine = "CONNECT 127.0.0.1:" + originPort + " HTTP/1.1\r\n";
        if (!head.startsWith(wantLine)) {
            System.stdout.println("  (proxy got head: '{}')", head);
            return -2;
        }
        String ok = "HTTP/1.1 200 Connection Established\r\n\r\n";
        int8[] ob = ok.toBytes();
        cli.writeAllAsync(ob, (int64) 0, (int64) ok.byteLength());

        IpAddress ip = IpAddress.loopbackV4();
        SocketAddress oa = SocketAddress.of(#ip, originPort);
        TcpStream origin = TcpStream.connectAsync(#oa);
        Task<int32> up = spawn pump(cli, origin);
        Task<int32> down = spawn pump(origin, cli);
        int32 u = await up;
        int32 d = await down;
        origin.close();
        cli.close();
        if (u <= 0 || d <= 0) { return -3; }
        return 1;
    }

    /** The client end: pinned trust + proxy; the GET must ride the tunnel. */
    public static async int32 httpsThroughTunnel(int32 proxyPort, int32 originPort) {
        String cp = ClientBuilderTests.certPem();
        int8[] anchor = cp.toBytes();
        HttpClient client = HttpClient.builder()
            .trustAnchor(anchor, cp.byteLength())
            .proxy("127.0.0.1", proxyPort)
            .build();
        String url = "https://127.0.0.1:" + originPort + "/x";
        HttpResponse resp = client.get(url);
        if (resp.statusCode() != 200) { return -1; }
        String got = ClientBuilderTests.respText(resp);
        if (!got.equals("tunnel")) {
            System.stdout.println("  (tunnel body: '{}')", got);
            return -2;
        }
        return 1;
    }

    // ---- scenarios -------------------------------------------------------

    static void defaultsOnTheWire(Check c) {
        scope {
            HttpServer srv = ClientBuilderTests.echoServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn defaultHeaderPair(port);
            c.eqInt((int64) await t1, 1,
                    "default header rides the wire; caller override wins");
            c.eqInt((int64) await s1, 1, "header pair rode one connection");
        }
    }

    static void versionPin(Check c) {
        scope {
            HttpServer srv = ClientBuilderTests.echoServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn pinnedVersion(port);
            c.eqInt((int64) await t1, 1, "version pin is what hits the wire");
            c.eqInt((int64) await s1, 1, "pinned exchange accepted once");
        }
    }

    static void redirectCap(Check c) {
        scope {
            HttpServer srv = ClientBuilderTests.echoServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn twoHopsUnderCapTwo(port);
            c.eqInt((int64) await t1, 1, "redirectLimit(2) follows a 2-hop chain");
            c.eqInt((int64) await s1, 1, "under-cap chain rode one connection");

            Task<int32> s2 = spawn acceptAndDispatch(core);
            Task<int32> t2 = spawn twoHopsOverCapOne(port);
            c.eqInt((int64) await t2, 1, "redirectLimit(1) trips on hop two");
            c.eqInt((int64) await s2, 1, "over-cap chain rode one connection");
        }
    }

    static void absoluteForm(Check c) {
        scope {
            HttpServer srv = ClientBuilderTests.echoServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptAndDispatch(core);
            Task<int32> t1 = spawn absoluteThroughProxy(port);
            c.eqInt((int64) await t1, 1,
                    "http-via-proxy sends the absolute-form target");
            c.eqInt((int64) await s1, 1, "proxied exchange accepted once");
        }
    }

    static void connectTunnel(Check c) {
        scope {
            IpAddress oip = IpAddress.loopbackV4();
            SocketAddress obind = SocketAddress.of(#oip, 0);
            TcpListener olst = TcpListener.bind(obind);
            int32 originPort = olst.boundPort();

            IpAddress pip = IpAddress.loopbackV4();
            SocketAddress pbind = SocketAddress.of(#pip, 0);
            TcpListener plst = TcpListener.bind(pbind);
            int32 proxyPort = plst.boundPort();

            Task<int32> o = spawn tlsOrigin(#olst);
            Task<int32> p = spawn connectProxy(#plst, originPort);
            Task<int32> t = spawn httpsThroughTunnel(proxyPort, originPort);
            c.eqInt((int64) await t, 1, "https exchange rides the CONNECT tunnel");
            c.eqInt((int64) await p, 1, "proxy saw a well-formed CONNECT + bytes both ways");
            c.eqInt((int64) await o, 1, "TLS origin served through the relay");
        }
    }
}
