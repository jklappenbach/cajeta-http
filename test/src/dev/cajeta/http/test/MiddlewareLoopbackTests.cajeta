package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.concurrent.Tasks;
import cajeta.time.Duration;
import cajeta.io.net.uri.Uri;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.HttpException;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.coding.ContentCoding;
import dev.cajeta.http.middleware.Middleware;
import dev.cajeta.http.middleware.MiddlewareChain;
import dev.cajeta.http.middleware.Recover;
import dev.cajeta.http.middleware.RequestId;
import dev.cajeta.http.middleware.ProxyHeaders;
import dev.cajeta.http.middleware.Cors;
import dev.cajeta.http.middleware.Compression;
import dev.cajeta.http.middleware.Decompression;
import dev.cajeta.http.middleware.ETag;
import dev.cajeta.http.middleware.Timeout;
import dev.cajeta.http.middleware.RateLimit;
import dev.cajeta.http.middleware.BasicAuth;
import dev.cajeta.http.middleware.BearerAuth;
import dev.cajeta.http.middleware.StaticFile;
import cajeta.io.file.File;
import cajeta.io.file.Path;

/**
 * http:2.2 — the umbrella's acceptance bar: **every bundled middleware
 * golden-tested through a real loopback server**, not just unit-called.
 * Four live `HttpServer`/`HttpClient` scopes (torn down in turn) exercise the
 * whole 2.2 set over an actual socket:
 *
 *   - **stack** — Recover, RequestId, ProxyHeaders, Cors, Compression, ETag
 *     (composed around one handler, the ergonomic global wiring);
 *   - **gated** — BearerAuth, RateLimit, Timeout;
 *   - **request-transform** — BasicAuth + Decompression (a gzip POST body);
 *   - **static** — StaticFile.
 */
public final class MiddlewareLoopbackTests {

    public static void run(Check c) {
        System.stdout.println("-- loopback: stack (Recover/RequestId/Proxy/Cors/Compression/ETag) --");
        stackServer(c);
        System.stdout.println("-- loopback: gated (Bearer/RateLimit/Timeout) --");
        gatedServer(c);
        System.stdout.println("-- loopback: request-transform (Basic/Decompression) --");
        transformServer(c);
        System.stdout.println("-- loopback: static file --");
        staticServer(c);
    }

    // ---- shared -----------------------------------------------------------

    public static async int32 serve(HttpServer srv) {
        srv.serve();
        return 1;
    }

    static #String big() {
        String unit = "{\"k\":\"the quick brown fox jumps over the lazy dog\"} ";
        String s = unit + unit;
        int32 i = 2;
        while (i < 20) {
            s = s + unit;
            i = i + 1;
        }
        return #s;
    }

    static boolean bytesEqStr(int8[] b, int32 n, String s) {
        if (n != s.byteLength()) {
            return false;
        }
        int32 i = 0;
        while (i < n) {
            if (b[i] != s.byteAt(i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    static #String url(int32 port, String path) {
        return "http://127.0.0.1:" + port + path;
    }

    // ---- client fibers ----------------------------------------------------

    static async int32 cStatus(int32 port, String path) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        try {
            HttpResponse resp = client.get(MiddlewareLoopbackTests.url(port, path));
            return resp.statusCode();
        } catch (Exception e) {
            return -3;
        }
    }

    static async int32 cStatusHdr(int32 port, String path, String hn, String hv) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        client.defaultHeader(hn, hv);
        try {
            HttpResponse resp = client.get(MiddlewareLoopbackTests.url(port, path));
            return resp.statusCode();
        } catch (Exception e) {
            return -3;
        }
    }

    /** GET with a Bearer token and a rate-limit key (distinct X-Forwarded-For). */
    static async int32 cStatusAuthXff(int32 port, String path, String token, String xff) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        client.defaultHeader("Authorization", "Bearer " + token);
        client.defaultHeader("X-Forwarded-For", xff);
        try {
            HttpResponse resp = client.get(MiddlewareLoopbackTests.url(port, path));
            return resp.statusCode();
        } catch (Exception e) {
            return -3;
        }
    }

    /** 1 iff GET `path` (with header hn:hv) returns a body equal to `expect`. */
    static async int32 cBodyEq(int32 port, String path, String hn, String hv, String expect) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        client.defaultHeader(hn, hv);
        try {
            HttpResponse resp = client.get(MiddlewareLoopbackTests.url(port, path));
            if (MiddlewareLoopbackTests.bytesEqStr(resp.body, resp.bodyLength(), expect)) {
                return 1;
            }
            return 0;
        } catch (Exception e) {
            return -3;
        }
    }

    /** 1 iff GET `path` carries response header `rhn`. */
    static async int32 cHdrPresent(int32 port, String path, String rhn) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        try {
            HttpResponse resp = client.get(MiddlewareLoopbackTests.url(port, path));
            String v = resp.getHeaders().get(rhn);
            if (v != null) {
                return 1;
            }
            return 0;
        } catch (Exception e) {
            return -3;
        }
    }

    /** GET, take the ETag, conditional GET with it → the conditional status. */
    static async int32 cEtagFlow(int32 port, String path) {
        HttpClient c1 = heap HttpClient();
        c1.exchangeTimeout(15000);
        try {
            HttpResponse r1 = c1.get(MiddlewareLoopbackTests.url(port, path));
            String tag = r1.getHeaders().get("ETag");
            if (tag == null) {
                return -1;
            }
            HttpClient c2 = heap HttpClient();
            c2.exchangeTimeout(15000);
            c2.defaultHeader("If-None-Match", tag);
            HttpResponse r2 = c2.get(MiddlewareLoopbackTests.url(port, path));
            return r2.statusCode();
        } catch (Exception e) {
            return -3;
        }
    }

    /** 1 iff an OPTIONS preflight from `origin` gets an Allow-Origin header. */
    static async int32 cPreflight(int32 port, String path, String origin) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        try {
            Uri uri = Uri.builder().scheme("http").host("127.0.0.1").port(port).path(path).build();
            HttpRequest req = HttpRequest.fromUri("OPTIONS", uri);
            req.setHeader("Origin", origin);
            req.setHeader("Access-Control-Request-Method", "GET");
            HttpResponse resp = client.send(uri, req);
            String acao = resp.getHeaders().get("Access-Control-Allow-Origin");
            if (acao != null) {
                return 1;
            }
            return 0;
        } catch (Exception e) {
            return -3;
        }
    }

    /** POST a gzip-encoded body (with Basic auth); 1 iff the echo equals `plain`. */
    static async int32 cPostGzip(int32 port, String path, String auth, String plain) {
        HttpClient client = heap HttpClient();
        client.exchangeTimeout(15000);
        try {
            Uri uri = Uri.builder().scheme("http").host("127.0.0.1").port(port).path(path).build();
            HttpRequest req = HttpRequest.fromUri("POST", uri);
            int8[] gz = ContentCoding.encode("gzip", plain.toBytes(), plain.byteLength());
            req.body(gz, gz.count());
            req.setHeader("Content-Encoding", "gzip");
            req.setHeader("Authorization", auth);
            HttpResponse resp = client.send(uri, req);
            if (resp.statusCode() != 200) {
                return -1;
            }
            if (MiddlewareLoopbackTests.bytesEqStr(resp.body, resp.bodyLength(), plain)) {
                return 1;
            }
            return 0;
        } catch (Exception e) {
            return -3;
        }
    }

    // ---- server A: the stack ---------------------------------------------

    public static #HttpResponse handleStack(HttpRequest req) {
        String t = req.getTarget();
        if (t.equals("/boom")) {
            throw heap HttpException("boom");
        }
        if (t.equals("/ip")) {
            String ip = req.getHeaders().get("X-Real-IP");
            if (ip == null) {
                ip = "none";
            }
            return HttpResponse.ok().body(ip.toBytes(), ip.byteLength());
        }
        if (t.equals("/data")) {
            String body = MiddlewareLoopbackTests.big();
            HttpResponse resp = HttpResponse.ok();
            resp.setHeader("Content-Type", "application/json");
            resp.body(body.toBytes(), body.byteLength());
            return #resp;
        }
        return HttpResponse.of(200);
    }

    static void stackServer(Check c) {
        Middleware rec = Recover.middleware();
        Middleware rid = RequestId.middleware();
        ProxyHeaders ph = ProxyHeaders.trusted();
        Middleware pm = ProxyHeaders.middleware(ph);
        Cors cors = Cors.create();
        cors.allowOrigin("http://example.com").allowMethods("GET, POST");
        Middleware cm = Cors.middleware(cors);
        Compression comp = Compression.create();
        Middleware zm = Compression.middleware(comp);
        Middleware et = ETag.middleware();
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#rec).use(#rid).use(#pm).use(#cm).use(#zm).use(#et);
        (HttpRequest) -> #HttpResponse termi =
            (req) -> MiddlewareLoopbackTests.handleStack(req);
        (HttpRequest) -> #HttpResponse app = chain.compose(termi);

        scope {
            HttpServerBuilder b = HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler(app);
            HttpServer srv = b.build();
            int32 port = srv.server.listener.boundPort();
            Task<int32> sv = spawn serve(srv);

            Task<int32> t1 = spawn cStatus(port, "/boom");
            c.eqInt((int64) await t1, 500, "loopback stack: Recover → 500 over the wire");

            Task<int32> t2 = spawn cHdrPresent(port, "/data", "X-Request-Id");
            c.eqInt((int64) await t2, 1, "loopback stack: RequestId header on the wire");

            String expect = MiddlewareLoopbackTests.big();
            Task<int32> t3 = spawn cBodyEq(port, "/data", "Accept-Encoding", "gzip", expect);
            c.eqInt((int64) await t3, 1,
                    "loopback stack: Compression round-trips (server gzip, client inflate)");

            Task<int32> t4 = spawn cHdrPresent(port, "/data", "Vary");
            c.eqInt((int64) await t4, 1, "loopback stack: Compression added Vary");

            Task<int32> t5 = spawn cEtagFlow(port, "/data");
            c.eqInt((int64) await t5, 304, "loopback stack: ETag conditional GET → 304");

            Task<int32> t6 = spawn cBodyEq(port, "/ip", "X-Forwarded-For", "1.2.3.4, 9.9.9.9", "1.2.3.4");
            c.eqInt((int64) await t6, 1, "loopback stack: ProxyHeaders resolved client IP");

            Task<int32> t7 = spawn cPreflight(port, "/data", "http://example.com");
            c.eqInt((int64) await t7, 1, "loopback stack: Cors preflight answered on the wire");

            boolean drained = srv.shutdown(Duration.ofSeconds(2));
            c.that(drained, "loopback stack: server drained clean");
            int32 s = await sv;
            c.eqInt((int64) s, 1, "loopback stack: accept loop exited");
        }
    }

    // ---- server B: gated (auth / rate / timeout) -------------------------

    public static #HttpResponse handleGated(HttpRequest req) {
        if (req.getTarget().equals("/slow")) {
            Tasks.sleepMillis((int64) 300);
            return HttpResponse.of(200);
        }
        return HttpResponse.of(200);
    }

    static void gatedServer(Check c) {
        BearerAuth ba = BearerAuth.create("api");
        (String) -> boolean vf = (t) -> t.equals("good-token");
        ba.verifier(#vf);
        Middleware am = BearerAuth.middleware(ba);
        RateLimit rl = RateLimit.create((int64) 2, (int64) 1);
        Middleware lm = RateLimit.middleware(rl);
        Middleware tm = Timeout.middleware((int64) 60);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#am).use(#lm).use(#tm);
        (HttpRequest) -> #HttpResponse termi =
            (req) -> MiddlewareLoopbackTests.handleGated(req);
        (HttpRequest) -> #HttpResponse app = chain.compose(termi);

        scope {
            HttpServerBuilder b = HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler(app);
            HttpServer srv = b.build();
            int32 port = srv.server.listener.boundPort();
            Task<int32> sv = spawn serve(srv);

            Task<int32> t1 = spawn cStatus(port, "/fast");
            c.eqInt((int64) await t1, 401, "loopback gated: no token → 401 (BearerAuth)");

            Task<int32> t2 = spawn cStatusAuthXff(port, "/fast", "good-token", "10.0.0.1");
            c.eqInt((int64) await t2, 200, "loopback gated: valid token → 200");

            Task<int32> t3 = spawn cStatusAuthXff(port, "/slow", "good-token", "10.0.0.2");
            c.eqInt((int64) await t3, 504, "loopback gated: slow handler → Timeout 504");

            // Burst 2 on a dedicated key: third rapid request → 429.
            Task<int32> r1 = spawn cStatusAuthXff(port, "/fast", "good-token", "10.0.0.3");
            await r1;
            Task<int32> r2 = spawn cStatusAuthXff(port, "/fast", "good-token", "10.0.0.3");
            await r2;
            Task<int32> r3 = spawn cStatusAuthXff(port, "/fast", "good-token", "10.0.0.3");
            c.eqInt((int64) await r3, 429, "loopback gated: burst exhausted → RateLimit 429");

            boolean drained = srv.shutdown(Duration.ofSeconds(2));
            c.that(drained, "loopback gated: server drained clean");
            int32 s = await sv;
            c.eqInt((int64) s, 1, "loopback gated: accept loop exited");
        }
    }

    // ---- server C: request transform (basic + decompression) -------------

    public static #HttpResponse handleEcho(HttpRequest req) {
        return HttpResponse.ok().body(req.body, req.bodyLength());
    }

    static void transformServer(Check c) {
        BasicAuth ba = BasicAuth.create("api");
        (String, String) -> boolean vf = (u, p) -> u.equals("alice") && p.equals("secret");
        ba.verifier(#vf);
        Middleware am = BasicAuth.middleware(ba);
        Decompression dec = Decompression.create();
        Middleware dm = Decompression.middleware(dec);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#am).use(#dm);
        (HttpRequest) -> #HttpResponse termi =
            (req) -> MiddlewareLoopbackTests.handleEcho(req);
        (HttpRequest) -> #HttpResponse app = chain.compose(termi);

        scope {
            HttpServerBuilder b = HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler(app);
            HttpServer srv = b.build();
            int32 port = srv.server.listener.boundPort();
            Task<int32> sv = spawn serve(srv);

            Task<int32> t1 = spawn cStatus(port, "/echo");
            c.eqInt((int64) await t1, 401, "loopback transform: no auth → 401 (BasicAuth)");

            // "alice:secret" base64 = YWxpY2U6c2VjcmV0
            String plain = MiddlewareLoopbackTests.big();
            Task<int32> t2 = spawn cPostGzip(port, "/echo", "Basic YWxpY2U6c2VjcmV0", plain);
            c.eqInt((int64) await t2, 1,
                    "loopback transform: gzip request inflated, handler saw plaintext");

            boolean drained = srv.shutdown(Duration.ofSeconds(2));
            c.that(drained, "loopback transform: server drained clean");
            int32 s = await sv;
            c.eqInt((int64) s, 1, "loopback transform: accept loop exited");
        }
    }

    // ---- server D: static file -------------------------------------------

    static void setupRoot(String root) {
        Path.of(root).mkdirs();
        String a = "hello over the wire";
        File.writeAllBytes(root + "/a.txt", a.toBytes(), a.byteLength());
    }

    static void staticServer(Check c) {
        String root = "build/test/lbroot";
        MiddlewareLoopbackTests.setupRoot(root);
        StaticFile sf = StaticFile.create(root);
        Middleware sm = StaticFile.middleware(sf);
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#sm);
        (HttpRequest) -> #HttpResponse termi = (req) -> HttpResponse.of(599);
        (HttpRequest) -> #HttpResponse app = chain.compose(termi);

        scope {
            HttpServerBuilder b = HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler(app);
            HttpServer srv = b.build();
            int32 port = srv.server.listener.boundPort();
            Task<int32> sv = spawn serve(srv);

            Task<int32> t1 = spawn cBodyEq(port, "/a.txt", "X-Unused", "x", "hello over the wire");
            c.eqInt((int64) await t1, 1, "loopback static: file served over the wire");

            Task<int32> t2 = spawn cStatus(port, "/missing.txt");
            c.eqInt((int64) await t2, 404, "loopback static: missing file → 404");

            boolean drained = srv.shutdown(Duration.ofSeconds(2));
            c.that(drained, "loopback static: server drained clean");
            int32 s = await sv;
            c.eqInt((int64) s, 1, "loopback static: accept loop exited");
        }
    }
}
