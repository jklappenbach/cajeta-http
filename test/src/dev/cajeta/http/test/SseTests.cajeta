package dev.cajeta.http.test;

import cajeta.lang.String;
import dev.cajeta.http.sse.SseEvent;
import dev.cajeta.http.sse.SseParser;

/**
 * http:4.4a — the `text/event-stream` wire codec: [`SseEvent`](../../../sse/SseEvent.cajeta)
 * serialize + [`SseParser`](../../../sse/SseParser.cajeta) parse. WHATWG golden
 * vectors both directions, multi-line `data`, comments/keep-alive, CR/LF/CRLF
 * tolerance, a stripped BOM, and unknown-field tolerance.
 */
public final class SseTests {

    static #String own(String s) {
        return s.substring(0, s.byteLength());
    }

    static #SseParser parseOf(String s) {
        SseParser p = heap SseParser();
        int8[] b #= s.toBytes();
        p.feed(b, s.byteLength());
        return #p;
    }

    // ---- serialize -> parse round-trips ----------------------------------

    static void roundTrips(Check c) {
        SseEvent e #= SseEvent.of("YHOO\n+2\n10");
        int8[] wire #= e.serialize();
        SseParser p = heap SseParser();
        p.feed(wire, (int32) wire.count());
        c.that(p.hasEvent(), "multi-line data event parses");
        SseEvent g #= p.nextEvent();
        c.that(g.data.equals("YHOO\n+2\n10"), "multi-line data round-trips");
        c.that(g.typeOrDefault().equals("message"), "untyped event -> message");

        SseEvent t #= SseEvent.typed("update", "hello");
        t.id #= SseTests.own("42");
        t.retry = 3000;
        int8[] w2 #= t.serialize();
        SseParser p2 = heap SseParser();
        p2.feed(w2, (int32) w2.count());
        SseEvent g2 #= p2.nextEvent();
        c.that(g2.event != null && g2.event.equals("update"),
               "event type round-trips");
        c.that(g2.data.equals("hello"), "data round-trips");
        c.that(g2.id != null && g2.id.equals("42"), "id round-trips");
        c.eqInt((int64) g2.retry, (int64) 3000, "retry round-trips");
    }

    // ---- WHATWG parse golden vector --------------------------------------

    static void whatwgVector(Check c) {
        String stream = ": test stream\n\n"
            + "data: first event\nid: 1\n\n"
            + "data:second event\nid\n\n"
            + "data:  third event\n\n";
        SseParser p #= SseTests.parseOf(stream);

        SseEvent e1 #= p.nextEvent();
        c.that(e1.data.equals("first event") && e1.id != null
                && e1.id.equals("1"), "vector event 1: 'first event' id 1");
        SseEvent e2 #= p.nextEvent();
        c.that(e2.data.equals("second event"), "vector event 2: 'second event'");
        SseEvent e3 #= p.nextEvent();
        c.that(e3.data.equals(" third event"),
               "vector event 3: ' third event' (one leading space kept)");
        c.that(!p.hasEvent(), "exactly three events dispatched");
    }

    // ---- line-ending + comment + BOM + unknown-field tolerance -----------

    static void tolerance(Check c) {
        // CRLF line endings.
        SseParser crlf #= SseTests.parseOf("data: hi\r\n\r\n");
        SseEvent a #= crlf.nextEvent();
        c.that(a.data.equals("hi"), "CRLF line endings parse");

        // Bare CR line endings.
        SseParser cr #= SseTests.parseOf("data: hi\r\r");
        SseEvent b #= cr.nextEvent();
        c.that(b.data.equals("hi"), "bare CR line endings parse");

        // A comment (keep-alive) between the field and the blank line.
        SseParser cm #= SseTests.parseOf("data: x\n: keep-alive\n\n");
        SseEvent d #= cm.nextEvent();
        c.that(d.data.equals("x"), "comment lines are ignored");

        // Leading UTF-8 BOM stripped.
        int8[] bom = [ (int8) 0xEF, (int8) 0xBB, (int8) 0xBF ];
        SseParser bp = heap SseParser();
        bp.feed(bom, 3);
        int8[] rest #= "data: z\n\n".toBytes();
        bp.feed(rest, (int32) rest.count());
        SseEvent be #= bp.nextEvent();
        c.that(be.data.equals("z"), "a leading BOM is stripped");

        // Unknown field ignored; the event still dispatches on its data.
        SseParser uf #= SseTests.parseOf("foo: bar\ndata: ok\n\n");
        SseEvent ue #= uf.nextEvent();
        c.that(ue.data.equals("ok"), "unknown fields are ignored");

        // A blank line with no data dispatches nothing.
        SseParser empty #= SseTests.parseOf("\n\n");
        c.that(!empty.hasEvent(), "blank lines with no data dispatch nothing");
    }

    public static void run(Check c) {
        System.stdout.println("-- sse codec: serialize<->parse round-trips --");
        SseTests.roundTrips(c);
        System.stdout.println("-- sse codec: WHATWG parse vector --");
        SseTests.whatwgVector(c);
        System.stdout.println("-- sse codec: line-ending/comment/BOM tolerance --");
        SseTests.tolerance(c);
    }
}
