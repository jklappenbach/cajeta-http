package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.time.Duration;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.h2.Http2Client;

/**
 * http:3.4d — **prior-knowledge** HTTP/2 (RFC 9113 §3.3). A plaintext server
 * built with `.h2PriorKnowledge()` sniffs the connection preface on each new
 * connection: an h2 client (whose first bytes ARE the preface) is served over
 * HTTP/2, while an ordinary h1 client (a non-preface first byte) degrades
 * cleanly to the h1 keep-alive loop — same handler, same port. The handler
 * echoes the request's protocol version, so the response body names the wire
 * that carried it (`HTTP/2.0` vs `HTTP/1.1`).
 */
public final class Http2PriorKnowledgeTests {

    public static #HttpResponse handle(HttpRequest req) {
        String v = req.version;
        return HttpResponse.ok().body(v.toBytes(), v.byteLength());
    }

    public static async int32 serve(HttpServer srv) {
        srv.serve();
        return 1;
    }

    static #String bodyString(int8[] body, int32 n) {
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = body[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    // h2 over the prior-knowledge port: 1 => 200 + body "HTTP/2.0".
    public static async int32 h2Client(int32 port) {
        IpAddress ca = IpAddress.loopbackV4();
        SocketAddress connAddr = SocketAddress.of(#ca, port);
        TcpStream sock = TcpStream.connectAsync(#connAddr);
        AsyncReader reader = heap AsyncReader(sock);
        AsyncWriter writer = heap AsyncWriter(sock);
        HttpRequest req = HttpRequest.of("GET", "/proto");
        HttpResponse resp = Http2Client.exchange(reader, writer, req, "http",
                                                 "127.0.0.1");
        sock.close();
        if (resp.statusCode() != 200) {
            return -1;
        }
        String body = Http2PriorKnowledgeTests.bodyString(resp.body,
                                                          resp.bodyLength());
        return body.equals("HTTP/2.0") ? 1 : -2;
    }

    // h1 to the same port (non-preface first byte): 1 => 200 + body "HTTP/1.1".
    public static async int32 h1Client(int32 port) {
        HttpClient client = HttpClient.builder().build();
        String url = "http://127.0.0.1:" + port + "/proto";
        HttpResponse resp = client.get(url);
        if (resp.statusCode() != 200) {
            return -1;
        }
        String body = Http2PriorKnowledgeTests.bodyString(resp.body,
                                                          resp.bodyLength());
        return body.equals("HTTP/1.1") ? 1 : -2;
    }

    public static void run(Check c) {
        System.stdout.println("-- h2 prior-knowledge: preface sniff -> h2, else h1 --");
        scope {
            HttpServerBuilder b = HttpServer.builder();
            b.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse h =
                (req) -> Http2PriorKnowledgeTests.handle(req);
            b.handler(h);
            b.h2PriorKnowledge();
            HttpServer srv = b.build();
            int32 port = srv.server.listener.boundPort();
            Task<int32> sv = spawn serve(srv);

            Task<int32> th2 = spawn h2Client(port);
            c.eqInt((int64) await th2, 1,
                    "prior-knowledge: preface -> served over HTTP/2");

            Task<int32> th1 = spawn h1Client(port);
            c.eqInt((int64) await th1, 1,
                    "prior-knowledge: non-preface -> degrades to h1");

            boolean drained = srv.shutdown(Duration.ofSeconds(2));
            c.that(drained, "prior-knowledge: server drained clean");
            int32 s = await sv;
            c.eqInt((int64) s, 1, "prior-knowledge: accept loop exited");
        }
    }
}
