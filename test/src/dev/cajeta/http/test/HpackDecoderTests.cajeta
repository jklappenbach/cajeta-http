    static void guards(Check c) {
        // Out-of-range index (index 62 with an empty dynamic table).
        HpackDecoder d = heap HpackDecoder(4096);
        int8[] bad = [ (int8) 0xbe ];   // 0x80 | 62
        boolean caught = false;
        try {
            HpackFieldList l #= d.decode(bad, 1);
        } catch (HpackException e) {
            caught = true;
        }
        c.that(caught, "out-of-range index raises HpackException");

        // Index 0 is invalid for an indexed field.
        int8[] zero = [ (int8) 0x80 ];
        boolean caught2 = false;
        HpackDecoder d2 = heap HpackDecoder(4096);
        try {
            HpackFieldList l #= d2.decode(zero, 1);
        } catch (HpackException e) {
            caught2 = true;
        }
        c.that(caught2, "indexed field index 0 raises HpackException");

        // Size update above the configured maximum is a COMPRESSION_ERROR.
        // 0x3f 0xe2 0x1f = dynamic table size update to 4097 (> 4096).
        int8[] su = [ (int8) 0x3f, (int8) 0xe2, (int8) 0x1f ];
        boolean caught3 = false;
        HpackDecoder d3 = heap HpackDecoder(4096);
        try {
            HpackFieldList l #= d3.decode(su, 3);
        } catch (HpackException e) {
            caught3 = true;
        }
        c.that(caught3, "oversize table update raises HpackException");

        // Decoded-list size cap (bomb guard): decode C.3.1 under a tiny cap.
        int8[] blk = [
            (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0x41, (int8) 0x0f,
            (int8) 0x77, (int8) 0x77, (int8) 0x77, (int8) 0x2e, (int8) 0x65,
            (int8) 0x78, (int8) 0x61, (int8) 0x6d, (int8) 0x70, (int8) 0x6c,
            (int8) 0x65, (int8) 0x2e, (int8) 0x63, (int8) 0x6f, (int8) 0x6d
        ];
        boolean caught4 = false;
        HpackDecoder d4 = heap HpackDecoder(4096);
        d4.setMaxHeaderListSize(40);
        try {
            HpackFieldList l #= d4.decode(blk, 20);
        } catch (HpackException e) {
            caught4 = true;
        }
        c.that(caught4, "decoded list over cap raises HpackException");

        // A valid dynamic table size update to 0 then a fit-check: 0x20 = update to 0.
        int8[] su0 = [ (int8) 0x20, (int8) 0x82 ];   // update-to-0 then :method GET
        HpackDecoder d5 = heap HpackDecoder(4096);
        HpackFieldList l5 #= d5.decode(su0, 2);
        c.eqInt((int64) l5.size(), (int64) 1, "size-update-then-indexed decodes");
        c.eqStr(l5.nameAt(0), ":method", "size-update leaves indexed intact");
        c.eqInt((int64) d5.dynamicTable().maxSize(), (int64) 0, "table max now 0");
    }
}
