package dev.cajeta.http.test;

import cajeta.lang.String;
import dev.cajeta.http.h2.HpackDecoder;
import dev.cajeta.http.h2.HpackFieldList;
import dev.cajeta.http.h2.HpackException;

/**
 * http:3.1c — HPACK **decoder** golden vectors (RFC 7541 Appendix C.2-C.6),
 * verbatim. C.2 are independent representation examples; C.3/C.4 are a request
 * sequence on one connection (no Huffman / Huffman) and C.5/C.6 a response
 * sequence with the dynamic table capped at 256 octets, so evictions occur.
 * Each block asserts the full decoded header list AND the dynamic-table state
 * (size + every entry) after decoding, proving the shared table evolves in
 * lock-step with the RFC. Plus the size-bomb guards.
 */
public final class HpackDecoderTests {

    public static void run(Check c) {
        System.stdout.println("-- hpack decode: C.2 representations --");
        HpackDecoderTests.c2(c);
        System.stdout.println("-- hpack decode: C.3 requests (raw) --");
        HpackDecoderTests.c3(c);
        System.stdout.println("-- hpack decode: C.4 requests (huffman) --");
        HpackDecoderTests.c4(c);
        System.stdout.println("-- hpack decode: C.5 responses (raw, evicting) --");
        HpackDecoderTests.c5(c);
        System.stdout.println("-- hpack decode: C.6 responses (huffman, evicting) --");
        HpackDecoderTests.c6(c);
        System.stdout.println("-- hpack decode: guards --");
        HpackDecoderTests.guards(c);
    }

    static void c2(Check c) {
        HpackDecoder d0 = heap HpackDecoder(4096);
        // C.2.1
        int8[] v0 = [
        (int8) 0x40, (int8) 0x0a, (int8) 0x63, (int8) 0x75, (int8) 0x73, (int8) 0x74, (int8) 0x6f, (int8) 0x6d,
        (int8) 0x2d, (int8) 0x6b, (int8) 0x65, (int8) 0x79, (int8) 0x0d, (int8) 0x63, (int8) 0x75, (int8) 0x73,
        (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d, (int8) 0x68, (int8) 0x65, (int8) 0x61, (int8) 0x64,
        (int8) 0x65, (int8) 0x72,
        ];
        HpackFieldList v0l #= d0.decode(v0, 26);
        c.eqInt((int64) v0l.size(), (int64) 1, "C.2.1 field count");
        c.eqStr(v0l.nameAt(0), "custom-key", "C.2.1[0] name");
        c.eqStr(v0l.valueAt(0), "custom-header", "C.2.1[0] value");
        c.eqInt((int64) d0.dynamicTable().currentSize(), (int64) 55, "C.2.1 table size");
        c.eqInt((int64) d0.dynamicTable().count(), (int64) 1, "C.2.1 table count");
        c.eqStr(d0.dynamicTable().nameAt(1), "custom-key", "C.2.1 dyn[1] name");
        c.eqStr(d0.dynamicTable().valueAt(1), "custom-header", "C.2.1 dyn[1] value");

        HpackDecoder d1 = heap HpackDecoder(4096);
        // C.2.2
        int8[] v1 = [
        (int8) 0x04, (int8) 0x0c, (int8) 0x2f, (int8) 0x73, (int8) 0x61, (int8) 0x6d, (int8) 0x70, (int8) 0x6c,
        (int8) 0x65, (int8) 0x2f, (int8) 0x70, (int8) 0x61, (int8) 0x74, (int8) 0x68,
        ];
        HpackFieldList v1l #= d1.decode(v1, 14);
        c.eqInt((int64) v1l.size(), (int64) 1, "C.2.2 field count");
        c.eqStr(v1l.nameAt(0), ":path", "C.2.2[0] name");
        c.eqStr(v1l.valueAt(0), "/sample/path", "C.2.2[0] value");
        c.eqInt((int64) d1.dynamicTable().currentSize(), (int64) 0, "C.2.2 table size");
        c.eqInt((int64) d1.dynamicTable().count(), (int64) 0, "C.2.2 table count");

        HpackDecoder d2 = heap HpackDecoder(4096);
        // C.2.3
        int8[] v2 = [
        (int8) 0x10, (int8) 0x08, (int8) 0x70, (int8) 0x61, (int8) 0x73, (int8) 0x73, (int8) 0x77, (int8) 0x6f,
        (int8) 0x72, (int8) 0x64, (int8) 0x06, (int8) 0x73, (int8) 0x65, (int8) 0x63, (int8) 0x72, (int8) 0x65,
        (int8) 0x74,
        ];
        HpackFieldList v2l #= d2.decode(v2, 17);
        c.eqInt((int64) v2l.size(), (int64) 1, "C.2.3 field count");
        c.eqStr(v2l.nameAt(0), "password", "C.2.3[0] name");
        c.eqStr(v2l.valueAt(0), "secret", "C.2.3[0] value");
        c.eqInt((int64) d2.dynamicTable().currentSize(), (int64) 0, "C.2.3 table size");
        c.eqInt((int64) d2.dynamicTable().count(), (int64) 0, "C.2.3 table count");

        HpackDecoder d3 = heap HpackDecoder(4096);
        // C.2.4
        int8[] v3 = [
        (int8) 0x82,
        ];
        HpackFieldList v3l #= d3.decode(v3, 1);
        c.eqInt((int64) v3l.size(), (int64) 1, "C.2.4 field count");
        c.eqStr(v3l.nameAt(0), ":method", "C.2.4[0] name");
        c.eqStr(v3l.valueAt(0), "GET", "C.2.4[0] value");
        c.eqInt((int64) d3.dynamicTable().currentSize(), (int64) 0, "C.2.4 table size");
        c.eqInt((int64) d3.dynamicTable().count(), (int64) 0, "C.2.4 table count");

    }

    static void c3(Check c) {
        HpackDecoder d = heap HpackDecoder(4096);
        // C.3.1
        int8[] v0 = [
        (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0x41, (int8) 0x0f, (int8) 0x77, (int8) 0x77, (int8) 0x77,
        (int8) 0x2e, (int8) 0x65, (int8) 0x78, (int8) 0x61, (int8) 0x6d, (int8) 0x70, (int8) 0x6c, (int8) 0x65,
        (int8) 0x2e, (int8) 0x63, (int8) 0x6f, (int8) 0x6d,
        ];
        HpackFieldList v0l #= d.decode(v0, 20);
        c.eqInt((int64) v0l.size(), (int64) 4, "C.3.1 field count");
        c.eqStr(v0l.nameAt(0), ":method", "C.3.1[0] name");
        c.eqStr(v0l.valueAt(0), "GET", "C.3.1[0] value");
        c.eqStr(v0l.nameAt(1), ":scheme", "C.3.1[1] name");
        c.eqStr(v0l.valueAt(1), "http", "C.3.1[1] value");
        c.eqStr(v0l.nameAt(2), ":path", "C.3.1[2] name");
        c.eqStr(v0l.valueAt(2), "/", "C.3.1[2] value");
        c.eqStr(v0l.nameAt(3), ":authority", "C.3.1[3] name");
        c.eqStr(v0l.valueAt(3), "www.example.com", "C.3.1[3] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 57, "C.3.1 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 1, "C.3.1 table count");
        c.eqStr(d.dynamicTable().nameAt(1), ":authority", "C.3.1 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "www.example.com", "C.3.1 dyn[1] value");

        // C.3.2
        int8[] v1 = [
        (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0xbe, (int8) 0x58, (int8) 0x08, (int8) 0x6e, (int8) 0x6f,
        (int8) 0x2d, (int8) 0x63, (int8) 0x61, (int8) 0x63, (int8) 0x68, (int8) 0x65,
        ];
        HpackFieldList v1l #= d.decode(v1, 14);
        c.eqInt((int64) v1l.size(), (int64) 5, "C.3.2 field count");
        c.eqStr(v1l.nameAt(0), ":method", "C.3.2[0] name");
        c.eqStr(v1l.valueAt(0), "GET", "C.3.2[0] value");
        c.eqStr(v1l.nameAt(1), ":scheme", "C.3.2[1] name");
        c.eqStr(v1l.valueAt(1), "http", "C.3.2[1] value");
        c.eqStr(v1l.nameAt(2), ":path", "C.3.2[2] name");
        c.eqStr(v1l.valueAt(2), "/", "C.3.2[2] value");
        c.eqStr(v1l.nameAt(3), ":authority", "C.3.2[3] name");
        c.eqStr(v1l.valueAt(3), "www.example.com", "C.3.2[3] value");
        c.eqStr(v1l.nameAt(4), "cache-control", "C.3.2[4] name");
        c.eqStr(v1l.valueAt(4), "no-cache", "C.3.2[4] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 110, "C.3.2 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 2, "C.3.2 table count");
        c.eqStr(d.dynamicTable().nameAt(1), "cache-control", "C.3.2 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "no-cache", "C.3.2 dyn[1] value");
        c.eqStr(d.dynamicTable().nameAt(2), ":authority", "C.3.2 dyn[2] name");
        c.eqStr(d.dynamicTable().valueAt(2), "www.example.com", "C.3.2 dyn[2] value");

        // C.3.3
        int8[] v2 = [
        (int8) 0x82, (int8) 0x87, (int8) 0x85, (int8) 0xbf, (int8) 0x40, (int8) 0x0a, (int8) 0x63, (int8) 0x75,
        (int8) 0x73, (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d, (int8) 0x6b, (int8) 0x65, (int8) 0x79,
        (int8) 0x0c, (int8) 0x63, (int8) 0x75, (int8) 0x73, (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d,
        (int8) 0x76, (int8) 0x61, (int8) 0x6c, (int8) 0x75, (int8) 0x65,
        ];
        HpackFieldList v2l #= d.decode(v2, 29);
        c.eqInt((int64) v2l.size(), (int64) 5, "C.3.3 field count");
        c.eqStr(v2l.nameAt(0), ":method", "C.3.3[0] name");
        c.eqStr(v2l.valueAt(0), "GET", "C.3.3[0] value");
        c.eqStr(v2l.nameAt(1), ":scheme", "C.3.3[1] name");
        c.eqStr(v2l.valueAt(1), "https", "C.3.3[1] value");
        c.eqStr(v2l.nameAt(2), ":path", "C.3.3[2] name");
        c.eqStr(v2l.valueAt(2), "/index.html", "C.3.3[2] value");
        c.eqStr(v2l.nameAt(3), ":authority", "C.3.3[3] name");
        c.eqStr(v2l.valueAt(3), "www.example.com", "C.3.3[3] value");
        c.eqStr(v2l.nameAt(4), "custom-key", "C.3.3[4] name");
        c.eqStr(v2l.valueAt(4), "custom-value", "C.3.3[4] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 164, "C.3.3 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 3, "C.3.3 table count");
        c.eqStr(d.dynamicTable().nameAt(1), "custom-key", "C.3.3 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "custom-value", "C.3.3 dyn[1] value");
        c.eqStr(d.dynamicTable().nameAt(2), "cache-control", "C.3.3 dyn[2] name");
        c.eqStr(d.dynamicTable().valueAt(2), "no-cache", "C.3.3 dyn[2] value");
        c.eqStr(d.dynamicTable().nameAt(3), ":authority", "C.3.3 dyn[3] name");
        c.eqStr(d.dynamicTable().valueAt(3), "www.example.com", "C.3.3 dyn[3] value");

    }

    static void c4(Check c) {
        HpackDecoder d = heap HpackDecoder(4096);
        // C.4.1
        int8[] v0 = [
        (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0x41, (int8) 0x8c, (int8) 0xf1, (int8) 0xe3, (int8) 0xc2,
        (int8) 0xe5, (int8) 0xf2, (int8) 0x3a, (int8) 0x6b, (int8) 0xa0, (int8) 0xab, (int8) 0x90, (int8) 0xf4,
        (int8) 0xff,
        ];
        HpackFieldList v0l #= d.decode(v0, 17);
        c.eqInt((int64) v0l.size(), (int64) 4, "C.4.1 field count");
        c.eqStr(v0l.nameAt(0), ":method", "C.4.1[0] name");
        c.eqStr(v0l.valueAt(0), "GET", "C.4.1[0] value");
        c.eqStr(v0l.nameAt(1), ":scheme", "C.4.1[1] name");
        c.eqStr(v0l.valueAt(1), "http", "C.4.1[1] value");
        c.eqStr(v0l.nameAt(2), ":path", "C.4.1[2] name");
        c.eqStr(v0l.valueAt(2), "/", "C.4.1[2] value");
        c.eqStr(v0l.nameAt(3), ":authority", "C.4.1[3] name");
        c.eqStr(v0l.valueAt(3), "www.example.com", "C.4.1[3] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 57, "C.4.1 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 1, "C.4.1 table count");
        c.eqStr(d.dynamicTable().nameAt(1), ":authority", "C.4.1 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "www.example.com", "C.4.1 dyn[1] value");

        // C.4.2
        int8[] v1 = [
        (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0xbe, (int8) 0x58, (int8) 0x86, (int8) 0xa8, (int8) 0xeb,
        (int8) 0x10, (int8) 0x64, (int8) 0x9c, (int8) 0xbf,
        ];
        HpackFieldList v1l #= d.decode(v1, 12);
        c.eqInt((int64) v1l.size(), (int64) 5, "C.4.2 field count");
        c.eqStr(v1l.nameAt(0), ":method", "C.4.2[0] name");
        c.eqStr(v1l.valueAt(0), "GET", "C.4.2[0] value");
        c.eqStr(v1l.nameAt(1), ":scheme", "C.4.2[1] name");
        c.eqStr(v1l.valueAt(1), "http", "C.4.2[1] value");
        c.eqStr(v1l.nameAt(2), ":path", "C.4.2[2] name");
        c.eqStr(v1l.valueAt(2), "/", "C.4.2[2] value");
        c.eqStr(v1l.nameAt(3), ":authority", "C.4.2[3] name");
        c.eqStr(v1l.valueAt(3), "www.example.com", "C.4.2[3] value");
        c.eqStr(v1l.nameAt(4), "cache-control", "C.4.2[4] name");
        c.eqStr(v1l.valueAt(4), "no-cache", "C.4.2[4] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 110, "C.4.2 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 2, "C.4.2 table count");
        c.eqStr(d.dynamicTable().nameAt(1), "cache-control", "C.4.2 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "no-cache", "C.4.2 dyn[1] value");
        c.eqStr(d.dynamicTable().nameAt(2), ":authority", "C.4.2 dyn[2] name");
        c.eqStr(d.dynamicTable().valueAt(2), "www.example.com", "C.4.2 dyn[2] value");

        // C.4.3
        int8[] v2 = [
        (int8) 0x82, (int8) 0x87, (int8) 0x85, (int8) 0xbf, (int8) 0x40, (int8) 0x88, (int8) 0x25, (int8) 0xa8,
        (int8) 0x49, (int8) 0xe9, (int8) 0x5b, (int8) 0xa9, (int8) 0x7d, (int8) 0x7f, (int8) 0x89, (int8) 0x25,
        (int8) 0xa8, (int8) 0x49, (int8) 0xe9, (int8) 0x5b, (int8) 0xb8, (int8) 0xe8, (int8) 0xb4, (int8) 0xbf,
        ];
        HpackFieldList v2l #= d.decode(v2, 24);
        c.eqInt((int64) v2l.size(), (int64) 5, "C.4.3 field count");
        c.eqStr(v2l.nameAt(0), ":method", "C.4.3[0] name");
        c.eqStr(v2l.valueAt(0), "GET", "C.4.3[0] value");
        c.eqStr(v2l.nameAt(1), ":scheme", "C.4.3[1] name");
        c.eqStr(v2l.valueAt(1), "https", "C.4.3[1] value");
        c.eqStr(v2l.nameAt(2), ":path", "C.4.3[2] name");
        c.eqStr(v2l.valueAt(2), "/index.html", "C.4.3[2] value");
        c.eqStr(v2l.nameAt(3), ":authority", "C.4.3[3] name");
        c.eqStr(v2l.valueAt(3), "www.example.com", "C.4.3[3] value");
        c.eqStr(v2l.nameAt(4), "custom-key", "C.4.3[4] name");
        c.eqStr(v2l.valueAt(4), "custom-value", "C.4.3[4] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 164, "C.4.3 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 3, "C.4.3 table count");
        c.eqStr(d.dynamicTable().nameAt(1), "custom-key", "C.4.3 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "custom-value", "C.4.3 dyn[1] value");
        c.eqStr(d.dynamicTable().nameAt(2), "cache-control", "C.4.3 dyn[2] name");
        c.eqStr(d.dynamicTable().valueAt(2), "no-cache", "C.4.3 dyn[2] value");
        c.eqStr(d.dynamicTable().nameAt(3), ":authority", "C.4.3 dyn[3] name");
        c.eqStr(d.dynamicTable().valueAt(3), "www.example.com", "C.4.3 dyn[3] value");

    }

    static void c5(Check c) {
        HpackDecoder d = heap HpackDecoder(256);
        // C.5.1
        int8[] v0 = [
        (int8) 0x48, (int8) 0x03, (int8) 0x33, (int8) 0x30, (int8) 0x32, (int8) 0x58, (int8) 0x07, (int8) 0x70,
        (int8) 0x72, (int8) 0x69, (int8) 0x76, (int8) 0x61, (int8) 0x74, (int8) 0x65, (int8) 0x61, (int8) 0x1d,
        (int8) 0x4d, (int8) 0x6f, (int8) 0x6e, (int8) 0x2c, (int8) 0x20, (int8) 0x32, (int8) 0x31, (int8) 0x20,
        (int8) 0x4f, (int8) 0x63, (int8) 0x74, (int8) 0x20, (int8) 0x32, (int8) 0x30, (int8) 0x31, (int8) 0x33,
        (int8) 0x20, (int8) 0x32, (int8) 0x30, (int8) 0x3a, (int8) 0x31, (int8) 0x33, (int8) 0x3a, (int8) 0x32,
        (int8) 0x31, (int8) 0x20, (int8) 0x47, (int8) 0x4d, (int8) 0x54, (int8) 0x6e, (int8) 0x17, (int8) 0x68,
        (int8) 0x74, (int8) 0x74, (int8) 0x70, (int8) 0x73, (int8) 0x3a, (int8) 0x2f, (int8) 0x2f, (int8) 0x77,
        (int8) 0x77, (int8) 0x77, (int8) 0x2e, (int8) 0x65, (int8) 0x78, (int8) 0x61, (int8) 0x6d, (int8) 0x70,
        (int8) 0x6c, (int8) 0x65, (int8) 0x2e, (int8) 0x63, (int8) 0x6f, (int8) 0x6d,
        ];
        HpackFieldList v0l #= d.decode(v0, 70);
        c.eqInt((int64) v0l.size(), (int64) 4, "C.5.1 field count");
        c.eqStr(v0l.nameAt(0), ":status", "C.5.1[0] name");
        c.eqStr(v0l.valueAt(0), "302", "C.5.1[0] value");
        c.eqStr(v0l.nameAt(1), "cache-control", "C.5.1[1] name");
        c.eqStr(v0l.valueAt(1), "private", "C.5.1[1] value");
        c.eqStr(v0l.nameAt(2), "date", "C.5.1[2] name");
        c.eqStr(v0l.valueAt(2), "Mon, 21 Oct 2013 20:13:21 GMT", "C.5.1[2] value");
        c.eqStr(v0l.nameAt(3), "location", "C.5.1[3] name");
        c.eqStr(v0l.valueAt(3), "https://www.example.com", "C.5.1[3] value");
        c.eqInt((int64) d.dynamicTable().currentSize(), (int64) 222, "C.5.1 table size");
        c.eqInt((int64) d.dynamicTable().count(), (int64) 4, "C.5.1 table count");
        c.eqStr(d.dynamicTable().nameAt(1), "location", "C.5.1 dyn[1] name");
        c.eqStr(d.dynamicTable().valueAt(1), "https://www.example.com", "C.5.1 dyn[1] value");
        c.eqStr(d.dynamicTable().nameAt(2), "date", "C.5.1 dyn[2] name");
        c.eqStr(d.dynamicTable().valueAt(2), "Mon, 21 Oct 2013 20:13:21 GMT", "C.5.1 dyn[2] value");
        c.eqStr(d.dynamicTable().nameAt(3), "cache-control", "C.5.1 dyn[3] name");
        c.eqStr(d.dynamicTable().valueAt(3), "private", "C.5.1 dyn[3] value");
        c.eqStr(d.dynamicTable().nameAt(4), ":status", "C.5.1 dyn[4] name");
        c.eqStr(d.dynamicTable().valueAt(4), "302", "C.5.1 dyn[4] value");

        // C.5.2
        int8[] v1 = [
        (int8) 0x48, (int8) 0x03, (int8) 0x33, (int8) 0x30, (int8) 0x37, (int8) 0xc1, (int8) 0xc0, (int8) 0xbf,
        ];
        HpackFieldList v1l #= d.decode(v1, 8);
        c.eqInt((int64) v1l.size(), (int64) 4, "C.5.2 field count");
        c.eqStr(v1l.nameAt(0), ":status", "C.5.2[0] name");
        c.eqStr(v1l.valueAt(0), "307", "C.5.2[0] value");
        c.eqStr(v1l.nameAt(1), "cache-control", "C.5.2[1] name");
