package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.io.net.BufferPool;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpListener;
import cajeta.io.net.TcpStream;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.server.ConnectionBuffers;
import dev.cajeta.http.server.ServerLimits;
import dev.cajeta.http.h2.Http2;
import dev.cajeta.http.h2.Http2Connection;
import dev.cajeta.http.h2.Http2FrameHeader;
import dev.cajeta.http.h2.Http2FrameWriter;
import dev.cajeta.http.h2.Http2Frames;
import dev.cajeta.http.h2.Http2SettingsList;
import dev.cajeta.http.h2.Http2ContentFrames;
import dev.cajeta.http.h2.Http2Payload;
import dev.cajeta.http.h2.HpackEncoder;
import dev.cajeta.http.h2.HpackDecoder;
import dev.cajeta.http.h2.HpackFieldList;

/**
 * A raw HTTP/2 client over loopback drives the `Http2Connection` engine with the
 * same handler an HTTP/1.1 server would use: a bodyless GET, a POST whose body
 * arrives in a DATA frame, a 404, and a body past one receive window.
 */
public final class Http2ConnTests {

    static #String own(String s) {
        return s.substring(0, s.byteLength());
    }

    /** Reads exactly `n` bytes within `timeoutMs` per read, false on timeout or EOF. */
    static boolean readExactWithin(AsyncReader r, int8[] buf, int32 n,
                                   int32 timeoutMs) {
        int32 off = 0;
        while (off < n) {
            int32 g = r.readWithin(buf, off, n - off, timeoutMs);
            if (g <= 0) {
                return false;
            }
            off = off + g;
        }
        return true;
    }

    static void handle(HttpRequest q, HttpResponse r) {
        if (Bytes.equals(q.target(), "/hello")) {
            r.body("hello, h2");
            return;
        }
        if (Bytes.equals(q.target(), "/echo")) {
            r.writeBytes(q.body());
            return;
        }
        r.status(404);
        r.body("nope");
    }

    public static async int32 h2Server(#TcpListener listener) {
        TcpStream sock #= listener.acceptAsync();
        AsyncReader reader = heap AsyncReader(sock);
        AsyncWriter writer = heap AsyncWriter(sock);
        ConnectionBuffers bufs = heap ConnectionBuffers(heap BufferPool(65536, 8));
        HttpParserLimits limits = heap HttpParserLimits();
        Http2Connection.serve(reader, writer,
                              (HttpRequest q, HttpResponse r) -> Http2ConnTests.handle(q, r),
                              bufs, limits, ServerLimits.DEFAULT_MAX_BODY_BYTES);
        sock.close();
        return 1;
    }

    static int32 statusOf(HpackFieldList fields) {
        int32 i = 0;
        while (i < fields.size()) {
            if (fields.nameAt(i).equals(":status")) {
                String v = fields.valueAt(i);
                int32 s = 0;
                int32 k = 0;
                while (k < v.byteLength()) {
                    s = s * 10 + ((((int32) v.byteAt(k)) & 0xFF) - 48);
                    k = k + 1;
                }
                return s;
            }
            i = i + 1;
        }
        return -1;
    }

    static void client(Check c, int32 port, String method, String path,
                       int8[] reqBody, int32 reqBodyLen, boolean hasReqBody,
                       int32 expStatus, String expBody) {
        IpAddress ca #= IpAddress.loopbackV4();
        SocketAddress connAddr #= SocketAddress.of(#ca, port);
        TcpStream sock #= TcpStream.connectAsync(#connAddr);
        AsyncReader reader = heap AsyncReader(sock);
        AsyncWriter writer = heap AsyncWriter(sock);

        int8[] pf #= Http2.preface();
        writer.writeAll(pf, 0, 24);

        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2SettingsList empty = heap Http2SettingsList();
        Http2Frames.writeSettings(fw, empty);

        HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
        HpackFieldList fl = heap HpackFieldList();
        fl.put(Http2ConnTests.own(":method"), Http2ConnTests.own(method));
        fl.put(Http2ConnTests.own(":path"), Http2ConnTests.own(path));
        fl.put(Http2ConnTests.own(":scheme"), Http2ConnTests.own("http"));
        fl.put(Http2ConnTests.own(":authority"), Http2ConnTests.own("127.0.0.1"));
        int8[] block #= enc.encode(fl);
        Http2ContentFrames.writeHeaders(fw, 1, block, (int32) block.count(),
                                        !hasReqBody, true, 0);
        if (hasReqBody) {
            Http2ContentFrames.writeData(fw, 1, reqBody, reqBodyLen, true, 0);
        }
        int8[] out #= fw.toBytes();
        writer.writeAll(out, 0, (int32) out.count());
        writer.flush();

        HpackDecoder dec = heap HpackDecoder(Http2.DEFAULT_HEADER_TABLE_SIZE);
        int32 status = -1;
        Http2ConnTests.windowUpdates = 0;
        int8[] body = heap int8[256];
        int32 bodyLen = 0;
        int32 bodyCap = 256;
        boolean done = false;
        boolean timedOut = false;
        while (!done && !timedOut) {
            int8[] hdr = heap int8[9];
            if (!Http2ConnTests.readExactWithin(reader, hdr, 9, 4000)) {
                System.stdout.println("  CLT timeout waiting for frame header");
                timedOut = true;
            } else {
                Http2FrameHeader h #= Http2FrameHeader(hdr);
                int32 type = h.typeCode();
                int32 flags = h.flags();
                int32 sid = h.streamId();
                int32 len = h.length();
                int8[] pl = heap int8[len];
                if (len > 0) {
                    Http2ConnTests.readExactWithin(reader, pl, len, 4000);
                }
                if (type == Http2.FRAME_WINDOW_UPDATE) {
                    Http2ConnTests.windowUpdates = Http2ConnTests.windowUpdates + 1;
                } else if (type == Http2.FRAME_SETTINGS) {
                    if ((flags & Http2.FLAG_ACK) == 0) {
                        Http2FrameWriter afw = heap Http2FrameWriter();
                        Http2Frames.writeSettingsAck(afw);
                        int8[] ab #= afw.toBytes();
                        writer.writeAll(ab, 0, (int32) ab.count());
                        writer.flush();
                    }
                } else if (type == Http2.FRAME_HEADERS) {
                    Http2Payload reg #= Http2ContentFrames.parseHeaders(pl, len,
                                                                      flags, sid);
                    int8[] blk = heap int8[reg.length];
                    int32 j = 0;
                    while (j < reg.length) {
                        blk[j] = pl[reg.offset + j];
                        j = j + 1;
                    }
                    HpackFieldList rf #= dec.decode(blk, reg.length);
                    status = Http2ConnTests.statusOf(rf);
                    if ((flags & Http2.FLAG_END_STREAM) != 0) {
                        done = true;
                    }
                } else if (type == Http2.FRAME_DATA) {
                    Http2Payload reg #= Http2ContentFrames.parseData(pl, len, flags,
                                                                   sid);
                    int32 j = 0;
                    while (j < reg.length) {
                        if (bodyLen >= bodyCap) {
                            int32 nc = bodyCap * 2;
                            int8[] nb = heap int8[nc];
                            int32 m = 0;
                            while (m < bodyLen) {
                                nb[m] = body[m];
                                m = m + 1;
                            }
                            body = #nb;
                            bodyCap = nc;
                        }
                        body[bodyLen] = pl[reg.offset + j];
                        bodyLen = bodyLen + 1;
                        j = j + 1;
                    }
                    if ((flags & Http2.FLAG_END_STREAM) != 0) {
                        done = true;
                    }
                }
            }
        }
        sock.close();

        c.that(!timedOut, "h2 exchange did not time out");
        c.eqInt((int64) status, (int64) expStatus, "h2 exchange status");
        boolean bodyOk = bodyLen == expBody.byteLength();
        if (bodyOk) {
            int32 j = 0;
            while (j < bodyLen) {
                if ((((int32) body[j]) & 0xFF)
                        != (((int32) expBody.byteAt(j)) & 0xFF)) {
                    bodyOk = false;
                    j = bodyLen;
                } else {
                    j = j + 1;
                }
            }
        }
        c.that(bodyOk, "h2 exchange body");
    }

    /** WINDOW_UPDATE frames the server sent during the last exchange. */
    static int32 windowUpdates;
    static int32 streamWindowUpdates;

    /**
     * A body past one receive window, sent as many DATA frames. The server must
     * hand back receive credit on the connection and on the stream as it consumes them.
     */
    static void largeBody(Check c) {
        scope {
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            Task<int32> sv = spawn h2Server(#listener);
            Http2ConnTests.bigClient(c, port);
            int32 r = await sv;
        }
    }

    /** 64 frames of 16384 octets, past the replenish threshold and within the frame size. */
    static final int32 BIG_FRAME = 16384;
    static final int32 BIG_FRAMES = 64;

    /** POSTs to the small-response path, so the server never waits on its own send window. */
    static void bigClient(Check c, int32 port) {
        IpAddress ca #= IpAddress.loopbackV4();
        SocketAddress connAddr #= SocketAddress.of(#ca, port);
        TcpStream sock #= TcpStream.connectAsync(#connAddr);
        AsyncReader reader = heap AsyncReader(sock);
        AsyncWriter writer = heap AsyncWriter(sock);

        int8[] pf #= Http2.preface();
        writer.writeAll(pf, 0, 24);

        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2SettingsList empty = heap Http2SettingsList();
        Http2Frames.writeSettings(fw, empty);

        HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
        HpackFieldList fl = heap HpackFieldList();
        fl.put(Http2ConnTests.own(":method"), Http2ConnTests.own("POST"));
        fl.put(Http2ConnTests.own(":path"), Http2ConnTests.own("/hello"));
        fl.put(Http2ConnTests.own(":scheme"), Http2ConnTests.own("http"));
        fl.put(Http2ConnTests.own(":authority"), Http2ConnTests.own("127.0.0.1"));
        int8[] block #= enc.encode(fl);
        Http2ContentFrames.writeHeaders(fw, 1, block, (int32) block.count(),
                                        false, true, 0);
        int8[] chunk = heap int8[Http2ConnTests.BIG_FRAME];
        int32 i = 0;
        while (i < Http2ConnTests.BIG_FRAME) {
            chunk[i] = (int8) 0x7a;
            i = i + 1;
        }
        int32 f = 0;
        while (f < Http2ConnTests.BIG_FRAMES) {
            boolean last = f == Http2ConnTests.BIG_FRAMES - 1;
            Http2ContentFrames.writeData(fw, 1, chunk,
                                         Http2ConnTests.BIG_FRAME, last, 0);
            f = f + 1;
        }
        int8[] out #= fw.toBytes();
        writer.writeAll(out, 0, (int32) out.count());
        writer.flush();

        Http2ConnTests.windowUpdates = 0;
        Http2ConnTests.streamWindowUpdates = 0;
        boolean sawEnd = false;
        boolean timedOut = false;
        while (!sawEnd && !timedOut) {
            int8[] hdr = heap int8[9];
            if (!Http2ConnTests.readExactWithin(reader, hdr, 9, 6000)) {
                timedOut = true;
            } else {
                Http2FrameHeader h #= Http2FrameHeader(hdr);
                int32 type = h.typeCode();
                int32 flags = h.flags();
                int32 len = h.length();
                int8[] pl = heap int8[len];
                if (len > 0) {
                    Http2ConnTests.readExactWithin(reader, pl, len, 6000);
                }
                if (type == Http2.FRAME_WINDOW_UPDATE) {
                    Http2ConnTests.windowUpdates =
                        Http2ConnTests.windowUpdates + 1;
                    if (h.streamId() != 0) {
                        Http2ConnTests.streamWindowUpdates =
                            Http2ConnTests.streamWindowUpdates + 1;
                    }
                } else if (type == Http2.FRAME_SETTINGS) {
                    if ((flags & Http2.FLAG_ACK) == 0) {
                        Http2FrameWriter afw = heap Http2FrameWriter();
                        Http2Frames.writeSettingsAck(afw);
                        int8[] ab #= afw.toBytes();
                        writer.writeAll(ab, 0, (int32) ab.count());
                        writer.flush();
                    }
                } else if (type == Http2.FRAME_DATA) {
                    if ((flags & Http2.FLAG_END_STREAM) != 0) { sawEnd = true; }
                } else if (type == Http2.FRAME_GOAWAY) {
                    sawEnd = true;
                }
            }
        }
        sock.close();
        c.that(!timedOut, "h2 large body: exchange completed");
        c.that(Http2ConnTests.windowUpdates > 0,
               "h2 large body: server returned receive-window credit");
        c.that(Http2ConnTests.streamWindowUpdates > 0,
               "h2 large body: server returned stream-level credit");
    }

    static void oneExchange(Check c, String method, String path, int8[] reqBody,
                            int32 reqBodyLen, boolean hasReqBody, int32 expStatus,
                            String expBody) {
        scope {
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            Task<int32> sv = spawn h2Server(#listener);
            Http2ConnTests.client(c, port, method, path, reqBody, reqBodyLen,
                                  hasReqBody, expStatus, expBody);
            int32 r = await sv;
        }
    }

    public static void run(Check c) {
        System.stdout.println("-- h2 conn: end-to-end exchange --");
        int8[] none = heap int8[0];
        Http2ConnTests.oneExchange(c, "GET", "/hello", none, 0, false, 200,
                                   "hello, h2");
        int8[] ping = [ (int8) 0x70, (int8) 0x69, (int8) 0x6e, (int8) 0x67 ];
        Http2ConnTests.oneExchange(c, "POST", "/echo", ping, 4, true, 200,
                                   "ping");
        Http2ConnTests.oneExchange(c, "GET", "/nope", none, 0, false, 404,
                                   "nope");
        System.stdout.println("-- h2 conn: body past one window --");
        Http2ConnTests.largeBody(c);
    }
}
