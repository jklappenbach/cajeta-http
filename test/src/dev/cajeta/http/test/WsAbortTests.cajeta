package dev.cajeta.http.test;

import cajeta.concurrent.Fiber;
import cajeta.io.net.Server;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.lang.String;
import cajeta.time.Duration;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.ws.WebSocketConnection;
import dev.cajeta.http.ws.WebSocketHandler;
import dev.cajeta.http.ws.WsMessage;
import dev.cajeta.http.ws.WsUpgrade;

/** Keeps the connection for a flooding fiber and records how it closed. */
final class FloodHandler implements WebSocketHandler {
    WebSocketConnection conn;
    int32 closes;
    int32 code;

    FloodHandler() {
        this.conn = null;
        this.closes = 0;
        this.code = 0;
    }

    public void onConnect(WebSocketConnection conn) { this.conn #= conn; }
    public void onMessage(WebSocketConnection conn, WsMessage message) { }
    public void onClose(WebSocketConnection conn, int32 code) {
        this.closes = this.closes + 1;
        this.code = code;
    }
}

/**
 * A peer that stops reading leaves a sender parked on the socket holding the
 * write lock, so no CLOSE frame can be written. `abort` ends the connection
 * anyway: the parked send fails, the reader loop ends, and `onClose` gets the
 * code `abort` was given (primavera-web spec §6.5, plan 4.1.4).
 */
public final class WsAbortTests {
    static FloodHandler FLOOD = heap FloodHandler();
    static int32 sent;
    static boolean senderEnded;

    static void handle(HttpRequest q, HttpResponse r) {
        WsUpgrade.accept(q, r, WsAbortTests.FLOOD, false);
    }

    public static async int32 acceptOne(Server core) {
        TcpStream conn #= core.acceptNext();
        core.dispatch(#conn);
        return 1;
    }

    public static async int32 flood() {
        while (WsAbortTests.FLOOD.conn == null) {
            Fiber.sleep(Duration.ofMillis(5));
        }
        int8[] big = heap int8[65536];
        try {
            while (true) {
                WsAbortTests.FLOOD.conn.sendBinary(big, 0, 65536);
                WsAbortTests.sent = WsAbortTests.sent + 1;
            }
        } catch (Exception e) {
        }
        WsAbortTests.senderEnded = true;
        return WsAbortTests.sent;
    }

    static void abortsAParkedSender(Check c) {
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler((HttpRequest q, HttpResponse r) -> WsAbortTests.handle(q, r));
            HttpServer srv #= b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> acc = spawn acceptOne(core);
            TcpStream peer #= TcpStream.connectAsync(SocketAddress.parse("127.0.0.1:" + port));
            String hello = "GET /ws HTTP/1.1\r\nHost: t\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n";
            int8[] hb #= hello.toBytes();
            peer.writeAllAsync(hb, (int64) 0, (int64) hello.byteLength());
            Task<int32> fl = spawn flood();
            // The peer reads nothing, so the sender parks once the socket buffers fill.
            int32 last = -1;
            int32 waited = 0;
            while (WsAbortTests.sent != last && waited < 400) {
                last = WsAbortTests.sent;
                Fiber.sleep(Duration.ofMillis(50));
                waited = waited + 1;
            }
            c.that(!WsAbortTests.senderEnded, "the sender is parked on a peer that does not read");
            WsAbortTests.FLOOD.conn.abort(1008);
            await fl;
            c.that(WsAbortTests.senderEnded, "abort fails the parked send");
            int32 w = 0;
            while (WsAbortTests.FLOOD.closes == 0 && w < 200) {
                Fiber.sleep(Duration.ofMillis(10));
                w = w + 1;
            }
            c.eqInt((int64) WsAbortTests.FLOOD.closes, 1, "onClose fires once");
            c.eqInt((int64) WsAbortTests.FLOOD.code, 1008, "onClose carries the abort's code");
            core.listener.close();
            await acc;
            peer.close();
        }
    }

    public static void run(Check c) {
        System.stdout.println("-- ws abort: a parked sender --");
        WsAbortTests.abortsAParkedSender(c);
    }
}
