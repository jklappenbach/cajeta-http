package dev.cajeta.http.test;

import dev.cajeta.http.Http;

// Entry point for the library's self-checking test binary (see the
// manifest's `test` task). Exit 0 iff every check passes.
public final class TestMain {
    public static int32 main(String[] args) {
        System.stdout.println("=== cajeta-http tests ===");
        Check c = heap Check();

        String v = Http.version();
        c.eqStr(v, "0.1.1", "Http.version()");

        CoreTypeTests.run(c);
        BodyTests.run(c);
        FormTests.run(c);
        StreamTests.run(c);
        MultipartTests.run(c);
        MessageBodyTests.run(c);
        ClientPoolTests.run(c);
        CodecTests.run(c);
        ServerTests.run(c);
        RouterTests.run(c);
        MiddlewareTests.run(c);
        MiddlewareBundleTests.run(c);
        MiddlewareTimeoutCorsTests.run(c);
        MiddlewareCompressionTests.run(c);
        MiddlewareAuthRateTests.run(c);
        MiddlewareStaticEtagProxyTests.run(c);
        MiddlewareLoopbackTests.run(c);
        ClientTests.run(c);
        RedirectTests.run(c);
        ClientTimeoutTests.run(c);
        DownloadTests.run(c);
        CodingTests.run(c);
        ClientCodingTests.run(c);
        ClientBuilderTests.run(c);
        ClientCookieTests.run(c);
        ServerDeadlineTests.run(c);
        ServerSizeLimitTests.run(c);
        StreamingCodingTests.run(c);
        ServerTlsTests.run(c);
        ServerStreamingTests.run(c);
        ServerAcceptControlTests.run(c);
        WsTests.run(c);
        HpackPrimitiveTests.run(c);
        HpackTableTests.run(c);
        HpackDecoderTests.run(c);
        HpackEncoderTests.run(c);
        Http2FrameTests.run(c);
        Http2FixedFrameTests.run(c);
        Http2ContentFrameTests.run(c);
        Http2SettingsTests.run(c);
        Http2StreamTests.run(c);
        Http2FlowTests.run(c);
        Http2ConnTests.run(c);
        Http2ConcurrencyTests.run(c);
        Http2FlowParkTests.run(c);
        Http2RstCancelTests.run(c);
        Http2ClientTests.run(c);
        Http2AlpnTests.run(c);
        Http2PriorKnowledgeTests.run(c);
        Http2PushTests.run(c);
        WsPerMessageDeflateTests.run(c);

        System.stdout.println("");
        System.stdout.println("=== {} passed, {} failed ===",
                              c.passes, c.failures);
        if (c.failures > 0) {
            return 1;
        }
        return 0;
    }
}
