package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.BufferPool;
import cajeta.io.net.ByteBuffer;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.h2.Http2;
import dev.cajeta.http.h2.Http2Connection;
import dev.cajeta.http.h2.Http2WriteSide;
import dev.cajeta.http.h2.HpackDecoder;
import dev.cajeta.http.server.ConnectionBuffers;

/** The h2 write side allocates nothing per response, and what a whole connection costs per request. */
public final class Http2AllocationTests {
    public static void run(Check c) {
        System.stdout.println("-- h2: response frames --");
        Http2AllocationTests.frames(c);
        System.stdout.println("-- h2: write side allocation --");
        Http2AllocationTests.writeSide(c);
        System.stdout.println("-- h2: connection cost per request --");
        Http2AllocationTests.perRequest(c);
    }

    static void handle(HttpRequest q, HttpResponse r) {
        r.header("Content-Type", "text/plain");
        r.body("ok");
    }

    static void frameHeader(int8[] a, int32 at, int32 len, int32 type, int32 flags, int32 sid) {
        a[at] = (int8) ((len >> 16) & 255);
        a[at + 1] = (int8) ((len >> 8) & 255);
        a[at + 2] = (int8) (len & 255);
        a[at + 3] = (int8) type;
        a[at + 4] = (int8) flags;
        a[at + 5] = (int8) ((sid >> 24) & 127);
        a[at + 6] = (int8) ((sid >> 16) & 255);
        a[at + 7] = (int8) ((sid >> 8) & 255);
        a[at + 8] = (int8) (sid & 255);
    }

    // The preface, an empty SETTINGS, then `n` GET / requests on streams 1, 3, 5 and on.
    static #String script(int32 n) {
        int32 per = 9 + 6;
        int8[] a = heap int8[24 + 9 + n * per];
        int8[] pf #= Http2.preface();
        int32 i = 0;
        while (i < 24) {
            a[i] = pf[i];
            i = i + 1;
        }
        Http2AllocationTests.frameHeader(a, 24, 0, 4, 0, 0);
        int32 at = 33;
        int32 k = 0;
        while (k < n) {
            Http2AllocationTests.frameHeader(a, at, 6, 1, 5, 1 + 2 * k);
            a[at + 9] = (int8) -126;
            a[at + 10] = (int8) -122;
            a[at + 11] = (int8) -124;
            a[at + 12] = (int8) 1;
            a[at + 13] = (int8) 1;
            a[at + 14] = (int8) 116;
            at = at + per;
            k = k + 1;
        }
        return Bytes.toString(a[0:at]);
    }

    static async int32 serveOn(AsyncReader reader, AsyncWriter writer, (HttpRequest, HttpResponse) -> void h,
                               ConnectionBuffers bufs, HttpParserLimits limits) {
        Http2Connection.serve(reader, writer, h, bufs, limits, (int64) 1048576);
        return 1;
    }

    static int64 serve(int32 n) {
        String s #= Http2AllocationTests.script(n);
        ScriptChannel ch = heap ScriptChannel(s, 65536);
        AsyncReader reader = heap AsyncReader(ch);
        AsyncWriter writer = heap AsyncWriter(ch);
        ConnectionBuffers bufs = heap ConnectionBuffers(heap BufferPool(16384, 8));
        HttpParserLimits limits = heap HttpParserLimits();
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> Http2AllocationTests.handle(q, r);
        int64 before = Cajeta.allocatedBytes();
        scope {
            Task<int32> t = spawn serveOn(reader, writer, h, bufs, limits);
            await t;
        }
        int64 used = Cajeta.allocatedBytes() - before;
        int32 answered = Http2AllocationTests.count(ch, "ok");
        if (answered != n) {
            System.stdout.println("    only {} of {} requests answered", answered, n);
            return (int64) -1;
        }
        return used;
    }

    // Occurrences of `word` in what the server wrote.
    static int32 count(ScriptChannel ch, String word) {
        int8[] a = ch.captured();
        String got #= Bytes.toString(a[0:ch.capturedLen()]);
        int32 n = 0;
        int64 at = got.indexOf(word);
        while (at >= (int64) 0) {
            n = n + 1;
            at = got.indexOfFrom(word, at + (int64) 1);
        }
        return n;
    }

    static void perRequest(Check c) {
        Http2AllocationTests.serve(20);
        int64 small = Http2AllocationTests.serve(20);
        int64 large = Http2AllocationTests.serve(100);
        c.that(small >= (int64) 0 && large >= (int64) 0, "every request on the connection is answered");
        int64 per = (large - small) / (int64) 80;
        System.stdout.println("    h2 server: {} bytes per request after warm-up ({} for 20, {} for 100)", per, small, large);
    }

    // Reassembles the header block starting at `at` into `block`; returns [end, blockLen, firstType, firstFlags, frames].
    static #int32[] headerBlock(int8[] a, int32 at, int8[] block) {
        int32[] out = heap int32[5];
        int32 bl = 0;
        int32 frames = 0;
        boolean done = false;
        while (!done) {
            int32 len = ((((int32) a[at]) & 255) << 16) | ((((int32) a[at + 1]) & 255) << 8) | (((int32) a[at + 2]) & 255);
            int32 type = ((int32) a[at + 3]) & 255;
            int32 flags = ((int32) a[at + 4]) & 255;
            if (frames == 0) {
                out[2] = type;
                out[3] = flags;
            }
            int32 i = 0;
            while (i < len) {
                block[bl + i] = a[at + 9 + i];
                i = i + 1;
            }
            bl = bl + len;
            at = at + 9 + len;
            frames = frames + 1;
            done = (flags & 4) != 0;
        }
        out[0] = at;
        out[1] = bl;
        out[4] = frames;
        return #out;
    }

    static int32 find(HpackDecoder d, int32 n, String name) {
        int32 i = 0;
        while (i < n) {
            if (Bytes.equals(d.fieldName(i), name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    static void frames(Check c) {
        ScriptChannel ch = heap ScriptChannel("", 16);
        AsyncWriter w = heap AsyncWriter(ch);
        Http2WriteSide ws = heap Http2WriteSide(w);
        HttpResponse r = heap HttpResponse(heap ByteBuffer(65536), null, 50000, 16);
        int8[] big = heap int8[30000];
        int32 i = 0;
        while (i < 30000) {
            big[i] = (int8) (97 + i % 26);
            i = i + 1;
        }
        String bigValue #= Bytes.toString(big[0:30000]);
        r.status(201);
        r.header("X-Big", bigValue);
        r.header("Content-Type", "text/plain");
        r.header("Connection", "close");
        r.header("Set-Cookie", "k=v");
        r.header("Date", "Mon, 28 Sep 2026 10:00:00 GMT");
        int8[] body = heap int8[2];
        body[0] = (int8) 111;
        body[1] = (int8) 107;
        ws.writeResponse(1, r, false, true, body, 0, 2, true);
        int8[] a = ch.captured();
        int8[] block = heap int8[65536];
        int32[] h #= Http2AllocationTests.headerBlock(a, 0, block);
        c.eqInt((int64) h[2], 1, "the head opens with a HEADERS frame");
        c.that((h[3] & 1) == 0, "HEADERS does not end a stream that carries DATA");
        c.that(h[4] >= 2, "a head over 16384 bytes continues in CONTINUATION frames");
        HpackDecoder d = heap HpackDecoder(4096);
        d.setMaxStringLength(65536);
        d.setMaxHeaderListSize(65536);
        int32 n = d.decodeInto(block, 0, h[1]);
        c.that(Bytes.equals(d.fieldName(0), ":status") && Bytes.equals(d.fieldValue(0), "201"),
            "a status outside the static table goes out as a literal");
        int32 ct = Http2AllocationTests.find(d, n, "content-type");
        c.that(ct > 0 && Bytes.equals(d.fieldValue(ct), "text/plain"), "names are lowercased");
        c.that(Http2AllocationTests.find(d, n, "connection") < 0, "connection-specific fields are dropped");
        c.that(Http2AllocationTests.find(d, n, "set-cookie") > 0 && Http2AllocationTests.find(d, n, "date") > 0,
            "never-indexed and non-indexed fields still arrive");
        int32 bx = Http2AllocationTests.find(d, n, "x-big");
        c.that(bx > 0 && Bytes.equals(d.fieldValue(bx), bigValue), "the continued field decodes whole");
        c.eqInt((int64) d.dynamicTable().count(), 1, "only content-type enters the table: x-big is too large, set-cookie and date are not indexed");
        int32 at = h[0];
        c.eqInt((int64) (((int32) a[at + 3]) & 255), 0, "DATA follows the head in the same write");
        c.eqInt((int64) (((int32) a[at + 4]) & 1), 1, "and ends the stream");
        c.that(a[at + 9] == (int8) 111 && a[at + 10] == (int8) 107, "carrying the body");
    }

    static void respond(Http2WriteSide ws, HttpResponse r, int8[] body, int32 sid) {
        r.reset();
        r.status(200);
        r.header("Content-Type", "text/plain");
        r.header("Cache-Control", "no-store");
        r.header("Date", "Mon, 28 Sep 2026 10:00:00 GMT");
        ws.writeResponse(sid, r, false, true, body, 0, 2, true);
    }

    static void writeSide(Check c) {
        ScriptChannel ch = heap ScriptChannel("", 16);
        AsyncWriter w = heap AsyncWriter(ch);
        Http2WriteSide ws = heap Http2WriteSide(w);
        HttpResponse r = heap HttpResponse(heap ByteBuffer(16384), null, 1024, 16);
        int8[] body = heap int8[2];
        body[0] = (int8) 111;
        body[1] = (int8) 107;
        Http2AllocationTests.respond(ws, r, body, 1);
        int32 warm = ch.capturedLen();
        int64 before = Cajeta.allocatedBytes();
        int32 i = 0;
        while (i < 1000) {
            Http2AllocationTests.respond(ws, r, body, 3 + 2 * i);
            i = i + 1;
        }
        int64 delta = Cajeta.allocatedBytes() - before;
        c.that(delta == (int64) 0, "1000 responses through the h2 write side allocate nothing (" + delta + " bytes)");
        int8[] a = ch.captured();
        int8[] block = heap int8[4096];
        int32[] h #= Http2AllocationTests.headerBlock(a, warm, block);
        c.that(h[1] < 40, "a repeated head re-encodes from the tables (" + h[1] + " bytes)");
    }
}

