import cajeta.error.Exception;
import cajeta.concurrent.Fiber;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.ServerModel;
import cajeta.io.net.TcpStream;
import cajeta.io.net.TimedOutException;
import dev.cajeta.crypto.tls.TlsStream;
import cajeta.time.Clock;
import cajeta.time.Duration;
import cajeta.time.Instant;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.client.HttpClient;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import dev.cajeta.http.h2.HpackDecoder;
import dev.cajeta.http.h2.HpackEncoder;
import dev.cajeta.http.h2.HpackFieldList;
import dev.cajeta.http.h2.Http2;
import dev.cajeta.http.h2.Http2ContentFrames;
import dev.cajeta.http.h2.Http2FrameHeader;
import dev.cajeta.http.h2.Http2FrameWriter;
import dev.cajeta.http.h2.Http2Frames;
import dev.cajeta.http.h2.Http2SettingsList;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.server.ServerLimits;

/**
 * request-dispatch plan Unit 3 (spec §2.1, §3.1, §3.2, §4.1 to §4.5): under
 * the default pool model a connection is assigned a fiber only when it holds
 * a complete request, framers do the reading, and admission bounds in-flight
 * units with back-pressure by pausing a socket. Plaintext HTTP/1.1 only here.
 */
public final class DispatchTests {
    @Native("__cajeta_dbg_fiber_count")
    private static int32 fiberCount();

    static int32 slowHits;
    static int32 upstreamPort;

    public static void run(Check c) {
        System.stdout.println("-- dispatch: framers count follows the builder (3.1.11) --");
        DispatchTests.framerCount(c);
        System.stdout.println("-- dispatch: a GET runs on a pool fiber, none per connection (3.1.1) --");
        DispatchTests.getOnPoolFiber(c);
        System.stdout.println("-- dispatch: idle keep-alive connections hold no fibers (3.1.5) --");
        DispatchTests.idleConnectionsHoldNoFibers(c);
        System.stdout.println("-- dispatch: a POST dispatches after its last body byte (3.1.2) --");
        DispatchTests.postDispatchesAfterBody(c);
        System.stdout.println("-- dispatch: a chunked body dispatches after the terminator (3.1.3) --");
        DispatchTests.chunkedDispatchesAfterTerminator(c);
        System.stdout.println("-- dispatch: 100-continue and 413 are answered on the framer (3.1.4) --");
        DispatchTests.expectContinueOnFramer(c);
        System.stdout.println("-- dispatch: three pipelined requests are one turn (3.1.6) --");
        DispatchTests.pipelinedIsOneTurn(c);
        System.stdout.println("-- dispatch: 431 and 408 without a dispatch (3.1.7) --");
        DispatchTests.headLimitsOnFramer(c);
        System.stdout.println("-- dispatch: maxInFlight bounds admission, not progress (3.1.8) --");
        DispatchTests.maxInFlightBounds(c);
        System.stdout.println("-- dispatch: back-pressure pauses a socket, refuses nothing (3.1.9) --");
        DispatchTests.backPressurePauses(c);
        System.stdout.println("-- dispatch: a dribbling head delays nobody else (3.1.10) --");
        DispatchTests.dribbleDelaysNobody(c);
        System.stdout.println("-- dispatch: a handler that calls another server parks and returns (3.1.12) --");
        DispatchTests.handlerCallsAnotherServer(c);
        System.stdout.println("-- dispatch: fiberPerConnection() is the old model, explicitly (3.3.2) --");
        DispatchTests.fiberPerConnectionExplicit(c);
        System.stdout.println("-- dispatch: no model call is the pool with its defaults (9.1.1) --");
        DispatchTests.defaultsAreThePool(c);
        System.stdout.println("-- dispatch: the stdlib shared-pool model is refused at build, naming maxInFlight (9.1.2) --");
        DispatchTests.sharedPoolRefused(c);
        System.stdout.println("-- dispatch tls: idle TLS connections hold no fibers (4.1.1) --");
        DispatchTests.tlsIdleConnectionsHoldNoFibers(c);
        System.stdout.println("-- dispatch tls: an https GET runs on a pool fiber (4.1.2) --");
        DispatchTests.tlsGetOnPoolFiber(c);
        System.stdout.println("-- dispatch tls: the builder's model and framer count apply to a TLS server (9.1.3) --");
        DispatchTests.tlsBuilderSettingsApply(c);
        System.stdout.println("-- dispatch tls: a stalled handshake delays nobody (4.1.3) --");
        DispatchTests.tlsStallDelaysNobody(c);
        System.stdout.println("-- dispatch h2: streams on one connection run in parallel by default (5.1.2) --");
        DispatchTests.h2StreamsParallel(c);
        System.stdout.println("-- dispatch h2: serializedStreams runs one at a time (5.1.2) --");
        DispatchTests.h2StreamsSerialized(c);
        System.stdout.println("-- dispatch h2: fifty open, ten complete, ten dispatched (5.1.1) --");
        DispatchTests.h2HeldStreams(c);
        System.stdout.println("-- dispatch h2: bytes per stream on one connection under the pool (10.3.3) --");
        DispatchTests.h2BytesPerStream(c);
        System.stdout.println("-- dispatch h2: a reset with a stream on a worker drops the connection once (5.1.2) --");
        DispatchTests.h2ResetWhileStreamInFlight(c);
        System.stdout.println("-- dispatch h2: a TLS read error with a stream on a worker drops the connection once (5.1.2) --");
        DispatchTests.h2TlsReadErrorWhileStreamInFlight(c);
    }

    // ----- fixtures -------------------------------------------------------

    static void handle(HttpRequest q, HttpResponse r) {
        if (Bytes.equals(q.path(), "/slow")) {
            DispatchTests.slowHits = DispatchTests.slowHits + 1;
            Fiber.sleep(Duration.ofMillis((int64) 100));
            r.body("slow-done");
            return;
        }
        if (Bytes.equals(q.path(), "/hung")) {
            Fiber.sleep(Duration.ofMillis((int64) 500));
            r.body("hung-done");
            return;
        }
        if (Bytes.equals(q.path(), "/echo")) {
            r.writeBytes(q.body());
            return;
        }
        if (Bytes.equals(q.path(), "/proxy")) {
            // Calls the second server: the client's socket reads park this
            // pool fiber on the reactor, never the framer.
            HttpClient client #= heap HttpClient();
            client.exchangeTimeout(5000);
            String url = "http://127.0.0.1:" + DispatchTests.upstreamPort + "/";
            ClientResponse resp #= client.get(url);
            String got #= resp.bodyString();
            r.body("via:" + got);
            return;
        }
        r.body("ok");
    }

    static #HttpServer server(int32 maxInFlight, int32 maxPending, int32 framers) {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
        if (maxInFlight > 0) { b.maxInFlight(maxInFlight); }
        if (maxPending > 0) { b.maxPendingUnits(maxPending); }
        if (framers > 0) { b.framers(framers); }
        return b.build();
    }

    public static async int32 serveIt(HttpServer srv) {
        srv.serve();
        return 1;
    }

    static int64 nowMs() {
        Instant t = Clock.now();
        return t.toEpochMilli();
    }

    /** Waits until the server reports its framers running, so counts are stable. */
    static void settle(HttpServer srv) {
        int32 i = 0;
        while (i < 200 && srv.framerCount() == 0) {
            Fiber.sleep(Duration.ofMillis((int64) 5));
            i = i + 1;
        }
        Fiber.sleep(Duration.ofMillis((int64) 20));
    }

    public static async int32 getPath(int32 port, String path, String want) {
        HttpClient client #= heap HttpClient();
        client.exchangeTimeout(15000);
        String url = "http://127.0.0.1:" + port + path;
        try {
            ClientResponse resp #= client.get(url);
            if (resp.status() != 200) { return -1; }
            String got #= resp.bodyString();
            if (!got.equals(want)) { return -2; }
            return 1;
        } catch (Exception e) {
            return -3;
        }
    }

    static #TcpStream connectRaw(int32 port) {
        IpAddress ip #= IpAddress.loopbackV4();
        SocketAddress a #= SocketAddress.of(#ip, port);
        return TcpStream.connectAsync(#a);
    }

    static void sendRaw(TcpStream s, String text) {
        int8[] b #= text.toBytes();
        s.writeAllAsync(b, (int64) 0, (int64) text.byteLength());
    }

    /** One bounded read: the count, 0 at EOF, -1 when `ms` elapsed first (readWithin throws on that). */
    static int64 readStep(TcpStream s, int8[] buf, int32 at, int32 ms) {
        try {
            return s.readWithin(buf, (int64) at, (int64) (buf.count() - at), ms);
        } catch (TimedOutException t) {
            return (int64) -1;
        }
    }

    /** Reads until `want` bytes arrived, EOF, or `ms` elapsed; returns the count. */
    static int32 readSome(TcpStream s, int8[] buf, int32 want, int32 ms) {
        int32 got = 0;
        int64 deadline = DispatchTests.nowMs() + (int64) ms;
        boolean open = true;
        while (open && got < want && DispatchTests.nowMs() < deadline) {
            int64 n = DispatchTests.readStep(s, buf, got, 50);
            if (n == (int64) 0) {
                open = false;
            } else if (n > (int64) 0) {
                got = got + (int32) n;
            }
        }
        return got;
    }

    static boolean contains(int8[] buf, int32 len, String needle) {
        int8[] nb #= needle.toBytes();
        int32 nl = needle.byteLength();
        int32 i = 0;
        while (i + nl <= len) {
            int32 j = 0;
            while (j < nl && buf[i + j] == nb[j]) { j = j + 1; }
            if (j == nl) { return true; }
            i = i + 1;
        }
        return false;
    }

    static int32 countOf(int8[] buf, int32 len, String needle) {
        int8[] nb #= needle.toBytes();
        int32 nl = needle.byteLength();
        int32 hits = 0;
        int32 i = 0;
        while (i + nl <= len) {
            int32 j = 0;
            while (j < nl && buf[i + j] == nb[j]) { j = j + 1; }
            if (j == nl) { hits = hits + 1; i = i + nl; } else { i = i + 1; }
        }
        return hits;
    }

    // ----- cases ----------------------------------------------------------

    /** 3.1.11: `framers(k)` yields k framers; the default is the carrier count. */
    static void framerCount(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 3);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            c.eqInt((int64) srv.framerCount(), (int64) 3, "framers(3) runs three framers");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            c.eqInt((int64) srv.framerCount(), (int64) Carriers.count(), "the default framer count is the carrier count");
            c.eqInt((int64) srv.maxInFlight(), (int64) 256, "the default maxInFlight is 256");
            c.eqInt((int64) srv.maxPendingUnits(), (int64) 4, "the default maxPendingUnits is 4");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.1: a GET is answered, and the live fiber count after it equals the count before it. */
    static void getOnPoolFiber(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 2);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int32 before = DispatchTests.fiberCount();
            int32 r = await spawn getPath(port, "/", "ok");
            c.eqInt((int64) r, (int64) 1, "GET / answered ok");
            Fiber.sleep(Duration.ofMillis((int64) 30));
            c.eqInt((int64) DispatchTests.fiberCount(), (int64) before, "no fiber was spawned for the connection");
            c.that(srv.dispatches() >= (int64) 1, "the request was dispatched through the pool");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.5: 1,000 idle keep-alive connections add no fibers. */
    static void idleConnectionsHoldNoFibers(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 2);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int32 before = DispatchTests.fiberCount();
            TcpStream[] conns = heap TcpStream[1000];
            int32 i = 0;
            while (i < 1000) {
                conns[i] #= DispatchTests.connectRaw(port);
                i = i + 1;
            }
            Fiber.sleep(Duration.ofMillis((int64) 200));
            c.eqInt((int64) DispatchTests.fiberCount(), (int64) before, "1,000 idle connections spawned no fiber");
            c.that(srv.idleConnections() >= 900, "the server counts them as idle connections");
            // They still work: one of them sends a request.
            DispatchTests.sendRaw(conns[617], "GET / HTTP/1.1\r\nhost: t\r\n\r\n");
            int8[] buf = heap int8[512];
            int32 got = DispatchTests.readSome(conns[617], buf, 20, 3000);
            c.that(DispatchTests.contains(buf, got, "200 OK"), "an idle connection answers when it speaks");
            i = 0;
            while (i < 1000) {
                conns[i].close();
                i = i + 1;
            }
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.2: the handler runs after the last body byte, not after the head. */
    static void postDispatchesAfterBody(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            TcpStream s #= DispatchTests.connectRaw(port);
            int64 d0 = srv.dispatches();
            DispatchTests.sendRaw(s, "POST /echo HTTP/1.1\r\nhost: t\r\ncontent-length: 10\r\n\r\nhello");
            Fiber.sleep(Duration.ofMillis((int64) 150));
            c.eqInt(srv.dispatches(), d0, "half a body is not a unit: nothing dispatched");
            DispatchTests.sendRaw(s, "world");
            int8[] buf = heap int8[512];
            int32 got = DispatchTests.readSome(s, buf, 20, 3000);
            c.that(DispatchTests.contains(buf, got, "helloworld"), "the whole body reached the handler");
            c.eqInt(srv.dispatches(), d0 + (int64) 1, "one dispatch for the complete request");
            s.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.3: a chunked body dispatches after the terminator and arrives dechunked. */
    static void chunkedDispatchesAfterTerminator(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            TcpStream s #= DispatchTests.connectRaw(port);
            int64 d0 = srv.dispatches();
            DispatchTests.sendRaw(s, "POST /echo HTTP/1.1\r\nhost: t\r\ntransfer-encoding: chunked\r\n\r\n5\r\nhello\r\n");
            Fiber.sleep(Duration.ofMillis((int64) 150));
            c.eqInt(srv.dispatches(), d0, "an open chunked body is not a unit");
            DispatchTests.sendRaw(s, "5\r\nworld\r\n0\r\n\r\n");
            int8[] buf = heap int8[512];
            int32 got = DispatchTests.readSome(s, buf, 20, 3000);
            c.that(DispatchTests.contains(buf, got, "helloworld"), "the dechunked body reached the handler");
            s.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.4: 100 Continue under the cap and 413 over it, both before any dispatch. */
    static void expectContinueOnFramer(Check c) {
        scope {
            ServerLimits sl = heap ServerLimits();
            sl.maxBodyBytes = (int64) 64;
            sl.expectContinueEnabled = true;
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
            b.serverLimits(#sl);
            b.framers(1);
            HttpServer srv #= b.build();
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int64 d0 = srv.dispatches();

            TcpStream s #= DispatchTests.connectRaw(port);
            DispatchTests.sendRaw(s, "POST /echo HTTP/1.1\r\nhost: t\r\nexpect: 100-continue\r\ncontent-length: 5\r\n\r\n");
            int8[] buf = heap int8[512];
            int32 got = DispatchTests.readSome(s, buf, 25, 3000);
            c.that(DispatchTests.contains(buf, got, "100 Continue"), "100 Continue arrives before the body is sent");
            c.eqInt(srv.dispatches(), d0, "100 Continue cost no dispatch");
            DispatchTests.sendRaw(s, "hello");
            int8[] buf2 = heap int8[512];
            int32 got2 = DispatchTests.readSome(s, buf2, 20, 3000);
            c.that(DispatchTests.contains(buf2, got2, "hello"), "the body then reaches the handler");
            s.close();

            TcpStream big #= DispatchTests.connectRaw(port);
            DispatchTests.sendRaw(big, "POST /echo HTTP/1.1\r\nhost: t\r\nexpect: 100-continue\r\ncontent-length: 5000\r\n\r\n");
            int8[] buf3 = heap int8[512];
            int32 got3 = DispatchTests.readSome(big, buf3, 20, 3000);
            c.that(DispatchTests.contains(buf3, got3, " 413 "), "a declared body over the cap is 413 on the framer");
            c.eqInt(srv.dispatches(), d0 + (int64) 1, "the 413 cost no dispatch");
            big.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.6: three pipelined GETs in one write: one dispatch, three in-order responses. */
    static void pipelinedIsOneTurn(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            TcpStream s #= DispatchTests.connectRaw(port);
            int64 d0 = srv.dispatches();
            String one = "GET / HTTP/1.1\r\nhost: t\r\n\r\n";
            DispatchTests.sendRaw(s, one + one + one);
            int8[] buf = heap int8[2048];
            int32 got = 0;
            int64 deadline = DispatchTests.nowMs() + (int64) 3000;
            boolean open = true;
            while (open && DispatchTests.countOf(buf, got, "200 OK") < 3 && DispatchTests.nowMs() < deadline) {
                int64 n = DispatchTests.readStep(s, buf, got, 50);
                if (n > (int64) 0) { got = got + (int32) n; }
                if (n == (int64) 0) { open = false; }
            }
            c.eqInt((int64) DispatchTests.countOf(buf, got, "200 OK"), (int64) 3, "three responses");
            c.eqInt(srv.dispatches(), d0 + (int64) 1, "one dispatch drained all three");
            s.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.7: a head over the buffer is 431 and a stalled head is 408, neither dispatched. */
    static void headLimitsOnFramer(Check c) {
        scope {
            ServerLimits sl = heap ServerLimits();
            sl.headReadTimeoutMs = 300;
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
            b.serverLimits(#sl);
            b.framers(1);
            HttpServer srv #= b.build();
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int64 d0 = srv.dispatches();

            TcpStream stall #= DispatchTests.connectRaw(port);
            DispatchTests.sendRaw(stall, "GET / HTTP/1.1\r\nhost: t\r\n");
            int8[] buf = heap int8[512];
            int32 got = DispatchTests.readSome(stall, buf, 20, 3000);
            c.that(DispatchTests.contains(buf, got, " 408 "), "a stalled head is 408");
            stall.close();

            TcpStream big #= DispatchTests.connectRaw(port);
            DispatchTests.sendRaw(big, "GET / HTTP/1.1\r\nhost: t\r\n");
            int32 k = 0;
            boolean alive = true;
            while (k < 1200 && alive) {
                try {
                    DispatchTests.sendRaw(big, "x-fill: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\r\n");
                } catch (Exception e) {
                    alive = false;
                }
                k = k + 1;
            }
            int8[] buf2 = heap int8[512];
            int32 got2 = DispatchTests.readSome(big, buf2, 20, 3000);
            c.that(DispatchTests.contains(buf2, got2, " 431 "), "a head over the buffer is 431");
            big.close();
            c.eqInt(srv.dispatches(), d0, "neither refusal cost a dispatch");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.8: maxInFlight(2) serializes a third slow request; parked handlers do not block others. */
    static void maxInFlightBounds(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(2, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int64 t0 = DispatchTests.nowMs();
            Task<int32> a = spawn getPath(port, "/slow", "slow-done");
            Task<int32> b = spawn getPath(port, "/slow", "slow-done");
            Task<int32> d = spawn getPath(port, "/slow", "slow-done");
            int32 ra = await a;
            int32 rb = await b;
            int32 rd = await d;
            int64 took = DispatchTests.nowMs() - t0;
            c.that(ra == 1 && rb == 1 && rd == 1, "all three slow requests complete");
            c.that(took >= (int64) 190, "the third waited for a slot (about 200 ms total)");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
        scope {
            HttpServer srv #= DispatchTests.server(8, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            Task<int32> h1 = spawn getPath(port, "/hung", "hung-done");
            Task<int32> h2 = spawn getPath(port, "/hung", "hung-done");
            Task<int32> h3 = spawn getPath(port, "/hung", "hung-done");
            Task<int32> h4 = spawn getPath(port, "/hung", "hung-done");
            Fiber.sleep(Duration.ofMillis((int64) 50));
            int64 t0 = DispatchTests.nowMs();
            int32 fast = await spawn getPath(port, "/", "ok");
            int64 took = DispatchTests.nowMs() - t0;
            c.eqInt((int64) fast, (int64) 1, "a fast request completes while four are parked");
            c.that(took < (int64) 300, "and it did not wait for them");
            await h1; await h2; await h3; await h4;
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.9: at maxInFlight(1) a client past maxPendingUnits is paused, not refused; everything completes. */
    static void backPressurePauses(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(1, 2, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            Task<int32> holder = spawn getPath(port, "/hung", "hung-done");
            Fiber.sleep(Duration.ofMillis((int64) 50));
            TcpStream s #= DispatchTests.connectRaw(port);
            String one = "GET / HTTP/1.1\r\nhost: t\r\n\r\n";
            DispatchTests.sendRaw(s, one + one + one + one + one + one);
            Fiber.sleep(Duration.ofMillis((int64) 100));
            c.that(srv.pausedSockets() >= 1, "a client past maxPendingUnits is paused");
            int8[] buf = heap int8[4096];
            int32 got = 0;
            int64 deadline = DispatchTests.nowMs() + (int64) 5000;
            boolean open = true;
            while (open && DispatchTests.countOf(buf, got, "200 OK") < 6 && DispatchTests.nowMs() < deadline) {
                int64 n = DispatchTests.readStep(s, buf, got, 50);
                if (n > (int64) 0) { got = got + (int32) n; }
                if (n == (int64) 0) { open = false; }
            }
            c.eqInt((int64) DispatchTests.countOf(buf, got, "200 OK"), (int64) 6, "all six complete, none refused");
            int32 rh = await holder;
            c.eqInt((int64) rh, (int64) 1, "the holder completed too");
            s.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.10: one client dribbling its head does not delay another on the same framer. */
    static void dribbleDelaysNobody(Check c) {
        scope {
            HttpServer srv #= DispatchTests.server(0, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            TcpStream drib #= DispatchTests.connectRaw(port);
            DispatchTests.sendRaw(drib, "GET / HTTP/1.1\r\nhos");
            int64 t0 = DispatchTests.nowMs();
            int32 r = await spawn getPath(port, "/", "ok");
            int64 took = DispatchTests.nowMs() - t0;
            c.eqInt((int64) r, (int64) 1, "the other client is answered");
            c.that(took < (int64) 500, "and not held behind the dribbler");
            DispatchTests.sendRaw(drib, "t: t\r\n\r\n");
            int8[] buf = heap int8[512];
            int32 got = DispatchTests.readSome(drib, buf, 20, 3000);
            c.that(DispatchTests.contains(buf, got, "200 OK"), "the dribbler is answered once its head completes");
            drib.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 3.1.12: a handler that calls a second server over the http client parks and returns; in-flight counted it meanwhile. */
    static void handlerCallsAnotherServer(Check c) {
        scope {
            HttpServer up #= DispatchTests.server(0, 0, 1);
            Task<int32> upTask = spawn serveIt(up);
            DispatchTests.settle(up);
            DispatchTests.upstreamPort = up.server.listener.boundPort();
            HttpServer srv #= DispatchTests.server(0, 0, 1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int32 r = await spawn getPath(port, "/proxy", "via:ok");
            c.eqInt((int64) r, (int64) 1, "the proxied body came back through both servers");
            c.that(srv.dispatches() >= (int64) 1 && up.dispatches() >= (int64) 1, "both servers dispatched through their pools");
            c.eqInt((int64) srv.inFlight(), (int64) 0, "nothing in flight once the handler returned");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
            up.shutdown(Duration.ofSeconds(2));
            await upTask;
        }
    }

    /** 9.1.1 (spec 6.1): a builder with no model call reports the pool, 256, 4 and one framer per carrier. */
    static void defaultsAreThePool(Check c) {
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
            HttpServer srv #= b.build();
            c.eqInt((int64) srv.dispatchMode, (int64) HttpServer.DISPATCH_POOL, "the pool");
            c.eqInt((int64) srv.maxInFlight(), (int64) 256, "maxInFlight 256");
            c.eqInt((int64) srv.maxPendingUnits(), (int64) 4, "maxPendingUnits 4");
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            c.eqInt((int64) srv.framerCount(), (int64) Carriers.count(), "Carriers.count() framers");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 9.1.2 (spec 6.2): `model(ServerModel.sharedPool(8))` is refused at build; the message names maxInFlight. */
    static void sharedPoolRefused(Check c) {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
        b.model(ServerModel.sharedPool(8));
        boolean refused = false;
        String msg = "";
        try {
            HttpServer srv #= b.build();
        } catch (Exception e) {
            refused = true;
            msg = "" + e.message;
        }
        c.that(refused, "build() refuses the shared-pool model");
        c.that(msg.contains("maxInFlight"), "and names maxInFlight (" + msg + ")");
    }

    /** 3.3.2: `fiberPerConnection()` runs the connection loop: no framers, requests still answered. */
    static void fiberPerConnectionExplicit(Check c) {
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
            b.fiberPerConnection();
            HttpServer srv #= b.build();
            Task<int32> sv = spawn serveIt(srv);
            Fiber.sleep(Duration.ofMillis((int64) 30));
            int32 port = srv.server.listener.boundPort();
            int32 r = await spawn getPath(port, "/", "ok");
            c.eqInt((int64) r, (int64) 1, "GET / answered ok under fiber per connection");
            c.eqInt((int64) srv.framerCount(), (int64) 0, "no framers run under fiber per connection");
            c.eqInt(srv.dispatches(), (int64) 0, "and nothing went through a pool");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    // ----- TLS under the pool (Unit 4) ------------------------------------

    static #HttpServer tlsServer(int32 framers) {
        String cp #= ClientBuilderTests.certPem();
        String kp #= ClientBuilderTests.keyPem();
        int8[] cert #= cp.toBytes();
        int8[] key #= kp.toBytes();
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
        b.tls(cert, cp.byteLength(), key, kp.byteLength());
        if (framers > 0) { b.framers(framers); }
        return b.build();
    }

    static int32 tlsPort(HttpServer srv) {
        return srv.tlsListener.boundPort();
    }

    public static async int32 httpsGet(int32 port, String path, String want) {
        String cp #= ClientBuilderTests.certPem();
        int8[] anchor #= cp.toBytes();
        HttpClient client #= HttpClient.builder().trustAnchor(anchor, cp.byteLength()).build();
        client.exchangeTimeout(15000);
        try {
            ClientResponse resp #= client.get("https://127.0.0.1:" + port + path);
            if (resp.status() != 200) { return -1; }
            String got #= resp.bodyString();
            if (!got.equals(want)) { return -2; }
            return 1;
        } catch (Exception e) {
            return -3;
        }
    }

    /** 4.1.1: 1,000 TLS connections that never handshake add no fibers. */
    static void tlsIdleConnectionsHoldNoFibers(Check c) {
        scope {
            HttpServer srv #= DispatchTests.tlsServer(2);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = DispatchTests.tlsPort(srv);
            int32 before = DispatchTests.fiberCount();
            TcpStream[] conns = heap TcpStream[1000];
            int32 i = 0;
            int32 failedAt = -1;
            String failure = "";
            while (i < 1000 && failedAt < 0) {
                try {
                    conns[i] #= DispatchTests.connectRaw(port);
                } catch (Exception e) {
                    failedAt = i;
                    failure #= "" + e.message;
                }
                i = i + 1;
            }
            c.that(failedAt < 0, "all 1,000 TLS connects succeed (failed at " + failedAt + ": " + failure + ")");
            int32 opened = failedAt < 0 ? 1000 : failedAt;
            Fiber.sleep(Duration.ofMillis((int64) 200));
            c.eqInt((int64) DispatchTests.fiberCount(), (int64) before, "1,000 idle TLS connections spawned no fiber");
            // One of them still works: a real https exchange beside them.
            int32 r = await spawn httpsGet(port, "/", "ok");
            c.eqInt((int64) r, (int64) 1, "an https GET beside the idle thousand is answered");
            i = 0;
            while (i < opened) {
                conns[i].close();
                i = i + 1;
            }
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** HTTP/1.1 over TLS with no ALPN offer, so the server speaks h1 and the pool serves it. */
    public static async int32 h1sGet(int32 port, String path, String want) {
        String cp #= ClientBuilderTests.certPem();
        IpAddress ip #= IpAddress.loopbackV4();
        SocketAddress a #= SocketAddress.of(#ip, port);
        TcpStream sock #= TcpStream.connectAsync(#a);
        String host = "127.0.0.1";
        int8[] hostBytes #= host.toBytes();
        int8[] anchor #= cp.toBytes();
        TlsStream tls #= TlsStream.client(#sock, hostBytes, host.byteLength(), anchor, cp.byteLength());
        try {
            tls.handshake();
            String req = "GET " + path + " HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n";
            int8[] rb #= req.toBytes();
            tls.writeAllAsync(rb, (int64) 0, (int64) req.byteLength());
            int8[] buf = heap int8[4096];
            int32 have = 0;
            boolean open = true;
            while (open && have < 4096) {
                int64 n = tls.readAsync(buf, (int64) have, (int64) (4096 - have));
                if (n <= (int64) 0) { open = false; } else { have = have + (int32) n; }
            }
            tls.close();
            if (!DispatchTests.contains(buf, have, "HTTP/1.1 200")) { return -1; }
            if (!DispatchTests.contains(buf, have, want)) { return -2; }
            return 1;
        } catch (Exception e) {
            return -3;
        }
    }

    /** 4.1.2: an HTTP/1.1 GET over TLS is answered on a pool fiber; the handshake ran on the framer. An ALPN-h2 client goes to the h2 loop until Unit 5. */
    static void tlsGetOnPoolFiber(Check c) {
        scope {
            HttpServer srv #= DispatchTests.tlsServer(1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = DispatchTests.tlsPort(srv);
            int32 before = DispatchTests.fiberCount();
            int32 r = await spawn h1sGet(port, "/", "ok");
            c.eqInt((int64) r, (int64) 1, "GET / over TLS answered ok");
            Fiber.sleep(Duration.ofMillis((int64) 30));
            c.eqInt((int64) DispatchTests.fiberCount(), (int64) before, "no fiber was spawned for the TLS connection");
            c.that(srv.dispatches() >= (int64) 1, "the request went through the pool");
            int64 d1 = srv.dispatches();
            int32 r2 = await spawn httpsGet(port, "/", "ok");
            c.eqInt((int64) r2, (int64) 1, "an ALPN-h2 client is answered");
            c.that(srv.dispatches() > d1, "and its stream went through the pool (5.1.7 over TLS)");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 9.1.3: a TLS server honors fiberPerConnection() and framers(k) like a plaintext one. */
    static void tlsBuilderSettingsApply(Check c) {
        scope {
            String cp #= ClientBuilderTests.certPem();
            String kp #= ClientBuilderTests.keyPem();
            int8[] cert #= cp.toBytes();
            int8[] key #= kp.toBytes();
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
            b.tls(cert, cp.byteLength(), key, kp.byteLength());
            b.fiberPerConnection();
            HttpServer old #= b.build();
            c.eqInt((int64) old.dispatchMode, (int64) HttpServer.DISPATCH_FIBER, "a TLS server built with fiberPerConnection() is the fiber model");
            HttpServer srv #= DispatchTests.tlsServer(1);
            c.eqInt((int64) srv.maxInFlightN, (int64) 256, "the pool defaults reach a TLS server");
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            c.eqInt((int64) srv.framerCount(), (int64) 1, "framers(1) gives a TLS server one framer");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 4.1.3: a client that connects and never handshakes delays nobody on its framer. */
    static void tlsStallDelaysNobody(Check c) {
        scope {
            HttpServer srv #= DispatchTests.tlsServer(1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = DispatchTests.tlsPort(srv);
            TcpStream stall #= DispatchTests.connectRaw(port);
            int8[] hello = heap int8[3];   // the first bytes of a ClientHello, then silence
            hello[0] = (int8) 22;
            hello[1] = (int8) 3;
            hello[2] = (int8) 1;
            stall.writeAllAsync(hello, (int64) 0, (int64) 3);
            int64 t0 = DispatchTests.nowMs();
            int32 r = await spawn httpsGet(port, "/", "ok");
            int64 took = DispatchTests.nowMs() - t0;
            c.eqInt((int64) r, (int64) 1, "the other client is answered");
            c.that(took < (int64) 1000, "and not held behind the stalled handshake");
            stall.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    // ----- h2 through the pool (Unit 5) ------------------------------------

    static #HttpServer h2Server(boolean serialized, int32 maxInFlight) {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> DispatchTests.handle(q, r));
        b.h2PriorKnowledge();
        b.framers(1);
        if (maxInFlight > 0) { b.maxInFlight(maxInFlight); }
        b.serializedStreams(serialized);
        return b.build();
    }

    static #String own(String s) {
        return s.substring(0, s.byteLength());
    }

    static void encodeRequest(HpackEncoder enc, Http2FrameWriter fw, int32 sid, String path, boolean endStream) {
        HpackFieldList fl = heap HpackFieldList();
        fl.put(DispatchTests.own(":method"), DispatchTests.own(endStream ? "GET" : "POST"));
        fl.put(DispatchTests.own(":path"), DispatchTests.own(path));
        fl.put(DispatchTests.own(":scheme"), DispatchTests.own("http"));
        fl.put(DispatchTests.own(":authority"), DispatchTests.own("127.0.0.1"));
        int8[] block #= enc.encode(fl);
        Http2ContentFrames.writeHeaders(fw, sid, block, (int32) block.count(), endStream, true, 0);
    }

    static boolean readExactWithin(AsyncReader r, int8[] buf, int32 n, int32 timeoutMs) {
        int32 off = 0;
        while (off < n) {
            int32 g = 0;
            try {
                g = r.readWithin(buf, off, n - off, timeoutMs);
            } catch (Exception e) {
                return false;
            }
            if (g <= 0) { return false; }
            off = off + g;
        }
        return true;
    }

    /**
     * Opens an h2 connection, sends the preface and settings, then one
     * HEADERS per path (closed when `close[i]`), and reads frames until
     * `wantDone` streams have ended or `ms` elapsed. Returns the stream id
     * that ended first, 0 when none did; `order` receives the end order.
     */
    static int32 h2Exchange(int32 port, String[] paths, boolean[] close, int32 n, int32 wantDone, int32 ms,
                            int32[] order) {
        IpAddress ca #= IpAddress.loopbackV4();
        SocketAddress connAddr #= SocketAddress.of(#ca, port);
        TcpStream sock #= TcpStream.connectAsync(#connAddr);
        AsyncReader reader = heap AsyncReader(sock);
        AsyncWriter writer = heap AsyncWriter(sock);
        int8[] pf #= Http2.preface();
        writer.writeAll(pf, 0, 24);
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2SettingsList empty = heap Http2SettingsList();
        Http2Frames.writeSettings(fw, empty);
        HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
        int32 i = 0;
        while (i < n) {
            DispatchTests.encodeRequest(enc, fw, 1 + 2 * i, paths[i], close[i]);
            i = i + 1;
        }
        int8[] out #= fw.toBytes();
        writer.writeAll(out, 0, (int32) out.count());
        writer.flush();
        int32 done = 0;
        int32 first = 0;
        int64 deadline = DispatchTests.nowMs() + (int64) ms;
        boolean open = true;
        while (open && done < wantDone && DispatchTests.nowMs() < deadline) {
            int8[] hdr = heap int8[9];
            if (!DispatchTests.readExactWithin(reader, hdr, 9, 500)) {
                if (DispatchTests.nowMs() >= deadline) { open = false; }
            } else {
                Http2FrameHeader h #= Http2FrameHeader(hdr);
                int32 type = h.typeCode();
                int32 flags = h.flags();
                int32 sid = h.streamId();
                int32 len = h.length();
                int8[] pl = heap int8[len > 0 ? len : 1];
                if (len > 0 && !DispatchTests.readExactWithin(reader, pl, len, 2000)) {
                    open = false;
                } else {
                    if (type == Http2.FRAME_SETTINGS && (flags & Http2.FLAG_ACK) == 0) {
                        Http2FrameWriter afw = heap Http2FrameWriter();
                        Http2Frames.writeSettingsAck(afw);
                        int8[] ab #= afw.toBytes();
                        writer.writeAll(ab, 0, (int32) ab.count());
                        writer.flush();
                    } else if (type == Http2.FRAME_GOAWAY) {
                        open = false;
                    } else if ((type == Http2.FRAME_HEADERS || type == Http2.FRAME_DATA)
                               && (flags & Http2.FLAG_END_STREAM) != 0) {
                        if (first == 0) { first = sid; }
                        if (done < order.count()) { order[done] = sid; }
                        done = done + 1;
                    }
                }
            }
        }
        sock.close();
        return first;
    }

    /** 5.1.2: /slow on stream 1 and / on stream 3 complete out of order, both through the pool. */
    static void h2StreamsParallel(Check c) {
        scope {
            HttpServer srv #= DispatchTests.h2Server(false, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int64 d0 = srv.dispatches();
            String[] paths = heap String[2];
            paths[0] = "/slow";
            paths[1] = "/";
            boolean[] close = heap boolean[2];
            close[0] = true;
            close[1] = true;
            int32[] order = heap int32[2];
            int32 first = DispatchTests.h2Exchange(port, paths, close, 2, 2, 5000, order);
            c.eqInt((int64) first, (int64) 3, "the fast stream finishes first: streams ran in parallel");
            c.eqInt(srv.dispatches() - d0, (int64) 2, "two stream units went through the pool");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 5.1.2 (4.4.2): under serializedStreams the slow stream finishes first. */
    static void h2StreamsSerialized(Check c) {
        scope {
            HttpServer srv #= DispatchTests.h2Server(true, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            String[] paths = heap String[2];
            paths[0] = "/slow";
            paths[1] = "/";
            boolean[] close = heap boolean[2];
            close[0] = true;
            close[1] = true;
            int32[] order = heap int32[2];
            int32 first = DispatchTests.h2Exchange(port, paths, close, 2, 2, 5000, order);
            c.eqInt((int64) first, (int64) 1, "serialized: stream 1 finishes before stream 3 starts");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 5.1.1: fifty streams opened, ten complete: ten dispatches, forty held, no fiber per stream. */
    static void h2HeldStreams(Check c) {
        scope {
            HttpServer srv #= DispatchTests.h2Server(false, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int32 before = DispatchTests.fiberCount();
            int64 d0 = srv.dispatches();
            String[] paths = heap String[50];
            boolean[] close = heap boolean[50];
            int32 i = 0;
            while (i < 50) {
                paths[i] = i < 10 ? "/" : "/echo";
                close[i] = i < 10;          // the first ten carry END_STREAM; the rest await a body
                i = i + 1;
            }
            int32[] order = heap int32[10];
            int32 first = DispatchTests.h2Exchange(port, paths, close, 50, 10, 5000, order);
            c.that(first > 0, "the completed streams were answered");
            c.eqInt(srv.dispatches() - d0, (int64) 10, "ten units dispatched, forty held");
            c.eqInt((int64) DispatchTests.fiberCount(), (int64) before, "no fiber per stream or per connection");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /**
     * 10.3.3 (spec 8.3): the pool's per-stream cost on one prior-knowledge
     * connection, as the connection loop's scripted figure is measured:
     * allocation over 20 and over 100 completed streams, the difference per
     * stream. In-process, so the raw client's own frame building is included;
     * the server's figure is at most this.
     */
    static int64 h2Streams(int32 port, int32 n) {
        String[] paths = heap String[n];
        boolean[] close = heap boolean[n];
        int32 i = 0;
        while (i < n) {
            paths[i] = "/";
            close[i] = true;
            i = i + 1;
        }
        int32[] order = heap int32[n];
        int64 before = Cajeta.allocatedBytes();
        int32 first = DispatchTests.h2Exchange(port, paths, close, n, n, 10000, order);
        int64 used = Cajeta.allocatedBytes() - before;
        return first > 0 ? used : (int64) -1;
    }

    static void h2BytesPerStream(Check c) {
        scope {
            HttpServer srv #= DispatchTests.h2Server(false, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            DispatchTests.h2Streams(port, 20);
            int64 small = DispatchTests.h2Streams(port, 20);
            int64 large = DispatchTests.h2Streams(port, 100);
            c.that(small >= (int64) 0 && large >= (int64) 0, "every stream on the connection is answered");
            int64 per = (large - small) / (int64) 80;
            System.stdout.println("    pool h2: {} bytes per stream after warm-up, client included ({} for 20, {} for 100)", per, small, large);
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /**
     * 5.1.2: a peer that resets the connection while a stream is on a worker.
     * The framer's read fails and closes the connection; the drop must wait
     * for the stream's return, or the return finds a freed connection.
     */
    static void h2ResetWhileStreamInFlight(Check c) {
        scope {
            HttpServer srv #= DispatchTests.h2Server(false, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = srv.server.listener.boundPort();
            int64 d0 = srv.dispatches();
            scope {
                IpAddress ca #= IpAddress.loopbackV4();
                SocketAddress connAddr #= SocketAddress.of(#ca, port);
                TcpStream sock #= TcpStream.connectAsync(#connAddr);
                AsyncWriter writer = heap AsyncWriter(sock);
                int8[] pf #= Http2.preface();
                writer.writeAll(pf, 0, 24);
                Http2FrameWriter fw = heap Http2FrameWriter();
                Http2SettingsList empty = heap Http2SettingsList();
                Http2Frames.writeSettings(fw, empty);
                HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
                DispatchTests.encodeRequest(enc, fw, 1, "/slow", true);
                int8[] out #= fw.toBytes();
                writer.writeAll(out, 0, (int32) out.count());
                writer.flush();
                // The stream is on a worker for 100 ms; the server's SETTINGS
                // sits unread here, so closing now sends a reset, not a FIN.
                Fiber.sleep(Duration.ofMillis((int64) 50));
                sock.close();
            }
            // The worker's 100 ms pass returns to the framer, which then drops
            // the connection; poll rather than sleep a fixed time, so a late
            // drop and a lost one read differently.
            int32 waited = 0;
            while (waited < 3000 && srv.server.inflightCount() != 0) {
                Fiber.sleep(Duration.ofMillis((int64) 20));
                waited = waited + 20;
            }
            c.eqInt(srv.dispatches() - d0, (int64) 1, "the stream was dispatched before the reset");
            c.eqInt((int64) srv.server.inflightCount(), (int64) 0, "the connection was counted gone exactly once (" + waited + " ms)");
            String[] paths = heap String[1];
            paths[0] = "/";
            boolean[] close = heap boolean[1];
            close[0] = true;
            int32[] order = heap int32[1];
            int32 first = DispatchTests.h2Exchange(port, paths, close, 1, 1, 2000, order);
            c.eqInt((int64) first, (int64) 1, "a fresh connection is answered afterwards");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /**
     * 5.1.2: an ALPN-h2 client over TLS whose bytes stop being TLS while a
     * stream is on a worker. The framer's TLS read raises, the connection
     * closes, and the drop must still wait for the stream's return. This is
     * the shape that crashed 4.1.3 intermittently: a TLS read error and the
     * worker's return woke the framer together, and the return found a
     * released connection.
     */
    static void h2TlsReadErrorWhileStreamInFlight(Check c) {
        scope {
            HttpServer srv #= DispatchTests.tlsServer(1);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = DispatchTests.tlsPort(srv);
            int64 d0 = srv.dispatches();
            int32 n0 = srv.tlsConnections();
            scope {
                String cp #= ClientBuilderTests.certPem();
                IpAddress ip #= IpAddress.loopbackV4();
                SocketAddress a #= SocketAddress.of(#ip, port);
                TcpStream sock #= TcpStream.connectAsync(#a);
                String host = "127.0.0.1";
                int8[] hostBytes #= host.toBytes();
                int8[] anchor #= cp.toBytes();
                TlsStream tls #= TlsStream.client(#sock, hostBytes, host.byteLength(), anchor, cp.byteLength());
                int8[] alpn = heap int8[3];
                alpn[0] = (int8) 2;
                alpn[1] = (int8) 104;   // h
                alpn[2] = (int8) 50;    // 2
                tls.offerAlpn(alpn, 3);
                tls.handshake();
                int8[] pf #= Http2.preface();
                tls.write(pf, 24);
                Http2FrameWriter fw = heap Http2FrameWriter();
                Http2SettingsList empty = heap Http2SettingsList();
                Http2Frames.writeSettings(fw, empty);
                HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
                DispatchTests.encodeRequest(enc, fw, 1, "/slow", true);
                int8[] out #= fw.toBytes();
                tls.write(out, (int32) out.count());
                // The stream is on a worker for 100 ms. Eight raw bytes on the
                // socket (the eventfd signal is a plain write) are not a TLS
                // record: the framer's next read raises and closes the
                // connection while the stream is still out.
                Fiber.sleep(Duration.ofMillis((int64) 50));
                Cajeta.eventfdSignal(tls.fd());
                Fiber.sleep(Duration.ofMillis((int64) 20));
            }
            Fiber.sleep(Duration.ofMillis((int64) 400));
            c.eqInt(srv.dispatches() - d0, (int64) 1, "the stream was dispatched before the read error");
            c.eqInt((int64) (srv.tlsConnections() - n0), (int64) 0, "the connection was counted gone exactly once");
            int32 r = await spawn httpsGet(port, "/", "ok");
            c.eqInt((int64) r, (int64) 1, "a fresh https client is answered afterwards");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }
}
