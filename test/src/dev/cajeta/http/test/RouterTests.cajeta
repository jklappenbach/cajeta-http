package dev.cajeta.http.test;

import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.routing.Router;

/**
 * http:1.7 — Router completeness suite. Pure dispatch over the message
 * model (no socket, no native), driving the router with hand-built
 * requests and asserting status / bound params — the same golden-vector
 * style ServerTests uses for the minimal router.
 *
 *   - 1.7a typed path params (`{id:int64}`): match/404 matrix per type,
 *     typed getter round-trip, string params unchanged.
 *   - 1.7b wildcards (`{p:*}` one segment, `{p:**}` rest of path):
 *     precedence literal > param > `*` > `**`, `**` binding incl. empty
 *     rest, and registration-time rejection of bad patterns.
 *   - 1.7c `mount(prefix, sub)`: nested dispatch with prefix params,
 *     mount-shadowing, and 405/Allow aggregated across the merged tree.
 *   - 1.7d per-route 413 thresholds: a route may carry a body cap tighter
 *     than the global; over-cap requests 413 at dispatch before the
 *     handler; unset inherits (no per-route restriction).
 */
public final class RouterTests {

    public static void run(Check c) {
        System.stdout.println("-- router: typed params (1.7a) --");
        typedParams(c);
        System.stdout.println("-- router: wildcards (1.7b) --");
        wildcards(c);
        System.stdout.println("-- router: mount (1.7c) --");
        mounts(c);
        System.stdout.println("-- router: per-route 413 (1.7d) --");
        perRouteLimits(c);
    }

    // Dispatch (method, target) with an `n`-byte body, returning the status.
    static int32 statusBody(Router r, String method, String target, int32 n) {
        int8[] buf = heap int8[n];
        HttpResponse resp #= r.dispatch(HttpRequest.of(method, target).body(buf, n));
        return resp.statusCode();
    }

    // Small helper: dispatch (method, target) and return the status code.
    static int32 status(Router r, String method, String target) {
        HttpResponse resp #= r.dispatch(HttpRequest.of(method, target));
        return resp.statusCode();
    }

    // A 200 response whose body is `s` — a marker the tests read back to see
    // which route won.
    static #HttpResponse text(String s) {
        return HttpResponse.ok().body(s.toBytes(), s.byteLength());
    }

    // Dispatch (method, target) and return the response body as a String.
    static #String body(Router r, String method, String target) {
        HttpResponse resp #= r.dispatch(HttpRequest.of(method, target));
        int32 len = resp.bodyLength();
        int8[] b = resp.body;
        int8[] copy = heap int8[len];
        int32 i = 0;
        while (i < len) {
            copy[i] = b[i];
            i = i + 1;
        }
        return heap String(#copy, len);
    }

    static void typedParams(Check c) {
        // A handler that echoes the typed int64 param as the body, so a
        // getter round-trip is observable end to end.
        (HttpRequest) -> #HttpResponse i64Echo = (req) -> {
            int64 v = req.pathParamInt64("v", (int64) -999);
            String b = "" + v;
            return HttpResponse.ok().body(b.toBytes(), b.byteLength());
        };
        (HttpRequest) -> #HttpResponse i32Echo = (req) -> {
            int32 v = req.pathParamInt32("v", (int32) -999);
            String b = "" + v;
            return HttpResponse.ok().body(b.toBytes(), b.byteLength());
        };
        (HttpRequest) -> #HttpResponse boolEcho = (req) -> {
            boolean v = req.pathParamBool("v", false);
            return HttpResponse.of(v ? 222 : 223);
        };
        (HttpRequest) -> #HttpResponse strEcho = (req) -> {
            String v #= req.pathParam("v");
            if (v == null) {
                return HttpResponse.of(500);
            }
            return HttpResponse.ok().body(v.toBytes(), v.byteLength());
        };

        Router r = heap Router();
        r.route("GET", "/i64/{v:int64}", i64Echo);
        r.route("GET", "/i32/{v:int32}", i32Echo);
        r.route("GET", "/u32/{v:uint32}", i64Echo);
        r.route("GET", "/i8/{v:int8}", i64Echo);
        r.route("GET", "/b/{v:bool}", boolEcho);
        r.route("GET", "/s/{v}", strEcho);
        r.route("GET", "/s2/{v:string}", strEcho);

        // -- int64: match, round-trip, 404 matrix ---------------------------
        HttpResponse hit #= r.dispatch(HttpRequest.of("GET", "/i64/42"));
        c.eqInt((int64) hit.statusCode(), 200, "int64 matches");
        c.eqBytes(hit.body, hit.bodyLength(), "42", "int64 getter round-trip");

        HttpResponse neg #= r.dispatch(HttpRequest.of("GET", "/i64/-7"));
        c.eqInt((int64) neg.statusCode(), 200, "int64 negative matches");
        c.eqBytes(neg.body, neg.bodyLength(), "-7", "int64 negative round-trip");

        HttpResponse zero #= r.dispatch(HttpRequest.of("GET", "/i64/0"));
        c.eqInt((int64) zero.statusCode(), 200, "int64 zero matches");
        c.eqBytes(zero.body, zero.bodyLength(), "0", "int64 zero round-trip");

        HttpResponse maxV #= r.dispatch(HttpRequest.of("GET", "/i64/9223372036854775807"));
        c.eqInt((int64) maxV.statusCode(), 200, "int64 max matches");

        c.eqInt((int64) RouterTests.status(r, "GET", "/i64/abc"), 404,
                "int64 non-numeric is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i64/007"), 404,
                "int64 leading zero is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i64/-0"), 404,
                "int64 negative zero is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i64/12x"), 404,
                "int64 trailing garbage is 404");
        c.eqInt((int64) RouterTests.status(r, "GET",
                "/i64/9223372036854775808"), 404,
                "int64 overflow (max+1) is 404");
        c.eqInt((int64) RouterTests.status(r, "GET",
                "/i64/99999999999999999999"), 404,
                "int64 overflow (20 digits) is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i64/"), 404,
                "int64 empty segment is 404 (no route)");

        // -- int32: width-specific overflow ---------------------------------
        c.eqInt((int64) RouterTests.status(r, "GET", "/i32/2147483647"), 200,
                "int32 max matches");
        HttpResponse i32neg #= r.dispatch(HttpRequest.of("GET", "/i32/-2147483648"));
        c.eqInt((int64) i32neg.statusCode(), 200, "int32 min matches");
        c.eqBytes(i32neg.body, i32neg.bodyLength(), "-2147483648",
                  "int32 min round-trip");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i32/2147483648"), 404,
                "int32 overflow (max+1) is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i32/-2147483649"), 404,
                "int32 underflow (min-1) is 404");

        // -- int8 -----------------------------------------------------------
        c.eqInt((int64) RouterTests.status(r, "GET", "/i8/127"), 200,
                "int8 max matches");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i8/-128"), 200,
                "int8 min matches");
        c.eqInt((int64) RouterTests.status(r, "GET", "/i8/128"), 404,
                "int8 overflow is 404");

        // -- uint32: no negatives, own bound --------------------------------
        c.eqInt((int64) RouterTests.status(r, "GET", "/u32/0"), 200,
                "uint32 zero matches");
        c.eqInt((int64) RouterTests.status(r, "GET", "/u32/4294967295"), 200,
                "uint32 max matches");
        c.eqInt((int64) RouterTests.status(r, "GET", "/u32/-1"), 404,
                "uint32 negative is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/u32/4294967296"), 404,
                "uint32 overflow is 404");

        // -- bool -----------------------------------------------------------
        c.eqInt((int64) RouterTests.status(r, "GET", "/b/true"), 222,
                "bool true matches, getter true");
        c.eqInt((int64) RouterTests.status(r, "GET", "/b/false"), 223,
                "bool false matches, getter false");
        c.eqInt((int64) RouterTests.status(r, "GET", "/b/1"), 404,
                "bool non-literal is 404");
        c.eqInt((int64) RouterTests.status(r, "GET", "/b/True"), 404,
                "bool is case-sensitive (404)");

        // -- string params unchanged ----------------------------------------
        HttpResponse s1 #= r.dispatch(HttpRequest.of("GET", "/s/hello"));
        c.eqInt((int64) s1.statusCode(), 200, "string param matches");
        c.eqBytes(s1.body, s1.bodyLength(), "hello", "string param bound");

        HttpResponse s2 #= r.dispatch(HttpRequest.of("GET", "/s/a%2Fb"));
        c.eqInt((int64) s2.statusCode(), 200, "string param percent-decoded match");
        c.eqBytes(s2.body, s2.bodyLength(), "a/b", "string param percent-decoded");

        // A digit path still matches a string param (types don't leak).
        HttpResponse s3 #= r.dispatch(HttpRequest.of("GET", "/s/42"));
        c.eqInt((int64) s3.statusCode(), 200, "string param accepts digits");
        c.eqBytes(s3.body, s3.bodyLength(), "42", "string param digit body");

        // Explicit {v:string} behaves exactly like {v}.
        HttpResponse s4 #= r.dispatch(HttpRequest.of("GET", "/s2/world"));
        c.eqInt((int64) s4.statusCode(), 200, "explicit string type matches");
        c.eqBytes(s4.body, s4.bodyLength(), "world", "explicit string type bound");

        // -- 404 vs 405: a type mismatch is 404, never 405 ------------------
        // POST /i64/42 : path matches, method differs -> 405 + Allow: GET.
        HttpResponse m405 #= r.dispatch(HttpRequest.of("POST", "/i64/42"));
        c.eqInt((int64) m405.statusCode(), 405, "typed path, wrong method is 405");
        String allow #= m405.getHeaders().get("Allow");
        c.that(allow != null && allow.equals("GET"), "typed 405 carries Allow: GET");

        // POST /i64/abc : path does NOT match (type mismatch) -> 404, not 405.
        c.eqInt((int64) RouterTests.status(r, "POST", "/i64/abc"), 404,
                "typed mismatch is 404 even for a registered path prefix");
    }

    static void wildcards(Check c) {
        (HttpRequest) -> #HttpResponse lit = (req) -> RouterTests.text("LIT");
        (HttpRequest) -> #HttpResponse par = (req) -> {
            String v #= req.pathParam("id");
            return RouterTests.text("PARAM:" + v);
        };
        (HttpRequest) -> #HttpResponse star = (req) -> {
            String v #= req.pathParam("w");
            return RouterTests.text("STAR:" + v);
        };
        (HttpRequest) -> #HttpResponse dstar = (req) -> {
            String v #= req.pathParam("rest");
            return RouterTests.text("REST:" + v);
        };

        // -- precedence: literal > param (registration order is irrelevant) --
        Router ra = heap Router();
        ra.route("GET", "/a/{id}", par);        // registered FIRST
        ra.route("GET", "/a/x", lit);           // more specific, registered LAST
        c.eqStr(RouterTests.body(ra, "GET", "/a/x"), "LIT",
                "literal beats param regardless of registration order");
        c.eqStr(RouterTests.body(ra, "GET", "/a/y"), "PARAM:y",
                "param matches a non-literal segment");

        // -- precedence: param > single wildcard -----------------------------
        Router rb = heap Router();
        rb.route("GET", "/b/{w:*}", star);      // registered FIRST
        rb.route("GET", "/b/{id}", par);
        c.eqStr(RouterTests.body(rb, "GET", "/b/z"), "PARAM:z",
                "param beats single wildcard");

        // -- precedence: single wildcard > double wildcard; * is one segment -
        Router rc = heap Router();
        rc.route("GET", "/c/{rest:**}", dstar);
        rc.route("GET", "/c/{w:*}", star);
        c.eqStr(RouterTests.body(rc, "GET", "/c/z"), "STAR:z",
                "single wildcard beats ** for one segment");
        c.eqStr(RouterTests.body(rc, "GET", "/c/z/y"), "REST:z/y",
                "** matches multiple segments where * cannot");

        // -- literal beats **, and ** binds the rest with '/' preserved ------
        Router rd = heap Router();
        rd.route("GET", "/d/{rest:**}", dstar);
        rd.route("GET", "/d/config", lit);
        c.eqStr(RouterTests.body(rd, "GET", "/d/config"), "LIT",
                "literal beats ** catch-all");
        c.eqStr(RouterTests.body(rd, "GET", "/d/other"), "REST:other",
                "** catches a single non-literal segment");
        c.eqStr(RouterTests.body(rd, "GET", "/d/a/b/c"), "REST:a/b/c",
                "** binds the rest with separators preserved");

        // -- ** binds an EMPTY rest (matches the prefix itself) --------------
        Router re = heap Router();
        re.route("GET", "/e/{rest:**}", dstar);
        c.eqStr(RouterTests.body(re, "GET", "/e"), "REST:",
                "** binds empty rest at the prefix");
        c.eqStr(RouterTests.body(re, "GET", "/e/a/b"), "REST:a/b",
                "** binds the multi-segment rest");
        // A prefix that does not match at all is still 404.
        c.eqInt((int64) RouterTests.status(re, "GET", "/zzz"), 404,
                "** router still 404s a non-matching prefix");

        // -- registration-time validation (Router.patternError) --------------
        c.that(Router.patternError("/a/x") == null,
               "valid literal pattern accepted");
        c.that(Router.patternError("/a/{id:int64}") == null,
               "valid typed pattern accepted");
        c.that(Router.patternError("/a/{w:*}") == null,
               "single wildcard accepted");
        c.that(Router.patternError("/a/{rest:**}") == null,
               "trailing ** accepted");
        c.that(Router.patternError("/a/{rest:**}/b") != null,
               "non-terminal ** rejected at registration");
        c.that(Router.patternError("/a/{x:bogus}") != null,
               "unknown path-param type rejected at registration");
    }

    static void mounts(Check c) {
        (HttpRequest) -> #HttpResponse userH = (req) -> {
            String tid #= req.pathParam("tid");
            String id #= req.pathParam("id");
            return RouterTests.text("T:" + tid + ",U:" + id);
        };
        (HttpRequest) -> #HttpResponse healthH = (req) ->
            RouterTests.text("HEALTH");
        (HttpRequest) -> #HttpResponse listH = (req) -> {
            String id #= req.pathParam("id");
            return RouterTests.text("LIST:" + id);
        };

        // -- nested dispatch with prefix params ------------------------------
        Router sub = heap Router();
        sub.route("GET", "/users/{id}", userH);
        sub.route("GET", "/health", healthH);
        Router parent = heap Router();
        parent.mount("/tenant/{tid}", sub);

        c.eqStr(RouterTests.body(parent, "GET", "/tenant/acme/users/42"),
                "T:acme,U:42", "mount: prefix param + sub param both bound");
        c.eqStr(RouterTests.body(parent, "GET", "/tenant/acme/health"),
                "HEALTH", "mount: nested literal route dispatches");
        c.eqInt((int64) RouterTests.status(parent, "GET", "/tenant/acme/nope"),
                404, "mount: unknown sub-path is 404");
        c.eqInt((int64) RouterTests.status(parent, "GET", "/other/acme/health"),
                404, "mount: prefix mismatch is 404");

        // -- mount shadowing: a more-specific direct route beats the mount ---
        Router sub2 = heap Router();
        sub2.route("GET", "/{id}", listH);          // -> GET /api/{id}
        Router p2 = heap Router();
        p2.route("GET", "/api/health", healthH);    // literal, more specific
        p2.mount("/api", sub2);
        c.eqStr(RouterTests.body(p2, "GET", "/api/health"), "HEALTH",
                "mount: literal parent route shadows mounted param route");
        c.eqStr(RouterTests.body(p2, "GET", "/api/xyz"), "LIST:xyz",
                "mount: mounted param route handles the rest");

        // -- 405/Allow aggregated across the merged tree ---------------------
        Router sub3 = heap Router();
        sub3.route("POST", "/{id}", listH);         // -> POST /api2/{id}
        Router p3 = heap Router();
        p3.route("GET", "/api2/{id}", healthH);     // GET /api2/{id}
        p3.mount("/api2", sub3);
        HttpResponse d #= p3.dispatch(HttpRequest.of("DELETE", "/api2/5"));
        c.eqInt((int64) d.statusCode(), 405,
                "mount: unmatched method across merged tree is 405");
        String allow #= d.getHeaders().get("Allow");
        c.that(allow != null && allow.equals("GET, POST"),
               "mount: Allow aggregates methods across direct + mounted routes");
    }

    static void perRouteLimits(Check c) {
        (HttpRequest) -> #HttpResponse okH = (req) -> RouterTests.text("OK");

        Router r = heap Router();
        r.routeLimited("POST", "/upload", (int64) 100, okH);   // tight 100 B cap
        r.route("POST", "/free", okH);                         // no per-route cap

        // A tighter per-route cap 413s an over-cap body (the global cap,
        // enforced server-side, would have admitted it).
        c.eqInt((int64) RouterTests.statusBody(r, "POST", "/upload", 500), 413,
                "per-route cap 413s an over-cap body");
        // Within the cap, the handler runs (200).
        c.eqInt((int64) RouterTests.statusBody(r, "POST", "/upload", 50), 200,
                "per-route cap admits a within-cap body");
        // Exactly at the cap is allowed (<=).
        c.eqInt((int64) RouterTests.statusBody(r, "POST", "/upload", 100), 200,
                "a body exactly at the cap is allowed");

        // An unset per-route cap imposes no router-side restriction.
        c.eqInt((int64) RouterTests.statusBody(r, "POST", "/free", 100000), 200,
                "unset per-route cap admits a large body");

        // A declared Content-Length over the cap 413s even with no buffered
        // body (the router trusts the declared length too).
        HttpResponse d #= r.dispatch(
            HttpRequest.of("POST", "/upload").setHeader("Content-Length", "1000"));
        c.eqInt((int64) d.statusCode(), 413,
                "declared Content-Length over cap 413s");
        // The cap is per-route: a route without one admits the same declared body.
        HttpResponse f #= r.dispatch(
            HttpRequest.of("POST", "/free").setHeader("Content-Length", "1000"));
        c.eqInt((int64) f.statusCode(), 200,
                "another route without a cap admits the same body");

        // A per-route cap survives mounting into the merged tree.
        Router sub = heap Router();
        sub.routeLimited("POST", "/avatar", (int64) 100, okH);
        Router parent = heap Router();
        parent.mount("/users/{id}", sub);
        c.eqInt((int64) RouterTests.statusBody(parent, "POST",
                "/users/7/avatar", 500), 413,
                "mounted route keeps its per-route cap");
        c.eqInt((int64) RouterTests.statusBody(parent, "POST",
                "/users/7/avatar", 50), 200,
                "mounted route admits a within-cap body");
    }
}
