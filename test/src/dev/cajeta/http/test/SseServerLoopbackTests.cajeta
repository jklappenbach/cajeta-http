package dev.cajeta.http.test;

import cajeta.concurrent.Fiber;
import cajeta.time.Duration;
import cajeta.lang.String;
import cajeta.io.net.Server;
import cajeta.io.net.TcpStream;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.sse.SseChannel;
import dev.cajeta.http.sse.SseClient;
import dev.cajeta.http.sse.SseEvent;
import dev.cajeta.http.sse.SseParser;
import dev.cajeta.http.sse.SseResponse;

/** An event channel that outlives the handler, since the pump runs after it. */
final class SseHolder {
    public SseChannel ch;

    public SseHolder(int32 cap) {
        SseChannel c = heap SseChannel(cap);
        this.ch = #c;
    }
}

/**
 * The SSE server over loopback. A producer fiber pushes events onto an
 * `SseChannel`, the handler streams it with `SseResponse.channel`, and the
 * events come back intact. A second scenario proves each event is sent while
 * the stream is still open: the producer holds the stream until the client
 * reports the first event.
 */
public final class SseServerLoopbackTests {
    static SseHolder src = null;
    static boolean gotFirst = false;
    static boolean sawBeforeClose = false;
    static int32 received = 0;

    public static async int32 acceptLoop(Server core) {
        int32 n = 0;
        boolean going = true;
        while (going) {
            TcpStream conn #= core.acceptNext();
            if (conn == null) {
                going = false;
            } else {
                core.dispatch(#conn);
                n = n + 1;
            }
        }
        return n;
    }

    public static async int32 produce(SseChannel ch) {
        SseEvent e0 #= SseEvent.of("first");
        ch.send(#e0);
        SseEvent e1 #= SseEvent.typed("tick", "2");
        ch.send(#e1);
        SseEvent e2 #= SseEvent.of("multi\nline");
        ch.send(#e2);
        ch.close();
        return 1;
    }

    public static async int32 produceHeld(SseChannel ch) {
        SseEvent e0 #= SseEvent.of("first");
        ch.send(#e0);
        int32 waited = 0;
        while (!SseServerLoopbackTests.gotFirst && waited < 300) {
            Fiber.sleep(Duration.ofMillis(10));
            waited = waited + 1;
        }
        SseServerLoopbackTests.sawBeforeClose = SseServerLoopbackTests.gotFirst;
        SseEvent e1 #= SseEvent.of("second");
        ch.send(#e1);
        ch.close();
        return 1;
    }

    static void handleSse(HttpRequest q, HttpResponse r) {
        SseResponse.channel(r, SseServerLoopbackTests.src.ch);
    }

    static #HttpServer server() {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> SseServerLoopbackTests.handleSse(q, r));
        return b.build();
    }

    public static async int32 getSse(int32 port) {
        HttpClient client #= heap HttpClient();
        ClientResponse resp #= client.get("http://127.0.0.1:" + port + "/events");
        if (resp.status() != 200) {
            return -1;
        }
        if (!Bytes.equals(resp.header("Content-Type"), "text/event-stream")) {
            return -2;
        }
        String text #= resp.bodyString();
        int8[] bytes #= text.toBytes();
        SseParser p = heap SseParser();
        p.feed(bytes, text.byteLength());
        if (!p.hasEvent()) {
            return -3;
        }
        SseEvent a #= p.nextEvent();
        if (!a.data.equals("first")) {
            return -4;
        }
        SseEvent b #= p.nextEvent();
        if (b.event == null || !b.event.equals("tick") || !b.data.equals("2")) {
            return -5;
        }
        SseEvent g #= p.nextEvent();
        if (!g.data.equals("multi\nline")) {
            return -6;
        }
        if (p.hasEvent()) {
            return -7;
        }
        return 1;
    }

    static void onEvent(SseEvent e) {
        SseServerLoopbackTests.received = SseServerLoopbackTests.received + 1;
        if (e.data.equals("first")) {
            SseServerLoopbackTests.gotFirst = true;
        }
    }

    public static async int32 subscribe(int32 port) {
        SseClient sc = heap SseClient("http://127.0.0.1:" + port + "/events");
        (SseEvent) -> void h = (e) -> SseServerLoopbackTests.onEvent(e);
        sc.subscribeOnce(h);
        return SseServerLoopbackTests.received;
    }

    static void channelOverLoopback(Check c) {
        scope {
            SseHolder hold = heap SseHolder(8);
            SseServerLoopbackTests.src #= hold;
            HttpServer srv #= SseServerLoopbackTests.server();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> pr = spawn produce(SseServerLoopbackTests.src.ch);
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn getSse(port);
            c.eqInt((int64) await t1, 1, "channel-pushed SSE events round-trip over loopback");
            core.listener.close();
            c.eqInt((int64) await s1, 1, "the SSE exchange rode one connection");
            c.eqInt((int64) await pr, 1, "the producer fiber completed");
        }
    }

    static void eventsArriveWhileOpen(Check c) {
        scope {
            SseServerLoopbackTests.gotFirst = false;
            SseServerLoopbackTests.sawBeforeClose = false;
            SseServerLoopbackTests.received = 0;
            SseHolder hold = heap SseHolder(8);
            SseServerLoopbackTests.src #= hold;
            HttpServer srv #= SseServerLoopbackTests.server();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> pr = spawn produceHeld(SseServerLoopbackTests.src.ch);
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn subscribe(port);
            c.eqInt((int64) await t1, 2, "the client received both events");
            await pr;
            c.that(SseServerLoopbackTests.sawBeforeClose,
                   "the first event reached the client while the stream was still open");
            core.listener.close();
            await s1;
        }
    }

    public static void run(Check c) {
        System.stdout.println("-- sse server loopback: channel over the wire --");
        SseServerLoopbackTests.channelOverLoopback(c);
        System.stdout.println("-- sse server loopback: events arrive while open --");
        SseServerLoopbackTests.eventsArriveWhileOpen(c);
    }
}
