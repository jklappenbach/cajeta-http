package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import dev.cajeta.http.ws.WebSocket;
import dev.cajeta.http.ws.WsUpgrade;
import dev.cajeta.http.ws.WsFrame;
import dev.cajeta.http.ws.WsOpcode;
import dev.cajeta.http.ws.WsFrameEncoder;
import dev.cajeta.http.ws.WsFrameDecoder;
import dev.cajeta.http.ws.WsMessage;
import dev.cajeta.http.ws.WsMessageAssembler;
import dev.cajeta.http.ws.PerMessageDeflate;
import dev.cajeta.http.ws.PmdParams;
import dev.cajeta.http.ws.WsCompression;
import dev.cajeta.http.ws.ProtocolViolationException;

/**
 * http:4.1a/4.1b — `permessage-deflate` (RFC 7692) at the frame + codec level.
 *
 *  - **RSV1 discipline** (`WsFrame`/decoder/encoder): RSV1 round-trips only when
 *    the decoder has `allowCompression()`; a set RSV1 without it, RSV1 on a
 *    control frame, and any RSV2/RSV3 bit are protocol violations.
 *  - **PerMessageDeflate**: the RFC 7692 §7.2.1 "Hello" worked example, plain
 *    round-trips, and the context-takeover contract (a repeated message
 *    compresses smaller with takeover; identically-sized and independent
 *    without).
 */
public final class WsPerMessageDeflateTests {

    static boolean bytesEq(int8[] a, int32 an, int8[] b, int32 bn) {
        if (an != bn) {
            return false;
        }
        int32 i = 0;
        while (i < an) {
            if (a[i] != b[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    static boolean strEq(int8[] a, int32 an, String s) {
        if (an != s.byteLength()) {
            return false;
        }
        int32 i = 0;
        while (i < an) {
            if ((((int32) a[i]) & 0xFF) != (((int32) s.byteAt(i)) & 0xFF)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // ---- 4.1a: RSV1 frame discipline -------------------------------------

    static void rsv1FrameCodec(Check c) {
        // A compressed data frame: RSV1 set, some payload.
        int8[] pay = { (int8) 0xAB, (int8) 0xCD, (int8) 0xEF };
        int8[] pcopy = { (int8) 0xAB, (int8) 0xCD, (int8) 0xEF };
        WsFrame f = WsFrame.of(true, WsOpcode.BINARY, false, #pcopy);
        f.rsv1 = true;
        int8[] wire = WsFrameEncoder.encodeUnmasked(f);
        int32 wn = (int32) wire.count();
        // byte 0 high nibble = FIN(0x80)|RSV1(0x40)|opcode(0x2) = 0xC2.
        c.eqInt((int64) (((int32) wire[0]) & 0xFF), (int64) 0xC2,
                "rsv1 encodes into byte0 (0xC2)");

        WsFrameDecoder d = WsFrameDecoder.forClient().allowCompression();
        d.feed(wire, wn);
        c.that(d.hasFrame(), "rsv1 frame decodes with compression allowed");
        WsFrame g = d.nextFrame();
        c.that(g.isRsv1(), "decoded frame carries RSV1");
        c.that(WsPerMessageDeflateTests.bytesEq(g.getPayload(),
                g.payloadLength(), pay, 3), "rsv1 frame payload intact");

        // Same bytes, no compression negotiated -> protocol violation.
        WsFrameDecoder d2 = WsFrameDecoder.forClient();
        boolean threw = false;
        try {
            d2.feed(wire, wn);
        } catch (ProtocolViolationException e) {
            threw = true;
        }
        c.that(threw, "RSV1 without a negotiated extension is rejected");
    }

    static void rsv1ControlRejected(Check c) {
        int8[] empty = heap int8[0];
        WsFrame ping = WsFrame.of(true, WsOpcode.PING, false, #empty);
        ping.rsv1 = true;
        int8[] wire = WsFrameEncoder.encodeUnmasked(ping);
        WsFrameDecoder d = WsFrameDecoder.forClient().allowCompression();
        boolean threw = false;
        try {
            d.feed(wire, (int32) wire.count());
        } catch (ProtocolViolationException e) {
            threw = true;
        }
        c.that(threw, "RSV1 on a control frame is rejected");
    }

    static void rsv2Rejected(Check c) {
        // Hand-craft a server->client frame with RSV2 (0x20) set on byte 0.
        // 0x80 FIN | 0x20 RSV2 | 0x02 BINARY = 0xA2, then a 0-length byte1.
        int8[] wire = { (int8) 0xA2, (int8) 0x00 };
        WsFrameDecoder d = WsFrameDecoder.forClient().allowCompression();
        boolean threw = false;
        try {
            d.feed(wire, 2);
        } catch (ProtocolViolationException e) {
            threw = true;
        }
        c.that(threw, "RSV2 is rejected even with compression allowed");
    }

    // ---- 4.1b: PerMessageDeflate codec -----------------------------------

    static void helloVector(Check c) {
        // RFC 7692 §7.2.1: "Hello" -> f2 48 cd c9 c9 07 00 (marker stripped).
        PerMessageDeflate pmd = heap PerMessageDeflate(false, false);
        String hello = "Hello";
        int8[] hb = hello.toBytes();
        int8[] comp = pmd.compress(hb, hello.byteLength());
        int8[] expect = { (int8) 0xf2, (int8) 0x48, (int8) 0xcd, (int8) 0xc9,
                          (int8) 0xc9, (int8) 0x07, (int8) 0x00 };
        c.that(WsPerMessageDeflateTests.bytesEq(comp, (int32) comp.count(),
                expect, 7), "permessage-deflate 'Hello' matches RFC 7692 §7.2.1");

        // And it decompresses back on a matching context.
        PerMessageDeflate rx = heap PerMessageDeflate(false, false);
        int8[] back = rx.decompress(comp, (int32) comp.count());
        c.that(WsPerMessageDeflateTests.strEq(back, (int32) back.count(), hello),
               "permessage-deflate 'Hello' round-trips");
    }

    static void roundTrip(Check c) {
        PerMessageDeflate tx = heap PerMessageDeflate(false, false);
        PerMessageDeflate rx = heap PerMessageDeflate(false, false);
        String msg = "the quick brown fox jumps over the lazy dog, "
            + "the quick brown fox jumps over the lazy dog.";
        int8[] mb = msg.toBytes();
        int8[] comp = tx.compress(mb, msg.byteLength());
        c.that(comp.count() < (int64) msg.byteLength(),
               "a compressible message shrinks");
        int8[] back = rx.decompress(comp, (int32) comp.count());
        c.that(WsPerMessageDeflateTests.strEq(back, (int32) back.count(), msg),
               "compressible message round-trips");
    }

    static void contextTakeover(Check c) {
        String m = "the quick brown fox jumps over the lazy dog. ";
        int8[] mb = m.toBytes();

        // With takeover: the second identical message reuses the window.
        PerMessageDeflate tx = heap PerMessageDeflate(false, false);
        PerMessageDeflate rx = heap PerMessageDeflate(false, false);
        int8[] c1 = tx.compress(mb, m.byteLength());
        int8[] c2 = tx.compress(mb, m.byteLength());
        c.that(c2.count() < c1.count(),
               "context takeover: 2nd identical message compresses smaller");
        int8[] b1 = rx.decompress(c1, (int32) c1.count());
        int8[] b2 = rx.decompress(c2, (int32) c2.count());
        c.that(WsPerMessageDeflateTests.strEq(b1, (int32) b1.count(), m)
                && WsPerMessageDeflateTests.strEq(b2, (int32) b2.count(), m),
               "context takeover: both messages decode");

        // Without takeover: each message is independent (same size, still ok).
        PerMessageDeflate txN = heap PerMessageDeflate(true, true);
        PerMessageDeflate rxN = heap PerMessageDeflate(true, true);
        int8[] n1 = txN.compress(mb, m.byteLength());
        int8[] n2 = txN.compress(mb, m.byteLength());
        c.eqInt((int64) n2.count(), (int64) n1.count(),
                "no_context_takeover: identical messages compress identically");
        int8[] q1 = rxN.decompress(n1, (int32) n1.count());
        int8[] q2 = rxN.decompress(n2, (int32) n2.count());
        c.that(WsPerMessageDeflateTests.strEq(q1, (int32) q1.count(), m)
                && WsPerMessageDeflateTests.strEq(q2, (int32) q2.count(), m),
               "no_context_takeover: both messages decode");
    }

    // ---- 4.1c: negotiation ------------------------------------------------

    static void negotiation(Check c) {
        String offer = WsCompression.clientOffer();
        c.that(offer.contains("permessage-deflate"),
               "client offer advertises permessage-deflate");

        // Plain accept: enabled, context takeover both sides (no reset flags).
        PmdParams s1 = WsCompression.negotiateServer(
            "permessage-deflate; client_max_window_bits");
        c.that(s1.enabled && s1.responseHeader.contains("permessage-deflate"),
               "server accepts a plain offer");
        c.that(!s1.localNoContextTakeover && !s1.peerNoContextTakeover,
               "plain accept keeps context takeover both sides");

        // client_no_context_takeover -> our (server) decompressor resets, and
        // the response echoes it.
        PmdParams s2 = WsCompression.negotiateServer(
            "permessage-deflate; client_no_context_takeover");
        c.that(s2.enabled && s2.peerNoContextTakeover
                && s2.responseHeader.contains("client_no_context_takeover"),
               "client_no_context_takeover honoured + echoed");

        // server_no_context_takeover -> our (server) compressor resets.
        PmdParams s3 = WsCompression.negotiateServer(
            "permessage-deflate; server_no_context_takeover");
        c.that(s3.enabled && s3.localNoContextTakeover
                && s3.responseHeader.contains("server_no_context_takeover"),
               "server_no_context_takeover honoured + echoed");

        // A demand for a smaller server window we cannot honour -> declined.
        PmdParams s4 = WsCompression.negotiateServer(
            "permessage-deflate; server_max_window_bits=10");
        c.that(!s4.enabled,
               "offer demanding server_max_window_bits<15 is declined");
        PmdParams s5 = WsCompression.negotiateServer(
            "permessage-deflate; server_max_window_bits=15");
        c.that(s5.enabled, "server_max_window_bits=15 is acceptable");

        // No extension / unrelated -> disabled (plain frames).
        PmdParams s6 = WsCompression.negotiateServer("foo; bar");
        c.that(!s6.enabled, "a non-permessage-deflate offer disables it");

        // Client confirms the server reply; perspectives mirror.
        PmdParams cc = WsCompression.confirmClient(
            "permessage-deflate; server_no_context_takeover");
        c.that(cc.enabled && cc.peerNoContextTakeover
                && !cc.localNoContextTakeover,
               "client confirm: server_no_context_takeover -> peer resets");
    }

    // ---- 4.1d(unit): message-layer RSV1 discipline + compressed flag -----

    static void messageCompression(Check c) {
        // A single compressed data frame -> a message flagged compressed.
        int8[] p = { (int8) 1, (int8) 2, (int8) 3 };
        WsFrame f = WsFrame.of(true, WsOpcode.TEXT, false, #p);
        f.rsv1 = true;
        WsMessageAssembler a1 = WsMessageAssembler.create();
        WsMessage m1 = a1.accept(f);
        c.that(m1 != null && m1.isCompressed(),
               "single compressed frame -> compressed message");

        // Fragmented compressed message: RSV1 only on the first frame.
        int8[] q1 = { (int8) 1, (int8) 2 };
        WsFrame g1 = WsFrame.of(false, WsOpcode.TEXT, false, #q1);
        g1.rsv1 = true;
        int8[] q2 = { (int8) 3, (int8) 4 };
        WsFrame g2 = WsFrame.of(true, WsOpcode.CONTINUATION, false, #q2);
        WsMessageAssembler a2 = WsMessageAssembler.create();
        WsMessage none = a2.accept(g1);
        WsMessage m2 = a2.accept(g2);
        c.that(none == null && m2 != null && m2.isCompressed()
                && m2.getPayload().count() == (int64) 4,
               "fragmented compressed message assembles and stays flagged");

        // RSV1 on a continuation frame is a protocol violation.
        int8[] r1 = { (int8) 1, (int8) 2 };
        WsFrame h1 = WsFrame.of(false, WsOpcode.TEXT, false, #r1);
        h1.rsv1 = true;
        int8[] r2 = { (int8) 3, (int8) 4 };
        WsFrame h2 = WsFrame.of(true, WsOpcode.CONTINUATION, false, #r2);
        h2.rsv1 = true;
        WsMessageAssembler a3 = WsMessageAssembler.create();
        WsMessage ignore = a3.accept(h1);
        boolean threw = false;
        try {
            WsMessage bad = a3.accept(h2);
        } catch (ProtocolViolationException e) {
            threw = true;
        }
        c.that(threw, "RSV1 on a continuation frame is rejected (assembler)");

        // A plain message is not flagged compressed.
        int8[] s = { (int8) 9 };
        WsFrame pf = WsFrame.of(true, WsOpcode.BINARY, false, #s);
        WsMessageAssembler a4 = WsMessageAssembler.create();
        WsMessage pm = a4.accept(pf);
        c.that(pm != null && !pm.isCompressed(),
               "an uncompressed message is not flagged");
    }

    // ---- 4.1d: live WebSocket send->receive compressed round-trip --------

    static void liveRoundTrip(Check c) {
        // Both sides agree on permessage-deflate with context takeover.
        PmdParams clientCfg = WsCompression.confirmClient("permessage-deflate");
        PmdParams serverCfg = WsCompression.negotiateServer("permessage-deflate");

        String msg = "compress me: the quick brown fox jumps over the lazy dog "
            + "and then does it all over again for good measure.";

        // Client encodes a compressed (RSV1, masked) TEXT frame into `wire`.
        MemChannel wire = heap MemChannel();
        MemChannel cDiscard = heap MemChannel();
        AsyncReader cr = heap AsyncReader(cDiscard);
        AsyncWriter cw = heap AsyncWriter(wire);
        WebSocket client = WebSocket.forClient(cr, cw);
        client.enableCompression(clientCfg);
        client.send(msg);
        cw.flush();

        int32 wireLen = wire.capturedLen();
        c.that(wireLen > 0 && wireLen < msg.byteLength() + 8,
               "compressed frame is emitted and smaller than the plaintext");

        // Server decodes + decompresses it back.
        MemChannel sDiscard = heap MemChannel();
        AsyncReader sr = heap AsyncReader(sDiscard);
        sr.stage(wire.captured(), wireLen);
        sr.markEof();
        AsyncWriter sw = heap AsyncWriter(sDiscard);
        WebSocket server = WebSocket.forServer(sr, sw);
        server.enableCompression(serverCfg);
        WsMessage got = server.receive();
        c.that(got != null
                && WsPerMessageDeflateTests.strEq(got.getPayload(),
                    (int32) got.getPayload().count(), msg),
               "live permessage-deflate send -> receive round-trips");
    }

    // ---- 4.1d: WsUpgrade server-side handshake negotiation ---------------

    static boolean bufContains(int8[] buf, int32 len, String needle) {
        int32 nl = needle.byteLength();
        if (nl == 0 || len < nl) {
            return false;
        }
        int32 i = 0;
        while (i <= len - nl) {
            int32 k = 0;
            boolean hit = true;
            while (hit && k < nl) {
                if ((((int32) buf[i + k]) & 0xFF)
                        != (((int32) needle.byteAt(k)) & 0xFF)) {
                    hit = false;
                }
                k = k + 1;
            }
            if (hit) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    static void handshakeNegotiates(Check c) {
        String req = "GET /chat HTTP/1.1\r\n"
            + "Host: example.com\r\n"
            + "Upgrade: websocket\r\n"
            + "Connection: Upgrade\r\n"
            + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"
            + "Sec-WebSocket-Version: 13\r\n"
            + "Sec-WebSocket-Extensions: permessage-deflate; client_max_window_bits\r\n"
            + "\r\n";
        int8[] rb = req.toBytes();

        MemChannel rin = heap MemChannel();
        AsyncReader reader = heap AsyncReader(rin);
        reader.stage(rb, req.byteLength());
        reader.markEof();
        MemChannel rout = heap MemChannel();
        AsyncWriter writer = heap AsyncWriter(rout);

        WebSocket ws = WsUpgrade.acceptServer(reader, writer, true);
        writer.flush();
        int8[] resp = rout.captured();
        int32 rlen = rout.capturedLen();
        c.that(WsPerMessageDeflateTests.bufContains(resp, rlen, "101"),
               "handshake: server sends 101 Switching Protocols");
        c.that(WsPerMessageDeflateTests.bufContains(resp, rlen,
                "permessage-deflate"),
               "handshake: 101 echoes the negotiated permessage-deflate");
    }

    public static void run(Check c) {
        System.stdout.println("-- ws pmd: RSV1 frame discipline --");
        WsPerMessageDeflateTests.rsv1FrameCodec(c);
        WsPerMessageDeflateTests.rsv1ControlRejected(c);
        WsPerMessageDeflateTests.rsv2Rejected(c);
        System.stdout.println("-- ws pmd: permessage-deflate codec --");
        WsPerMessageDeflateTests.helloVector(c);
        WsPerMessageDeflateTests.roundTrip(c);
        WsPerMessageDeflateTests.contextTakeover(c);
        System.stdout.println("-- ws pmd: negotiation --");
        WsPerMessageDeflateTests.negotiation(c);
        System.stdout.println("-- ws pmd: message-layer RSV1 discipline --");
        WsPerMessageDeflateTests.messageCompression(c);
        System.stdout.println("-- ws pmd: live send->receive round-trip --");
        WsPerMessageDeflateTests.liveRoundTrip(c);
        System.stdout.println("-- ws pmd: WsUpgrade server negotiation --");
        WsPerMessageDeflateTests.handshakeNegotiates(c);
    }
}
