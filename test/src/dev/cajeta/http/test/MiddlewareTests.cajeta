package dev.cajeta.http.test;

import cajeta.lang.String;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.HttpException;
import dev.cajeta.http.middleware.Middleware;
import dev.cajeta.http.middleware.MiddlewareChain;
import dev.cajeta.http.middleware.Cors;
import dev.cajeta.http.routing.Router;

/** Chain composition: order, short-circuit, exceptions, per-route chains. */
public final class MiddlewareTests {
    public static void run(Check c) {
        System.stdout.println("-- middleware: composition --");
        MiddlewareTests.order(c);
        MiddlewareTests.shortCircuit(c);
        MiddlewareTests.exceptionCrossing(c);
        MiddlewareTests.perRouteInsideGlobal(c);
        MiddlewareTests.allocation(c);
        MiddlewareTests.ownedConfig(c);
    }

    // A chain whose Cors policy is made here and never returned: the middleware owns it.
    static #MiddlewareChain corsChain((HttpRequest, HttpResponse) -> void handler) {
        Cors policy #= Cors.create();
        policy.allowOrigin("https://good.example");
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#Cors.middleware(#policy));
        chain.build(handler);
        return #chain;
    }

    static void ownedConfig(Check c) {
        (HttpRequest, HttpResponse) -> void ok = (HttpRequest q, HttpResponse r) -> {
            r.body("ok");
        };
        MiddlewareTests.corsChain(ok);
        int64 idle = Cajeta.liveCount();
        {
            MiddlewareChain chain #= MiddlewareTests.corsChain(ok);
        }
        c.eqInt(Cajeta.liveCount() - idle, (int64) 0, "a chain and the config it owns are freed together");

        boolean right = false;
        int64 before = Cajeta.liveCount();
        {
            MiddlewareChain chain #= MiddlewareTests.corsChain(ok);
            int32 i = 0;
            while (i < 64) {
                String junk #= "churn-" + i;
                i = i + 1;
            }
            (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
            String got #= Wire.serve("OPTIONS /x HTTP/1.1\r\nOrigin: https://good.example\r\n"
                + "Access-Control-Request-Method: POST\r\n\r\n", app);
            String allowed #= Wire.header(got, "Access-Control-Allow-Origin");
            right = allowed.equals("https://good.example");
        }
        c.that(right, "a config made inside a factory lives as long as its middleware");
        c.eqInt(Cajeta.liveCount() - before, (int64) 0, "serving through it leaves nothing behind");
    }

    static #Middleware tracer(Trace t, int8 in, int8 out) {
        return Middleware.of((HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> {
            t.mark(in);
            next(q, r);
            t.mark(out);
        });
    }

    static void order(Check c) {
        Trace t = heap Trace();
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> {
            t.mark((int8) 72);
            r.body("ok");
        };
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#MiddlewareTests.tracer(t, (int8) 65, (int8) 97))
             .use(#MiddlewareTests.tracer(t, (int8) 66, (int8) 98))
             .use(#MiddlewareTests.tracer(t, (int8) 67, (int8) 99));
        chain.build(h);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 200, "composed chain reaches the handler");
        c.eqStr(t.str(), "ABCHcba", "first-registered outermost, and the response bubbles back out");
    }

    static void shortCircuit(Check c) {
        Trace t = heap Trace();
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> {
            t.mark((int8) 72);
        };
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#MiddlewareTests.tracer(t, (int8) 65, (int8) 97))
             .use(#Middleware.of((HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> {
                 t.mark((int8) 68);
                 r.status(403);
             }))
             .use(#MiddlewareTests.tracer(t, (int8) 67, (int8) 99));
        chain.build(h);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 403, "short-circuit answers the deny status");
        c.eqStr(t.str(), "ADa", "short-circuit skips inner middleware and the handler");
    }

    static void exceptionCrossing(Check c) {
        Trace t = heap Trace();
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> {
            t.mark((int8) 72);
            throw heap HttpException("boom");
        };
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#MiddlewareTests.tracer(t, (int8) 65, (int8) 97));
        chain.build(h);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        String got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 400, "a handler exception crosses the stack to the connection");
        c.eqStr(t.str(), "AH", "post-next code does not run when the inner chain throws");
    }

    static void perRouteInsideGlobal(Check c) {
        Trace t = heap Trace();
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> {
            t.mark((int8) 72);
        };
        MiddlewareChain routeChain = heap MiddlewareChain();
        routeChain.use(#MiddlewareTests.tracer(t, (int8) 67, (int8) 99));
        Router router = heap Router();
        router.routeMw("GET", "/x", #routeChain, h);
        (HttpRequest, HttpResponse) -> void dispatch = (HttpRequest q, HttpResponse r) -> router.dispatch(q, r);
        MiddlewareChain global = heap MiddlewareChain();
        global.use(#MiddlewareTests.tracer(t, (int8) 65, (int8) 97))
              .use(#MiddlewareTests.tracer(t, (int8) 66, (int8) 98));
        global.build(dispatch);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> global.run(q, r);
        String got #= Wire.serve("GET /x HTTP/1.1\r\n\r\n", app);
        c.eqInt((int64) Wire.status(got), 200, "per-route inside global reaches the handler");
        c.eqStr(t.str(), "ABCHcba", "global wraps per-route wraps handler");
    }

    static void allocation(Check c) {
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> {
            r.status(201);
        };
        MiddlewareChain chain = heap MiddlewareChain();
        chain.use(#Middleware.of((HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> {
                 next(q, r);
             }))
             .use(#Middleware.of((HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> {
                 next(q, r);
             }));
        chain.build(h);
        (HttpRequest, HttpResponse) -> void app = (HttpRequest q, HttpResponse r) -> chain.run(q, r);
        int64 small = ConnectionTests.measure(100, app);
        int64 large = ConnectionTests.measure(1100, app);
        c.that(large - small == 0,
            "1000 more requests through a two-layer chain allocate nothing (" + small + " then " + large + ")");
    }
}
