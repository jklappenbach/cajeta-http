    static void c6(Check c) {
        HpackEncoder e = heap HpackEncoder(256, true);
        // C.6.1
        HpackFieldList l0 = heap HpackFieldList();
        l0.put(HpackEncoderTests.own(":status"), HpackEncoderTests.own("302"));
        l0.put(HpackEncoderTests.own("cache-control"), HpackEncoderTests.own("private"));
        l0.put(HpackEncoderTests.own("date"), HpackEncoderTests.own("Mon, 21 Oct 2013 20:13:21 GMT"));
        l0.put(HpackEncoderTests.own("location"), HpackEncoderTests.own("https://www.example.com"));
        int8[] enc0 = e.encode(l0);
        int8[] exp0 = [
        (int8) 0x48, (int8) 0x82, (int8) 0x64, (int8) 0x02, (int8) 0x58, (int8) 0x85, (int8) 0xae, (int8) 0xc3,
