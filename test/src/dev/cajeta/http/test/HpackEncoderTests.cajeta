        // C.6.3
        HpackFieldList l2 = heap HpackFieldList();
        l2.put(HpackEncoderTests.own(":status"), HpackEncoderTests.own("200"));
        l2.put(HpackEncoderTests.own("cache-control"), HpackEncoderTests.own("private"));
        l2.put(HpackEncoderTests.own("date"), HpackEncoderTests.own("Mon, 21 Oct 2013 20:13:22 GMT"));
        l2.put(HpackEncoderTests.own("location"), HpackEncoderTests.own("https://www.example.com"));
        l2.put(HpackEncoderTests.own("content-encoding"), HpackEncoderTests.own("gzip"));
        l2.put(HpackEncoderTests.own("set-cookie"), HpackEncoderTests.own("foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"));
        int8[] enc2 = e.encode(l2);
