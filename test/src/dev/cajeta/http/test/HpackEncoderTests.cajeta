        c.that(HpackEncoderTests.sameBytes(enc2, (int32) enc2.count(), exp2, 79), "C.6.3 encode matches RFC bytes");
        c.eqInt((int64) e.dynamicTable().currentSize(), (int64) 215, "C.6.3 encoder table size");

    }

    static void reps(Check c) {
        // C.2.1 literal + incremental indexing (raw): 40 0a custom-key 0d custom-header.
        HpackEncoder e1 = heap HpackEncoder(4096, false);
        HpackFieldList a = heap HpackFieldList();
        a.put(HpackEncoderTests.own("custom-key"), HpackEncoderTests.own("custom-header"));
        int8[] r1 = e1.encode(a);
        int8[] x1 = [
            (int8) 0x40, (int8) 0x0a, (int8) 0x63, (int8) 0x75, (int8) 0x73,
            (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d, (int8) 0x6b,
            (int8) 0x65, (int8) 0x79, (int8) 0x0d, (int8) 0x63, (int8) 0x75,
            (int8) 0x73, (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d,
            (int8) 0x68, (int8) 0x65, (int8) 0x61, (int8) 0x64, (int8) 0x65,
            (int8) 0x72
        ];
        c.that(HpackEncoderTests.sameBytes(r1, (int32) r1.count(), x1, 26),
               "C.2.1 encode matches");

        // C.2.4 indexed :method GET -> 0x82.
        HpackEncoder e2 = heap HpackEncoder(4096, false);
        HpackFieldList b = heap HpackFieldList();
        b.put(HpackEncoderTests.own(":method"), HpackEncoderTests.own("GET"));
        int8[] r2 = e2.encode(b);
        c.eqInt((int64) r2.count(), (int64) 1, "C.2.4 single byte");
        c.eqInt(((int64) r2[0]) & (int64) 0xFF, (int64) 0x82, "C.2.4 == 0x82");

        // C.2.3 never-indexed (sensitive): 10 08 password 06 secret; not indexed.
        HpackEncoder e3 = heap HpackEncoder(4096, false);
        HpackFieldList d = heap HpackFieldList();
        d.putSensitive(HpackEncoderTests.own("password"), HpackEncoderTests.own("secret"), true);
        int8[] r3 = e3.encode(d);
        int8[] x3 = [
            (int8) 0x10, (int8) 0x08, (int8) 0x70, (int8) 0x61, (int8) 0x73,
            (int8) 0x73, (int8) 0x77, (int8) 0x6f, (int8) 0x72, (int8) 0x64,
            (int8) 0x06, (int8) 0x73, (int8) 0x65, (int8) 0x63, (int8) 0x72,
            (int8) 0x65, (int8) 0x74
        ];
        c.that(HpackEncoderTests.sameBytes(r3, (int32) r3.count(), x3, 17),
               "C.2.3 never-indexed encode matches");
        c.eqInt((int64) e3.dynamicTable().count(), (int64) 0,
                "never-indexed field not added to table");

        // Queued table-size update is emitted at the head of the next block.
        HpackEncoder e4 = heap HpackEncoder(4096, false);
        e4.signalTableSizeUpdate(100);
        HpackFieldList f = heap HpackFieldList();
        f.put(HpackEncoderTests.own(":method"), HpackEncoderTests.own("GET"));
        int8[] r4 = e4.encode(f);
        c.eqInt((int64) r4.count(), (int64) 3, "size-update prefixes the block");
        c.eqInt(((int64) r4[0]) & (int64) 0xFF, (int64) 0x3f, "size-update octet0 (0x20|31)");
        c.eqInt(((int64) r4[1]) & (int64) 0xFF, (int64) 0x45, "size-update octet1 (100-31=69)");
        c.eqInt(((int64) r4[2]) & (int64) 0xFF, (int64) 0x82, "indexed :method after update");
        c.eqInt((int64) e4.dynamicTable().maxSize(), (int64) 100, "table re-bounded to 100");

        // Round-trip: encode with Huffman, decode, compare to the originals.
        HpackEncoder e5 = heap HpackEncoder(4096, true);
        HpackDecoder dec = heap HpackDecoder(4096);
        HpackFieldList src = heap HpackFieldList();
        src.put(HpackEncoderTests.own(":method"), HpackEncoderTests.own("GET"));
        src.put(HpackEncoderTests.own(":path"), HpackEncoderTests.own("/resource"));
        src.put(HpackEncoderTests.own("accept"), HpackEncoderTests.own("text/html, application/xhtml"));
        src.put(HpackEncoderTests.own("x-custom"), HpackEncoderTests.own("a value with spaces"));
        int8[] enc = e5.encode(src);
        HpackFieldList got = dec.decode(enc, (int32) enc.count());
        c.eqInt((int64) got.size(), (int64) 4, "round-trip field count");
        c.eqStr(got.nameAt(0), ":method", "round-trip[0] name");
        c.eqStr(got.valueAt(0), "GET", "round-trip[0] value");
        c.eqStr(got.nameAt(1), ":path", "round-trip[1] name");
        c.eqStr(got.valueAt(1), "/resource", "round-trip[1] value");
        c.eqStr(got.nameAt(2), "accept", "round-trip[2] name");
        c.eqStr(got.valueAt(2), "text/html, application/xhtml", "round-trip[2] value");
        c.eqStr(got.nameAt(3), "x-custom", "round-trip[3] name");
        c.eqStr(got.valueAt(3), "a value with spaces", "round-trip[3] value");
    }
}
