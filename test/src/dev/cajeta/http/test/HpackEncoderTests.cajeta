package dev.cajeta.http.test;

import cajeta.lang.String;
import dev.cajeta.http.h2.HpackEncoder;
import dev.cajeta.http.h2.HpackDecoder;
import dev.cajeta.http.h2.HpackField;
import dev.cajeta.http.h2.HpackFieldList;

/**
 * http:3.1d — HPACK **encoder** (RFC 7541 §6, encode side). The primary test
 * is byte-exact reproduction of the RFC Appendix C request/response sequences
 * (C.3/C.4 at 4096, C.5/C.6 at 256 with evictions), proving the encoder's
 * index-when-possible strategy is interoperable, not merely self-consistent.
 * Plus the independent C.2 representations the strategy produces, never-indexed
 * for sensitive fields, a queued table-size update, and an encode->decode
 * round-trip.
 */
public final class HpackEncoderTests {

    static #String own(String s) {
        return s.substring(0, s.byteLength());
    }

    static boolean sameBytes(int8[] a, int32 an, int8[] b, int32 bn) {
        if (an != bn) {
            return false;
        }
        int32 i = 0;
        while (i < an) {
            if ((((int32) a[i]) & 0xFF) != (((int32) b[i]) & 0xFF)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    public static void run(Check c) {
        System.stdout.println("-- hpack encode: C.3 requests (raw) --");
        HpackEncoderTests.c3(c);
        System.stdout.println("-- hpack encode: C.4 requests (huffman) --");
        HpackEncoderTests.c4(c);
        System.stdout.println("-- hpack encode: C.5 responses (raw, evicting) --");
        HpackEncoderTests.c5(c);
        System.stdout.println("-- hpack encode: C.6 responses (huffman, evicting) --");
        HpackEncoderTests.c6(c);
        System.stdout.println("-- hpack encode: representations + guards --");
        HpackEncoderTests.reps(c);
    }

    static void c3(Check c) {
        HpackEncoder e = heap HpackEncoder(4096, false);
        // C.3.1
        HpackFieldList l0 = heap HpackFieldList();
        l0.put(HpackEncoderTests.own(":method"), HpackEncoderTests.own("GET"));
        l0.put(HpackEncoderTests.own(":scheme"), HpackEncoderTests.own("http"));
        l0.put(HpackEncoderTests.own(":path"), HpackEncoderTests.own("/"));
        l0.put(HpackEncoderTests.own(":authority"), HpackEncoderTests.own("www.example.com"));
        int8[] enc0 = e.encode(l0);
        int8[] exp0 = [
        (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0x41, (int8) 0x0f, (int8) 0x77, (int8) 0x77, (int8) 0x77,
        (int8) 0x2e, (int8) 0x65, (int8) 0x78, (int8) 0x61, (int8) 0x6d, (int8) 0x70, (int8) 0x6c, (int8) 0x65,
        (int8) 0x2e, (int8) 0x63, (int8) 0x6f, (int8) 0x6d,
        ];
        c.that(HpackEncoderTests.sameBytes(enc0, (int32) enc0.count(), exp0, 20), "C.3.1 encode matches RFC bytes");
        c.eqInt((int64) e.dynamicTable().currentSize(), (int64) 57, "C.3.1 encoder table size");

        // C.3.2
        HpackFieldList l1 = heap HpackFieldList();
        l1.put(HpackEncoderTests.own(":method"), HpackEncoderTests.own("GET"));
        l1.put(HpackEncoderTests.own(":scheme"), HpackEncoderTests.own("http"));
        l1.put(HpackEncoderTests.own(":path"), HpackEncoderTests.own("/"));
        l1.put(HpackEncoderTests.own(":authority"), HpackEncoderTests.own("www.example.com"));
        l1.put(HpackEncoderTests.own("cache-control"), HpackEncoderTests.own("no-cache"));
        int8[] enc1 = e.encode(l1);
        int8[] exp1 = [
        (int8) 0x82, (int8) 0x86, (int8) 0x84, (int8) 0xbe, (int8) 0x58, (int8) 0x08, (int8) 0x6e, (int8) 0x6f,
        (int8) 0x2d, (int8) 0x63, (int8) 0x61, (int8) 0x63, (int8) 0x68, (int8) 0x65,
        ];
        c.that(HpackEncoderTests.sameBytes(enc1, (int32) enc1.count(), exp1, 14), "C.3.2 encode matches RFC bytes");
        c.eqInt((int64) e.dynamicTable().currentSize(), (int64) 110, "C.3.2 encoder table size");

        // C.3.3
        HpackFieldList l2 = heap HpackFieldList();
        l2.put(HpackEncoderTests.own(":method"), HpackEncoderTests.own("GET"));
        l2.put(HpackEncoderTests.own(":scheme"), HpackEncoderTests.own("https"));
        l2.put(HpackEncoderTests.own(":path"), HpackEncoderTests.own("/index.html"));
        l2.put(HpackEncoderTests.own(":authority"), HpackEncoderTests.own("www.example.com"));
        l2.put(HpackEncoderTests.own("custom-key"), HpackEncoderTests.own("custom-value"));
        int8[] enc2 = e.encode(l2);
        int8[] exp2 = [
        (int8) 0x82, (int8) 0x87, (int8) 0x85, (int8) 0xbf, (int8) 0x40, (int8) 0x0a, (int8) 0x63, (int8) 0x75,
        (int8) 0x73, (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d, (int8) 0x6b, (int8) 0x65, (int8) 0x79,
        (int8) 0x0c, (int8) 0x63, (int8) 0x75, (int8) 0x73, (int8) 0x74, (int8) 0x6f, (int8) 0x6d, (int8) 0x2d,
        (int8) 0x76, (int8) 0x61, (int8) 0x6c, (int8) 0x75, (int8) 0x65,
        ];
        c.that(HpackEncoderTests.sameBytes(enc2, (int32) enc2.count(), exp2, 29), "C.3.3 encode matches RFC bytes");
        c.eqInt((int64) e.dynamicTable().currentSize(), (int64) 164, "C.3.3 encoder table size");

    }

