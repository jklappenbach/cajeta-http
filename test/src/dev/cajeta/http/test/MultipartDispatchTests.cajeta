package dev.cajeta.http.test;

import cajeta.concurrent.Fiber;
import cajeta.error.Exception;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.BufferPool;
import cajeta.io.net.TcpStream;
import cajeta.time.Duration;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.ClientRequest;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.MediaType;
import dev.cajeta.http.body.Body;
import dev.cajeta.http.body.MultipartBody;
import dev.cajeta.http.body.MultipartParser;
import dev.cajeta.http.body.MultipartPart;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.http.server.MultipartMode;
import dev.cajeta.unit.Check;

/**
 * request-dispatch plan Unit 7 (spec §2.3): multipart per route. `whole`
 * holds the body as any other; `part` runs the handler once per completed
 * part, in order, fed by the framer so the body never has to fit the input
 * buffer; `stream` hands the handler the body at head complete.
 */
public final class MultipartDispatchTests {
    static int32 wholeRuns;
    static int32 wholeParts;
    static int64 wholeBytes;
    static int32 partRuns;
    static String partOrder;
    static int64 streamBytes;
    static int64 streamAlloc;

    public static void run(Check c) {
        MultipartDispatchTests.partOrder = "";
        System.stdout.println("-- multipart dispatch: whole, a 3 MB two-file form runs the handler once (7.1.1) --");
        MultipartDispatchTests.wholeMode(c);
        System.stdout.println("-- multipart dispatch: part, five files run the handler five times in order (7.1.2) --");
        MultipartDispatchTests.partMode(c);
        System.stdout.println("-- multipart dispatch: part, a part over maxPartBytes is 413 (7.1.2) --");
        MultipartDispatchTests.partTooBig(c);
        System.stdout.println("-- multipart dispatch: stream, a 64 MB part is read incrementally in bounded memory (7.1.3) --");
        MultipartDispatchTests.streamMode(c);
    }

    // ----- fixtures -------------------------------------------------------

    static void handle(HttpRequest q, HttpResponse r) {
        if (Bytes.equals(q.path(), "/whole")) {
            MultipartDispatchTests.wholeRuns = MultipartDispatchTests.wholeRuns + 1;
            MediaType ct #= q.contentType();
            String bound #= MultipartParser.boundaryOf(ct);
            MultipartParser p #= MultipartParser.forBoundary(bound);
            int8[] body #= Bytes.copyOf(q.body());
            p.feed(body, (int32) body.count());
            MultipartDispatchTests.wholeParts = p.partCount();
            int64 total = (int64) 0;
            int32 i = 0;
            while (i < p.partCount()) {
                total = total + p.part(i).body().contentLength();
                i = i + 1;
            }
            MultipartDispatchTests.wholeBytes = total;
            r.body("parts " + p.partCount());
            return;
        }
        if (Bytes.equals(q.path(), "/parts")) {
            if (q.multipartIndex() == 0) {
                MultipartDispatchTests.partOrder = "";
                MultipartDispatchTests.partRuns = 0;
            }
            MultipartDispatchTests.partRuns = MultipartDispatchTests.partRuns + 1;
            MultipartPart p = q.multipartPart();
            if (p != null) {
                MultipartDispatchTests.partOrder = MultipartDispatchTests.partOrder + p.name()
                    + ":" + p.body().contentLength() + ",";
            }
            if (q.multipartLast()) {
                r.body("got " + MultipartDispatchTests.partRuns);
            }
            return;
        }
        if (Bytes.equals(q.path(), "/big")) {
            int64 a0 = Cajeta.allocatedBytes();
            Body b = q.bodyStream();
            if (b == null) {
                r.status(500);
                r.body("not streamed");
                return;
            }
            AsyncReader rd = b.reader();
            int8[] buf = heap int8[65536];
            int64 total = (int64) 0;
            boolean going = true;
            while (going) {
                int32 n = rd.read(buf, 0, 65536);
                if (n <= 0) {
                    going = false;
                } else {
                    total = total + (int64) n;
                }
            }
            MultipartDispatchTests.streamBytes = total;
            MultipartDispatchTests.streamAlloc = Cajeta.allocatedBytes() - a0;
            r.body("n=" + total);
            return;
        }
        r.body("plain");
    }

    static #HttpServer server(int32 bufferBytes, int32 maxPart) {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> MultipartDispatchTests.handle(q, r));
        b.framers(1);
        b.multipart("POST", "/parts", MultipartMode.PART);
        b.multipart("POST", "/big", MultipartMode.STREAM);
        if (bufferBytes > 0) {
            b.bufferPool(heap BufferPool(bufferBytes, 8));
        }
        if (maxPart > 0) {
            b.maxPartBytes(maxPart);
        }
        return b.build();
    }

    public static async int32 serveIt(HttpServer srv) {
        srv.serve();
        return 1;
    }

    static int32 port(HttpServer srv) {
        return srv.server.listener.boundPort();
    }

    static #int8[] fill(int32 n, int32 seed) {
        int8[] d = heap int8[n];
        int32 i = 0;
        while (i < n) {
            d[i] = (int8) (97 + ((i + seed) % 23));
            i = i + 1;
        }
        return #d;
    }

    /** A form of `files` octet-stream files of `each` bytes, named f0, f1, ... */
    static #MultipartBody form(int32 files, int32 each) {
        MultipartBody b #= MultipartBody.of();
        int32 i = 0;
        while (i < files) {
            MediaType t #= MediaType.parse("application/octet-stream");
            int8[] d #= MultipartDispatchTests.fill(each, i);
            b.addFile("f" + i, "f" + i + ".bin", #t, #d, each);
            i = i + 1;
        }
        return #b;
    }

    static int32 post(int32 port, String path, #MultipartBody body, String[] got) {
        HttpClient client #= heap HttpClient();
        client.exchangeTimeout(15000);
        ClientRequest req #= ClientRequest.post("http://127.0.0.1:" + port + path);
        req.body(#body);
        try {
            ClientResponse resp #= client.send(req);
            got[0] #= resp.bodyString();
            return resp.status();
        } catch (Exception e) {
            got[0] = "" + e.message;
            return -1;
        }
    }

    // ----- cases ----------------------------------------------------------

    /** 7.1.1: whole mode, the default: a 3 MB form with two files reaches the handler once, both parts in memory. */
    static void wholeMode(Check c) {
        scope {
            HttpServer srv #= MultipartDispatchTests.server(4194304, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = MultipartDispatchTests.port(srv);
            MultipartDispatchTests.wholeRuns = 0;
            int64 d0 = srv.dispatches();
            MultipartBody body #= MultipartDispatchTests.form(2, 1572864);
            String[] got = heap String[1];
            int32 status = MultipartDispatchTests.post(port, "/whole", #body, got);
            c.eqInt((int64) status, (int64) 200, "the form is accepted (" + got[0] + ")");
            c.that(got[0].equals("parts 2"), "the handler saw both parts");
            c.eqInt((int64) MultipartDispatchTests.wholeRuns, (int64) 1, "the handler ran once");
            c.eqInt(MultipartDispatchTests.wholeBytes, (int64) 3145728, "with 3 MB of part content");
            c.eqInt(srv.dispatches() - d0, (int64) 1, "one dispatch");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 7.1.2: part mode: five 100 KB files through a 64 KB buffer run the handler five times, in order. */
    static void partMode(Check c) {
        scope {
            HttpServer srv #= MultipartDispatchTests.server(0, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = MultipartDispatchTests.port(srv);
            MultipartBody body #= MultipartDispatchTests.form(5, 102400);
            String[] got = heap String[1];
            int32 status = MultipartDispatchTests.post(port, "/parts", #body, got);
            c.eqInt((int64) status, (int64) 200, "the form is accepted (" + got[0] + ")");
            c.that(got[0].equals("got 5"), "the response is written after the last part (" + got[0] + ")");
            c.eqInt((int64) MultipartDispatchTests.partRuns, (int64) 5, "the handler ran once per part");
            c.that(MultipartDispatchTests.partOrder.equals("f0:102400,f1:102400,f2:102400,f3:102400,f4:102400,"),
                "in order, each with its content (" + MultipartDispatchTests.partOrder + ")");
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 7.1.2: a part over maxPartBytes ends the request with 413. */
    static void partTooBig(Check c) {
        scope {
            HttpServer srv #= MultipartDispatchTests.server(0, 1024);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = MultipartDispatchTests.port(srv);
            MultipartBody body #= MultipartDispatchTests.form(1, 4096);
            int8[] wire #= body.wire();
            TcpStream s #= DispatchTests.connectRaw(port);
            MediaType ct #= body.contentType();
            String ctText #= ct.format();
            DispatchTests.sendRaw(s, "POST /parts HTTP/1.1\r\nHost: t\r\nContent-Type: " + ctText
                + "\r\nContent-Length: " + wire.count() + "\r\n\r\n");
            try {
                s.writeAllAsync(wire, (int64) 0, (int64) wire.count());
            } catch (Exception e) {
            }
            int8[] buf = heap int8[2048];
            int32 n = 0;
            boolean going = true;
            while (going) {
                int64 r = DispatchTests.readStep(s, buf, n, 3000);
                if (r <= (int64) 0) {
                    going = false;
                } else {
                    n = n + (int32) r;
                }
            }
            c.that(DispatchTests.contains(buf, n, " 413 "), "the request ends with 413");
            s.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }

    /** 7.1.3: stream mode: a 64 MB part is read incrementally by the handler, in bounded memory. */
    static void streamMode(Check c) {
        scope {
            HttpServer srv #= MultipartDispatchTests.server(0, 0);
            Task<int32> sv = spawn serveIt(srv);
            DispatchTests.settle(srv);
            int32 port = MultipartDispatchTests.port(srv);
            int32 chunk = 1048576;
            int32 chunks = 64;
            int64 total = (int64) chunk * (int64) chunks;
            int8[] data #= MultipartDispatchTests.fill(chunk, 3);
            TcpStream s #= DispatchTests.connectRaw(port);
            DispatchTests.sendRaw(s, "POST /big HTTP/1.1\r\nHost: t\r\n"
                + "Content-Type: multipart/form-data; boundary=XYZ\r\nContent-Length: " + total + "\r\n\r\n");
            int32 i = 0;
            while (i < chunks) {
                s.writeAllAsync(data, (int64) 0, (int64) chunk);
                i = i + 1;
            }
            int8[] buf = heap int8[2048];
            int32 n = 0;
            boolean going = true;
            while (going) {
                int64 r = DispatchTests.readStep(s, buf, n, 10000);
                if (r <= (int64) 0) {
                    going = false;
                } else {
                    n = n + (int32) r;
                    if (DispatchTests.contains(buf, n, "n=" + total)) {
                        going = false;
                    }
                }
            }
            c.that(DispatchTests.contains(buf, n, " 200 "), "the upload is answered");
            c.that(DispatchTests.contains(buf, n, "n=" + total), "the handler read every byte");
            c.eqInt(MultipartDispatchTests.streamBytes, total, "counted incrementally");
            c.that(MultipartDispatchTests.streamAlloc < (int64) 8388608,
                "in bounded memory (" + MultipartDispatchTests.streamAlloc + " bytes allocated)");
            s.close();
            srv.shutdown(Duration.ofSeconds(2));
            await sv;
        }
    }
}
