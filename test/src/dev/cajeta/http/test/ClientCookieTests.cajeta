package dev.cajeta.http.test;

import cajeta.io.net.Server;
import cajeta.io.net.TcpStream;
import cajeta.lang.Slice;
import cajeta.lang.String;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;

/**
 * The client's `CookieJar`, off by default, against a loopback server that
 * sets cookies and echoes back the `Cookie` header a request carried.
 */
public final class ClientCookieTests {

    public static void run(Check c) {
        System.stdout.println("-- client cookies: off by default --");
        offByDefault(c);
        System.stdout.println("-- client cookies: jar round-trip --");
        jarRoundTrip(c);
        System.stdout.println("-- client cookies: path scope --");
        pathScope(c);
        System.stdout.println("-- client cookies: expiry --");
        expiry(c);
        System.stdout.println("-- client cookies: secure + foreign domain --");
        withheld(c);
    }

    static void setOne(HttpResponse r, String header, String body) {
        r.setHeader("Set-Cookie", header);
        r.body(body);
    }

    static void echoCookie(HttpRequest q, HttpResponse r) {
        if (q.hasHeader("cookie")) {
            r.bodyBytes(q.header("cookie"));
        } else {
            r.body("-");
        }
    }

    static void handle(HttpRequest q, HttpResponse r) {
        Slice<int8> t = q.target();
        if (Bytes.equals(t, "/set")) {
            ClientCookieTests.setOne(r, "sid=abc; Path=/", "set");
            return;
        }
        if (Bytes.equals(t, "/settwo")) {
            r.header("Set-Cookie", "a=1; Path=/");
            r.header("Set-Cookie", "b=2; Path=/");
            r.body("two");
            return;
        }
        if (Bytes.equals(t, "/setpath")) {
            ClientCookieTests.setOne(r, "app=1; Path=/app", "set");
            return;
        }
        if (Bytes.equals(t, "/kill")) {
            ClientCookieTests.setOne(r, "sid=gone; Path=/; Max-Age=0", "killed");
            return;
        }
        if (Bytes.equals(t, "/setsecure")) {
            ClientCookieTests.setOne(r, "sec=1; Path=/; Secure", "set");
            return;
        }
        if (Bytes.equals(t, "/setforeign")) {
            ClientCookieTests.setOne(r, "f=1; Domain=other.test; Path=/", "set");
            return;
        }
        if (Bytes.equals(t, "/setfuture")) {
            ClientCookieTests.setOne(r, "fut=1; Path=/; Expires=Wed, 01 Jan 2031 00:00:00 GMT", "set");
            return;
        }
        if (Bytes.equals(t, "/setpast")) {
            ClientCookieTests.setOne(r, "past=1; Path=/; Expires=Mon, 01 Jan 2001 00:00:00 GMT", "set");
            return;
        }
        if (Bytes.equals(t, "/echo") || Bytes.equals(t, "/app/echo")) {
            ClientCookieTests.echoCookie(q, r);
            return;
        }
        r.status(404);
    }

    /** Accepts and dispatches until the listener closes, and returns the connection count. */
    public static async int32 acceptLoop(Server core) {
        int32 n = 0;
        boolean going = true;
        while (going) {
            TcpStream conn #= core.acceptNext();
            if (conn == null) {
                going = false;
            } else {
                core.dispatch(#conn);
                n = n + 1;
            }
        }
        return n;
    }

    static #HttpServer cookieServer() {
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> ClientCookieTests.handle(q, r));
        return b.build();
    }

    /** GETs `path` with `client` and returns the body text, or null on a non-200. */
    static #String getText(HttpClient client, int32 port, String path) {
        ClientResponse resp #= client.get("http://127.0.0.1:" + port + path);
        if (resp.status() != 200) {
            return null;
        }
        return resp.bodyString();
    }

    /** The default client never stores or returns a cookie. */
    public static async int32 noJar(int32 port) {
        HttpClient client = heap HttpClient();
        String s #= ClientCookieTests.getText(client, port, "/set");
        if (s == null || !s.equals("set")) { return -1; }
        String e #= ClientCookieTests.getText(client, port, "/echo");
        if (e == null) { return -2; }
        if (!e.equals("-")) {
            System.stdout.println("  (no-jar echo: '{}')", e);
            return -3;
        }
        return 1;
    }

    /** Set, then return across exchanges, and two Set-Cookie fields both stick. */
    public static async int32 roundTrip(int32 port) {
        HttpClient client #= HttpClient.builder().cookieJar().build();
        String s #= ClientCookieTests.getText(client, port, "/set");
        if (s == null) { return -1; }
        String e1 #= ClientCookieTests.getText(client, port, "/echo");
        if (e1 == null || !e1.equals("sid=abc")) {
            System.stdout.println("  (round-trip echo 1: '{}')", e1);
            return -2;
        }
        String s2 #= ClientCookieTests.getText(client, port, "/settwo");
        if (s2 == null) { return -3; }
        String e2 #= ClientCookieTests.getText(client, port, "/echo");
        if (e2 == null || !e2.equals("sid=abc; a=1; b=2")) {
            System.stdout.println("  (round-trip echo 2: '{}')", e2);
            return -4;
        }
        return 1;
    }

    /** A `/app`-scoped cookie rides `/app/echo`, never `/echo`. */
    public static async int32 pathScoped(int32 port) {
        HttpClient client #= HttpClient.builder().cookieJar().build();
        String s #= ClientCookieTests.getText(client, port, "/setpath");
        if (s == null) { return -1; }
        String top #= ClientCookieTests.getText(client, port, "/echo");
        if (top == null || !top.equals("-")) {
            System.stdout.println("  (path-scope top echo: '{}')", top);
            return -2;
        }
        String app #= ClientCookieTests.getText(client, port, "/app/echo");
        if (app == null || !app.equals("app=1")) {
            System.stdout.println("  (path-scope app echo: '{}')", app);
            return -3;
        }
        return 1;
    }

    /** Max-Age=0 deletes, a past Expires never stores, a future Expires does. */
    public static async int32 expiryDrops(int32 port) {
        HttpClient client #= HttpClient.builder().cookieJar().build();
        String s #= ClientCookieTests.getText(client, port, "/set");
        if (s == null) { return -1; }
        String e1 #= ClientCookieTests.getText(client, port, "/echo");
        if (e1 == null || !e1.equals("sid=abc")) { return -2; }
        String k #= ClientCookieTests.getText(client, port, "/kill");
        if (k == null) { return -3; }
        String e2 #= ClientCookieTests.getText(client, port, "/echo");
        if (e2 == null || !e2.equals("-")) {
            System.stdout.println("  (post-kill echo: '{}')", e2);
            return -4;
        }
        String f #= ClientCookieTests.getText(client, port, "/setfuture");
        if (f == null) { return -5; }
        String e3 #= ClientCookieTests.getText(client, port, "/echo");
        if (e3 == null || !e3.equals("fut=1")) {
            System.stdout.println("  (future-expires echo: '{}')", e3);
            return -6;
        }
        String p #= ClientCookieTests.getText(client, port, "/setpast");
        if (p == null) { return -7; }
        String e4 #= ClientCookieTests.getText(client, port, "/echo");
        if (e4 == null || !e4.equals("fut=1")) {
            System.stdout.println("  (past-expires echo: '{}')", e4);
            return -8;
        }
        return 1;
    }

    /** Secure is withheld over http, and a foreign Domain is rejected at store. */
    public static async int32 secureAndForeign(int32 port) {
        HttpClient client #= HttpClient.builder().cookieJar().build();
        String s #= ClientCookieTests.getText(client, port, "/setsecure");
        if (s == null) { return -1; }
        String e1 #= ClientCookieTests.getText(client, port, "/echo");
        if (e1 == null || !e1.equals("-")) {
            System.stdout.println("  (secure-over-http echo: '{}')", e1);
            return -2;
        }
        String f #= ClientCookieTests.getText(client, port, "/setforeign");
        if (f == null) { return -3; }
        String e2 #= ClientCookieTests.getText(client, port, "/echo");
        if (e2 == null || !e2.equals("-")) {
            System.stdout.println("  (foreign-domain echo: '{}')", e2);
            return -4;
        }
        return 1;
    }

    static void offByDefault(Check c) {
        scope {
            HttpServer srv #= ClientCookieTests.cookieServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn noJar(port);
            c.eqInt((int64) await t1, 1, "no jar: nothing echoed back");
            core.listener.close();
            c.eqInt((int64) await s1, 1, "no-jar pair rode one connection");
        }
    }

    static void jarRoundTrip(Check c) {
        scope {
            HttpServer srv #= ClientCookieTests.cookieServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn roundTrip(port);
            c.eqInt((int64) await t1, 1, "jar returns stored cookies across exchanges");
            core.listener.close();
            c.eqInt((int64) await s1, 1, "round-trip rode one connection");
        }
    }

    static void pathScope(Check c) {
        scope {
            HttpServer srv #= ClientCookieTests.cookieServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn pathScoped(port);
            c.eqInt((int64) await t1, 1, "Path attribute scopes the send");
            core.listener.close();
            c.eqInt((int64) await s1, 1, "path-scope legs rode one connection");
        }
    }

    static void expiry(Check c) {
        scope {
            HttpServer srv #= ClientCookieTests.cookieServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn expiryDrops(port);
            c.eqInt((int64) await t1, 1, "Max-Age=0 deletes; Expires stores future, drops past");
            core.listener.close();
            c.eqInt((int64) await s1, 1, "expiry legs rode one connection");
        }
    }

    static void withheld(Check c) {
        scope {
            HttpServer srv #= ClientCookieTests.cookieServer();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn secureAndForeign(port);
            c.eqInt((int64) await t1, 1, "Secure withheld over http; foreign Domain rejected");
            core.listener.close();
            c.eqInt((int64) await s1, 1, "withheld legs rode one connection");
        }
    }
}
