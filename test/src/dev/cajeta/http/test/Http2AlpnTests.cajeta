package dev.cajeta.http.test;

import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.tls.TlsStream;
import cajeta.error.Exception;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;

/**
 * ALPN negotiation: the shipped client and the TLS server select h2 and the same
 * handler answers, while a client offering only http/1.1 negotiates http/1.1.
 */
public final class Http2AlpnTests {

    /** Echoes the request's protocol version as the body. */
    public static void handle(HttpRequest q, HttpResponse r) {
        r.body(q.version().wireString());
    }

    static #HttpServer tlsServer() {
        String cp #= ClientBuilderTests.certPem();
        String kp #= ClientBuilderTests.keyPem();
        int8[] cert #= cp.toBytes();
        int8[] key #= kp.toBytes();
        HttpServerBuilder b #= HttpServer.builder();
        b.bind("127.0.0.1:0");
        b.handler((HttpRequest q, HttpResponse r) -> Http2AlpnTests.handle(q, r));
        b.tls(cert, cp.byteLength(), key, kp.byteLength());
        return b.build();
    }

    public static async int32 acceptTlsOnce(HttpServer srv) {
        TcpStream conn #= srv.acceptTlsNext();
        srv.dispatchTls(#conn);
        return 1;
    }

    /** 1 when the body is "HTTP/2", 2 when it is "HTTP/1.1", negative otherwise. */
    public static async int32 h2Client(int32 port) {
        String cp #= ClientBuilderTests.certPem();
        int8[] anchor #= cp.toBytes();
        HttpClient client #= HttpClient.builder()
            .trustAnchor(anchor, cp.byteLength())
            .build();
        String url = "https://127.0.0.1:" + port + "/proto";
        ClientResponse resp #= client.get(url);
        if (resp.status() != 200) {
            return -1;
        }
        String body #= resp.bodyString();
        if (body.equals("HTTP/2")) {
            return 1;
        }
        if (body.equals("HTTP/1.1")) {
            return 2;
        }
        return -2;
    }

    static #int8[] alpnHttp11() {
        int8[] a = heap int8[9];
        a[0] = (int8) 8;
        a[1] = (int8) 104;  a[2] = (int8) 116;  a[3] = (int8) 116;
        a[4] = (int8) 112;  a[5] = (int8) 47;   a[6] = (int8) 49;
        a[7] = (int8) 46;   a[8] = (int8) 49;
        return #a;
    }

    /** 1 when a client offering only http/1.1 negotiates http/1.1. */
    public static async int32 h1FallbackClient(int32 port) {
        String cp #= ClientBuilderTests.certPem();
        IpAddress ip #= IpAddress.loopbackV4();
        SocketAddress a #= SocketAddress.of(#ip, port);
        TcpStream sock #= TcpStream.connectAsync(#a);
        String host = "127.0.0.1";
        int8[] hostBytes #= host.toBytes();
        int8[] anchor #= cp.toBytes();
        TlsStream tls #= TlsStream.client(#sock, hostBytes, host.byteLength(),
                                         anchor, cp.byteLength());
        int8[] alpn #= Http2AlpnTests.alpnHttp11();
        tls.offerAlpn(alpn, 9);
        tls.handshake();
        int8[] sel = heap int8[16];
        int32 selLen = tls.negotiatedAlpn(sel, 16);
        boolean h1 = selLen == 8 && sel[0] == (int8) 104 && sel[1] == (int8) 116;
        tls.close();
        return h1 ? 1 : -1;
    }

    static void h2Negotiated(Check c) {
        scope {
            HttpServer srv #= Http2AlpnTests.tlsServer();
            int32 port = srv.tlsListener.boundPort();
            Task<int32> s1 = spawn acceptTlsOnce(srv);
            Task<int32> t1 = spawn h2Client(port);
            c.eqInt((int64) await t1, 1,
                    "ALPN selects h2: same handler served over HTTP/2");
            c.eqInt((int64) await s1, 1, "h2 exchange accepted once");
        }
    }

    static void h1Fallback(Check c) {
        scope {
            HttpServer srv #= Http2AlpnTests.tlsServer();
            int32 port = srv.tlsListener.boundPort();
            Task<int32> s1 = spawn acceptTlsOnce(srv);
            Task<int32> t1 = spawn h1FallbackClient(port);
            c.eqInt((int64) await t1, 1,
                    "ALPN http/1.1-only client negotiates http/1.1, not h2");
            c.eqInt((int64) await s1, 1, "fallback exchange accepted once");
        }
    }

    public static void run(Check c) {
        System.stdout.println("-- h2 alpn: h2 negotiated over TLS --");
        Http2AlpnTests.h2Negotiated(c);
        System.stdout.println("-- h2 alpn: http/1.1 fallback --");
        Http2AlpnTests.h1Fallback(c);
    }
}
