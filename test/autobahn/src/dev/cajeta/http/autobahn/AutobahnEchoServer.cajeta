package dev.cajeta.http.autobahn;

import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.ws.WsUpgrade;

/**
 * The Autobahn testee: an HttpServer whose one handler upgrades every request
 * to a WebSocket echoed by `AutobahnEcho`, with permessage-deflate offered.
 */
public final class AutobahnEchoServer {
    public static int32 main() {
        AutobahnEcho echo = heap AutobahnEcho();
        (HttpRequest, HttpResponse) -> void h = (HttpRequest q, HttpResponse r) -> {
            WsUpgrade.accept(q, r, echo, true);
        };
        HttpServer srv #= HttpServer.bind("127.0.0.1:9001", h);
        System.stdout.println("autobahn echo server: ws://127.0.0.1:9001");
        srv.serve();
        return 0;
    }
}
