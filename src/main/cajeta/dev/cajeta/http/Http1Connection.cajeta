package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.lang.Slice;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.ByteChannel;
import cajeta.io.net.TimedOutException;
import cajeta.error.Exception;
import cajeta.time.Clock;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.body.MultipartParser;
import dev.cajeta.http.server.MultipartMode;
import dev.cajeta.http.server.MultipartRoutes;

/**
 * One HTTP/1.1 connection: reads each request into the input buffer,
 * parses it in place, runs the handler over the request view and the
 * response writer, and writes the response from the output buffer. The
 * request, response and scanner are made once and reused for every
 * request on the connection.
 */
public final class Http1Connection {
    ByteChannel ch;
    ByteBuffer in;
    ByteBuffer out;
    HeadScanner scanner;
    HttpRequest req;
    HttpResponse res;
    (HttpRequest, HttpResponse) -> void handler;
    int32 headMs;
    int32 bodyMs;
    int64 maxBody;
    boolean expectEnabled;
    int32 consumed;
    boolean streaming;
    RequestBodyChannel bodyChan;
    RequestBody streamed;
    boolean inStream;
    // Multipart per route (spec §2.3, §4.6): the server's PART and STREAM
    // routes, the largest part a PART route accepts, and the PART state: the
    // head copied aside (the body streams through `in` and is compacted
    // away) and the parser the loop feeds.
    MultipartRoutes mpRoutes;
    int32 maxPartBytes;
    int8[] mpHead;
    int32 mpHeadLen;
    MultipartParser mp;

    static final int64 DRAIN_LIMIT = 262144;

    /**
     * A connection over `ch` reading into `in` and writing from `out`. Both
     * buffers are borrowed and must outlive the connection.
     */
    public Http1Connection(ByteChannel ch, ByteBuffer in, ByteBuffer out,
                           HttpParserLimits parse, int32 headMs, int32 bodyMs,
                           int64 maxBody, boolean expectEnabled,
                           (HttpRequest, HttpResponse) -> void handler) {
        this.ch #= ch;
        this.in #= in;
        this.out #= out;
        this.scanner = heap HeadScanner(parse);
        this.req = heap HttpRequest(parse.maxHeaderCount);
        this.res = heap HttpResponse(out, ch, 4096, 64);
        this.handler #= handler;
        this.headMs = headMs;
        this.bodyMs = bodyMs;
        this.maxBody = maxBody;
        this.expectEnabled = expectEnabled;
        this.consumed = 0;
        this.streaming = false;
        this.bodyChan = null;
        this.streamed = null;
        this.inStream = false;
        this.mpRoutes = null;
        this.maxPartBytes = MultipartParser.DEFAULT_MAX_PART_BYTES;
        this.mpHead = null;
        this.mpHeadLen = 0;
        this.mp = null;
    }

    /**
     * Streams request bodies to the handler instead of holding them, so a body
     * larger than the input buffer is served. Returns this connection.
     */
    public Http1Connection streamRequestBodies(boolean on) {
        this.streaming = on;
        if (on) {
            this.ensureStreamObjects();
        }
        return this;
    }

    /**
     * Applies the server's per-route multipart modes (spec §2.3) on this
     * connection, as the framer does under the pool (spec §4.6): a PART route
     * runs the handler once per completed part, a STREAM route hands the body
     * over at head complete. `routes` may be null when every route is WHOLE.
     */
    public Http1Connection multipartRoutes(MultipartRoutes routes, int32 maxPartBytes) {
        this.mpRoutes #= routes;   // the server lends its routes; the store records the borrow
        this.maxPartBytes = maxPartBytes;
        return this;
    }

    /** The streamed-body objects, built on first use: a STREAM route needs them without global streaming. */
    void ensureStreamObjects() {
        if (this.bodyChan == null) {
            this.bodyChan = heap RequestBodyChannel();
            this.streamed = heap RequestBody(this.bodyChan);
        }
    }

    boolean overCap(int64 n) {
        return this.maxBody > 0 && n > this.maxBody;
    }

    /** Serves requests until the peer closes or a response ends reuse. */
    public void serve() {
        boolean more = true;
        while (more) {
            try {
                more = this.serveOne();
            } catch (TimedOutException t) {
                this.refuse(408);
                more = false;
            } catch (HttpException e) {
                this.refuse(e.httpStatus());
                more = false;
            } catch (Exception e) {
                more = false;
            }
        }
    }

    void refuse(int32 status) {
        try {
            this.res.reset();
            this.res.status(status);
            if (this.res.finish(false, Version.HTTP_1_1, false)) {
                this.out.writeToAsync(this.ch);
            }
        } catch (Exception e) {
        }
    }

    int32 remaining(int64 deadline) {
        if (deadline <= 0) {
            return 0;
        }
        int64 left = deadline - Clock.now().toEpochMilli();
        if (left < 1) {
            return 1;
        }
        if (left > (int64) 2147483647) {
            return 2147483647;
        }
        return (int32) left;
    }

    int32 readHead() {
        int64 deadline = 0;
        int32 h = this.scanner.scan(this.in);
        while (h < 0) {
            if (this.in.writable() == 0) {
                throw heap HeadersTooLargeException("head exceeds the input buffer",
                    (int64) this.in.capacity(), (int64) this.in.readable());
            }
            int32 ms = this.headMs;
            if (deadline > 0) {
                ms = this.remaining(deadline);
            }
            boolean first = this.in.readable() == 0;
            int32 n = this.in.fillWithin(this.ch, ms);
            if (n == 0) {
                if (first) {
                    return -1;
                }
                throw heap UnexpectedEofException("stream ended inside the request head",
                    (int64) this.in.readable());
            }
            if (first && this.headMs > 0) {
                deadline = Clock.now().toEpochMilli() + (int64) this.headMs;
            }
            h = this.scanner.scan(this.in);
        }
        return h;
    }

    void need(int32 total) {
        while (this.in.readable() < total) {
            if (this.in.fillWithin(this.ch, this.bodyMs) == 0) {
                throw heap UnexpectedEofException("stream ended inside the request body",
                    (int64) this.in.readable());
            }
        }
    }

    int32 expectation() {
        int32 i = this.req.table.find("expect", 0);
        if (i < 0) {
            return 0;
        }
        if (!Bytes.equalsIgnoreCase(this.req.table.valueAt(i), "100-continue")) {
            return 417;
        }
        if (!this.expectEnabled) {
            return 0;
        }
        if (this.req.framing == HttpRequest.FRAMING_LENGTH && this.overCap(this.req.declaredLength)) {
            return 413;
        }
        if (this.req.versionKind != Version.HTTP_1_1) {
            return 0;
        }
        return 100;
    }

    void sendContinue() {
        this.out.clear();
        int8[] a = this.out.array();
        int32 end = HttpResponse.put(a, 0, "HTTP/1.1 100 Continue\r\n\r\n");
        this.out.advanceWrite(end);
        this.out.writeToAsync(this.ch);
    }

    static int32 hexDigit(int8 b) {
        int32 c = ((int32) b) & 255;
        return Bytes.hexValue(c);
    }

    int32 lineEnd(int32 from) {
        int8[] a = this.in.array();
        int32 p = from;
        while (true) {
            int32 end = this.in.writePosition();
            while (p + 1 < end) {
                if (a[p] == (int8) 13 && a[p + 1] == (int8) 10) {
                    return p;
                }
                p = p + 1;
            }
            if (this.in.writable() == 0) {
                throw heap PayloadTooLargeException("chunked body exceeds the input buffer",
                    (int64) this.in.capacity(), (int64) this.in.readable());
            }
            if (this.in.fillWithin(this.ch, this.bodyMs) == 0) {
                throw heap UnexpectedEofException("stream ended inside a chunked body",
                    (int64) this.in.readable());
            }
        }
        return -1;
    }

    int32 dechunk(int32 start) {
        int8[] a = this.in.array();
        int32 dst = start;
        int32 src = start;
        while (true) {
            int32 le = this.lineEnd(src);
            int64 size = 0;
            int32 p = src;
            int32 digits = 0;
            while (p < le && a[p] != (int8) 59) {
                int32 d = Http1Connection.hexDigit(a[p]);
                if (d < 0 || digits >= 8) {
                    throw heap InvalidChunkEncodingException("bad chunk size", (int64) (p - start));
                }
                size = size * 16 + (int64) d;
                digits = digits + 1;
                p = p + 1;
            }
            if (digits == 0) {
                throw heap InvalidChunkEncodingException("empty chunk size", (int64) (src - start));
            }
            src = le + 2;
            if (size == 0) {
                int32 t = this.lineEnd(src);
                while (t != src) {
                    src = t + 2;
                    t = this.lineEnd(src);
                }
                this.consumed = src + 2;
                return dst;
            }
            if (this.overCap((int64) (dst - start) + size)) {
                throw heap PayloadTooLargeException("chunked body over the limit",
                    this.maxBody, (int64) (dst - start) + size);
            }
            int32 n = (int32) size;
            if (src + n + 2 > this.in.capacity()) {
                throw heap PayloadTooLargeException("chunked body exceeds the input buffer",
                    (int64) this.in.capacity(), (int64) (src + n + 2));
            }
            this.need(src + n + 2 - this.in.readPosition());
            if (a[src + n] != (int8) 13 || a[src + n + 1] != (int8) 10) {
                throw heap InvalidChunkEncodingException("chunk data not followed by CRLF",
                    (int64) (src + n - start));
            }
            if (dst != src) {
                int32 i = 0;
                while (i < n) {
                    a[dst + i] = a[src + i];
                    i = i + 1;
                }
            }
            dst = dst + n;
            src = src + n + 2;
        }
        return dst;
    }

    /**
     * Reads or binds the request body after a head of `headLen` bytes.
     * `streamThis` is a STREAM multipart route (spec §2.3): the body is handed
     * to the handler at head complete as it is for every request under
     * `streamRequestBodies(true)`, and the declared length is not held to
     * `maxBodyBytes`, as under the framer.
     */
    boolean readBody(int32 headLen, boolean streamThis) {
        int32 start = this.in.readPosition() + headLen;
        this.consumed = start;
        this.inStream = false;
        if (!streamThis && this.req.framing == HttpRequest.FRAMING_LENGTH && this.overCap(this.req.declaredLength)) {
            throw heap PayloadTooLargeException("body over the limit", this.maxBody, this.req.declaredLength);
        }
        if ((this.streaming || streamThis) && this.req.framing != HttpRequest.FRAMING_NONE) {
            this.ensureStreamObjects();
            if (start >= this.in.capacity()) {
                throw heap HeadersTooLargeException("head leaves no room for the body",
                    (int64) this.in.capacity(), (int64) start);
            }
            boolean chunked = this.req.framing == HttpRequest.FRAMING_CHUNKED;
            this.bodyChan.begin(this.ch, this.in.array(), start, this.in.writePosition(), this.in.capacity(),
                chunked, this.req.declaredLength, this.bodyMs, this.maxBody);
            this.streamed.reset(this.req, chunked ? (int64) -1 : this.req.declaredLength);
            this.req.bindStream(this.streamed);
            this.inStream = true;
            return true;
        }
        if (this.req.framing == HttpRequest.FRAMING_LENGTH) {
            int64 n = this.req.declaredLength;
            if (this.overCap(n)) {
                throw heap PayloadTooLargeException("body over the limit", this.maxBody, n);
            }
            if ((int64) start + n > (int64) this.in.capacity()) {
                throw heap PayloadTooLargeException("body exceeds the input buffer",
                    (int64) (this.in.capacity() - start), n);
            }
            this.need(headLen + (int32) n);
            this.req.bodyOff = start;
            this.req.bodyLen = (int32) n;
            this.consumed = start + (int32) n;
            return true;
        }
        if (this.req.framing == HttpRequest.FRAMING_CHUNKED) {
            int32 end = this.dechunk(start);
            this.req.bodyOff = start;
            this.req.bodyLen = end - start;
            return true;
        }
        return true;
    }

    void dispatch() {
        this.res.reset();
        this.runHandler();
    }

    void runHandler() {
        try {
            (HttpRequest, HttpResponse) -> void fn = this.handler;
            fn(this.req, this.res);
        } catch (TimedOutException t) {
            if (this.res.isCommitted()) {
                throw t;
            }
            this.res.reset();
            this.res.status(408);
        } catch (HttpException e) {
            if (this.res.isCommitted()) {
                throw e;
            }
            this.res.reset();
            this.res.status(e.httpStatus());
        } catch (Exception e) {
            if (this.res.isCommitted()) {
                throw e;
            }
            this.res.reset();
            this.res.status(500);
        }
    }

    // Runs the response's takeover over this channel, bytes already read first.
    void switchProtocols() {
        Takeover t #= this.res.takeUpgrade();
        int32 cap = this.in.readable() > 8192 ? this.in.readable() : 8192;
        AsyncReader reader = heap AsyncReader(this.ch, cap);
        if (this.in.readable() > 0) {
            reader.stage(this.in.array(), this.in.readable());
            this.in.advanceRead(this.in.readable());
        }
        AsyncWriter writer = heap AsyncWriter(this.ch);
        t.attach(this.ch);
        t.run(reader, writer);
    }

    /** Serves one request. Returns false when the connection should close. */
    boolean serveOne() {
        this.scanner.reset();
        int32 h = this.readHead();
        if (h < 0) {
            return false;
        }
        HeadScanner.parseRequest(this.in.array(), this.in.readPosition(), h, this.req);
        int32 ex = this.expectation();
        if (ex == 417 || ex == 413) {
            this.refuse(ex);
            return false;
        }
        if (ex == 100 && this.in.readable() == h) {
            this.sendContinue();
        }
        int32 mode = MultipartMode.WHOLE;
        if (this.mpRoutes != null && this.req.framing != HttpRequest.FRAMING_NONE) {
            mode = this.mpRoutes.modeFor(this.req);
        }
        if (mode == MultipartMode.PART && this.req.framing == HttpRequest.FRAMING_LENGTH) {
            // A chunked multipart body on a PART route is held whole, as under the framer.
            return this.serveParts(h);
        }
        this.readBody(h, mode == MultipartMode.STREAM);
        this.dispatch();
        boolean reuse = this.req.reuse;
        if (this.inStream && !this.bodyChan.drain(Http1Connection.DRAIN_LIMIT)) {
            reuse = false;
        }
        boolean omit = this.req.methodKind == Method.HEAD;
        if (this.res.finish(reuse, this.req.versionKind, omit)) {
            this.out.writeToAsync(this.ch);
        }
        boolean keep = this.res.keepsAlive() && reuse;
        if (this.inStream) {
            this.req.bindBody(0, 0);
            this.bodyChan.restore(this.in);
        } else {
            this.in.advanceRead(this.consumed - this.in.readPosition());
            this.in.compact();
        }
        if (this.res.upgrades()) {
            this.switchProtocols();
            return false;
        }
        return keep;
    }

    /**
     * Serves a length-framed request on a PART multipart route (spec §2.3.2):
     * the head is copied aside, the body is fed to the parser from the input
     * buffer as it arrives, and the handler runs once per completed part, in
     * order, with the response sent after the last. A part is dispatched only
     * once it is known whether it is the last, so a delimiter split across
     * reads cannot run the final part with `multipartLast()` false. An empty
     * form runs the handler once with no part. Returns the keep-alive decision.
     */
    boolean serveParts(int32 h) {
        MediaType ct #= this.req.contentType();
        String bound #= MultipartParser.boundaryOf(ct);
        if (bound == null || bound.byteLength() == 0) {
            this.refuse(400);
            return false;
        }
        if (this.mpHead == null || this.mpHead.count() < (int64) h) {
            this.mpHead = heap int8[h];
        }
        int8[] src = this.in.array();
        int32 from = this.in.readPosition();
        int32 i = 0;
        while (i < h) {
            this.mpHead[i] = src[from + i];
            i = i + 1;
        }
        this.mpHeadLen = h;
        this.mp #= MultipartParser.forBoundaryWithLimits(bound, MultipartParser.DEFAULT_MAX_PARTS,
            this.maxPartBytes);
        int64 remaining = this.req.declaredLength;
        this.in.advanceRead(h);
        this.in.compact();
        int32 queued = 0;
        boolean keep = true;
        boolean done = false;
        while (!done) {
            int32 avail = this.in.readable();
            if ((int64) avail > remaining) {
                avail = (int32) remaining;
            }
            if (avail > 0) {
                this.mp.feedFrom(this.in.array(), this.in.readPosition(), avail);
                this.in.advanceRead(avail);
                remaining = remaining - (int64) avail;
                this.in.compact();
            }
            boolean complete = this.mp.isComplete();
            // Part i is dispatched once a later part has begun or the closing
            // delimiter has been seen: only then is `last` known.
            while (queued < this.mp.partCount() && (queued < this.mp.partCount() - 1 || complete)) {
                boolean last = complete && queued == this.mp.partCount() - 1;
                keep = this.partTurn(queued, last);
                queued = queued + 1;
            }
            if (complete && this.mp.partCount() == 0 && queued == 0) {
                // An empty form: the handler runs once with no part.
                keep = this.partTurn(-1, true);
                queued = 1;
            }
            if (remaining <= (int64) 0) {
                this.mp.endInput();   // raises when the closing delimiter never came
                done = true;
            } else if (this.in.fillWithin(this.ch, this.bodyMs) == 0) {
                throw heap UnexpectedEofException("stream ended inside the request body",
                    (int64) this.in.readable());
            }
        }
        this.mp = null;
        this.req.mpPart = null;
        if (this.res.upgrades()) {
            this.switchProtocols();
            return false;
        }
        return keep;
    }

    /**
     * One part of a PART-mode request: the handler runs with the part on the
     * request; after the last part the response goes out as for any request.
     * Returns the keep-alive decision (true while parts remain).
     */
    boolean partTurn(int32 idx, boolean last) {
        HeadScanner.parseRequest(this.mpHead, 0, this.mpHeadLen, this.req);
        this.req.bodyOff = 0;
        this.req.bodyLen = 0;
        this.req.mpIndex = idx < 0 ? 0 : idx;
        this.req.mpPart = idx >= 0 ? this.mp.part(idx) : null;
        this.req.mpLast = last;
        if (idx <= 0) {
            this.res.reset();
        }
        this.runHandler();
        if (!last) {
            return true;
        }
        boolean reuse = this.req.reuse;
        boolean omit = this.req.methodKind == Method.HEAD;
        if (this.res.finish(reuse, this.req.versionKind, omit)) {
            this.out.writeToAsync(this.ch);
        }
        return this.res.keepsAlive() && reuse;
    }
}
