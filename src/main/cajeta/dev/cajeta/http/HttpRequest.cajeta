package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.lang.Slice;
import dev.cajeta.http.body.Body;

/**
 * An inbound request, as windows into the connection's input buffer.
 *
 * The server owns one per connection and reuses it for every request, so
 * every window is valid until the handler returns. A value that must outlive
 * the request is copied with one of the `String` accessors.
 */
public final class HttpRequest {
    int8[] none;
    int8[] src;
    Method methodKind;
    int32 methodOff;
    int32 methodLen;
    Version versionKind;
    int32 versionOff;
    int32 versionLen;
    int32 targetOff;
    int32 targetLen;
    int32 pathLen;
    HeaderTable table;
    int32 framing;
    int64 declaredLength;
    boolean reuse;
    int32 bodyOff;
    int32 bodyLen;
    Body stream;
    String[] paramNames;
    int32[] paramSpans;
    int32 paramCount;
    int32[] segSpans;
    int32 segCount;

    static int32 FRAMING_NONE = 0;
    static int32 FRAMING_LENGTH = 1;
    static int32 FRAMING_CHUNKED = 2;

    /** An empty request whose header table holds at most `maxHeaders` fields. */
    public HttpRequest(int32 maxHeaders) {
        this.table = heap HeaderTable(maxHeaders);
        this.paramSpans = heap int32[32];
        this.segSpans = heap int32[256];
        this.paramNames = null;
        this.none = heap int8[0];
        this.src #= this.none;
        this.stream = null;
        this.clear();
    }

    void clear() {
        this.methodKind = Method.GET;
        this.methodOff = 0;
        this.methodLen = 0;
        this.versionKind = Version.HTTP_1_1;
        this.versionOff = 0;
        this.versionLen = 0;
        this.targetOff = 0;
        this.targetLen = 0;
        this.pathLen = 0;
        this.framing = HttpRequest.FRAMING_NONE;
        this.declaredLength = -1;
        this.reuse = true;
        this.bodyOff = 0;
        this.bodyLen = 0;
        this.stream = null;
        this.paramNames = null;
        this.paramCount = 0;
        this.segCount = 0;
    }

    void rebind(int8[] store) {
        this.clear();
        this.src #= store;
        this.table.reset(store);
    }

    /** The method, or EXTENSION for one the enum does not name. */
    public Method method() {
        return this.methodKind;
    }

    /** The method token as sent. */
    public Slice<int8> methodBytes() {
        return this.src[this.methodOff:this.methodOff + this.methodLen];
    }

    /** True when the method token equals `token` exactly. */
    public boolean methodIs(String token) {
        return Bytes.equals(this.methodBytes(), token);
    }

    /** The protocol version. */
    public Version version() {
        return this.versionKind;
    }

    /** The request target as sent: path and query. */
    public Slice<int8> target() {
        return this.src[this.targetOff:this.targetOff + this.targetLen];
    }

    /** The path part of the target, without the query. */
    public Slice<int8> path() {
        return this.src[this.targetOff:this.targetOff + this.pathLen];
    }

    /** True when the target carries a `?` query. */
    public boolean hasQuery() {
        return this.pathLen < this.targetLen;
    }

    /** The query after `?`, or an empty window. */
    public Slice<int8> query() {
        if (this.pathLen >= this.targetLen) {
            return this.src[0:0];
        }
        int32 q = this.targetOff + this.pathLen + 1;
        return this.src[q:this.targetOff + this.targetLen];
    }

    /** An owned copy of the target. */
    public #String targetString() {
        return Bytes.toString(this.target());
    }

    /** An owned copy of the path. */
    public #String pathString() {
        return Bytes.toString(this.path());
    }

    /** The header fields. */
    public HeaderTable headers() {
        return this.table;
    }

    /** The first value of header `name`, or an empty window. */
    public Slice<int8> header(String name) {
        return this.table.get(name);
    }

    /** True when header `name` is present. */
    public boolean hasHeader(String name) {
        return this.table.has(name);
    }

    /** True when header `name` equals `value`, ignoring case. */
    public boolean headerIs(String name, String value) {
        return this.table.is(name, value);
    }

    /** True when header `name` lists `token`, ignoring case. */
    public boolean headerHasToken(String name, String token) {
        return this.table.hasToken(name, token);
    }

    /** Header `name` as a non-negative integer, or `fallback`. */
    public int64 headerInt64(String name, int64 fallback) {
        return this.table.int64Of(name, fallback);
    }

    /** An owned copy of header `name`, or null when absent. */
    public #String headerString(String name) {
        return this.table.copy(name);
    }

    /** The declared Content-Length, or -1 when none was declared. */
    public int64 contentLength() {
        return this.declaredLength;
    }

    /** True when the connection may carry another request after this one. */
    public boolean keepAlive() {
        return this.reuse;
    }

    /** True when the request carries a body, held or streamed. */
    public boolean hasBody() {
        return this.bodyLen > 0 || this.stream != null;
    }

    /** The body held in the input buffer, or an empty window. */
    public Slice<int8> body() {
        return this.src[this.bodyOff:this.bodyOff + this.bodyLen];
    }

    /** Length of the held body in bytes. */
    public int32 bodyLength() {
        return this.bodyLen;
    }

    /** True when the body was too large to hold and is streamed instead. */
    public boolean bodyStreamed() {
        return this.stream != null;
    }

    /** The streamed body, or null when the body is held. */
    public Body bodyStream() {
        return this.stream;
    }

    /**
     * Splits the path into its non-empty segments for a router. Returns the
     * count, or -1 when the path has more segments than the request holds.
     */
    public int32 splitPath() {
        int32 end = this.targetOff + this.pathLen;
        int32 cap = this.segSpans.count() / 2;
        int32 n = 0;
        int32 start = this.targetOff;
        int32 i = this.targetOff;
        while (i <= end) {
            if (i == end || this.src[i] == (int8) 47) {
                if (i > start) {
                    if (n >= cap) {
                        return -1;
                    }
                    this.segSpans[n * 2] = start;
                    this.segSpans[n * 2 + 1] = i - start;
                    n = n + 1;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        this.segCount = n;
        return n;
    }

    /** Path segment `i` from the last `splitPath`, as sent. */
    public Slice<int8> segment(int32 i) {
        int32 off = this.segSpans[i * 2];
        return this.src[off:off + this.segSpans[i * 2 + 1]];
    }

    /** Binds parameter names for a matched route. `names` must outlive the request. */
    public void bindParams(String[] names, int32 count) {
        this.paramNames #= names;
        this.paramCount = count;
    }

    /** Binds parameter `i` to path segment `seg`. */
    public void bindSegment(int32 i, int32 seg) {
        this.paramSpans[i * 2] = this.segSpans[seg * 2];
        this.paramSpans[i * 2 + 1] = this.segSpans[seg * 2 + 1];
    }

    /** Binds parameter `i` to an empty value. */
    public void bindEmpty(int32 i) {
        this.paramSpans[i * 2] = this.targetOff;
        this.paramSpans[i * 2 + 1] = 0;
    }

    /** Binds parameter `i` to the rest of the path from segment `seg` on. */
    public void bindRest(int32 i, int32 seg) {
        int32 off = this.segSpans[seg * 2];
        this.paramSpans[i * 2] = off;
        this.paramSpans[i * 2 + 1] = this.targetOff + this.pathLen - off;
    }

    int32 paramIndex(String name) {
        int32 i = 0;
        while (i < this.paramCount) {
            if (this.paramNames[i].equals(name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** Number of path parameters bound by the matched route. */
    public int32 paramCount() {
        return this.paramCount;
    }

    /** True when the matched route bound parameter `name`. */
    public boolean hasParam(String name) {
        return this.paramIndex(name) >= 0;
    }

    /** Path parameter `name` as sent, percent-encoding intact, or an empty window. */
    public Slice<int8> param(String name) {
        int32 i = this.paramIndex(name);
        if (i < 0) {
            return this.src[0:0];
        }
        int32 off = this.paramSpans[i * 2];
        return this.src[off:off + this.paramSpans[i * 2 + 1]];
    }

    /** Path parameter `name` as a decimal integer, or `fallback`. */
    public int64 paramInt64(String name, int64 fallback) {
        if (this.paramIndex(name) < 0) {
            return fallback;
        }
        Slice<int8> raw = this.param(name);
        if (Bytes.indexOf(raw, (int8) 37) < 0) {
            return Bytes.parseSignedInt64(raw, fallback);
        }
        String decoded #= Bytes.percentDecode(raw);
        int8[] b #= decoded.toBytes();
        return Bytes.parseSignedInt64(b[0:decoded.byteLength()], fallback);
    }

    /** Path parameter `name` as an int32, or `fallback` when absent or out of range. */
    public int32 paramInt32(String name, int32 fallback) {
        int64 v = this.paramInt64(name, (int64) -2147483649);
        if (v < (int64) -2147483648 || v > (int64) 2147483647) {
            return fallback;
        }
        return (int32) v;
    }

    /** Path parameter `name` as `true` or `false`, or `fallback`. */
    public boolean paramBool(String name, boolean fallback) {
        Slice<int8> v = this.param(name);
        if (Bytes.equalsIgnoreCase(v, "true")) {
            return true;
        }
        if (Bytes.equalsIgnoreCase(v, "false")) {
            return false;
        }
        return fallback;
    }

    /** An owned, percent-decoded copy of path parameter `name`, or null. */
    public #String paramString(String name) {
        if (this.paramIndex(name) < 0) {
            return null;
        }
        return Bytes.percentDecode(this.param(name));
    }
}
