package dev.cajeta.http.routing;

import cajeta.lang.String;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.PathParams;
import cajeta.io.net.uri.PercentCodec;
import cajeta.io.net.uri.MalformedUriException;

/**
 * One **compiled route** in the [`Router`](Router.cajeta) (plan item
 * **NET-9.3**) — a `(method, path-pattern, handler)` triple, with the
 * pattern pre-split into match segments so dispatch is a per-request
 * segment walk rather than a re-parse.
 *
 * A **path pattern** is the registered template, e.g. `/users/{id}` or
 * `/`. It is split once at construction on `/` into **segments**; each
 * segment is either:
 *
 *   - a **literal** (`users`) — matches a request segment iff the bytes
 *     are equal, or
 *   - a **parameter** (`{id}`) — matches *any* single non-empty request
 *     segment, binding the captured (percent-decoded) value to the
 *     parameter name (`id`).
 *
 * The pattern is **case-sensitive** in its literal segments (paths are,
 * RFC 3986 §6.2.2.1) and the method token is taken verbatim
 * (`HttpRequest.method` is case-sensitive, RFC 7230 §3.1.1).
 *
 * This minimal form deliberately has **no** wildcard / catch-all / regex /
 * optional segments — a pattern and a request path match iff they have the
 * **same segment count** and every segment pairwise matches. "Deliberately
 * not a web framework" (Net.md §HTTP-server). The [`Router`](Router.cajeta)
 * layers method-vs-path 404/405 resolution over a list of these.
 */
public class Route {
    /** The HTTP method token this route answers (verbatim, e.g. `"GET"`). */
    public String method;

    /** The raw registered pattern (`"/users/{id}"`), kept for diagnostics. */
    public String pattern;

    /**
     * The pattern's path segments, in order. `"/users/{id}"` splits to
     * `["users", "{id}"]`; the root `"/"` splits to the empty list (zero
     * segments). A literal segment carries its text; a parameter segment
     * carries the `{name}` form verbatim and is identified at match time
     * by [`isParam`](#isParam).
     */
    public String[] segments;

    /** Number of valid entries in [`segments`](#segments). */
    public int32 segmentCount;

    /**
     * True iff the **last** segment is a `**` catch-all (`{rest:**}`) — a
     * variable-length match that binds the remaining path (http:1.7b). A
     * `**` in any non-final position is rejected at registration
     * ([`Router.patternError`](Router.cajeta)), so a `**` recorded here is
     * always terminal.
     */
    public boolean hasDoubleStar;

    /**
     * An optional **per-route body cap** in bytes (http:1.7d), or `0` when
     * unset (the route inherits only the server's global
     * `ServerLimits.maxBodyBytes`). When positive, [`Router.dispatch`](Router.cajeta)
     * answers `413 Payload Too Large` before the handler runs for any
     * request whose body — declared `Content-Length` or buffered bytes —
     * exceeds it. A per-route cap only **tightens**: the global cap is the
     * server-side pre-buffer gate; this refines it downward for one route
     * (e.g. a login endpoint that accepts at most 1 KiB). Set via
     * [`Router.routeLimited`](Router.cajeta#routeLimited).
     */
    public int64 maxBodyBytes;

    /** The handler to invoke when this route matches. */
    public (HttpRequest) -> #HttpResponse handler;

    /**
     * Compile a route from a method token, a path pattern, and a handler.
     * Splits `pattern` into [`segments`](#segments) once; an empty path or
     * `"/"` yields zero segments (the root route).
     */
    public Route(String method, String pattern,
                 (HttpRequest) -> #HttpResponse handler) {
        this.method = method.substring(0, method.byteLength());
        this.pattern = pattern.substring(0, pattern.byteLength());
        this.handler = handler;
        this.maxBodyBytes = 0;
        this.splitPattern(pattern);
        this.hasDoubleStar = this.computeDoubleStar();
    }

    /**
     * Whether the final segment is a `**` catch-all. Only the last segment
     * is inspected: a `**` elsewhere is a registration error the
     * [`Router`](Router.cajeta) rejects, so treating a non-final `**` as an
     * ordinary (never-matching) typed param here is a safe fallback.
     */
    boolean computeDoubleStar() {
        if (this.segmentCount == 0) {
            return false;
        }
        int32 last = this.segmentCount - 1;
        if (!this.isParam(last)) {
            return false;
        }
        String t = this.paramType(last);
        return t.equals("**");
    }

    /**
     * Split `pattern` on `/` into [`segments`](#segments). A leading `/`
     * (the conventional absolute path) produces no empty leading segment;
     * internal empty segments (a `//`) are skipped, matching the lenient
     * normalization a request path receives in [`Router.dispatch`](Router.cajeta).
     */
    void splitPattern(String pattern) {
        this.segments = heap String[8];
        this.segmentCount = 0;
        int32 n = pattern.byteLength();
        int32 segStart = 0;
        int32 i = 0;
        while (i <= n) {
            boolean atEnd = (i == n);
            boolean slash = (!atEnd) && (((int32) pattern.byteAt(i) & 0xff) == 47);
            if (atEnd || slash) {
                if (i > segStart) {
                    this.appendSegment(pattern.substring(segStart, i));
                }
                segStart = i + 1;
            }
            i = i + 1;
        }
    }

    /** Append one compiled segment, growing the backing array on demand. */
    void appendSegment(#String seg) {
        if (this.segmentCount >= this.segments.count()) {
            int32 newCap = this.segments.count() * 2;
            String[] grown = heap String[newCap];
            int32 j = 0;
            while (j < this.segmentCount) {
                grown[j] = this.segments[j];
                j = j + 1;
            }
            this.segments = grown;
        }
        this.segments[this.segmentCount] = #seg;
        this.segmentCount = this.segmentCount + 1;
    }

    /** The number of pattern segments. */
    public int32 patternSegmentCount() {
        return this.segmentCount;
    }

    /** True iff this route's method token equals `m` (case-sensitive). */
    public boolean methodMatches(String m) {
        return this.method.equals(m);
    }

    /**
     * Does pattern segment `i` denote a path **parameter** (`{name}`)?
     * A segment is a parameter iff it is at least two bytes and is wrapped
     * in `{` … `}`.
     */
    public boolean isParam(int32 i) {
        String seg = this.segments[i];
        int32 len = seg.byteLength();
        if (len < 2) {
            return false;
        }
        boolean open = (((int32) seg.byteAt(0) & 0xff) == 123);          // '{'
        boolean close = (((int32) seg.byteAt(len - 1) & 0xff) == 125);   // '}'
        return open && close;
    }

    /**
     * The byte index of the `:` inside param segment `i` that separates the
     * name from its type (`{id:int64}`), or `-1` when the segment is an
     * untyped `{name}`. Only the braces' interior is scanned.
     */
    int32 paramColon(int32 i) {
        String seg = this.segments[i];
        int32 len = seg.byteLength();
        int32 k = 1;                                 // skip '{'
        while (k < len - 1) {                        // stop before '}'
            if ((((int32) seg.byteAt(k)) & 0xff) == 58) {    // ':'
                return k;
            }
            k = k + 1;
        }
        return -1;
    }

    /**
     * The parameter name of segment `i` — the text between `{` and either
     * the type separator `:` (`{id:int64}` → `id`) or the closing `}`
     * (`{id}` → `id`).
     */
    public #String paramName(int32 i) {
        String seg = this.segments[i];
        int32 len = seg.byteLength();
        int32 colon = this.paramColon(i);
        int32 end = colon < 0 ? (len - 1) : colon;
        return seg.substring(1, end);
    }

    /**
     * The declared type token of param segment `i` — the text between `:`
     * and `}` (`{id:int64}` → `int64`), or `"string"` for an untyped
     * `{name}`. See [`PathParams.matchesType`](../PathParams.cajeta) for the
     * per-type match rules.
     */
    public #String paramType(int32 i) {
        String seg = this.segments[i];
        int32 len = seg.byteLength();
        int32 colon = this.paramColon(i);
        if (colon < 0) {
            return "string".substring(0, 6);
        }
        return seg.substring(colon + 1, len - 1);
    }

    /** The literal text of segment `i` (only meaningful when not a param). */
    public String literal(int32 i) {
        return this.segments[i];
    }

    /**
     * Attempt to match this route's pattern against the request `path`
     * segments (`pathSegs[0..pathLen)`), populating `out` with the
     * captured, percent-decoded parameter bindings.
     *
     * Returns `true` iff the segment counts are equal and every segment
     * matches (literals byte-equal, parameters capture any non-empty
     * segment). On a non-match `out` is left in whatever partial state the
     * walk reached — the caller discards it (each dispatch uses a fresh
     * [`PathParams`](PathParams.cajeta) per candidate route).
     *
     * A captured segment that carries a malformed `%XX` escape (so
     * [`PercentCodec.decode`](../uri/PercentCodec.cajeta) throws) is
     * treated as a **non-match** (the path is not a valid reference to the
     * resource) rather than an error propagated to the caller.
     */
    public boolean tryMatch(String[] pathSegs, int32 pathLen, PathParams out) {
        return this.matchAndScore(pathSegs, pathLen, out) >= (int64) 0;
    }

    /**
     * Match this route's pattern against the request `path` segments and, on
     * a match, return a **specificity score** (higher = more specific) while
     * binding the captured params into `out`; return `-1` on a non-match.
     *
     * The score packs a per-position **class** — literal (5) > param /
     * typed (4) > single wildcard `*` (3) > a `**`-absorbed segment (1) —
     * into 3 bits each, most-significant first, with a terminal class
     * appended (exact end 6, `**` end 0). Comparing two matching routes'
     * scores as integers therefore reproduces the plan's precedence
     * **literal > param > `*` > `**`** decided at the earliest differing
     * segment (the [`Router`](Router.cajeta) picks the highest-scoring
     * route, ties broken by registration order). Precedence is exact for
     * paths up to ~20 segments; deeper paths that tie on the packable
     * prefix fall back to registration order.
     *
     * A non-`**` pattern matches iff the segment counts are equal; a `**`
     * pattern matches iff the path has at least the fixed (pre-`**`)
     * segments, and its `**` binds the remaining segments joined by `/`
     * (the raw rest, separators preserved; **empty** when the path stops at
     * the prefix). A captured segment whose `%XX` escape is malformed, or a
     * typed segment whose value is out of range, is a **non-match** (so the
     * router resolves it to 404, never 405).
     */
    public int64 matchAndScore(String[] pathSegs, int32 pathLen, PathParams out) {
        int32 fixed = this.hasDoubleStar ? (this.segmentCount - 1)
                                         : this.segmentCount;
        if (this.hasDoubleStar) {
            if (pathLen < fixed) {
                return (int64) -1;
            }
        } else {
            if (pathLen != this.segmentCount) {
                return (int64) -1;
            }
        }

        int64 score = 0;
        int32 i = 0;
        while (i < fixed) {
            String reqSeg = pathSegs[i];
            int32 cls;
            if (this.isParam(i)) {
                if (reqSeg.byteLength() == 0) {
                    return (int64) -1;
                }
                String type = this.paramType(i);
                if (type.equals("*")) {
                    // Single wildcard: binds any one (decoded) segment.
                    String wName = this.paramName(i);
                    try {
                        String wDecoded = PercentCodec.decode(reqSeg);
                        out.put(#wName, #wDecoded);
                    } catch (MalformedUriException e) {
                        return (int64) -1;
                    }
                    cls = 3;
                } else {
                    // Typed / string param: value must satisfy the type.
                    String pName = this.paramName(i);
                    try {
                        String pDecoded = PercentCodec.decode(reqSeg);
                        if (!PathParams.matchesType(type, pDecoded)) {
                            return (int64) -1;       // type mismatch -> 404
                        }
                        out.put(#pName, #pDecoded);
                    } catch (MalformedUriException e) {
                        return (int64) -1;
                    }
                    cls = 4;
                }
            } else {
                String lit = this.segments[i];
                if (!lit.equals(reqSeg)) {
                    return (int64) -1;
                }
                cls = 5;
            }
            score = Route.packClass(score, pathLen, i, cls);
            i = i + 1;
        }

        if (this.hasDoubleStar) {
            String restName = this.paramName(this.segmentCount - 1);
            String rest = Route.joinRest(pathSegs, fixed, pathLen);
            out.put(#restName, #rest);
            int32 p = fixed;
            while (p < pathLen) {
                score = Route.packClass(score, pathLen, p, 1);
                p = p + 1;
            }
            score = Route.packClass(score, pathLen, pathLen, 0);   // terminal
        } else {
            score = Route.packClass(score, pathLen, pathLen, 6);   // exact end
        }
        return score;
    }

    /**
     * Fold `cls` (0..7) into `score` at element `elemIndex` of a
     * `pathLen`-segment path — 3 bits per element, most-significant first so
     * earlier segments dominate. Elements whose bit offset exceeds the int64
     * width (a path deeper than ~20 segments) are dropped, degrading
     * precedence to registration order there without affecting the
     * match/no-match decision.
     */
    static int64 packClass(int64 score, int32 pathLen, int32 elemIndex,
                           int32 cls) {
        int32 shift = 3 * (pathLen - elemIndex);
        if (shift < 0 || shift >= 63) {
            return score;
        }
        return score | (((int64) cls) << shift);
    }

    /**
     * Join `segs[start..pathLen)` with `/` — the value a `**` catch-all
     * binds (the raw remaining path, separators preserved). An empty range
     * (the path stopped at the prefix) yields the empty string.
     */
    static #String joinRest(String[] segs, int32 start, int32 pathLen) {
        int32 total = 0;
        int32 i = start;
        while (i < pathLen) {
            if (i > start) {
                total = total + 1;                   // the '/' separator
            }
            total = total + segs[i].byteLength();
            i = i + 1;
        }
        int8[] out = heap int8[total];
        int32 dst = 0;
        i = start;
        while (i < pathLen) {
            if (i > start) {
                out[dst] = (int8) 47;                // '/'
                dst = dst + 1;
            }
            String s = segs[i];
            int32 n = s.byteLength();
            int32 j = 0;
            while (j < n) {
                out[dst] = s.byteAt(j);
                dst = dst + 1;
                j = j + 1;
            }
            i = i + 1;
        }
        return heap String(#out, total);
    }
}
