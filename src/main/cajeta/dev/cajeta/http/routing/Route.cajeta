package dev.cajeta.http.routing;

import cajeta.lang.String;
import cajeta.lang.Slice;
import cajeta.error.UnrecoverableException;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.middleware.MiddlewareChain;

/**
 * One registered route: a method, a path pattern parsed once at
 * registration, and the handler with its middleware already composed.
 *
 * A pattern segment is a literal, `{name}` or `{name:type}` with type one of
 * string, int64, int32, int16, int8, uint32, uint16, uint8, bool or `*`, or
 * a final `{name:**}` that takes the rest of the path. Matching reads the
 * request's path segments in place and allocates nothing.
 */
public class Route {
    public String method;
    public String pattern;
    String[] lits;
    int32[] kinds;
    int32[] types;
    int32[] slots;
    public int32 segmentCount;
    public boolean hasDoubleStar;
    String[] names;
    int32 paramCount;
    public int64 maxBodyBytes;
    public MiddlewareChain mw;
    (HttpRequest, HttpResponse) -> void terminal;

    static int32 LITERAL = 0;
    static int32 TYPED = 1;
    static int32 ANY = 2;
    static int32 REST = 3;

    /** A route for `method` and `pattern` that runs `handler`. */
    public Route(String method, String pattern, (HttpRequest, HttpResponse) -> void handler) {
        this.method #= method.substring(0, method.byteLength());
        this.pattern #= pattern.substring(0, pattern.byteLength());
        this.terminal #= handler;
        this.maxBodyBytes = 0;
        this.mw = null;
        this.lits = heap String[32];
        this.kinds = heap int32[32];
        this.types = heap int32[32];
        this.slots = heap int32[32];
        this.names = heap String[16];
        this.paramCount = 0;
        this.segmentCount = 0;
        this.parse(pattern);
        this.hasDoubleStar = this.segmentCount > 0 && this.kinds[this.segmentCount - 1] == Route.REST;
    }

    /** Wraps the handler in `chain`. The route keeps the chain for its lifetime. */
    public void wrap(#MiddlewareChain chain) {
        this.mw #= chain;
        this.mw.build(this.terminal);
    }

    /** Runs the route's handler, through its middleware when it has any. */
    public void run(HttpRequest q, HttpResponse r) {
        if (this.mw != null) {
            this.mw.run(q, r);
            return;
        }
        (HttpRequest, HttpResponse) -> void h = this.terminal;
        h(q, r);
    }

    /** The error in `pattern`, or null when it is valid. */
    public static #String patternError(String pattern) {
        int32 n = pattern.byteLength();
        int32 start = 0;
        int32 i = 0;
        int32 params = 0;
        int32 segs = 0;
        boolean restSeen = false;
        while (i <= n) {
            if (i == n || pattern.byteAt(i) == (int8) 47) {
                if (i > start) {
                    if (restSeen) {
                        return "router: '**' catch-all must be the last segment in pattern '" + pattern + "'";
                    }
                    segs = segs + 1;
                    String seg #= pattern.substring(start, i);
                    if (Route.isParamText(seg)) {
                        params = params + 1;
                        String type #= Route.typeText(seg);
                        if (type.equals("**")) {
                            restSeen = true;
                        } else if (!type.equals("*") && Route.typeCode(type) < 0) {
                            return "router: unknown path-param type '" + type + "' in pattern '" + pattern + "'";
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if (segs > 32 || params > 16) {
            return "router: pattern '" + pattern + "' has more than 32 segments or 16 parameters";
        }
        return null;
    }

    static boolean isParamText(String seg) {
        int32 len = seg.byteLength();
        return len >= 2 && seg.byteAt(0) == (int8) 123 && seg.byteAt(len - 1) == (int8) 125;
    }

    static int32 colonOf(String seg) {
        int32 len = seg.byteLength();
        int32 k = 1;
        while (k < len - 1) {
            if (seg.byteAt(k) == (int8) 58) {
                return k;
            }
            k = k + 1;
        }
        return -1;
    }

    static #String typeText(String seg) {
        int32 c = Route.colonOf(seg);
        if (c < 0) {
            return "string".substring(0, 6);
        }
        return seg.substring(c + 1, seg.byteLength() - 1);
    }

    static #String nameText(String seg) {
        int32 c = Route.colonOf(seg);
        int32 end = c < 0 ? seg.byteLength() - 1 : c;
        return seg.substring(1, end);
    }

    static int32 typeCode(String t) {
        if (t.equals("string")) { return 0; }
        if (t.equals("int64")) { return 1; }
        if (t.equals("int32")) { return 2; }
        if (t.equals("int16")) { return 3; }
        if (t.equals("int8")) { return 4; }
        if (t.equals("uint32")) { return 5; }
        if (t.equals("uint16")) { return 6; }
        if (t.equals("uint8")) { return 7; }
        if (t.equals("bool")) { return 8; }
        return -1;
    }

    void parse(String pattern) {
        int32 n = pattern.byteLength();
        int32 start = 0;
        int32 i = 0;
        while (i <= n) {
            if (i == n || pattern.byteAt(i) == (int8) 47) {
                if (i > start) {
                    String seg #= pattern.substring(start, i);
                    int32 k = this.segmentCount;
                    if (Route.isParamText(seg)) {
                        String type #= Route.typeText(seg);
                        this.names[this.paramCount] #= Route.nameText(seg);
                        this.slots[k] = this.paramCount;
                        this.paramCount = this.paramCount + 1;
                        if (type.equals("**")) {
                            this.kinds[k] = Route.REST;
                        } else if (type.equals("*")) {
                            this.kinds[k] = Route.ANY;
                        } else {
                            this.kinds[k] = Route.TYPED;
                            this.types[k] = Route.typeCode(type);
                        }
                    } else {
                        this.kinds[k] = Route.LITERAL;
                        this.slots[k] = -1;
                    }
                    this.lits[k] = #seg;
                    this.segmentCount = k + 1;
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }

    /** True when the route's method is exactly `m`. */
    public boolean methodMatches(Slice<int8> m) {
        return Bytes.equals(m, this.method);
    }

    static int32 escapeWidth(Slice<int8> s, int64 i) {
        if (s[i] != (int8) 37) {
            return 1;
        }
        if (i + 2 >= s.count()) {
            return -1;
        }
        int32 hi = Bytes.hexValue(((int32) s[i + 1]) & 255);
        int32 lo = Bytes.hexValue(((int32) s[i + 2]) & 255);
        if (hi < 0 || lo < 0) {
            return -1;
        }
        return 3;
    }

    static int32 decodedAt(Slice<int8> s, int64 i, int32 width) {
        if (width == 1) {
            return ((int32) s[i]) & 255;
        }
        return Bytes.hexValue(((int32) s[i + 1]) & 255) * 16 + Bytes.hexValue(((int32) s[i + 2]) & 255);
    }

    static boolean escapesValid(Slice<int8> s) {
        int64 i = 0;
        while (i < s.count()) {
            int32 w = Route.escapeWidth(s, i);
            if (w < 0) {
                return false;
            }
            i = i + (int64) w;
        }
        return true;
    }

    static String posLimit(int32 type) {
        if (type == 1) { return "9223372036854775807"; }
        if (type == 2) { return "2147483647"; }
        if (type == 3) { return "32767"; }
        if (type == 4) { return "127"; }
        if (type == 5) { return "4294967295"; }
        if (type == 6) { return "65535"; }
        return "255";
    }

    static String negLimit(int32 type) {
        if (type == 1) { return "9223372036854775808"; }
        if (type == 2) { return "2147483648"; }
        if (type == 3) { return "32768"; }
        return "128";
    }

    static boolean decimalFits(Slice<int8> s, int32 type) {
        boolean signed = type >= 1 && type <= 4;
        int64 i = 0;
        int64 n = s.count();
        boolean neg = false;
        if (n > 0) {
            int32 w0 = Route.escapeWidth(s, 0);
            if (signed && Route.decodedAt(s, 0, w0) == 45) {
                neg = true;
                i = (int64) w0;
            }
        }
        String max = neg ? Route.negLimit(type) : Route.posLimit(type);
        int32 digits = 0;
        int32 first = -1;
        int64 p = i;
        while (p < n) {
            int32 w = Route.escapeWidth(s, p);
            int32 d = Route.decodedAt(s, p, w) - 48;
            if (d < 0 || d > 9) {
                return false;
            }
            if (digits == 0) {
                first = d;
            }
            digits = digits + 1;
            p = p + (int64) w;
        }
        if (digits == 0) {
            return false;
        }
        if (first == 0) {
            return digits == 1 && !neg;
        }
        int32 maxLen = max.byteLength();
        if (digits != maxLen) {
            return digits < maxLen;
        }
        p = i;
        int32 j = 0;
        while (p < n) {
            int32 w = Route.escapeWidth(s, p);
            int32 cv = Route.decodedAt(s, p, w);
            int32 cm = ((int32) max.byteAt(j)) & 255;
            if (cv != cm) {
                return cv < cm;
            }
            j = j + 1;
            p = p + (int64) w;
        }
        return true;
    }

    static boolean decodedEquals(Slice<int8> s, String text) {
        int64 i = 0;
        int32 j = 0;
        int32 n = text.byteLength();
        while (i < s.count()) {
            int32 w = Route.escapeWidth(s, i);
            if (j >= n || Route.decodedAt(s, i, w) != (((int32) text.byteAt(j)) & 255)) {
                return false;
            }
            j = j + 1;
            i = i + (int64) w;
        }
        return j == n;
    }

    static boolean typeMatches(Slice<int8> s, int32 type) {
        if (!Route.escapesValid(s)) {
            return false;
        }
        if (type == 0) {
            return s.count() > 0;
        }
        if (type == 8) {
            return Route.decodedEquals(s, "true") || Route.decodedEquals(s, "false");
        }
        return Route.decimalFits(s, type);
    }

    static int64 pack(int64 score, int32 pathLen, int32 index, int32 cls) {
        int32 shift = 3 * (pathLen - index);
        if (shift < 0 || shift >= 63) {
            return score;
        }
        return score | (((int64) cls) << shift);
    }

    /**
     * The match score of the request's split path against this route, or
     * -1 when it does not match. A higher score is a more specific route.
     */
    public int64 score(HttpRequest q, int32 pathLen) {
        int32 fixed = this.hasDoubleStar ? this.segmentCount - 1 : this.segmentCount;
        if (this.hasDoubleStar) {
            if (pathLen < fixed) {
                return -1;
            }
        } else if (pathLen != this.segmentCount) {
            return -1;
        }
        int64 score = 0;
        int32 i = 0;
        while (i < fixed) {
            Slice<int8> seg = q.segment(i);
            int32 kind = this.kinds[i];
            int32 cls = 5;
            if (kind == Route.LITERAL) {
                if (!Bytes.equals(seg, this.lits[i])) {
                    return -1;
                }
            } else if (kind == Route.ANY) {
                if (seg.count() == 0 || !Route.escapesValid(seg)) {
                    return -1;
                }
                cls = 3;
            } else {
                if (!Route.typeMatches(seg, this.types[i])) {
                    return -1;
                }
                cls = 4;
            }
            score = Route.pack(score, pathLen, i, cls);
            i = i + 1;
        }
        if (this.hasDoubleStar) {
            int32 p = fixed;
            while (p < pathLen) {
                score = Route.pack(score, pathLen, p, 1);
                p = p + 1;
            }
            return Route.pack(score, pathLen, pathLen, 0);
        }
        return Route.pack(score, pathLen, pathLen, 6);
    }

    /** Binds this route's parameters on a request whose path it matched. */
    public void bind(HttpRequest q, int32 pathLen) {
        q.bindParams(this.names, this.paramCount);
        int32 i = 0;
        while (i < this.segmentCount) {
            int32 slot = this.slots[i];
            if (slot >= 0) {
                if (this.kinds[i] == Route.REST) {
                    if (i < pathLen) {
                        q.bindRest(slot, i);
                    } else {
                        q.bindEmpty(slot);
                    }
                } else {
                    q.bindSegment(slot, i);
                }
            }
            i = i + 1;
        }
    }
}
