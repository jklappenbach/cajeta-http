package dev.cajeta.http.routing;

import cajeta.lang.String;
import cajeta.lang.Slice;
import cajeta.error.UnrecoverableException;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.middleware.MiddlewareChain;

/**
 * Dispatches a request to the most specific matching route.
 *
 * A path that matches no route answers 404, and a path that matches only
 * under other methods answers 405 with `Allow`. A route with a body cap
 * answers 413 when the request's body is over it. On the success path the
 * router allocates nothing: segments and parameters are windows into the
 * request.
 */
public class Router {
    Route[] routes;
    int32 routeCount;

    /** An empty router. */
    public Router() {
        this.routes = heap Route[8];
        this.routeCount = 0;
    }

    static void check(String pattern) {
        String err #= Route.patternError(pattern);
        if (err != null) {
            throw heap UnrecoverableException(#err);
        }
    }

    /** Adds a route. Raises when the pattern is invalid. */
    public Router route(String method, String pattern, (HttpRequest, HttpResponse) -> void handler) {
        Router.check(pattern);
        Route r = heap Route(method, pattern, #handler);
        this.append(#r);
        return this;
    }

    /** Adds a route whose request body may not exceed `maxBodyBytes`. */
    public Router routeLimited(String method, String pattern, int64 maxBodyBytes,
                               (HttpRequest, HttpResponse) -> void handler) {
        Router.check(pattern);
        Route r = heap Route(method, pattern, #handler);
        r.maxBodyBytes = maxBodyBytes;
        this.append(#r);
        return this;
    }

    /** Adds a route whose handler runs inside `chain`. */
    public Router routeMw(String method, String pattern, #MiddlewareChain chain,
                          (HttpRequest, HttpResponse) -> void handler) {
        Router.check(pattern);
        Route r = heap Route(method, pattern, #handler);
        r.wrap(#chain);
        this.append(#r);
        return this;
    }

    void append(#Route r) {
        if (this.routeCount >= this.routes.count()) {
            Route[] grown = heap Route[this.routes.count() * 2];
            int32 j = 0;
            while (j < this.routeCount) {
                grown[j] #= this.routes[j];
                j = j + 1;
            }
            this.routes #= grown;
        }
        this.routes[this.routeCount] = #r;
        this.routeCount = this.routeCount + 1;
    }

    /** Number of routes. */
    public int32 size() {
        return this.routeCount;
    }

    /** Adds every route of `sub` under `prefix`. `sub` must outlive this router. */
    public Router mount(String prefix, Router sub) {
        int32 i = 0;
        while (i < sub.routeCount) {
            Route r = sub.routes[i];
            String combined #= Router.joinPattern(prefix, r.pattern);
            this.routeLimited(r.method, combined, r.maxBodyBytes, r.terminal);
            i = i + 1;
        }
        return this;
    }

    static #String joinPattern(String prefix, String sub) {
        int32 pn = prefix.byteLength();
        while (pn > 0 && prefix.byteAt(pn - 1) == (int8) 47) {
            pn = pn - 1;
        }
        int32 ss = 0;
        while (ss < sub.byteLength() && sub.byteAt(ss) == (int8) 47) {
            ss = ss + 1;
        }
        String head #= prefix.substring(0, pn);
        String tail #= sub.substring(ss, sub.byteLength());
        if (head.byteLength() == 0 && tail.byteLength() == 0) {
            return "/".substring(0, 1);
        }
        if (head.byteLength() > 0 && head.byteAt(0) != (int8) 47) {
            return "/" + head + "/" + tail;
        }
        return head + "/" + tail;
    }

    /** Runs the best route for `q` into `r`, or answers 404, 405 or 413. */
    public void dispatch(HttpRequest q, HttpResponse r) {
        int32 n = q.splitPath();
        if (n < 0) {
            r.status(404);
            return;
        }
        Slice<int8> method = q.methodBytes();
        boolean pathMatched = false;
        int32 best = -1;
        int64 bestScore = -1;
        int32 i = 0;
        while (i < this.routeCount) {
            Route rt = this.routes[i];
            int64 sc = rt.score(q, n);
            if (sc >= 0) {
                pathMatched = true;
                if (rt.methodMatches(method) && (best < 0 || sc > bestScore)) {
                    best = i;
                    bestScore = sc;
                }
            }
            i = i + 1;
        }
        if (best >= 0) {
            Route chosen = this.routes[best];
            if (chosen.maxBodyBytes > 0 && (q.contentLength() > chosen.maxBodyBytes
                    || (int64) q.bodyLength() > chosen.maxBodyBytes)) {
                r.status(413);
                return;
            }
            chosen.bind(q, n);
            chosen.run(q, r);
            return;
        }
        if (pathMatched) {
            r.status(405);
            String allow #= this.allowFor(q, n);
            if (allow.byteLength() > 0) {
                r.setHeader("Allow", allow);
            }
            return;
        }
        r.status(404);
    }

    #String allowFor(HttpRequest q, int32 n) {
        String acc #= "".substring(0, 0);
        int32 i = 0;
        while (i < this.routeCount) {
            Route rt = this.routes[i];
            if (rt.score(q, n) >= 0 && !Router.listed(acc, rt.method)) {
                if (acc.byteLength() == 0) {
                    acc #= rt.method.substring(0, rt.method.byteLength());
                } else {
                    acc #= acc + ", " + rt.method;
                }
            }
            i = i + 1;
        }
        return #acc;
    }

    static boolean listed(String acc, String m) {
        int32 n = acc.byteLength();
        int32 start = 0;
        int32 i = 0;
        while (i <= n) {
            if (i == n || acc.byteAt(i) == (int8) 44) {
                String tok #= acc.substring(start, i).trim();
                if (tok.equals(m)) {
                    return true;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return false;
    }
}
