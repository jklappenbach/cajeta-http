package dev.cajeta.http.ws;

/**
 * A strict **UTF-8 well-formedness check** (RFC 3629) for WebSocket **text**
 * messages — RFC 6455 §8.1 requires a text frame's payload to be valid UTF-8,
 * and a violation is a `1007` *invalid payload* close. Rejects overlong
 * encodings, UTF-16 surrogate halves (`U+D800..U+DFFF`), and code points above
 * `U+10FFFF`, plus any truncated trailing sequence.
 *
 * This is a **whole-buffer** validator run when a text message is fully
 * reassembled (the "non-strict" Autobahn discipline — validate at message end
 * rather than mid-stream), which is all [`WsProtocol`](WsProtocol.cajeta) needs
 * to fail an invalid text message cleanly.
 */
public class Utf8Validator {

    /** True iff `data[0 .. n)` is well-formed UTF-8. */
    public static boolean isValid(int8[] data, int32 n) {
        int32 i = 0;
        while (i < n) {
            int32 b0 = ((int32) data[i]) & 0xFF;
            if (b0 <= 0x7F) {
                i = i + 1;
            } else if (b0 >= 0xC2 && b0 <= 0xDF) {
                // 2-byte: one continuation. (0xC0/0xC1 are overlong → invalid.)
                if (i + 1 >= n) {
                    return false;
                }
                if (!Utf8Validator.cont(data[i + 1])) {
                    return false;
                }
                i = i + 2;
            } else if (b0 == 0xE0) {
                // 3-byte, no overlong: second byte 0xA0..0xBF.
                if (i + 2 >= n) {
                    return false;
                }
                if (!Utf8Validator.range(data[i + 1], 0xA0, 0xBF)
                        || !Utf8Validator.cont(data[i + 2])) {
                    return false;
                }
                i = i + 3;
            } else if (b0 >= 0xE1 && b0 <= 0xEC) {
                if (i + 2 >= n) {
                    return false;
                }
                if (!Utf8Validator.cont(data[i + 1])
                        || !Utf8Validator.cont(data[i + 2])) {
                    return false;
                }
                i = i + 3;
            } else if (b0 == 0xED) {
                // 3-byte, no surrogates: second byte 0x80..0x9F.
                if (i + 2 >= n) {
                    return false;
                }
                if (!Utf8Validator.range(data[i + 1], 0x80, 0x9F)
                        || !Utf8Validator.cont(data[i + 2])) {
                    return false;
                }
                i = i + 3;
            } else if (b0 >= 0xEE && b0 <= 0xEF) {
                if (i + 2 >= n) {
                    return false;
                }
                if (!Utf8Validator.cont(data[i + 1])
                        || !Utf8Validator.cont(data[i + 2])) {
                    return false;
                }
                i = i + 3;
            } else if (b0 == 0xF0) {
                // 4-byte, no overlong: second byte 0x90..0xBF.
                if (i + 3 >= n) {
                    return false;
                }
                if (!Utf8Validator.range(data[i + 1], 0x90, 0xBF)
                        || !Utf8Validator.cont(data[i + 2])
                        || !Utf8Validator.cont(data[i + 3])) {
                    return false;
                }
                i = i + 4;
            } else if (b0 >= 0xF1 && b0 <= 0xF3) {
                if (i + 3 >= n) {
                    return false;
                }
                if (!Utf8Validator.cont(data[i + 1])
                        || !Utf8Validator.cont(data[i + 2])
                        || !Utf8Validator.cont(data[i + 3])) {
                    return false;
                }
                i = i + 4;
            } else if (b0 == 0xF4) {
                // 4-byte, max U+10FFFF: second byte 0x80..0x8F.
                if (i + 3 >= n) {
                    return false;
                }
                if (!Utf8Validator.range(data[i + 1], 0x80, 0x8F)
                        || !Utf8Validator.cont(data[i + 2])
                        || !Utf8Validator.cont(data[i + 3])) {
                    return false;
                }
                i = i + 4;
            } else {
                // 0x80..0xC1 (stray continuation / overlong lead) or
                // 0xF5..0xFF (> U+10FFFF): invalid lead byte.
                return false;
            }
        }
        return true;
    }

    /** A continuation byte: 0x80..0xBF. */
    static boolean cont(int8 b) {
        int32 v = ((int32) b) & 0xFF;
        return v >= 0x80 && v <= 0xBF;
    }

    /** `b` in `[lo, hi]` (byte value). */
    static boolean range(int8 b, int32 lo, int32 hi) {
        int32 v = ((int32) b) & 0xFF;
        return v >= lo && v <= hi;
    }
}
