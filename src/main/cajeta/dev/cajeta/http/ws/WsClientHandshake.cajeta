package dev.cajeta.http.ws;

import cajeta.lang.String;
import cajeta.codec.Base64;
import cajeta.io.net.uri.Uri;
import dev.cajeta.http.ClientResponse;

/**
 * The WebSocket client-side opening handshake (RFC 6455 §4.1): the upgrade
 * request head for a `ws://` or `wss://` URI, and the check that the server's
 * 101 carries the matching `Sec-WebSocket-Accept`.
 */
public class WsClientHandshake {
    /**
     * The upgrade request head for `uri` and `key`, ending in the blank line.
     * `extensions` is offered when not empty.
     */
    public static #String requestHead(Uri uri, String key, String extensions) {
        String path = uri.getPath();
        String target = "/";
        if (path != null && path.byteLength() > 0) {
            target = path;
        }
        String query = uri.getQuery();
        String hostLine = "" + uri.getHost();
        if (uri.getPort() > 0) {
            hostLine = hostLine + ":" + uri.getPort();
        }
        String head = "GET " + target;
        if (query != null && query.byteLength() > 0) {
            head = head + "?" + query;
        }
        head = head + " HTTP/1.1\r\nHost: " + hostLine
            + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key
            + "\r\nSec-WebSocket-Version: 13\r\n";
        if (extensions.byteLength() > 0) {
            head = head + "Sec-WebSocket-Extensions: " + extensions + "\r\n";
        }
        return head + "\r\n";
    }

    /** Whether `response` completes the handshake for `key`. */
    public static boolean validateAccept(ClientResponse response, String key) {
        if (response.status() != 101 || !response.hasHeader("Sec-WebSocket-Accept")) {
            return false;
        }
        String got #= response.headerString("Sec-WebSocket-Accept");
        String expect #= WsServerHandshake.acceptKey(key);
        return got.equals(expect);
    }

    /** Throws `HandshakeRejectedException` unless `response` completes the handshake. */
    public static void requireAccept(ClientResponse response, String key) {
        if (!WsClientHandshake.validateAccept(response, key)) {
            throw heap HandshakeRejectedException(
                "server did not complete the WebSocket handshake", 400);
        }
    }

    /**
     * A 16-byte `Sec-WebSocket-Key` mixed from `seed`. It is varying and
     * deterministic, and not cryptographically random.
     */
    public static #String placeholderKey(int32 seed) {
        int8[] raw = heap int8[16];
        int32 x = seed;
        int32 i = 0;
        while (i < 16) {
            x = x * 1103515245 + 12345 + i;
            x = x ^ (x >> 7);
            raw[i] = (int8) (x & 255);
            i = i + 1;
        }
        return Base64.encode(raw, (int64) 16);
    }
}
