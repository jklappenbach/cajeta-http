package dev.cajeta.http.ws;

import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.uri.Uri;
import cajeta.error.Exception;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HeadScanner;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.Version;
import dev.cajeta.http.h1.HttpParserLimits;

/**
 * Switches a connection to WebSocket. A handler on `HttpServer` calls
 * [`accept`](#accept), which answers the upgrade and hands the connection to
 * the `WebSocketHandler` once the 101 is sent. The raw-stream forms
 * (`acceptServer`, `serve`, `connectClient`) run the same handshake over a
 * reader and writer the caller already holds.
 */
public final class WsUpgrade {
    /**
     * Answers an upgrade request on `r`. On success the connection switches to
     * `handler` after the 101, and `handler` must outlive it. Returns false after
     * writing the 400 or 426 rejection when `q` is not a valid upgrade.
     */
    public static boolean accept(HttpRequest q, HttpResponse r, WebSocketHandler handler,
                                 boolean allowCompression) {
        try {
            WsServerHandshake.accept(q, r);
        } catch (HandshakeRejectedException e) {
            WsServerHandshake.reject(e, r);
            return false;
        }
        PmdParams params #= WsUpgrade.serverParams(q, allowCompression);
        if (params.enabled) {
            r.header("Sec-WebSocket-Extensions", params.responseHeader);
        }
        r.upgrade(heap WsTakeover(handler, #params));
        return true;
    }

    /** Reads an upgrade request from `reader` and answers it on `writer`. */
    public static #WebSocket acceptServer(AsyncReader reader, AsyncWriter writer) {
        return WsUpgrade.acceptServer(reader, writer, false);
    }

    /** As `acceptServer`, negotiating `permessage-deflate` when allowed. */
    public static #WebSocket acceptServer(AsyncReader reader, AsyncWriter writer,
                                          boolean allowCompression) {
        HttpParserLimits limits = heap HttpParserLimits();
        ByteBuffer head #= WsUpgrade.readHead(reader, limits);
        HttpRequest q = heap HttpRequest(limits.maxHeaderCount);
        HeadScanner.parseRequest(head.array(), 0, head.readable(), q);
        ByteBuffer out = heap ByteBuffer(8192);
        HttpResponse r = heap HttpResponse(out, null, 4096, 64);
        WsServerHandshake.accept(q, r);
        PmdParams params #= WsUpgrade.serverParams(q, allowCompression);
        if (params.enabled) {
            r.header("Sec-WebSocket-Extensions", params.responseHeader);
        }
        r.finish(true, Version.HTTP_1_1, true);
        writer.writeAll(out.array(), out.readPosition(), out.readable());
        writer.flush();
        WebSocket ws #= WebSocket.forServer(reader, writer);
        ws.enableCompression(params);
        return #ws;
    }

    static #PmdParams serverParams(HttpRequest q, boolean allow) {
        if (!allow || !q.hasHeader("Sec-WebSocket-Extensions")) {
            return heap PmdParams();
        }
        String offered #= q.headerString("Sec-WebSocket-Extensions");
        return WsCompression.negotiateServer(offered);
    }

    /** Reads an upgrade request, answers it, and runs `handler` until the close. */
    public static void serve(AsyncReader reader, AsyncWriter writer, WebSocketHandler handler) {
        WsUpgrade.serve(reader, writer, handler, false);
    }

    /** As `serve`, negotiating `permessage-deflate` when allowed. */
    public static void serve(AsyncReader reader, AsyncWriter writer, WebSocketHandler handler,
                             boolean allowCompression) {
        WebSocket ws #= WsUpgrade.acceptServer(reader, writer, allowCompression);
        WsUpgrade.run(#ws, handler);
    }

    /** Runs `handler` over an open socket until the close, then reports it. */
    public static void run(#WebSocket ws, WebSocketHandler handler) {
        WebSocketConnection conn = heap WebSocketConnection(ws);
        int32 code = WsCloseCode.NORMAL;
        try {
            handler.onConnect(conn);
            boolean running = true;
            while (running) {
                WsMessage m #= ws.receive();
                handler.onMessage(conn, m);
            }
        } catch (ConnectionClosedException e) {
            code = e.closeCode;
        } catch (WebSocketException e) {
            code = WsCloseCode.PROTOCOL_ERROR;
            WsUpgrade.closeQuietly(ws, code);
        } catch (Exception e) {
            code = WsCloseCode.INTERNAL_ERROR;
            WsUpgrade.closeQuietly(ws, code);
        }
        try {
            handler.onClose(conn, code);
        } catch (Exception e) {
        }
    }

    static void closeQuietly(WebSocket ws, int32 code) {
        try {
            String none = "";
            ws.close(code, none);
        } catch (Exception e) {
        }
    }

    /** The client handshake for `uri` over a reader and writer the caller holds. */
    public static #WebSocket connectClient(AsyncReader reader, AsyncWriter writer,
                                           Uri uri, int32 keySeed) {
        return WsUpgrade.connectClient(reader, writer, uri, keySeed, false);
    }

    /** As `connectClient`, offering `permessage-deflate` when asked. */
    public static #WebSocket connectClient(AsyncReader reader, AsyncWriter writer,
                                           Uri uri, int32 keySeed,
                                           boolean offerCompression) {
        ClientResponse response = heap ClientResponse();
        String key #= WsUpgrade.handshakeClient(reader, writer, uri, keySeed,
                                                offerCompression, response);
        PmdParams params #= WsUpgrade.clientParams(response, offerCompression);
        WebSocket ws #= WebSocket.forClient(reader, writer);
        ws.enableCompression(params);
        return #ws;
    }

    /**
     * Sends the upgrade request and reads the 101 into `response`, throwing
     * `HandshakeRejectedException` when it does not complete. Returns the key.
     */
    public static #String handshakeClient(AsyncReader reader, AsyncWriter writer, Uri uri,
                                          int32 keySeed, boolean offerCompression,
                                          ClientResponse response) {
        String key #= WsClientHandshake.placeholderKey(keySeed);
        String offer = "";
        if (offerCompression) {
            offer #= WsCompression.clientOffer();
        }
        String head #= WsClientHandshake.requestHead(uri, key, offer);
        int8[] bytes #= head.toBytes();
        writer.writeAll(bytes, 0, head.byteLength());
        writer.flush();
        HttpParserLimits limits = heap HttpParserLimits();
        ByteBuffer buf #= WsUpgrade.readHead(reader, limits);
        HeadScanner.parseResponse(buf.array(), 0, buf.readable(), response);
        response.adopt(#buf);
        WsClientHandshake.requireAccept(response, key);
        return #key;
    }

    static #PmdParams clientParams(ClientResponse response, boolean offered) {
        if (!offered || !response.hasHeader("Sec-WebSocket-Extensions")) {
            return heap PmdParams();
        }
        String ext #= response.headerString("Sec-WebSocket-Extensions");
        return WsCompression.confirmClient(ext);
    }

    /**
     * Reads exactly one message head, one byte at a time so nothing past its
     * blank line is taken from `reader`. Throws on a head longer than the limits.
     */
    static #ByteBuffer readHead(AsyncReader reader, HttpParserLimits limits) {
        HeadScanner scanner = heap HeadScanner(limits);
        ByteBuffer buf = heap ByteBuffer(16384);
        int8[] one = heap int8[1];
        int32 h = -1;
        while (h < 0) {
            if (reader.read(one, 0, 1) == 0) {
                throw heap HandshakeRejectedException("connection closed during the handshake", 400);
            }
            buf.put(one[0]);
            h = scanner.scan(buf);
        }
        return #buf;
    }
}
