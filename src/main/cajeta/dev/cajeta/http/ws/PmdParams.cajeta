package dev.cajeta.http.ws;

import cajeta.lang.String;

/**
 * The negotiated `permessage-deflate` parameters for one connection (plan
 * **4.1c**), produced by [`WsCompression`](WsCompression.cajeta). `enabled`
 * gates whether messages are compressed at all; the two takeover flags map onto
 * [`PerMessageDeflate`](PerMessageDeflate.cajeta)'s constructor — `local` is our
 * own compressor (reset per message when set), `peer` our decompressor (reset
 * when the peer resets its compressor). `responseHeader` is the
 * `Sec-WebSocket-Extensions` value the **server** echoes back (empty on the
 * client side or when the offer is declined).
 */
public final class PmdParams {
    public boolean enabled;
    public boolean localNoContextTakeover;
    public boolean peerNoContextTakeover;
    public String responseHeader;
    /**
     * Outbound DEFLATE compression level 1..9 — defaults to **1**, the right
     * choice for on-the-fly per-message compression (low CPU per send; context
     * takeover already handles repeats). Raise it for a server that sends
     * large, unique, bandwidth-sensitive messages.
     */
    public int32 level;

    public PmdParams() {
        this.enabled = false;
        this.localNoContextTakeover = false;
        this.peerNoContextTakeover = false;
        this.responseHeader = "";
        this.level = 1;
    }

    /** A `PerMessageDeflate` codec configured from these params. */
    public #PerMessageDeflate codec() {
        return heap PerMessageDeflate(this.localNoContextTakeover,
                                      this.peerNoContextTakeover, this.level);
    }
}
