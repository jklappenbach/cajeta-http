package dev.cajeta.http.ws;

import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.ByteChannel;
import dev.cajeta.http.Takeover;
import dev.cajeta.http.h2.NowWriter;

/**
 * The takeover `WsUpgrade.accept` registers: once the 101 is sent, it runs the
 * handler over the switched connection. The handler is borrowed from the
 * application, which keeps it for the server's life.
 */
public final class WsTakeover extends Takeover {
    WebSocketHandler handler;
    PmdParams params;
    ByteChannel ch;

    public WsTakeover(WebSocketHandler handler, #PmdParams params) {
        this.handler #= handler;
        this.params #= params;
        this.ch = null;
    }

    public void attach(ByteChannel ch) {
        this.ch #= ch;
    }

    /**
     * The framer-side form (request-dispatch spec §2.5): the handler and the
     * negotiated extension move to a `WsFramed` the connection's framer
     * drives, and this takeover never runs.
     */
    public #WsFramed framed(ByteChannel ch, ^NowWriter now, int64 maxMessage, int32 maxUnits) {
        WebSocketHandler h #= this.handler;
        PmdParams p #= this.params;
        return heap WsFramed(#h, #p, ch, now, maxMessage, maxUnits);
    }

    public void run(AsyncReader reader, AsyncWriter writer) {
        WebSocket ws #= WebSocket.forServer(reader, writer);
        ws.enableCompression(this.params);
        ws.useTransport(this.ch);
        WsUpgrade.run(#ws, this.handler);
    }
}
