package dev.cajeta.http.ws;

import cajeta.lang.String;
import cajeta.hash.Sha1;
import cajeta.codec.Base64;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.Method;
import dev.cajeta.http.ws.HandshakeRejectedException;

/**
 * The WebSocket server-side opening handshake (RFC 6455 §4.2). It validates a
 * request view as a well-formed upgrade, computes `Sec-WebSocket-Accept`, and
 * writes the `101 Switching Protocols` head into the response writer. A
 * malformed request is rejected with 400, and a version other than 13 with
 * 426 carrying `Sec-WebSocket-Version: 13`.
 */
public final class WsServerHandshake {
    /** The RFC 6455 §1.3 GUID appended to the client key before hashing. */
    public static #String guid() {
        String g = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        return g.substring(0, g.byteLength());
    }

    /** `base64(SHA-1(key + GUID))`, the accept token for a client key. */
    public static #String acceptKey(String key) {
        String g #= WsServerHandshake.guid();
        Sha1 h #= heap Sha1();
        int8[] kb #= key.toBytes();
        int8[] gb #= g.toBytes();
        h.update(kb, (int64) key.byteLength());
        h.update(gb, (int64) g.byteLength());
        int8[] digest #= h.digest();
        return Base64.encode(digest, (int64) digest.count());
    }

    /**
     * Validates `q` and writes the 101 head into `r`. Throws
     * `HandshakeRejectedException` carrying the status to answer with instead.
     */
    public static void accept(HttpRequest q, HttpResponse r) {
        WsServerHandshake.validate(q);
        String key #= q.headerString("Sec-WebSocket-Key");
        String acceptValue #= WsServerHandshake.acceptKey(key);
        r.status(101);
        r.header("Upgrade", "websocket");
        r.header("Sec-WebSocket-Accept", acceptValue);
    }

    /** Whether `q` is a valid upgrade, the non-throwing form of `validate`. */
    public static boolean isUpgradeRequest(HttpRequest q) {
        return q.method() == Method.GET
            && q.headerHasToken("Upgrade", "websocket")
            && q.headerHasToken("Connection", "upgrade")
            && WsServerHandshake.hasKey(q)
            && q.headerIs("Sec-WebSocket-Version", "13");
    }

    /** Throws `HandshakeRejectedException` unless `q` is a valid upgrade. */
    public static void validate(HttpRequest q) {
        if (q.method() != Method.GET) {
            throw heap HandshakeRejectedException("websocket upgrade requires the GET method", 400);
        }
        if (!q.headerHasToken("Upgrade", "websocket")) {
            throw heap HandshakeRejectedException("missing or non-websocket Upgrade header", 400);
        }
        if (!q.headerHasToken("Connection", "upgrade")) {
            throw heap HandshakeRejectedException("Connection header does not request upgrade", 400);
        }
        if (!WsServerHandshake.hasKey(q)) {
            throw heap HandshakeRejectedException("missing Sec-WebSocket-Key header", 400);
        }
        if (!q.headerIs("Sec-WebSocket-Version", "13")) {
            throw heap HandshakeRejectedException("unsupported Sec-WebSocket-Version (only 13)", 426);
        }
    }

    /** Writes the rejection for `e` into `r`. */
    public static void reject(HandshakeRejectedException e, HttpResponse r) {
        r.status(e.httpStatus);
        if (e.httpStatus == 426) {
            r.header("Sec-WebSocket-Version", "13");
        }
    }

    static boolean hasKey(HttpRequest q) {
        return q.hasHeader("Sec-WebSocket-Key") && q.header("Sec-WebSocket-Key").count() > 0;
    }
}
