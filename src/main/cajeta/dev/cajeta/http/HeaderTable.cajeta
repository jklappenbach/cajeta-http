package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.lang.Slice;

/**
 * The header fields of one inbound message, held as windows into the
 * message's byte store. Lookup is case-insensitive over the bytes and
 * allocates nothing. The table is reused from message to message.
 *
 * A field set after parsing is copied into the table's own scratch bytes, so
 * an edit survives only until the next message.
 */
public final class HeaderTable {
    int8[] none;
    int8[] src;
    int8[] extra;
    int32 extraUsed;
    int32[] spans;
    int32 used;
    int32 limit;

    static int32 STRIDE = 5;

    /** A table that holds at most `limit` parsed fields. */
    public HeaderTable(int32 limit) {
        this.limit = limit;
        this.spans = heap int32[(limit + 8) * HeaderTable.STRIDE];
        this.used = 0;
        this.none = heap int8[0];
        this.src #= this.none;
        this.extra = heap int8[256];
        this.extraUsed = 0;
    }

    void reset(int8[] store) {
        this.src #= store;
        this.used = 0;
        this.extraUsed = 0;
    }

    void addField(int32 nameOff, int32 nameLen, int32 valueOff, int32 valueLen, int32 store) {
        if (this.used * HeaderTable.STRIDE >= this.spans.count()) {
            int32[] grown = heap int32[this.spans.count() * 2];
            int32 j = 0;
            while (j < this.used * HeaderTable.STRIDE) {
                grown[j] = this.spans[j];
                j = j + 1;
            }
            this.spans #= grown;
        }
        int32 k = this.used * HeaderTable.STRIDE;
        this.spans[k] = nameOff;
        this.spans[k + 1] = nameLen;
        this.spans[k + 2] = valueOff;
        this.spans[k + 3] = valueLen;
        this.spans[k + 4] = store;
        this.used = this.used + 1;
    }

    /** Records one parsed field. False when the table is already full. */
    boolean add(int32 nameOff, int32 nameLen, int32 valueOff, int32 valueLen) {
        if (this.used >= this.limit) {
            return false;
        }
        this.addField(nameOff, nameLen, valueOff, valueLen, 0);
        return true;
    }

    /** Number of fields, repeated names counted separately. */
    public int32 count() {
        return this.used;
    }

    /** The name of field `i`, as sent. */
    public Slice<int8> nameAt(int32 i) {
        int32 k = i * HeaderTable.STRIDE;
        int32 off = this.spans[k];
        if (this.spans[k + 4] == 1) {
            return this.extra[off:off + this.spans[k + 1]];
        }
        return this.src[off:off + this.spans[k + 1]];
    }

    /** The value of field `i`, with surrounding whitespace removed. */
    public Slice<int8> valueAt(int32 i) {
        int32 k = i * HeaderTable.STRIDE;
        int32 off = this.spans[k + 2];
        if (this.spans[k + 4] == 1) {
            return this.extra[off:off + this.spans[k + 3]];
        }
        return this.src[off:off + this.spans[k + 3]];
    }

    /** Index of the first field named `name` at or after `from`, or -1. */
    public int32 find(String name, int32 from) {
        int32 i = from;
        while (i < this.used) {
            if (Bytes.equalsIgnoreCase(this.nameAt(i), name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** True when a field named `name` is present. */
    public boolean has(String name) {
        return this.find(name, 0) >= 0;
    }

    /** The first value named `name`, or an empty window when absent. */
    public Slice<int8> get(String name) {
        int32 i = this.find(name, 0);
        if (i < 0) {
            return this.src[0:0];
        }
        return this.valueAt(i);
    }

    /** Number of fields named `name`. */
    public int32 countOf(String name) {
        int32 n = 0;
        int32 i = this.find(name, 0);
        while (i >= 0) {
            n = n + 1;
            i = this.find(name, i + 1);
        }
        return n;
    }

    /** True when the first value named `name` equals `value`, ignoring case. */
    public boolean is(String name, String value) {
        int32 i = this.find(name, 0);
        return i >= 0 && Bytes.equalsIgnoreCase(this.valueAt(i), value);
    }

    /** True when any field named `name` lists `token`, ignoring case. */
    public boolean hasToken(String name, String token) {
        int32 i = this.find(name, 0);
        while (i >= 0) {
            if (Bytes.hasToken(this.valueAt(i), token)) {
                return true;
            }
            i = this.find(name, i + 1);
        }
        return false;
    }

    /** The first value named `name` as a non-negative integer, or `fallback`. */
    public int64 int64Of(String name, int64 fallback) {
        int32 i = this.find(name, 0);
        if (i < 0) {
            return fallback;
        }
        return Bytes.parseInt64(this.valueAt(i), fallback);
    }

    /** An owned copy of the first value named `name`, or null when absent. */
    public #String copy(String name) {
        int32 i = this.find(name, 0);
        if (i < 0) {
            return null;
        }
        return Bytes.toString(this.valueAt(i));
    }

    /** Removes every field named `name`. */
    public void remove(String name) {
        int32 w = 0;
        int32 r = 0;
        while (r < this.used) {
            if (!Bytes.equalsIgnoreCase(this.nameAt(r), name)) {
                if (w != r) {
                    int32 j = 0;
                    while (j < HeaderTable.STRIDE) {
                        this.spans[w * HeaderTable.STRIDE + j] = this.spans[r * HeaderTable.STRIDE + j];
                        j = j + 1;
                    }
                }
                w = w + 1;
            }
            r = r + 1;
        }
        this.used = w;
    }

    int32 room(int32 need) {
        int32 at = this.extraUsed;
        if (at + need > this.extra.count()) {
            int32 cap = this.extra.count() * 2;
            while (cap < at + need) {
                cap = cap * 2;
            }
            int8[] grown = heap int8[cap];
            int32 j = 0;
            while (j < at) {
                grown[j] = this.extra[j];
                j = j + 1;
            }
            this.extra #= grown;
        }
        this.extraUsed = at + need;
        return at;
    }

    /** Replaces every field named `name` with one field holding `value`. */
    public void set(String name, String value) {
        this.remove(name);
        int32 nl = name.byteLength();
        int32 vl = value.byteLength();
        int32 at = this.room(nl + vl);
        int32 i = 0;
        while (i < nl) {
            this.extra[at + i] = name.byteAt(i);
            i = i + 1;
        }
        i = 0;
        while (i < vl) {
            this.extra[at + nl + i] = value.byteAt(i);
            i = i + 1;
        }
        this.addField(at, nl, at + nl, vl, 1);
    }

    /** As `set`, copying the value from a window, which may be one of this table's own. */
    public void setBytes(String name, Slice<int8> value) {
        int32 vl = (int32) value.count();
        int32 nl = name.byteLength();
        this.remove(name);
        if (this.extraUsed + nl + vl > this.extra.count()) {
            int8[] held = heap int8[vl];
            int32 h = 0;
            while (h < vl) {
                held[h] = value[(int64) h];
                h = h + 1;
            }
            this.putHeld(name, held, vl);
            return;
        }
        int32 at = this.room(nl + vl);
        int32 i = 0;
        while (i < nl) {
            this.extra[at + i] = name.byteAt(i);
            i = i + 1;
        }
        i = 0;
        while (i < vl) {
            this.extra[at + nl + i] = value[(int64) i];
            i = i + 1;
        }
        this.addField(at, nl, at + nl, vl, 1);
    }

    void putHeld(String name, int8[] held, int32 vl) {
        int32 nl = name.byteLength();
        int32 at = this.room(nl + vl);
        int32 i = 0;
        while (i < nl) {
            this.extra[at + i] = name.byteAt(i);
            i = i + 1;
        }
        i = 0;
        while (i < vl) {
            this.extra[at + nl + i] = held[i];
            i = i + 1;
        }
        this.addField(at, nl, at + nl, vl, 1);
    }
}
