package dev.cajeta.http.server;

import cajeta.lang.String;
import cajeta.io.net.Server;
import cajeta.io.net.ServerModel;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.TcpListener;
import cajeta.io.net.ConnectionLimits;
import cajeta.io.net.ConnectionLimiter;
import cajeta.io.net.BufferPool;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.ByteChannel;
import cajeta.io.net.tls.TlsStream;
import cajeta.error.Exception;
import cajeta.time.Duration;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.Http1Connection;
import dev.cajeta.http.h1.HttpParserLimits;

/**
 * An HTTP/1.1 server. Each connection takes an input and an output buffer
 * from the server's pool, serves every request on it through one
 * `Http1Connection`, and returns both buffers when it closes.
 *
 * The handler receives the request as a view over the input buffer and a
 * response that writes into the output buffer:
 *
 * ```cajeta
 * HttpServer srv #= HttpServer.builder()
 *     .bind("127.0.0.1:8080")
 *     .handler((HttpRequest q, HttpResponse r) -> r.body("hello"))
 *     .build();
 * srv.serve();
 * ```
 */
public class HttpServer {
    public (HttpRequest, HttpResponse) -> void handler;
    public Server server;
    public HttpParserLimits limits;
    public ServerLimits serverLimits;
    public ServerModel model;
    public ConnectionBuffers buffers;
    public TcpListener tlsListener;
    int8[] tlsCert;
    int32 tlsCertLen;
    int8[] tlsKey;
    int32 tlsKeyLen;
    public boolean isTls;
    public ConnectionLimiter limiter;
    public ConnectionLimits connLimits;

    /** Default size of each connection buffer, which bounds a request head and a held body. */
    public static final int32 DEFAULT_BUFFER_BYTES = 65536;

    /** A server running `handler`, not yet bound. */
    public HttpServer((HttpRequest, HttpResponse) -> void handler) {
        this.handler #= handler;
        this.server = null;
        this.limits = heap HttpParserLimits();
        this.serverLimits = heap ServerLimits();
        this.buffers = heap ConnectionBuffers(heap BufferPool(HttpServer.DEFAULT_BUFFER_BYTES, 64));
        this.isTls = false;
    }

    /** Binds `addr` with one fiber per connection. */
    public static #HttpServer bind(String addr, (HttpRequest, HttpResponse) -> void handler) {
        return HttpServer.bindAddressWithModel(SocketAddress.parse(addr),
            ServerModel.fiberPerConnection(), #handler);
    }

    /** Binds `addr` with one fiber per connection. */
    public static #HttpServer bindAddress(#SocketAddress addr, (HttpRequest, HttpResponse) -> void handler) {
        return HttpServer.bindAddressWithModel(#addr, ServerModel.fiberPerConnection(), #handler);
    }

    /** Binds `addr` under `model`. */
    public static #HttpServer bindWithModel(String addr, ServerModel model,
                                            (HttpRequest, HttpResponse) -> void handler) {
        return HttpServer.bindAddressWithModel(SocketAddress.parse(addr), model, #handler);
    }

    /** Binds `addr` under `model`. */
    public static #HttpServer bindAddressWithModel(#SocketAddress addr, ServerModel model,
                                                   (HttpRequest, HttpResponse) -> void handler) {
        return HttpServer.bindAddressWithModelAndLimits(#addr, model, #handler, null, null, null);
    }

    void applyLimits(#ServerLimits limits, #BufferPool pool) {
        if (limits != null) {
            ServerLimits l #= limits;
            this.serverLimits #= l;
            HttpParserLimits pl #= this.serverLimits.toParserLimits();
            this.limits #= pl;
        }
        if (pool != null) {
            BufferPool p #= pool;
            this.buffers = heap ConnectionBuffers(#p);
        }
    }

    /**
     * Binds `addr` under `model` with optional server limits, connection
     * limits and buffer pool. A null argument keeps the default.
     */
    public static #HttpServer bindAddressWithModelAndLimits(
            #SocketAddress addr, ServerModel model, (HttpRequest, HttpResponse) -> void handler,
            #ServerLimits limits, #ConnectionLimits climits, #BufferPool pool) {
        HttpServer srv = heap HttpServer(#handler);
        srv.model = model;
        srv.applyLimits(#limits, #pool);
        HttpServer self = srv;
        if (climits != null) {
            ConnectionLimits cls #= climits;
            int32 backlog = cls.listenBacklog;
            ConnectionLimiter climiter #= ConnectionLimiter.fromLimits(cls);
            srv.limiter #= climiter;
            srv.connLimits #= cls;
            Server admitted #= model.bindServerWithBacklog(#addr, backlog,
                (conn) -> self.serveAdmitted(conn));
            srv.server = #admitted;
            return #srv;
        }
        Server core #= model.bindServer(#addr, (conn) -> self.serveChannel(conn));
        srv.server = #core;
        return #srv;
    }

    void serveAdmitted(TcpStream conn) {
        if (!this.limiter.admit()) {
            conn.close();
            return;
        }
        try {
            this.serveChannel(conn);
        } catch (Exception e) {
        }
        this.limiter.release();
    }

    /** Serves every request on `ch` until it closes. */
    public void serveChannel(ByteChannel ch) {
        ByteBuffer in #= this.buffers.take();
        ByteBuffer out #= this.buffers.take();
        ServerLimits sl = this.serverLimits;
        Http1Connection conn = heap Http1Connection(ch, in, out, this.limits,
            sl.headReadTimeoutMs, sl.bodyReadTimeoutMs, sl.maxBodyBytes,
            sl.expectContinueEnabled, this.handler);
        try {
            conn.serve();
        } catch (Exception e) {
        }
        this.buffers.give(#in);
        this.buffers.give(#out);
    }

    /** Binds `addr` for HTTPS with the PEM `cert` and `key`. */
    public static #HttpServer bindTlsAddress(#SocketAddress addr, (HttpRequest, HttpResponse) -> void handler,
                                             #ServerLimits limits, int8[] cert, int32 certLen,
                                             int8[] key, int32 keyLen) {
        HttpServer srv = heap HttpServer(#handler);
        srv.applyLimits(#limits, null);
        int8[] certCopy = heap int8[certLen];
        int32 i = 0;
        while (i < certLen) {
            certCopy[i] = cert[i];
            i = i + 1;
        }
        srv.tlsCert #= certCopy;
        srv.tlsCertLen = certLen;
        int8[] keyCopy = heap int8[keyLen];
        i = 0;
        while (i < keyLen) {
            keyCopy[i] = key[i];
            i = i + 1;
        }
        srv.tlsKey #= keyCopy;
        srv.tlsKeyLen = keyLen;
        srv.isTls = true;
        TcpListener lst #= TcpListener.bind(addr);
        srv.tlsListener #= lst;
        return #srv;
    }

    /** The next TLS connection, or null once the listener is closed. */
    public #TcpStream acceptTlsNext() {
        try {
            return this.tlsListener.acceptAsync();
        } catch (Exception e) {
            return null;
        }
    }

    /** Serves `conn` over TLS on its own fiber. */
    public void dispatchTls(#TcpStream conn) {
        spawn tlsWorker(this, #conn);
    }

    static async int32 tlsWorker(HttpServer srv, #TcpStream conn) {
        TlsStream tls #= TlsStream.server(#conn, srv.tlsCert, srv.tlsCertLen, srv.tlsKey, srv.tlsKeyLen);
        int8[] alpn #= HttpServer.alpnHttp11();
        tls.supportAlpn(alpn, 9);
        try {
            tls.handshake();
        } catch (Exception e) {
            tls.close();
            return 0;
        }
        try {
            srv.serveChannel(tls);
        } catch (Exception e) {
        }
        try {
            tls.close();
        } catch (Exception e) {
        }
        return 1;
    }

    static #int8[] alpnHttp11() {
        int8[] a = heap int8[9];
        a[0] = (int8) 8;
        a[1] = (int8) 104;
        a[2] = (int8) 116;
        a[3] = (int8) 116;
        a[4] = (int8) 112;
        a[5] = (int8) 47;
        a[6] = (int8) 49;
        a[7] = (int8) 46;
        a[8] = (int8) 49;
        return #a;
    }

    /** Accepts and serves connections until `shutdown`. */
    public void serve() {
        if (this.isTls) {
            scope {
                boolean go = true;
                while (go) {
                    go = this.acceptOneTls();
                }
            }
            return;
        }
        this.server.serve();
    }

    boolean acceptOneTls() {
        TcpStream conn #= this.acceptTlsNext();
        if (conn == null) {
            return false;
        }
        this.dispatchTls(#conn);
        return true;
    }

    /** `serve` as a task. */
    public async int32 runAsync() {
        this.serve();
        return 0;
    }

    /** Stops accepting and waits up to `deadline` for open connections. */
    public boolean shutdown(Duration deadline) {
        if (this.isTls) {
            this.tlsListener.close();
            return true;
        }
        return this.server.shutdown(deadline);
    }

    /** The bound address. */
    public #SocketAddress localAddress() {
        if (this.isTls) {
            return this.tlsListener.localAddress();
        }
        return this.server.localAddress();
    }

    /** The server model. */
    public ServerModel serverModel() {
        return this.model;
    }

    /** The lifetime count of fresh connection buffers, for allocation checks. */
    public int32 bufferAllocations() {
        return this.buffers.allocations();
    }

    /** A builder. */
    public static #HttpServerBuilder builder() {
        return heap HttpServerBuilder();
    }
}
