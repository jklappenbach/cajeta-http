package dev.cajeta.http.server;

import dev.cajeta.http.h1.HttpParserLimits;

/**
 * The limits a server enforces before and while a handler runs: read
 * deadlines, the body cap, head caps, `Expect: 100-continue`, and whether
 * request bodies stream. A `0` for a deadline or the body cap disables it.
 */
public class ServerLimits {
    /** Default head-read deadline: 30 s. */
    public static final int32 DEFAULT_HEAD_TIMEOUT_MS = 30000;
    /** Default body-read idle timeout: 60 s. */
    public static final int32 DEFAULT_BODY_TIMEOUT_MS = 60000;
    /** Default max body size: 16 MiB. */
    public static final int64 DEFAULT_MAX_BODY_BYTES = (int64) 16777216;

    /** Milliseconds from a request's first byte to the end of its head; past it the answer is 408. */
    public int32 headReadTimeoutMs;
    /** Milliseconds each body read may wait for the peer; past it the answer is 408. */
    public int32 bodyReadTimeoutMs;
    /** Largest body in bytes. A larger `Content-Length` is 413 up front, a chunked body 413 once it crosses. */
    public int64 maxBodyBytes;
    /** Answers `Expect: 100-continue` with 100, or 413 when the declared length is over the cap. */
    public boolean expectContinueEnabled;
    /** Head caps installed on the parser; over any of them is 431. Non-positive means the parser default. */
    public int32 maxHeadBytes;
    public int32 maxLineBytes;
    public int32 maxHeaderCount;
    /**
     * Streams HTTP/1.1 request bodies to the handler through `bodyStream()`
     * instead of holding them, so bodies larger than the input buffer are served.
     */
    public boolean streamRequestBody;

    /** A 30 s head deadline, a 60 s body idle timeout, a 16 MiB body cap, 100-continue honoured. */
    public ServerLimits() {
        this.headReadTimeoutMs = ServerLimits.DEFAULT_HEAD_TIMEOUT_MS;
        this.bodyReadTimeoutMs = ServerLimits.DEFAULT_BODY_TIMEOUT_MS;
        this.maxBodyBytes = ServerLimits.DEFAULT_MAX_BODY_BYTES;
        this.expectContinueEnabled = true;
        this.maxHeadBytes = 65536;
        this.maxLineBytes = 8192;
        this.maxHeaderCount = 100;
        this.streamRequestBody = false;
    }

    /** Limits with these deadlines and cap, taken verbatim, so `0` disables one. */
    public static #ServerLimits of(int32 headReadTimeoutMs,
                                   int32 bodyReadTimeoutMs,
                                   int64 maxBodyBytes,
                                   boolean expectContinueEnabled) {
        ServerLimits l = heap ServerLimits();
        l.headReadTimeoutMs = headReadTimeoutMs;
        l.bodyReadTimeoutMs = bodyReadTimeoutMs;
        l.maxBodyBytes = maxBodyBytes;
        l.expectContinueEnabled = expectContinueEnabled;
        return #l;
    }

    /** The parser limits carrying the head caps. */
    public #HttpParserLimits toParserLimits() {
        return HttpParserLimits.of(this.maxHeadBytes, this.maxLineBytes,
                                   this.maxHeaderCount);
    }

    /** True when a head deadline is in force. */
    public boolean hasHeadDeadline() {
        return this.headReadTimeoutMs > 0;
    }

    /** True when a body idle timeout is in force. */
    public boolean hasBodyDeadline() {
        return this.bodyReadTimeoutMs > 0;
    }

    /** True when a body cap is in force. */
    public boolean hasBodyCap() {
        return this.maxBodyBytes > 0;
    }

    /** Whether a body of `lengthBytes` is within the cap. Always true with no cap. */
    public boolean bodyWithinCap(int64 lengthBytes) {
        if (!this.hasBodyCap()) {
            return true;
        }
        return lengthBytes <= this.maxBodyBytes;
    }
}
