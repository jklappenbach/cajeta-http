package dev.cajeta.http.server;

import cajeta.error.Exception;

import cajeta.lang.String;
import cajeta.io.net.ServerModel;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.ConnectionLimits;
import cajeta.io.net.BufferPool;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;

/** Collects a server's address, model, handler, limits, buffers and TLS material. */
public class HttpServerBuilder {
    private String addr;
    private ServerModel model;
    private (HttpRequest, HttpResponse) -> void handler;
    private ServerLimits slim;
    private BufferPool bPool;
    private int8[] bCert;
    private int32 bCertLen;
    private int8[] bKey;
    private int32 bKeyLen;
    private boolean bTls;
    private ConnectionLimits bClimits;
    private boolean bH2Prior;
    private int32 bMode;
    private int32 bMaxInFlight;
    private int32 bMaxPending;
    private int32 bFramers;
    private boolean bSerializedStreams;
    private int64 bWsMaxMessage;
    private MultipartRoutes bMultipart;
    private int32 bMaxPartBytes;
    private boolean bRefused;   // model(ServerModel.sharedPool(n)) was called

    /** A builder with the request-dispatch pool (spec §6) and default limits. */
    public HttpServerBuilder() {
        this.addr = null;
        this.model #= ServerModel.fiberPerConnection();
        this.handler = null;
        this.slim = null;
        this.bPool = null;
        this.bCert = heap int8[0];
        this.bCertLen = 0;
        this.bKey = heap int8[0];
        this.bKeyLen = 0;
        this.bTls = false;
        this.bClimits = null;
        this.bH2Prior = false;
        this.bMode = HttpServer.DISPATCH_POOL;
        this.bMaxInFlight = 256;
        this.bMaxPending = 4;
        this.bFramers = 0;
        this.bSerializedStreams = false;
        this.bWsMaxMessage = (int64) 0;
        this.bMultipart = null;
        this.bMaxPartBytes = 0;
        this.bRefused = false;
    }

    /** h2: one stream at a time per connection (spec §4.4); default false, streams run in parallel. */
    public HttpServerBuilder serializedStreams(boolean on) {
        this.bSerializedStreams = on;
        return this;
    }

    /**
     * How the route `method pattern` takes a multipart body (spec §2.3):
     * `MultipartMode.WHOLE` (the default for every route), `PART` (the handler
     * runs once per completed part, with `HttpRequest.multipartPart` set) or
     * `STREAM` (the handler gets `HttpRequest.bodyStream` at head complete).
     * The modes apply under both server models, the pool and
     * `fiberPerConnection()` (spec §4.6), and to HTTP/1.1 requests and h2
     * streams alike (h2-streaming-request-body, 0.8.0).
     */
    public HttpServerBuilder multipart(String method, String pattern, int32 mode) {
        if (this.bMultipart == null) {
            this.bMultipart = heap MultipartRoutes();
        }
        this.bMultipart.add(method, pattern, mode);
        return this;
    }

    /** The largest single part a `PART` route accepts, in bytes (spec §2.3.2); default 16 MiB. */
    public HttpServerBuilder maxPartBytes(int32 bytes) {
        this.bMaxPartBytes = bytes;
        return this;
    }

    /** The largest WebSocket message a route accepts, in bytes (spec §2.5.3); default 64 MiB. */
    public HttpServerBuilder wsMaxMessageLength(int64 bytes) {
        this.bWsMaxMessage = bytes;
        return this;
    }

    /** Units dispatched and not yet returned (spec §4.2); default 256. */
    public HttpServerBuilder maxInFlight(int32 n) {
        this.bMaxInFlight = n < 1 ? 1 : n;
        return this;
    }

    /** Complete units a connection may hold before its socket is paused (spec §4.3); default 4. */
    public HttpServerBuilder maxPendingUnits(int32 n) {
        this.bMaxPending = n < 1 ? 1 : n;
        return this;
    }

    /** Framer fibers (spec §3.1); default the carrier count. */
    public HttpServerBuilder framers(int32 k) {
        this.bFramers = k < 1 ? 0 : k;
        return this;
    }

    /** Serves HTTP/2 on plaintext connections that open with its preface (RFC 9113 prior knowledge). */
    public HttpServerBuilder h2PriorKnowledge() {
        this.bH2Prior = true;
        return this;
    }

    /** The address to bind, such as "127.0.0.1:8080". */
    public HttpServerBuilder bind(String addr) {
        this.addr #= addr.substring(0, addr.byteLength());
        return this;
    }

    /**
     * The server model, for `fiberPerConnection()` spelled through the stdlib
     * type. The stdlib shared-pool kind is not a model this server takes:
     * `build()` refuses it, naming `maxInFlight` (spec §6.2). The old call
     * meant N workers owning whole connections; the pool bounds units in
     * flight instead, and `maxInFlight(n)` is the setting that replaces it.
     */
    public HttpServerBuilder model(ServerModel model) {
        if (model.kind == ServerModel.SHARED_POOL_KIND) {
            this.bRefused = true;
            return this;
        }
        this.bMode = HttpServer.DISPATCH_FIBER;
        this.model #= model;
        return this;
    }

    /** One fiber per connection, the connection's own loop (spec §4.6). */
    public HttpServerBuilder fiberPerConnection() {
        this.bMode = HttpServer.DISPATCH_FIBER;
        this.model #= ServerModel.fiberPerConnection();
        return this;
    }

    /** The handler every request runs. */
    public HttpServerBuilder handler((HttpRequest, HttpResponse) -> void handler) {
        this.handler #= handler;
        return this;
    }

    /** Timeouts, body cap and head limits. */
    public HttpServerBuilder serverLimits(#ServerLimits l) {
        this.slim = #l;
        return this;
    }

    /** Admission limits on concurrent connections. */
    public HttpServerBuilder connectionLimits(#ConnectionLimits l) {
        this.bClimits = #l;
        return this;
    }

    /**
     * The pool connection buffers come from. Its buffer size bounds a request
     * head plus a held body, and a response before it is flushed in pieces.
     */
    public HttpServerBuilder bufferPool(#BufferPool pool) {
        this.bPool = #pool;
        return this;
    }

    /** Serves HTTPS with the PEM `cert` and `key`, which are copied. */
    public HttpServerBuilder tls(int8[] cert, int32 certLen, int8[] key, int32 keyLen) {
        int8[] certCopy = heap int8[certLen];
        int32 i = 0;
        while (i < certLen) {
            certCopy[i] = cert[i];
            i = i + 1;
        }
        this.bCert = #certCopy;
        this.bCertLen = certLen;
        int8[] keyCopy = heap int8[keyLen];
        i = 0;
        while (i < keyLen) {
            keyCopy[i] = key[i];
            i = i + 1;
        }
        this.bKey = #keyCopy;
        this.bKeyLen = keyLen;
        this.bTls = true;
        return this;
    }

    /** The selected model. */
    public ServerModel selectedModel() {
        return this.model;
    }

    /** Binds and returns the server. A missing handler answers every request with 500. */
    public #HttpServer build() {
        if (this.bRefused) {
            String why = "HttpServerBuilder: the stdlib shared-pool model is not a server model here; "
                + "the request-dispatch pool is the default and maxInFlight(n) bounds the units in flight "
                + "(sharedPool(n) meant n workers owning whole connections)";
            throw heap Exception(why.substring(0, why.byteLength()));
        }
        (HttpRequest, HttpResponse) -> void h #= this.handler;
        this.handler = null;
        if (h == null) {
            h = (HttpRequest q, HttpResponse r) -> {
                r.status(500);
            };
        }
        ServerLimits l = null;
        if (this.slim != null) {
            ServerLimits moved #= this.slim;
            this.slim = null;
            l = #moved;
        }
        BufferPool p = null;
        if (this.bPool != null) {
            BufferPool pmoved #= this.bPool;
            this.bPool = null;
            p = #pmoved;
        }
        if (this.bTls) {
            HttpServer tls #= HttpServer.bindTlsAddress(SocketAddress.parse(this.addr), #h, #l,
                this.bCert, this.bCertLen, this.bKey, this.bKeyLen);
            if (this.bClimits != null) {
                ConnectionLimits tmoved #= this.bClimits;
                this.bClimits = null;
                tls.limitConnections(#tmoved);
            }
            if (p != null) {
                BufferPool tp #= p;
                p = null;
                tls.buffers = heap ConnectionBuffers(#tp);
            }
            this.applyDispatch(tls);
            return #tls;
        }
        ConnectionLimits cl = null;
        if (this.bClimits != null) {
            ConnectionLimits cmoved #= this.bClimits;
            this.bClimits = null;
            cl = #cmoved;
        }
        ServerModel m #= this.model;
        this.model = null;
        HttpServer srv #= HttpServer.bindAddressWithModelAndLimits(SocketAddress.parse(this.addr),
            #m, #h, #l, #cl, #p);
        this.applyDispatch(srv);
        return #srv;
    }

    /** The model and the dispatch settings, the same for a plaintext and a TLS server. */
    void applyDispatch(HttpServer srv) {
        srv.h2Prior = this.bH2Prior;
        srv.dispatchMode = this.bMode;
        srv.maxInFlightN = this.bMaxInFlight;
        srv.maxPendingN = this.bMaxPending;
        srv.framerN = this.bFramers;
        srv.serializedStreamsN = this.bSerializedStreams;
        if (this.bWsMaxMessage > (int64) 0) {
            srv.wsMaxMessageN = this.bWsMaxMessage;
        }
        if (this.bMultipart != null) {
            MultipartRoutes mr #= this.bMultipart;
            srv.multipartRoutes #= mr;
        }
        if (this.bMaxPartBytes > 0) {
            srv.maxPartBytesN = this.bMaxPartBytes;
        }
    }

    /** Builds and serves until shutdown. */
    public void serve() {
        HttpServer srv #= this.build();
        srv.serve();
    }
}
