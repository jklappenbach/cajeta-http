package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 401 Unauthorized. A server answers it with an empty body. */
public class UnauthorizedException extends HttpException {
    public UnauthorizedException() {
        this.message = "Unauthorized";
        this.cause = 0;
        this.kind = 12;
    }

    public UnauthorizedException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 401;
    }
}
