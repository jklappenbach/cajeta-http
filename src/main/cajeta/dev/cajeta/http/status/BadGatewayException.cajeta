package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 502 Bad Gateway. A server answers it with an empty body. */
public class BadGatewayException extends HttpException {
    public BadGatewayException() {
        this.message = "Bad Gateway";
        this.cause = 0;
        this.kind = 12;
    }

    public BadGatewayException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 502;
    }
}
