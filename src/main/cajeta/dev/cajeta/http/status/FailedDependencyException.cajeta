package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 424 Failed Dependency. A server answers it with an empty body. */
public class FailedDependencyException extends HttpException {
    public FailedDependencyException() {
        this.message = "Failed Dependency";
        this.cause = 0;
        this.kind = 12;
    }

    public FailedDependencyException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 424;
    }
}
