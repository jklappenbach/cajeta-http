package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 429 Too Many Requests. A server answers it with an empty body. */
public class TooManyRequestsException extends HttpException {
    public TooManyRequestsException() {
        this.message = "Too Many Requests";
        this.cause = 0;
        this.kind = 12;
    }

    public TooManyRequestsException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 429;
    }
}
