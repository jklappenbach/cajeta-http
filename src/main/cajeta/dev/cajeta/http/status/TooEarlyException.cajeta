package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 425 Too Early. A server answers it with an empty body. */
public class TooEarlyException extends HttpException {
    public TooEarlyException() {
        this.message = "Too Early";
        this.cause = 0;
        this.kind = 12;
    }

    public TooEarlyException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 425;
    }
}
