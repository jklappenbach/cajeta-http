package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 402 Payment Required. A server answers it with an empty body. */
public class PaymentRequiredException extends HttpException {
    public PaymentRequiredException() {
        this.message = "Payment Required";
        this.cause = 0;
        this.kind = 12;
    }

    public PaymentRequiredException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 402;
    }
}
