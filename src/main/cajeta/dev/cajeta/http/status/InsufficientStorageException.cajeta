package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 507 Insufficient Storage. A server answers it with an empty body. */
public class InsufficientStorageException extends HttpException {
    public InsufficientStorageException() {
        this.message = "Insufficient Storage";
        this.cause = 0;
        this.kind = 12;
    }

    public InsufficientStorageException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 507;
    }
}
