package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 428 Precondition Required. A server answers it with an empty body. */
public class PreconditionRequiredException extends HttpException {
    public PreconditionRequiredException() {
        this.message = "Precondition Required";
        this.cause = 0;
        this.kind = 12;
    }

    public PreconditionRequiredException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 428;
    }
}
