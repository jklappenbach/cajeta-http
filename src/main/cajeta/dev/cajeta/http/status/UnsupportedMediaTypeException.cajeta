package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 415 Unsupported Media Type. A server answers it with an empty body. */
public class UnsupportedMediaTypeException extends HttpException {
    public UnsupportedMediaTypeException() {
        this.message = "Unsupported Media Type";
        this.cause = 0;
        this.kind = 12;
    }

    public UnsupportedMediaTypeException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 415;
    }
}
