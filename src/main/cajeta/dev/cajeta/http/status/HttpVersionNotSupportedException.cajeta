package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 505 HTTP Version Not Supported. A server answers it with an empty body. */
public class HttpVersionNotSupportedException extends HttpException {
    public HttpVersionNotSupportedException() {
        this.message = "HTTP Version Not Supported";
        this.cause = 0;
        this.kind = 12;
    }

    public HttpVersionNotSupportedException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 505;
    }
}
