package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 506 Variant Also Negotiates. A server answers it with an empty body. */
public class VariantAlsoNegotiatesException extends HttpException {
    public VariantAlsoNegotiatesException() {
        this.message = "Variant Also Negotiates";
        this.cause = 0;
        this.kind = 12;
    }

    public VariantAlsoNegotiatesException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 506;
    }
}
