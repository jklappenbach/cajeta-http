package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 400 Bad Request. A server answers it with an empty body. */
public class BadRequestException extends HttpException {
    public BadRequestException() {
        this.message = "Bad Request";
        this.cause = 0;
        this.kind = 12;
    }

    public BadRequestException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 400;
    }
}
