package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 411 Length Required. A server answers it with an empty body. */
public class LengthRequiredException extends HttpException {
    public LengthRequiredException() {
        this.message = "Length Required";
        this.cause = 0;
        this.kind = 12;
    }

    public LengthRequiredException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 411;
    }
}
