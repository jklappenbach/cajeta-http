package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 409 Conflict. A server answers it with an empty body. */
public class ConflictException extends HttpException {
    public ConflictException() {
        this.message = "Conflict";
        this.cause = 0;
        this.kind = 12;
    }

    public ConflictException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 409;
    }
}
