package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 412 Precondition Failed. A server answers it with an empty body. */
public class PreconditionFailedException extends HttpException {
    public PreconditionFailedException() {
        this.message = "Precondition Failed";
        this.cause = 0;
        this.kind = 12;
    }

    public PreconditionFailedException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 412;
    }
}
