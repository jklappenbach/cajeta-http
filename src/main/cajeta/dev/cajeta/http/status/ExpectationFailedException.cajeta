package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 417 Expectation Failed. A server answers it with an empty body. */
public class ExpectationFailedException extends HttpException {
    public ExpectationFailedException() {
        this.message = "Expectation Failed";
        this.cause = 0;
        this.kind = 12;
    }

    public ExpectationFailedException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 417;
    }
}
