package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 407 Proxy Authentication Required. A server answers it with an empty body. */
public class ProxyAuthenticationRequiredException extends HttpException {
    public ProxyAuthenticationRequiredException() {
        this.message = "Proxy Authentication Required";
        this.cause = 0;
        this.kind = 12;
    }

    public ProxyAuthenticationRequiredException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 407;
    }
}
