package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 510 Not Extended. A server answers it with an empty body. */
public class NotExtendedException extends HttpException {
    public NotExtendedException() {
        this.message = "Not Extended";
        this.cause = 0;
        this.kind = 12;
    }

    public NotExtendedException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 510;
    }
}
