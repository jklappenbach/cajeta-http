package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 426 Upgrade Required. A server answers it with an empty body. */
public class UpgradeRequiredException extends HttpException {
    public UpgradeRequiredException() {
        this.message = "Upgrade Required";
        this.cause = 0;
        this.kind = 12;
    }

    public UpgradeRequiredException(String message) {
        this.message #= message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 426;
    }
}
