package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 451 Unavailable For Legal Reasons. A server answers it with an empty body. */
public class UnavailableForLegalReasonsException extends HttpException {
    public UnavailableForLegalReasonsException() {
        this.message = "Unavailable For Legal Reasons";
        this.cause = 0;
        this.kind = 12;
    }

    public UnavailableForLegalReasonsException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 451;
    }
}
