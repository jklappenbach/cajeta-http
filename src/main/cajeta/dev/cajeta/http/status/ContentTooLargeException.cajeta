package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.PayloadTooLargeException;

/** 413 Content Too Large, thrown by application code. The parser's own limit raises {@link PayloadTooLargeException}. */
public class ContentTooLargeException extends PayloadTooLargeException {
    public ContentTooLargeException() {
        this.message = "Content Too Large";
        this.cause = 0;
        this.kind = 12;
        this.limit = 0;
        this.observed = 0;
    }

    public ContentTooLargeException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
        this.limit = 0;
        this.observed = 0;
    }
}
