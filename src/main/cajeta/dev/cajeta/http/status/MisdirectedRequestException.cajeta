package dev.cajeta.http.status;

import cajeta.lang.String;
import dev.cajeta.http.HttpException;

/** 421 Misdirected Request. A server answers it with an empty body. */
public class MisdirectedRequestException extends HttpException {
    public MisdirectedRequestException() {
        this.message = "Misdirected Request";
        this.cause = 0;
        this.kind = 12;
    }

    public MisdirectedRequestException(String message) {
        this.message = message;
        this.cause = 0;
        this.kind = 12;
    }

    public int32 httpStatus() {
        return 421;
    }
}
