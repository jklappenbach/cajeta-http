package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.lang.Slice;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.ByteChannel;
import dev.cajeta.http.body.Body;

/**
 * The response a handler fills, written straight into the connection's
 * output buffer.
 *
 * The body lands behind reserved head room, and the head is composed in
 * front of it when the handler returns, so a response that fits is one
 * write. A body that outgrows the buffer is flushed in bounded pieces, as
 * chunks unless the handler declared a Content-Length. Header names and
 * values are copied in, so nothing the handler passes is retained.
 */
public final class HttpResponse {
    ByteBuffer out;
    ByteChannel ch;
    int8[] fields;
    int32[] spans;
    int32 fieldsUsed;
    int32 count;
    int32 maxFields;
    int32 room;
    int32 code;
    int32 bodyLen;
    int64 sent;
    boolean committed;
    boolean chunked;
    boolean omitBody;
    boolean reuse;
    Version peer;
    Body stream;

    /**
     * A writer over `out` with `fieldBytes` of header space and at most
     * `maxFields` fields. `ch` receives flushes and may be null when the
     * response must fit in the buffer.
     */
    public HttpResponse(ByteBuffer out, ByteChannel ch, int32 fieldBytes, int32 maxFields) {
        this.out #= out;
        this.ch #= ch;
        this.fields = heap int8[fieldBytes];
        this.spans = heap int32[maxFields * 5];
        this.maxFields = maxFields;
        this.room = fieldBytes + 128;
        this.reset();
    }

    /** Clears status, headers and body for the next response on the connection. */
    public void reset() {
        this.code = 200;
        this.fieldsUsed = 0;
        this.count = 0;
        this.bodyLen = 0;
        this.sent = 0;
        this.committed = false;
        this.chunked = false;
        this.omitBody = false;
        this.reuse = true;
        this.peer = Version.HTTP_1_1;
        this.stream = null;
    }

    /** Sets the status code. */
    public HttpResponse status(int32 status) {
        this.code = status;
        return this;
    }

    /** The status code, 200 unless set. */
    public int32 status() {
        return this.code;
    }

    /** True once the head has been written to the channel. */
    public boolean isCommitted() {
        return this.committed;
    }

    void requireOpen() {
        if (this.committed) {
            throw heap HttpException("response head already sent");
        }
    }

    int32 reserve(int32 n) {
        if (this.fieldsUsed + n > this.fields.count() || this.count >= this.maxFields) {
            throw heap HeadersTooLargeException("response header space exhausted",
                (int64) this.fields.count(), (int64) (this.fieldsUsed + n));
        }
        int32 at = this.fieldsUsed;
        this.fieldsUsed = this.fieldsUsed + n;
        return at;
    }

    void putText(int32 at, String text) {
        int32 n = text.byteLength();
        int32 i = 0;
        while (i < n) {
            this.fields[at + i] = text.byteAt(i);
            i = i + 1;
        }
    }

    void addSpan(int32 nameAt, int32 nameLen, int32 valueAt, int32 valueLen) {
        int32 k = this.count * 5;
        this.spans[k] = nameAt;
        this.spans[k + 1] = nameLen;
        this.spans[k + 2] = valueAt;
        this.spans[k + 3] = valueLen;
        this.spans[k + 4] = 1;
        this.count = this.count + 1;
    }

    /** Adds a header field, keeping any earlier field of the same name. */
    public HttpResponse header(String name, String value) {
        this.requireOpen();
        int32 nl = name.byteLength();
        int32 vl = value.byteLength();
        int32 at = this.reserve(nl + vl);
        this.putText(at, name);
        this.putText(at + nl, value);
        this.addSpan(at, nl, at + nl, vl);
        return this;
    }

    /** Adds a header field whose value is a byte window. */
    public HttpResponse headerBytes(String name, Slice<int8> value) {
        this.requireOpen();
        int32 nl = name.byteLength();
        int32 vl = (int32) value.count();
        int32 at = this.reserve(nl + vl);
        this.putText(at, name);
        int32 i = 0;
        while (i < vl) {
            this.fields[at + nl + i] = value[(int64) i];
            i = i + 1;
        }
        this.addSpan(at, nl, at + nl, vl);
        return this;
    }

    /** Adds a header field whose value is a decimal integer. */
    public HttpResponse headerInt(String name, int64 value) {
        this.requireOpen();
        int32 digits = HttpResponse.decimalWidth(value);
        int32 nl = name.byteLength();
        int32 at = this.reserve(nl + digits);
        this.putText(at, name);
        HttpResponse.putDecimal(this.fields, at + nl, digits, value);
        this.addSpan(at, nl, at + nl, digits);
        return this;
    }

    /** Replaces every field named `name` with one field. */
    public HttpResponse setHeader(String name, String value) {
        this.removeHeader(name);
        return this.header(name, value);
    }

    /** Removes every field named `name`. */
    public HttpResponse removeHeader(String name) {
        this.requireOpen();
        int32 i = 0;
        while (i < this.count) {
            if (this.spans[i * 5 + 4] == 1 && Bytes.equalsIgnoreCase(this.nameAt(i), name)) {
                this.spans[i * 5 + 4] = 0;
            }
            i = i + 1;
        }
        return this;
    }

    Slice<int8> nameAt(int32 i) {
        int32 k = i * 5;
        return this.fields[this.spans[k]:this.spans[k] + this.spans[k + 1]];
    }

    Slice<int8> valueAt(int32 i) {
        int32 k = i * 5;
        return this.fields[this.spans[k + 2]:this.spans[k + 2] + this.spans[k + 3]];
    }

    int32 findField(String name) {
        int32 i = 0;
        while (i < this.count) {
            if (this.spans[i * 5 + 4] == 1 && Bytes.equalsIgnoreCase(this.nameAt(i), name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** True when a field named `name` is set. */
    public boolean hasHeader(String name) {
        return this.findField(name) >= 0;
    }

    /** The first value named `name`, or an empty window. */
    public Slice<int8> header(String name) {
        int32 i = this.findField(name);
        if (i < 0) {
            return this.fields[0:0];
        }
        return this.valueAt(i);
    }

    /** True when the first value named `name` lists `token`, ignoring case. */
    public boolean headerHasToken(String name, String token) {
        int32 i = this.findField(name);
        return i >= 0 && Bytes.hasToken(this.valueAt(i), token);
    }

    int32 capacity() {
        return this.out.capacity() - this.room - 8;
    }

    /** Replaces the body with the bytes of `text`. */
    public HttpResponse body(String text) {
        this.bodyLen = 0;
        return this.write(text);
    }

    /** Replaces the body with `data[0 .. length)`. */
    public HttpResponse body(int8[] data, int32 length) {
        this.bodyLen = 0;
        return this.write(data, 0, length);
    }

    /** Replaces the body with the bytes of a window. */
    public HttpResponse bodyBytes(Slice<int8> data) {
        this.bodyLen = 0;
        return this.writeBytes(data);
    }

    /** Streams the body from `b` after the handler returns. */
    public HttpResponse body(#Body b) {
        this.bodyLen = 0;
        this.stream #= b;
        return this;
    }

    /** Appends the bytes of `text` to the body. */
    public HttpResponse write(String text) {
        int32 n = text.byteLength();
        int32 i = 0;
        while (i < n) {
            if (this.bodyLen >= this.capacity()) {
                this.spill();
            }
            this.out.array()[this.room + this.bodyLen] = text.byteAt(i);
            this.bodyLen = this.bodyLen + 1;
            i = i + 1;
        }
        return this;
    }

    /** Appends `data[offset .. offset + length)` to the body. */
    public HttpResponse write(int8[] data, int32 offset, int32 length) {
        int32 i = 0;
        int8[] a = this.out.array();
        while (i < length) {
            if (this.bodyLen >= this.capacity()) {
                this.spill();
            }
            a[this.room + this.bodyLen] = data[offset + i];
            this.bodyLen = this.bodyLen + 1;
            i = i + 1;
        }
        return this;
    }

    /** Appends the bytes of a window to the body. */
    public HttpResponse writeBytes(Slice<int8> data) {
        int64 n = data.count();
        int64 i = 0;
        int8[] a = this.out.array();
        while (i < n) {
            if (this.bodyLen >= this.capacity()) {
                this.spill();
            }
            a[this.room + this.bodyLen] = data[i];
            this.bodyLen = this.bodyLen + 1;
            i = i + 1;
        }
        return this;
    }

    /** The body not yet flushed, as a window into the output buffer. */
    public Slice<int8> body() {
        int8[] a = this.out.array();
        return a[this.room:this.room + this.bodyLen];
    }

    /** Length of the body not yet flushed. */
    public int32 bodyLength() {
        return this.bodyLen;
    }

    /** The streamed body, or null. */
    public Body bodyStream() {
        return this.stream;
    }

    static int32 decimalWidth(int64 v) {
        int32 d = 1;
        int64 x = v;
        while (x >= 10) {
            x = x / 10;
            d = d + 1;
        }
        return d;
    }

    static void putDecimal(int8[] a, int32 at, int32 digits, int64 v) {
        int64 x = v;
        int32 i = digits - 1;
        while (i >= 0) {
            a[at + i] = (int8) (48 + (int32) (x % 10));
            x = x / 10;
            i = i - 1;
        }
    }

    boolean bodyless() {
        return (this.code >= 100 && this.code < 200) || this.code == 204 || this.code == 304;
    }

    public static int32 put(int8[] a, int32 at, String text) {
        int32 n = text.byteLength();
        int32 i = 0;
        while (i < n) {
            a[at + i] = text.byteAt(i);
            i = i + 1;
        }
        return at + n;
    }

    static int32 putBytes(int8[] a, int32 at, Slice<int8> s) {
        int64 n = s.count();
        int64 i = 0;
        while (i < n) {
            a[at + (int32) i] = s[i];
            i = i + 1;
        }
        return at + (int32) n;
    }

    int32 headLength(boolean withLength, int64 length) {
        String reason = Status.reasonLiteral(this.code);
        int32 n = 9 + 3 + 1 + reason.byteLength() + 2;
        int32 i = 0;
        while (i < this.count) {
            int32 k = i * 5;
            if (this.spans[k + 4] == 1) {
                n = n + this.spans[k + 1] + 2 + this.spans[k + 3] + 2;
            }
            i = i + 1;
        }
        if (withLength) {
            n = n + 16 + HttpResponse.decimalWidth(length) + 2;
        }
        if (this.chunked) {
            n = n + 19 + 7 + 2;
        }
        if (!this.reuse) {
            n = n + 12 + 5 + 2;
        } else if (this.peer == Version.HTTP_1_0) {
            n = n + 12 + 10 + 2;
        }
        return n + 2;
    }

    void composeHead(int32 at, boolean withLength, int64 length) {
        int8[] a = this.out.array();
        int32 p = HttpResponse.put(a, at, "HTTP/1.1 ");
        HttpResponse.putDecimal(a, p, 3, (int64) this.code);
        p = p + 3;
        a[p] = (int8) 32;
        p = HttpResponse.put(a, p + 1, Status.reasonLiteral(this.code));
        p = HttpResponse.put(a, p, "\r\n");
        int32 i = 0;
        while (i < this.count) {
            if (this.spans[i * 5 + 4] == 1) {
                p = HttpResponse.putBytes(a, p, this.nameAt(i));
                p = HttpResponse.put(a, p, ": ");
                p = HttpResponse.putBytes(a, p, this.valueAt(i));
                p = HttpResponse.put(a, p, "\r\n");
            }
            i = i + 1;
        }
        if (withLength) {
            p = HttpResponse.put(a, p, "content-length: ");
            int32 d = HttpResponse.decimalWidth(length);
            HttpResponse.putDecimal(a, p, d, length);
            p = HttpResponse.put(a, p + d, "\r\n");
        }
        if (this.chunked) {
            p = HttpResponse.put(a, p, "transfer-encoding: chunked\r\n");
        }
        if (!this.reuse) {
            p = HttpResponse.put(a, p, "Connection: close\r\n");
        } else if (this.peer == Version.HTTP_1_0) {
            p = HttpResponse.put(a, p, "Connection: keep-alive\r\n");
        }
        HttpResponse.put(a, p, "\r\n");
    }

    void prepareFraming(boolean reuse, Version peer) {
        this.reuse = reuse;
        this.peer = peer;
        this.removeHeader("Connection");
    }

    static int32 hexWidth(int32 v) {
        int32 d = 1;
        int32 x = v;
        while (x >= 16) {
            x = x / 16;
            d = d + 1;
        }
        return d;
    }

    static void putHex(int8[] a, int32 at, int32 digits, int32 v) {
        int32 x = v;
        int32 i = digits - 1;
        while (i >= 0) {
            int32 h = x % 16;
            a[at + i] = (int8) (h < 10 ? 48 + h : 87 + h);
            x = x / 16;
            i = i - 1;
        }
    }

    void flushRange(int32 from, int32 to) {
        this.out.clear();
        this.out.advanceWrite(to);
        this.out.advanceRead(from);
        this.out.writeToAsync(this.ch);
    }

    void spill() {
        if (this.ch == null) {
            throw heap HttpException("response body exceeds the output buffer");
        }
        int8[] a = this.out.array();
        int32 start = this.room;
        if (!this.committed) {
            this.chunked = !this.hasHeader("content-length") && !this.hasHeader("transfer-encoding");
            int32 lineLen = this.chunked ? HttpResponse.hexWidth(this.bodyLen) + 2 : 0;
            int32 h = this.headLength(false, (int64) 0);
            start = this.room - lineLen - h;
            this.composeHead(start, false, (int64) 0);
            this.committed = true;
        } else if (this.chunked) {
            start = this.room - HttpResponse.hexWidth(this.bodyLen) - 2;
        }
        int32 end = this.room + this.bodyLen;
        if (this.chunked) {
            int32 w = HttpResponse.hexWidth(this.bodyLen);
            int32 lineAt = this.room - w - 2;
            HttpResponse.putHex(a, lineAt, w, this.bodyLen);
            a[lineAt + w] = (int8) 13;
            a[lineAt + w + 1] = (int8) 10;
            a[end] = (int8) 13;
            a[end + 1] = (int8) 10;
            end = end + 2;
        }
        this.flushRange(start, end);
        this.sent = this.sent + (int64) this.bodyLen;
        this.bodyLen = 0;
    }

    /**
     * Makes the response ready to write. `reuse` says whether the connection
     * stays open, and `peer` is the request's version. Returns false when
     * everything was already flushed. Otherwise the output buffer's readable
     * region is exactly the bytes still to send.
     */
    public boolean finish(boolean reuse, Version peer, boolean omitBody) {
        if (!this.committed) {
            this.prepareFraming(reuse && !this.headerHasToken("connection", "close"), peer);
            this.omitBody = omitBody;
            boolean declared = this.hasHeader("content-length") || this.hasHeader("transfer-encoding");
            boolean withLength = !declared && !this.bodyless();
            int32 h = this.headLength(withLength, (int64) this.bodyLen);
            int32 start = this.room - h;
            this.composeHead(start, withLength, (int64) this.bodyLen);
            int32 end = this.room + (this.omitBody || this.bodyless() ? 0 : this.bodyLen);
            this.out.clear();
            this.out.advanceWrite(end);
            this.out.advanceRead(start);
            this.committed = true;
            return true;
        }
        int8[] a = this.out.array();
        int32 start = this.room;
        int32 end = this.room + this.bodyLen;
        if (this.chunked) {
            if (this.bodyLen > 0) {
                int32 w = HttpResponse.hexWidth(this.bodyLen);
                start = this.room - w - 2;
                HttpResponse.putHex(a, start, w, this.bodyLen);
                a[start + w] = (int8) 13;
                a[start + w + 1] = (int8) 10;
                a[end] = (int8) 13;
                a[end + 1] = (int8) 10;
                end = end + 2;
            }
            end = HttpResponse.put(a, end, "0\r\n\r\n");
        }
        if (end == start) {
            return false;
        }
        this.out.clear();
        this.out.advanceWrite(end);
        this.out.advanceRead(start);
        return true;
    }

    /** Whether the connection stays open after this response. */
    public boolean keepsAlive() {
        return this.reuse;
    }
}
