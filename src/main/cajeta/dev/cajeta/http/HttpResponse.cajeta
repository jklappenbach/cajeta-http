package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.Headers;
import dev.cajeta.http.body.Body;
import dev.cajeta.http.body.BytesBody;
import dev.cajeta.http.Status;
import dev.cajeta.http.Version;
import dev.cajeta.http.MediaType;
import dev.cajeta.http.HeaderValues;

/**
 * An HTTP/1.1 **response** message — the status-line triple
 * (*HTTP-version*, *status-code*, *reason-phrase*), a
 * [`Headers`](../Headers.cajeta) map, and an optional in-memory
 * **body**.
 *
 * The response half of the NET-7.1 message model, and the mirror of
 * [`HttpRequest`](HttpRequest.cajeta): a **pure data type** with no
 * I/O, tested directly over the JIT. The incremental parser (NET-7.3),
 * body framing (NET-7.4), and serializer (NET-7.5) read and write
 * *through* it.
 *
 * ## The status line
 *
 * ```
 * status-line = HTTP-version SP status-code SP reason-phrase CRLF
 * ```
 *
 *   - **`version`** — the protocol version string, default
 *     `"HTTP/1.1"`.
 *   - **`status`** — the numeric status code (`200`, `404`, …) as an
 *     `int32`. The classifier helpers (`isSuccess`, `isRedirect`,
 *     `isClientError`, `isServerError`, `isInformational`) read the
 *     standard 1xx–5xx ranges off it.
 *   - **`reason`** — the human-readable reason phrase. The
 *     [`of`](#) factory fills the **standard** phrase for the
 *     well-known codes (RFC 7231) and an empty phrase for the rest;
 *     a caller may override it. The reason phrase is advisory — a
 *     client keys off the numeric code, not the text.
 *
 * ## The body handle
 *
 * As with the request, NET-7.1 carries the body **in memory** (`body`
 * + `hasBody`); the streaming `BodyReader` (NET-7.4) layers over the
 * same field later. `hasBody == false` is "no body" (e.g. a `204` or a
 * `304`); a zero-length buffer with `hasBody == true` is a
 * present-empty body.
 *
 * ## Builder shape
 *
 * Fluent, mirroring [`HttpRequest`](HttpRequest.cajeta): an
 * [`of`](#) / [`ok`](#) / [`notFound`](#) factory yields a base
 * response, then chainable mutators (`header`, `body`, `reason`,
 * `version`) layer fields on, each returning the borrowed `this`:
 *
 * ```cajeta
 * HttpResponse resp = HttpResponse.ok()
 *     .header("Content-Type", "text/plain")
 *     .body(payload, payload.count());
 * ```
 */
public class HttpResponse {
    /** HTTP-version string (`"HTTP/1.1"`). */
    public String version;
    /** Numeric status code (`200`, `404`, …). */
    public int32 status;
    /** Reason phrase (`"OK"`, `"Not Found"`, possibly empty). */
    public String reason;

    /** The header map. Never null after construction. */
    public Headers headers;

    /**
     * In-memory message body, meaningful only when `hasBody` is true.
     * (See [`HttpRequest`](HttpRequest.cajeta) for the present-empty
     * vs absent distinction.)
     */
    public int8[] body;
    /** True iff this response carries a message body. */
    public boolean hasBody;

    /** The typed body model (http:1.3e), or null. */
    public Body bodyModel;

    /**
     * HTTP/2 server-push promises (http:3.5), or `null` until the first
     * [`push`](#push). Each [`PushEntry`](PushEntry.cajeta) becomes a
     * `PUSH_PROMISE` + a pushed response on an h2 connection when the peer
     * allows push; ignored over HTTP/1.1.
     */
    public PushEntry[] pushes;
    int32 pushLen;
    int32 pushCap;

    /**
     * Field-pinning constructor. Defaults to a `200`/`OK`/`HTTP/1.1`
     * response with an empty header map and no body, so a
     * partially-built instance never carries dangling state. The
     * factories are the ergonomic entry points.
     */
    public HttpResponse() {
        int8[] v = heap int8[8];
        v[0] = (int8) 72;   // 'H'
        v[1] = (int8) 84;   // 'T'
        v[2] = (int8) 84;   // 'T'
        v[3] = (int8) 80;   // 'P'
        v[4] = (int8) 47;   // '/'
        v[5] = (int8) 49;   // '1'
        v[6] = (int8) 46;   // '.'
        v[7] = (int8) 49;   // '1'
        this.version = heap String(#v, 8);
        this.status = 200;
        int8[] r = heap int8[2];
        r[0] = (int8) 79;   // 'O'
        r[1] = (int8) 75;   // 'K'
        this.reason = heap String(#r, 2);
        this.headers = heap Headers();
        int8[] e = heap int8[0];
        this.body = #e;
        this.hasBody = false;
        this.bodyModel = null;
        this.pushes = null;
        this.pushLen = 0;
        this.pushCap = 0;
    }

    // -- HTTP/2 server push (http:3.5) --------------------------------------

    /**
     * Declare an HTTP/2 server push: promise `GET path` and carry the pushed
     * response as `status` + `body[0 .. bodyLen)`. Copied in, so the caller's
     * buffers are theirs to reuse. Returns `this` to chain. On an HTTP/2
     * connection whose peer left `SETTINGS_ENABLE_PUSH` on, this becomes a
     * `PUSH_PROMISE` + a pushed response on a reserved stream; over h1 it is
     * ignored.
     */
    public HttpResponse push(String path, int32 status, int8[] body,
                             int32 bodyLen) {
        if (this.pushes == null) {
            this.pushes = heap PushEntry[4];
            this.pushCap = 4;
        } else if (this.pushLen == this.pushCap) {
            this.growPushes();
        }
        String p = path.substring(0, path.byteLength());
        int8[] b = heap int8[bodyLen];
        int32 i = 0;
        while (i < bodyLen) {
            b[i] = body[i];
            i = i + 1;
        }
        this.pushes[this.pushLen] = heap PushEntry(#p, status, #b, bodyLen);
        this.pushLen = this.pushLen + 1;
        return this;
    }

    /** Number of server-push promises attached. */
    public int32 pushCount() {
        return this.pushLen;
    }

    /** The promised request path of push `i` (borrowed). */
    public String pushPathAt(int32 i) {
        return this.pushes[i].path;
    }

    /** The pushed response status of push `i`. */
    public int32 pushStatusAt(int32 i) {
        return this.pushes[i].status;
    }

    /** The pushed response body of push `i` (borrowed). */
    public int8[] pushBodyAt(int32 i) {
        return this.pushes[i].body;
    }

    /** The pushed response body length of push `i`. */
    public int32 pushBodyLenAt(int32 i) {
        return this.pushes[i].bodyLen;
    }

    void growPushes() {
        int32 nc = this.pushCap * 2;
        PushEntry[] ne = heap PushEntry[nc];
        int32 i = 0;
        while (i < this.pushLen) {
            ne[i] #= #this.pushes[i];
            i = i + 1;
        }
        this.pushes #= ne;
        this.pushCap = nc;
    }

    // -- factories ----------------------------------------------------------

    /**
     * A bodyless response with the given status code on `HTTP/1.1`,
     * its reason phrase set to the **standard** phrase for the code
     * ([`reasonFor`](#)) — or empty for an unrecognized code.
     */
    public static #HttpResponse of(int32 status) {
        HttpResponse r = heap HttpResponse();
        r.status = status;
        r.reason = HttpResponse.reasonFor(status);
        return #r;
    }

    /** A `200 OK` response. */
    public static #HttpResponse ok() {
        return HttpResponse.of(200);
    }

    /** A `404 Not Found` response. */
    public static #HttpResponse notFound() {
        return HttpResponse.of(404);
    }

    /**
     * The standard reason phrase for a status code, or an **empty**
     * string for an unregistered code. Delegates to the consolidated
     * RFC 9110 §15 registry on [`Status`](Status.cajeta) (http:1.2b) —
     * this type's own table is gone, and codes the old table lacked
     * (203, 205, 300, 410, 422, …) now carry their canonical phrase.
     * The phrase is advisory; clients key off the code.
     */
    public static #String reasonFor(int32 status) {
        return Status.reasonFor(status);
    }

    // -- chainable mutators -------------------------------------------------

    /**
     * Append a `(name, value)` header (multi-value, order-preserving)
     * and return the borrowed `this`. Use [`setHeader`](#) for
     * last-write-wins.
     */
    public HttpResponse header(String name, String value) {
        this.headers.add(name, value);
        return this;
    }

    /** Set a header last-write-wins and return `this`. */
    public HttpResponse setHeader(String name, String value) {
        this.headers.set(name, value);
        return this;
    }

    /**
     * Attach an in-memory body (a fresh owned copy of `data`'s
     * `length` bytes) and return `this`. Sets `hasBody`. The
     * serializer (NET-7.5) frames this as `Content-Length: length`.
     */
    public HttpResponse body(int8[] data, int32 length) {
        int8[] copy = heap int8[length];
        int32 i = 0;
        while (i < length) {
            copy[i] = data[i];
            i = i + 1;
        }
        this.body = #copy;
        this.hasBody = true;
        return this;
    }

    /** Override the reason phrase and return `this`. */
    public HttpResponse reason(String phrase) {
        this.reason = phrase.substring(0, phrase.byteLength());
        return this;
    }

    /** Override the HTTP-version string and return `this`. */
    public HttpResponse version(String v) {
        this.version = v.substring(0, v.byteLength());
        return this;
    }

    // -- accessors + classifiers --------------------------------------------

    /** The HTTP-version string. */
    public String getVersion() {
        return this.version;
    }

    /** The numeric status code. */
    public int32 statusCode() {
        return this.status;
    }

    /** The reason phrase (possibly empty). */
    public String getReason() {
        return this.reason;
    }

    /** The header map (live; mutating it mutates the response). */
    public Headers getHeaders() {
        return this.headers;
    }

    // -- typed views (http:1.2b) --------------------------------------------

    /**
     * The status as a [`Status`](Status.cajeta) — code plus this
     * response's actual reason phrase (which may differ from the
     * registry's if it was overridden via [`reason`](#reason)).
     */
    public #Status statusType() {
        return Status.of(this.status, this.reason);
    }

    /** The [`Version`](Version.cajeta) for the HTTP-version string. */
    public Version versionType() {
        return Version.of(this.version);
    }

    /**
     * The `Content-Type` header as a [`MediaType`](MediaType.cajeta), or
     * `null` when absent/malformed. See
     * [`HeaderValues.contentType`](HeaderValues.cajeta).
     */
    public #MediaType contentType() {
        return HeaderValues.contentType(this.headers);
    }

    /**
     * The `Content-Length` value, or `-1` when absent or not a pure digit
     * run. See [`HeaderValues.contentLength`](HeaderValues.cajeta).
     */
    public int64 contentLength() {
        return HeaderValues.contentLength(this.headers);
    }

    /** Length of the in-memory body, or 0 when `hasBody` is false. */
    public int32 bodyLength() {
        if (!this.hasBody) {
            return 0;
        }
        return this.body.count();
    }

    /** 1xx — informational. */
    public boolean isInformational() {
        return this.status >= 100 && this.status < 200;
    }

    /** 2xx — success. */
    public boolean isSuccess() {
        return this.status >= 200 && this.status < 300;
    }

    /** 3xx — redirection. */
    public boolean isRedirect() {
        return this.status >= 300 && this.status < 400;
    }

    /** 4xx — client error. */
    public boolean isClientError() {
        return this.status >= 400 && this.status < 500;
    }

    /** 5xx — server error. */
    public boolean isServerError() {
        return this.status >= 500 && this.status < 600;
    }

    // -- Body model (http:1.3e) --------------------------------------------

    /**
     * Attach a [`Body`](body/Body.cajeta) and return `this` — the
     * response twin of
     * [`HttpRequest.body`](HttpRequest.cajeta#body). The body's media
     * type becomes `Content-Type` (parameters included) unless one is
     * already set; a known-length body is drained into the raw byte path
     * so existing serializer paths work unchanged, while an
     * unknown-length body is carried for the chunked writer.
     */
    public HttpResponse body(#Body b) {
        MediaType t = b.contentType();
        if (t != null && !this.headers.contains("content-type")) {
            String tv = t.format();
            this.headers.set("Content-Type", tv);
        }
        int64 n = b.contentLength();
        if (n >= (int64) 0) {
            int8[] drained = HttpResponse.drainBody(b, (int32) n);
            this.body = #drained;
            this.hasBody = true;
        }
        this.bodyModel = #b;
        return this;
    }

    /** The attached [`Body`](body/Body.cajeta), or null (borrow). */
    public Body getBody() {
        return this.bodyModel;
    }

    /**
     * This message's body as a [`Body`](body/Body.cajeta) — a fresh
     * [`BytesBody`](body/BytesBody.cajeta) over the received bytes, so a
     * client can read a parsed response through the same uniform
     * surface. Null when the response carries no body, or when a body
     * model is already attached (reach it via [`getBody`](#getBody)).
     */
    public #Body asBody() {
        if (this.bodyModel != null) {
            return null;
        }
        if (!this.hasBody) {
            return null;
        }
        int32 n = this.bodyLength();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = this.body[i];
            i = i + 1;
        }
        MediaType t = this.contentType();
        BytesBody bb = BytesBody.of(#copy, n, #t);
        Body out = #bb;
        return #out;
    }

    /** Drain a known-length `Body` into a fresh exactly-sized buffer. */
    static #int8[] drainBody(Body b, int32 len) {
        int8[] out = heap int8[len];
        if (len == 0) {
            return #out;
        }
        AsyncReader r = b.reader();
        int32 o = 0;
        while (o < len) {
            int32 got = r.read(out, o, len - o);
            if (got <= 0) {
                o = len;
            } else {
                o = o + got;
            }
        }
        return #out;
    }
}
