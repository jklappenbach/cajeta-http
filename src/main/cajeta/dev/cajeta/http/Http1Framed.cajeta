package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.error.Exception;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.ByteBuffer;
import cajeta.concurrent.AtomicInt64;
import cajeta.io.net.ByteChannel;
import cajeta.io.net.TcpStream;
import cajeta.io.net.TimedOutException;
import dev.cajeta.crypto.tls.TlsConnection;
import dev.cajeta.crypto.tls.TlsStream;
import cajeta.time.Clock;
import cajeta.time.Instant;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.server.ConnectionBuffers;
import dev.cajeta.http.h2.Http2;
import dev.cajeta.http.h2.Http2Connection;
import dev.cajeta.http.h2.NowWriter;
import dev.cajeta.http.body.MultipartParser;
import dev.cajeta.http.body.MultipartPart;
import dev.cajeta.http.server.MultipartMode;
import dev.cajeta.http.server.MultipartRoutes;
import dev.cajeta.http.framing.Protocol;
import dev.cajeta.http.framing.ProtocolCounters;
import dev.cajeta.http.framing.ProtocolFramed;
import dev.cajeta.http.ws.WsFramed;
import dev.cajeta.http.ws.WsTakeover;
import dev.cajeta.http.server.ServerLimits;

/**
 * One plaintext HTTP/1.1 connection under the request-dispatch pool
 * (request-dispatch spec §2.1, §3.2, §4.1). Two sides touch it, never at
 * once:
 *
 *   - the framer calls `pump` on readiness: it drains the socket without
 *     parking, scans and parses to each hold point, answers 100-continue and
 *     the head and body refusals itself, and queues complete units;
 *   - a pool worker calls `turn` once the connection is dispatched: it runs
 *     every queued unit through the handler in order and writes the
 *     responses, parking only on the socket's send side.
 *
 * Units are recorded as absolute offsets into `in`; the buffer is compacted
 * only at the end of a turn, when no unit is outstanding.
 */
public final class Http1Framed implements NowWriter {
    static final int32 PHASE_HEAD = 0;
    static final int32 PHASE_BODY_LENGTH = 1;
    static final int32 PHASE_BODY_CHUNKED = 2;
    static final int32 PHASE_BODY_PARTS = 3;      // a PART multipart route: the framer feeds the parser

    /** `pump` results. */
    public static final int32 PUMP_IDLE = 0;      // nothing new to dispatch
    public static final int32 PUMP_READY = 1;     // at least one unit queued
    public static final int32 PUMP_CLOSED = 2;    // closed: the caller drops it
    public static final int32 PUMP_STREAMS = 3;   // h2: completed streams wait for the pool

    public TcpStream conn;
    // A WebSocket after its upgrade (spec §2.5): frames decode here on the
    // framer, each message is a unit, the handler runs on a worker's turn.
    WsFramed ws;
    public int64 wsMaxMessage;

    // Multipart per route (spec §2.3). In PART mode the head is copied aside,
    // the body is fed to the parser as it arrives and each completed part is
    // a unit; the handler sees the part on the request.
    public MultipartRoutes mpRoutes;
    public int32 maxPartBytes;

    // A developer-framed protocol after its upgrade (spec §5), and a plain
    // takeover handed to its own fiber (spec §2.6): the socket moved with it.
    ProtocolFramed framedProto;
    public ProtocolCounters protoCounters;
    public boolean detached;
    MultipartParser mp;
    int8[] mpHead;
    int32 mpHeadLen;
    int64 mpRemaining;
    int32 mpQueued;
    boolean[] uIsPart;
    int32[] uPart;
    boolean[] uPartLast;
    public TlsStream tls;        // non-null under TLS: owns the socket then
    public boolean handshaking;  // TLS: the handshake has not completed
    public Http2Connection h2;   // non-null once the connection speaks h2
    AsyncWriter h2Writer;        // owned here: the h2 write side keeps a borrow of it
    public AtomicInt64 streamedCounter; // the pool's count of units run with the body still arriving; bumped before the handler
    public int32 h2InFlight;     // streams on workers; the framer alone moves it, so no worker touches a dropped connection
    public boolean h2Prior;      // plaintext: a preface switches the connection to h2
    public ConnectionBuffers bufs;   // for the h2 slots
    public int32 fd;
    public int32 framerIndex;
    ByteBuffer in;
    ByteBuffer out;
    HeadScanner scanner;
    HttpRequest req;
    HttpResponse res;
    HttpParserLimits parse;
    (HttpRequest, HttpResponse) -> void handler;
    int32 headMs;
    int32 bodyMs;
    int64 maxBody;
    boolean expectEnabled;
    boolean streaming;
    RequestBodyChannel bodyChan;
    RequestBody streamed;

    // Parse state for the unit being framed.
    int32 phase;
    int32 headLen;
    boolean continueSent;
    int64 deadline;          // epoch ms the current unit must complete by; 0 = none

    // Queued units, as absolute offsets into `in`.
    int32 maxUnits;
    int32[] uStart;
    int32[] uHead;
    int32[] uBodyOff;
    int32[] uBodyLen;
    int32[] uEnd;
    boolean[] uStream;
    int32 units;

    public boolean dispatched;   // on a worker, or queued for one
    public boolean waiting;      // complete units, but the pool refused the handoff
    public boolean eof;          // the peer finished writing
    public boolean closed;
    public int32 slot;           // index in the framer's table

    public Http1Framed(#TcpStream conn, #ByteBuffer in, #ByteBuffer out,
                       HttpParserLimits parse, ServerLimits sl,
                       (HttpRequest, HttpResponse) -> void handler,
                       int32 maxUnits, int32 framerIndex) {
        this.conn #= conn;
        this.tls = null;
        this.handshaking = false;
        this.tlsPending = false;
        this.h2 = null;
        this.h2Writer = null;
        this.h2InFlight = 0;
        this.streamedCounter = null;
        this.h2Prior = false;
        this.ws = null;
        this.wsMaxMessage = (int64) 67108864;
        this.mpRoutes = null;
        this.maxPartBytes = 16777216;
        this.framedProto = null;
        this.protoCounters = null;
        this.detached = false;
        this.mp = null;
        this.mpHead = null;
        this.mpHeadLen = 0;
        this.mpRemaining = (int64) 0;
        this.mpQueued = 0;
        this.bufs = null;
        this.fd = this.conn.fd;
        this.in #= in;
        this.out #= out;
        this.scanner = heap HeadScanner(parse);
        this.req = heap HttpRequest(parse.maxHeaderCount);
        this.res = heap HttpResponse(this.out, this.conn, 4096, 64);
        this.parse #= parse;
        this.handler #= handler;
        this.headMs = sl.headReadTimeoutMs;
        this.bodyMs = sl.bodyReadTimeoutMs;
        this.maxBody = sl.maxBodyBytes;
        this.expectEnabled = sl.expectContinueEnabled;
        this.streaming = sl.streamRequestBody;
        this.bodyChan = null;
        this.streamed = null;
        if (this.streaming) {
            this.bodyChan = heap RequestBodyChannel();
            this.streamed = heap RequestBody(this.bodyChan);
        }
        this.phase = Http1Framed.PHASE_HEAD;
        this.headLen = 0;
        this.continueSent = false;
        this.deadline = (int64) 0;
        this.maxUnits = maxUnits < 1 ? 1 : maxUnits;
        this.uStart = heap int32[this.maxUnits];
        this.uHead = heap int32[this.maxUnits];
        this.uBodyOff = heap int32[this.maxUnits];
        this.uBodyLen = heap int32[this.maxUnits];
        this.uEnd = heap int32[this.maxUnits];
        this.uStream = heap boolean[this.maxUnits];
        this.uIsPart = heap boolean[this.maxUnits];
        this.uPart = heap int32[this.maxUnits];
        this.uPartLast = heap boolean[this.maxUnits];
        this.units = 0;
        this.dispatched = false;
        this.waiting = false;
        this.eof = false;
        this.closed = false;
        this.slot = -1;
        this.framerIndex = framerIndex;
    }

    /**
     * Turns this connection into a TLS one: the socket moves into a server
     * TLS stream, the framer then drives its handshake and decryption through
     * the stream's non-parking entries, and responses are sealed by the worker
     * through the same stream. Called by the framer on intake, so the accept
     * loop never pays the per-connection engine setup.
     */
    public void startTls(int8[] cert, int32 certLen, int8[] key, int32 keyLen,
                         int8[] alpn, int32 alpnLen) {
        TcpStream sock #= this.conn;
        this.conn = heap TcpStream(-1);
        TlsStream t #= TlsStream.server(#sock, cert, certLen, key, keyLen);
        if (alpnLen > 0) {
            t.supportAlpn(alpn, alpnLen);
        }
        this.tls #= t;
        this.handshaking = true;
        this.fd = this.tls.fd();
        this.res = heap HttpResponse(this.out, this.tls, 4096, 64);
        this.tlsPending = false;
    }

    /** Set by the accept loop: the framer wraps the socket in TLS on intake. */
    public boolean tlsPending;

    public int32 unitCount() {
        if (this.ws != null) {
            return this.ws.unitCount();
        }
        if (this.framedProto != null) {
            return this.framedProto.unitCount();
        }
        return this.units;
    }

    /** True when the mailbox is full: the framer has stopped reading this socket. */
    public boolean mailboxFull() {
        if (this.ws != null) {
            return this.ws.full();
        }
        if (this.framedProto != null) {
            return this.framedProto.full();
        }
        return this.units >= this.maxUnits;
    }

    /** Bytes buffered beyond the queued units. */
    public boolean hasUnframedBytes() {
        return this.in.readable() > 0;
    }

    public int64 deadlineMs() {
        return this.deadline;
    }

    static int64 nowMs() {
        Instant t = Clock.now();
        return t.toEpochMilli();
    }

    // ----- framer side -------------------------------------------------------

    /**
     * Drains the socket without parking and advances framing. Returns
     * PUMP_READY when at least one unit is queued, PUMP_CLOSED when the
     * connection was closed here (EOF, or a refusal was written), else
     * PUMP_IDLE.
     */
    public int32 pump(int64 now) {
        if (this.closed) {
            return Http1Framed.PUMP_CLOSED;
        }
        boolean readMore = true;
        boolean gotBytes = false;
        if (this.tls != null) {
            if (this.handshaking) {
                int32 hs = this.pumpHandshake();
                if (hs != Http1Framed.PUMP_IDLE) {
                    return hs;
                }
                if (this.handshaking) {
                    return Http1Framed.PUMP_IDLE;
                }
            }
            // Ciphertext in, plaintext straight into the buffer.
            boolean fillMore = true;
            while (fillMore && !this.eof) {
                int32 f = 0;
                try {
                    f = this.tls.fillNow();
                } catch (Exception e) {
                    this.close();
                    return Http1Framed.PUMP_CLOSED;
                }
                if (f < 0) {
                    fillMore = false;
                } else if (f == 0) {
                    this.eof = true;
                }
            }
            boolean decryptMore = true;
            while (decryptMore && this.in.writable() > 0) {
                int32 d = 0;
                try {
                    d = this.tls.readPlaintextNow(this.in);
                } catch (Exception e) {
                    this.close();
                    return Http1Framed.PUMP_CLOSED;
                }
                if (d > 0) {
                    gotBytes = true;
                } else {
                    if (d < 0) {
                        this.eof = true;
                    }
                    decryptMore = false;
                }
            }
            readMore = false;
        }
        while (readMore && !this.eof && this.in.writable() > 0) {
            int64 n = (int64) 0;
            try {
                n = this.conn.readNow(this.in.array(), (int64) this.in.writePosition(),
                    (int64) this.in.writable());
            } catch (Exception e) {
                this.close();
                return Http1Framed.PUMP_CLOSED;
            }
            if (n < (int64) 0) {
                readMore = false;
            } else if (n == (int64) 0) {
                this.eof = true;
            } else {
                this.in.advanceWrite((int32) n);
                gotBytes = true;
            }
        }
        if (this.ws != null) {
            return this.pumpWs();
        }
        if (this.framedProto != null) {
            return this.pumpProto();
        }
        if (this.h2 == null && this.h2Prior && this.in.readable() >= 24 && this.units == 0
                && this.phase == Http1Framed.PHASE_HEAD
                && Http2.matchesPreface(this.in.array(), this.in.readPosition(), 24)) {
            this.switchToH2();
        }
        if (this.h2 != null) {
            return this.pumpH2();
        }
        // A body read that arrives inside the idle timeout keeps the request
        // alive, whatever its total: the body deadline is per read, as the
        // connection loop's `fillWithin(ch, bodyMs)` was.
        if (gotBytes && this.phase != Http1Framed.PHASE_HEAD && this.bodyMs > 0) {
            this.deadline = now + (int64) this.bodyMs;
        }
        try {
            this.frame(now);
        } catch (HeadersTooLargeException h) {
            this.refuse(431);
            return Http1Framed.PUMP_CLOSED;
        } catch (PayloadTooLargeException p) {
            this.refuse(413);
            return Http1Framed.PUMP_CLOSED;
        } catch (InvalidChunkEncodingException i) {
            this.refuse(400);
            return Http1Framed.PUMP_CLOSED;
        } catch (HttpException e) {
            this.refuse(e.httpStatus());
            return Http1Framed.PUMP_CLOSED;
        } catch (Exception e) {
            this.refuse(400);
            return Http1Framed.PUMP_CLOSED;
        }
        if (this.closed) {
            return Http1Framed.PUMP_CLOSED;
        }
        if (this.units > 0) {
            return Http1Framed.PUMP_READY;
        }
        if (this.eof) {
            // The peer is done and left no complete unit behind.
            this.close();
            return Http1Framed.PUMP_CLOSED;
        }
        if (this.in.writable() == 0 && this.phase == Http1Framed.PHASE_HEAD) {
            this.refuse(431);
            return Http1Framed.PUMP_CLOSED;
        }
        return Http1Framed.PUMP_IDLE;
    }

    /**
     * Advances the TLS handshake without parking: PUMP_IDLE while it waits
     * for bytes (or once done, with `handshaking` cleared), PUMP_H2 when ALPN
     * chose h2 (the caller hands the stream to the h2 loop), PUMP_CLOSED on
     * failure or EOF.
     */
    int32 pumpHandshake() {
        boolean again = true;
        while (again) {
            int32 r = 0;
            try {
                r = this.tls.handshakeNow();
            } catch (Exception e) {
                this.close();
                return Http1Framed.PUMP_CLOSED;
            }
            if (r == TlsConnection.OK) {
                this.handshaking = false;
                if (this.deadline == (int64) 0 && this.headMs > 0) {
                    this.deadline = Http1Framed.nowMs() + (int64) this.headMs;
                }
                int8[] proto = heap int8[16];
                int32 pn = this.tls.negotiatedAlpn(proto, 16);
                if (pn == 2 && proto[0] == (int8) 104 && proto[1] == (int8) 50) {
                    this.switchToH2();
                }
                return Http1Framed.PUMP_IDLE;
            }
            if (r == TlsConnection.FAILED || r == TlsConnection.CLOSED) {
                this.close();
                return Http1Framed.PUMP_CLOSED;
            }
            int32 f = 0;
            try {
                f = this.tls.fillNow();
            } catch (Exception e) {
                this.close();
                return Http1Framed.PUMP_CLOSED;
            }
            if (f == 0) {
                this.close();
                return Http1Framed.PUMP_CLOSED;
            }
            if (f < 0) {
                again = false;
            }
        }
        if (this.deadline == (int64) 0 && this.headMs > 0) {
            // A handshake that never completes is a head that never arrives.
            this.deadline = Http1Framed.nowMs() + (int64) this.headMs;
        }
        return Http1Framed.PUMP_IDLE;
    }

    /** The connection speaks h2 from here: frames come through `feed`, streams go to the pool. */
    void switchToH2() {
        // The write side keeps a borrow of the writer, so the writer must
        // outlive the h2 connection: a field here, not a local of this call.
        this.h2Writer = heap AsyncWriter(this.channel());
        this.h2 #= Http2Connection.framed(this.h2Writer, this.handler, this.bufs, this.parse,
            this.maxBody, this);
        this.h2.streaming(this.streaming, this.mpRoutes, this.maxPartBytes);
        this.deadline = (int64) 0;
    }

    /** The transport's non-parking write: bytes taken, or 0 when none could go. */
    public int32 writeNow(int8[] b, int32 off, int32 len) {
        if (this.tls != null) {
            try {
                return this.tls.writeNow(b, off, len) ? len : 0;
            } catch (Exception e) {
                return 0;
            }
        }
        int64 sent = (int64) 0;
        try {
            sent = this.conn.write(b, (int64) off, (int64) len);
        } catch (Exception e) {
            sent = (int64) 0;
        }
        return sent < (int64) 0 ? 0 : (int32) sent;
    }

    /** Feeds buffered bytes to the h2 connection: PUMP_STREAMS when streams wait, PUMP_CLOSED once it is quiet after its end. */
    int32 pumpH2() {
        int32 n = -1;
        try {
            n = this.h2.feed(this.in);
        } catch (Exception e) {
            n = -1;
            this.h2.endInput();
        }
        this.in.compact();
        if (this.eof) {
            this.h2.endInput();
            n = -1;
        }
        if (n < 0) {
            if (this.h2Quiet()) {
                this.close();
                return Http1Framed.PUMP_CLOSED;
            }
            return Http1Framed.PUMP_IDLE;
        }
        return n > 0 ? Http1Framed.PUMP_STREAMS : Http1Framed.PUMP_IDLE;
    }

    /** Developer framing: run the Framer over what arrived; a complete unit is a unit of work. */
    int32 pumpProto() {
        int32 n = this.framedProto.feed(this.in);
        this.in.compact();
        if (this.eof) {
            this.framedProto.transportEof();
            n = this.framedProto.unitCount();
        }
        if (this.framedProto.finished()) {
            this.close();
            return Http1Framed.PUMP_CLOSED;
        }
        return n > 0 ? Http1Framed.PUMP_READY : Http1Framed.PUMP_IDLE;
    }

    /** WebSocket: decode what arrived; a message is a unit, pings and closes are answered here. */
    int32 pumpWs() {
        int32 n = this.ws.feed(this.in);
        this.in.compact();
        if (this.eof) {
            this.ws.transportEof();
            n = this.ws.unitCount();
        }
        if (this.ws.finished()) {
            this.close();
            return Http1Framed.PUMP_CLOSED;
        }
        return n > 0 ? Http1Framed.PUMP_READY : Http1Framed.PUMP_IDLE;
    }

    /** No stream waiting and none on a worker: an ended h2 connection may be released. */
    public boolean h2Quiet() {
        return this.h2 != null && this.h2.readyCount() == 0 && this.h2InFlight == 0;
    }

    /** Completed h2 streams waiting for the pool. */
    public int32 readyStreams() {
        return this.h2 == null ? 0 : this.h2.readyCount();
    }

    /** Frames as many complete units as the bytes hold, up to the mailbox size. */
    void frame(int64 now) {
        boolean progress = true;
        while (progress && this.units < this.maxUnits && !this.closed) {
            progress = false;
            if (this.phase == Http1Framed.PHASE_HEAD) {
                if (this.in.readable() == 0) {
                    this.deadline = (int64) 0;
                    return;
                }
                if (this.deadline == (int64) 0 && this.headMs > 0) {
                    this.deadline = now + (int64) this.headMs;
                }
                int32 h = this.scanner.scan(this.in);
                if (h < 0) {
                    return;
                }
                this.headLen = h;
                HeadScanner.parseRequest(this.in.array(), this.in.readPosition(), h, this.req);
                int32 ex = this.expectation();
                if (ex == 417 || ex == 413) {
                    this.refuse(ex);
                    return;
                }
                if (ex == 100 && this.in.readable() == h && !this.continueSent) {
                    this.sendContinue();
                    this.continueSent = true;
                }
                int32 start = this.in.readPosition() + h;
                int32 mode = MultipartMode.WHOLE;
                if (this.mpRoutes != null && this.req.framing != HttpRequest.FRAMING_NONE) {
                    mode = this.mpRoutes.modeFor(this.req);
                }
                boolean partMode = mode == MultipartMode.PART
                    && this.req.framing == HttpRequest.FRAMING_LENGTH;
                boolean streamUnit = (this.streaming || mode == MultipartMode.STREAM)
                    && this.req.framing != HttpRequest.FRAMING_NONE;
                if (!partMode && !streamUnit && this.req.framing == HttpRequest.FRAMING_LENGTH
                        && this.maxBody > (int64) 0 && this.req.declaredLength > this.maxBody) {
                    throw heap PayloadTooLargeException("body over the limit", this.maxBody,
                        this.req.declaredLength);
                }
                if (partMode) {
                    this.beginParts(h, now);
                    progress = !this.closed;
                } else if (streamUnit) {
                    // Streaming: the hold point is head complete; the handler
                    // reads the body itself. One unit only: the rest of the
                    // bytes belong to its body.
                    this.queue(this.in.readPosition(), h, start, 0, start, true);
                    this.in.advanceRead(h);
                    this.scanner.reset();
                    this.deadline = (int64) 0;
                    return;
                } else if (this.req.framing == HttpRequest.FRAMING_LENGTH) {
                    if ((int64) start + this.req.declaredLength > (int64) this.in.capacity()) {
                        throw heap PayloadTooLargeException("body exceeds the input buffer",
                            (int64) (this.in.capacity() - start), this.req.declaredLength);
                    }
                    this.phase = Http1Framed.PHASE_BODY_LENGTH;
                    if (this.bodyMs > 0) {
                        this.deadline = now + (int64) this.bodyMs;
                    }
                } else if (this.req.framing == HttpRequest.FRAMING_CHUNKED) {
                    this.phase = Http1Framed.PHASE_BODY_CHUNKED;
                    if (this.bodyMs > 0) {
                        this.deadline = now + (int64) this.bodyMs;
                    }
                } else {
                    this.queue(this.in.readPosition(), h, start, 0, start, false);
                    this.in.advanceRead(h);
                    this.scanner.reset();
                    this.deadline = (int64) 0;
                    progress = true;
                }
            }
            if (this.phase == Http1Framed.PHASE_BODY_PARTS) {
                if (!this.partsOnly()) {
                    // Units with offsets into `in` wait ahead of this request:
                    // no compaction until their turn has run.
                    return;
                }
                int32 avail = this.in.readable();
                if ((int64) avail > this.mpRemaining) {
                    avail = (int32) this.mpRemaining;
                }
                if (avail > 0) {
                    this.mp.feedFrom(this.in.array(), this.in.readPosition(), avail);
                    this.in.advanceRead(avail);
                    this.mpRemaining = this.mpRemaining - (int64) avail;
                    this.in.compact();
                    if (this.bodyMs > 0) {
                        this.deadline = now + (int64) this.bodyMs;
                    }
                }
                boolean complete = this.mp.isComplete();
                // Part i is queued once a later part has begun or the closing
                // delimiter has been seen: only then is `last` known. The parser
                // counts a part at its content's end and resolves the delimiter
                // after it, so a read ending between `--boundary` and `--` would
                // otherwise run the final part with multipartLast() false and
                // never send the response (12.1.2).
                while (this.mpQueued < this.mp.partCount() && this.units < this.maxUnits
                        && (this.mpQueued < this.mp.partCount() - 1 || complete)) {
                    boolean last = complete && this.mpQueued == this.mp.partCount() - 1;
                    this.queuePart(this.mpQueued, last);
                    this.mpQueued = this.mpQueued + 1;
                }
                if (complete && this.mp.partCount() == 0 && this.mpQueued == 0
                        && this.units < this.maxUnits) {
                    // An empty form: the handler runs once with no part.
                    this.queuePart(-1, true);
                    this.mpQueued = 1;
                }
                if (this.mpRemaining > (int64) 0) {
                    return;
                }
                this.mp.endInput();   // raises when the closing delimiter never came
                this.phase = Http1Framed.PHASE_HEAD;
                this.scanner.reset();
                this.deadline = (int64) 0;
                progress = true;
            } else if (this.phase == Http1Framed.PHASE_BODY_LENGTH) {
                int32 start = this.in.readPosition() + this.headLen;
                int32 n = (int32) this.req.declaredLength;
                if (this.in.writePosition() < start + n) {
                    return;
                }
                this.queue(this.in.readPosition(), this.headLen, start, n, start + n, false);
                this.in.advanceRead(this.headLen + n);
                this.scanner.reset();
                this.phase = Http1Framed.PHASE_HEAD;
                this.deadline = (int64) 0;
                progress = true;
            } else if (this.phase == Http1Framed.PHASE_BODY_CHUNKED) {
                int32 start = this.in.readPosition() + this.headLen;
                int32 endOfChunks = this.measureChunks(start);
                if (endOfChunks < 0) {
                    return;
                }
                int32 bodyEnd = this.dechunk(start);
                this.queue(this.in.readPosition(), this.headLen, start, bodyEnd - start, endOfChunks, false);
                this.in.advanceRead(endOfChunks - this.in.readPosition());
                this.scanner.reset();
                this.phase = Http1Framed.PHASE_HEAD;
                this.deadline = (int64) 0;
                progress = true;
            }
        }
    }

    void queue(int32 start, int32 head, int32 bodyOff, int32 bodyLen, int32 end, boolean stream) {
        int32 i = this.units;
        this.uStart[i] = start;
        this.uHead[i] = head;
        this.uBodyOff[i] = bodyOff;
        this.uBodyLen[i] = bodyLen;
        this.uEnd[i] = end;
        this.uStream[i] = stream;
        this.uIsPart[i] = false;
        this.uPart[i] = -1;
        this.uPartLast[i] = false;
        this.units = i + 1;
        this.continueSent = false;
    }

    /** One completed part of a PART-mode request as a unit; `last` sends the response after it. */
    void queuePart(int32 index, boolean last) {
        int32 i = this.units;
        this.uStart[i] = 0;
        this.uHead[i] = 0;
        this.uBodyOff[i] = 0;
        this.uBodyLen[i] = 0;
        this.uEnd[i] = 0;
        this.uStream[i] = false;
        this.uIsPart[i] = true;
        this.uPart[i] = index;
        this.uPartLast[i] = last;
        this.units = i + 1;
        this.continueSent = false;
    }

    /** The streamed-body objects, built on first use: a STREAM route needs them without global streaming. */
    void ensureStreamObjects() {
        if (this.bodyChan == null) {
            this.bodyChan = heap RequestBodyChannel();
            this.streamed = heap RequestBody(this.bodyChan);
        }
    }

    /** True when every queued unit is a part: nothing holds offsets into `in`. */
    boolean partsOnly() {
        int32 i = 0;
        while (i < this.units) {
            if (!this.uIsPart[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /**
     * Enters PART mode for the request whose head is the next `h` bytes:
     * copies the head aside (the body streams through `in` and is compacted
     * away), builds the parser, and starts feeding.
     */
    void beginParts(int32 h, int64 now) {
        MediaType ct #= this.req.contentType();
        String bound #= MultipartParser.boundaryOf(ct);
        if (bound == null || bound.byteLength() == 0) {
            this.refuse(400);
            return;
        }
        if (this.mpHead == null || this.mpHead.count() < (int64) h) {
            this.mpHead = heap int8[h];
        }
        int8[] src = this.in.array();
        int32 from = this.in.readPosition();
        int32 i = 0;
        while (i < h) {
            this.mpHead[i] = src[from + i];
            i = i + 1;
        }
        this.mpHeadLen = h;
        this.mp #= MultipartParser.forBoundaryWithLimits(bound, MultipartParser.DEFAULT_MAX_PARTS,
            this.maxPartBytes);
        this.mpRemaining = this.req.declaredLength;
        this.mpQueued = 0;
        this.in.advanceRead(h);
        this.scanner.reset();
        this.phase = Http1Framed.PHASE_BODY_PARTS;
        if (this.bodyMs > 0) {
            this.deadline = now + (int64) this.bodyMs;
        }
    }

    /** The framer's deadline check: true when the unit expired and the connection was closed. */
    public boolean expire(int64 now) {
        if (this.closed || this.deadline == (int64) 0 || now < this.deadline) {
            return false;
        }
        this.refuse(408);
        return true;
    }

    int32 expectation() {
        int32 i = this.req.table.find("expect", 0);
        if (i < 0) {
            return 0;
        }
        if (!Bytes.equalsIgnoreCase(this.req.table.valueAt(i), "100-continue")) {
            return 417;
        }
        if (!this.expectEnabled) {
            return 0;
        }
        if (this.req.framing == HttpRequest.FRAMING_LENGTH
                && this.maxBody > (int64) 0 && this.req.declaredLength > this.maxBody) {
            return 413;
        }
        if (this.req.versionKind != Version.HTTP_1_1) {
            return 0;
        }
        return 100;
    }

    /** Writes a small protocol reply without parking; a peer that cannot take it is closed. */
    boolean writeSmall(String text) {
        int8[] b #= text.toBytes();
        int32 n = text.byteLength();
        if (this.tls != null) {
            try {
                return this.tls.writeNow(b, 0, n);
            } catch (Exception e) {
                return false;
            }
        }
        int64 sent = (int64) 0;
        try {
            sent = this.conn.write(b, (int64) 0, (int64) n);
        } catch (Exception e) {
            sent = (int64) -1;
        }
        return sent == (int64) n;
    }

    void sendContinue() {
        if (!this.writeSmall("HTTP/1.1 100 Continue\r\n\r\n")) {
            this.close();
        }
    }

    /** A status-only refusal from the framer, then close. */
    void refuse(int32 status) {
        if (this.closed) {
            return;
        }
        String line = "HTTP/1.1 " + status + " " + Status.reasonLiteral(status)
            + "\r\ncontent-length: 0\r\nconnection: close\r\n\r\n";
        this.writeSmall(line);
        this.close();
    }

    // Chunked framing: a measuring pass that answers the end offset of the
    // whole chunked body (after the trailer's blank line) or -1 when more
    // bytes are needed, then the in-place pass that compacts the data.

    int32 lineEnd(int32 from) {
        int8[] a = this.in.array();
        int32 end = this.in.writePosition();
        int32 p = from;
        while (p + 1 < end) {
            if (a[p] == (int8) 13 && a[p + 1] == (int8) 10) {
                return p;
            }
            p = p + 1;
        }
        return -1;
    }

    int32 measureChunks(int32 start) {
        int8[] a = this.in.array();
        int32 src = start;
        int64 total = (int64) 0;
        while (true) {
            int32 le = this.lineEnd(src);
            if (le < 0) {
                return -1;
            }
            int64 size = (int64) 0;
            int32 p = src;
            int32 digits = 0;
            while (p < le && a[p] != (int8) 59) {
                int32 d = Bytes.hexValue(((int32) a[p]) & 255);
                if (d < 0 || digits >= 8) {
                    throw heap InvalidChunkEncodingException("bad chunk size", (int64) (p - start));
                }
                size = size * (int64) 16 + (int64) d;
                digits = digits + 1;
                p = p + 1;
            }
            if (digits == 0) {
                throw heap InvalidChunkEncodingException("empty chunk size", (int64) (src - start));
            }
            src = le + 2;
            if (size == (int64) 0) {
                int32 t = this.lineEnd(src);
                while (t >= 0 && t != src) {
                    src = t + 2;
                    t = this.lineEnd(src);
                }
                if (t < 0) {
                    return -1;
                }
                return src + 2;
            }
            total = total + size;
            if (this.maxBody > (int64) 0 && total > this.maxBody) {
                throw heap PayloadTooLargeException("chunked body over the limit", this.maxBody, total);
            }
            int32 n = (int32) size;
            if (src + n + 2 > this.in.capacity()) {
                throw heap PayloadTooLargeException("chunked body exceeds the input buffer",
                    (int64) this.in.capacity(), (int64) (src + n + 2));
            }
            if (this.in.writePosition() < src + n + 2) {
                return -1;
            }
            if (a[src + n] != (int8) 13 || a[src + n + 1] != (int8) 10) {
                throw heap InvalidChunkEncodingException("chunk data not followed by CRLF",
                    (int64) (src + n - start));
            }
            src = src + n + 2;
        }
        return -1;
    }

    int32 dechunk(int32 start) {
        int8[] a = this.in.array();
        int32 dst = start;
        int32 src = start;
        while (true) {
            int32 le = this.lineEnd(src);
            int64 size = (int64) 0;
            int32 p = src;
            while (p < le && a[p] != (int8) 59) {
                size = size * (int64) 16 + (int64) Bytes.hexValue(((int32) a[p]) & 255);
                p = p + 1;
            }
            src = le + 2;
            if (size == (int64) 0) {
                return dst;
            }
            int32 n = (int32) size;
            if (dst != src) {
                int32 i = 0;
                while (i < n) {
                    a[dst + i] = a[src + i];
                    i = i + 1;
                }
            }
            dst = dst + n;
            src = src + n + 2;
        }
        return dst;
    }

    // ----- worker side -------------------------------------------------------

    /**
     * Runs every queued unit through the handler in order and writes the
     * responses. Returns true when the connection stays open for more.
     */
    public boolean turn() {
        if (this.ws != null) {
            return this.ws.turn();
        }
        if (this.framedProto != null) {
            return this.framedProto.turn();
        }
        boolean keep = true;
        int32 i = 0;
        int32 n = this.units;
        while (i < n && keep) {
            if (this.uIsPart[i]) {
                keep = this.partTurn(i);
                i = i + 1;
                continue;
            }
            HeadScanner.parseRequest(this.in.array(), this.uStart[i], this.uHead[i], this.req);
            if (this.uStream[i]) {
                if (this.streamedCounter != null) {
                    this.streamedCounter.fetchAdd((int64) 1);
                }
                this.ensureStreamObjects();
                boolean chunked = this.req.framing == HttpRequest.FRAMING_CHUNKED;
                this.bodyChan.begin(this.channel(), this.in.array(), this.uBodyOff[i],
                    this.in.writePosition(), this.in.capacity(), chunked,
                    this.req.declaredLength, this.bodyMs, this.maxBody);
                this.streamed.reset(this.req, chunked ? (int64) -1 : this.req.declaredLength);
                this.req.bindStream(this.streamed);
            } else {
                this.req.bodyOff = this.uBodyOff[i];
                this.req.bodyLen = this.uBodyLen[i];
            }
            this.dispatch();
            boolean reuse = this.req.reuse;
            if (this.uStream[i] && !this.bodyChan.drain((int64) 262144)) {
                reuse = false;
            }
            boolean omit = this.req.methodKind == Method.HEAD;
            if (this.res.finish(reuse, this.req.versionKind, omit)) {
                this.out.writeToAsync(this.channel());
            }
            keep = this.res.keepsAlive() && reuse;
            if (this.uStream[i]) {
                this.req.bindBody(0, 0);
                this.bodyChan.restore(this.in);
            }
            if (this.res.upgrades()) {
                this.units = 0;
                // A WebSocket stays with its framer and this turn runs its
                // onConnect; any other takeover owns the connection here.
                return this.switchProtocols();
            }
            i = i + 1;
        }
        this.units = 0;
        if (keep) {
            this.in.compact();
            if (this.eof && this.in.readable() == 0) {
                keep = false;
            }
        }
        return keep;
    }

    /**
     * One part of a PART-mode request: the handler runs with the part on the
     * request; after the last part the response goes out as for any request.
     * Returns the keep-alive decision (true while parts remain).
     */
    boolean partTurn(int32 i) {
        HeadScanner.parseRequest(this.mpHead, 0, this.mpHeadLen, this.req);
        this.req.bodyOff = 0;
        this.req.bodyLen = 0;
        int32 idx = this.uPart[i];
        this.req.mpIndex = idx < 0 ? 0 : idx;
        this.req.mpPart = idx >= 0 ? this.mp.part(idx) : null;
        this.req.mpLast = this.uPartLast[i];
        this.dispatchKeeping(idx <= 0);
        if (!this.uPartLast[i]) {
            return true;
        }
        boolean reuse = this.req.reuse;
        boolean omit = this.req.methodKind == Method.HEAD;
        if (this.res.finish(reuse, this.req.versionKind, omit)) {
            this.out.writeToAsync(this.channel());
        }
        boolean keep = this.res.keepsAlive() && reuse;
        this.req.mpPart = null;
        this.mp = null;
        if (this.res.upgrades()) {
            this.units = 0;
            return this.switchProtocols();
        }
        return keep;
    }

    void dispatch() {
        this.dispatchKeeping(true);
    }

    /** `dispatch`, resetting the response first unless a PART request's earlier parts wrote to it. */
    void dispatchKeeping(boolean reset) {
        if (reset) {
            this.res.reset();
        }
        this.runHandler();
    }

    void runHandler() {
        try {
            (HttpRequest, HttpResponse) -> void fn = this.handler;
            fn(this.req, this.res);
        } catch (TimedOutException t) {
            if (this.res.isCommitted()) {
                throw t;
            }
            this.res.reset();
            this.res.status(408);
        } catch (HttpException e) {
            if (this.res.isCommitted()) {
                throw e;
            }
            this.res.reset();
            this.res.status(e.httpStatus());
        } catch (Exception e) {
            if (this.res.isCommitted()) {
                throw e;
            }
            this.res.reset();
            this.res.status(500);
        }
    }

    /**
     * Switches to the response's takeover. A WebSocket becomes a framed
     * connection (spec §2.5) and the result is its first turn's keep-alive;
     * any other takeover runs over this channel on this fiber, bytes already
     * read first, and the result is false.
     */
    boolean switchProtocols() {
        Takeover t #= this.res.takeUpgrade();
        if (t instanceof WsTakeover w) {
            this.ws #= w.framed(this.channel(), this, this.wsMaxMessage, this.maxUnits);
            return this.ws.turn();
        }
        if (t instanceof Protocol p) {
            this.framedProto #= p.framed(this.channel(), this.protoCounters, this.maxUnits);
            return true;
        }
        // Any other takeover owns the connection on its own fiber (spec §2.6):
        // the socket and the bytes already read move with it, and this
        // connection leaves the pool's table without closing anything. It is
        // `detach`ed, not spawned: a statement-position spawn is joined when
        // this frame exits, which held the worker for the takeover's life.
        int32 preLen = this.in.readable();
        int8[] pre = heap int8[preLen > 0 ? preLen : 1];
        int8[] src = this.in.array();
        int32 from = this.in.readPosition();
        int32 i = 0;
        while (i < preLen) {
            pre[i] = src[from + i];
            i = i + 1;
        }
        this.in.advanceRead(preLen);
        this.detached = true;
        if (this.tls != null) {
            TlsStream ts #= this.tls;
            this.tls = null;
            detach runTakeoverTls(#t, #ts, #pre, preLen);
        } else {
            TcpStream sock #= this.conn;
            this.conn = null;
            detach runTakeoverTcp(#t, #sock, #pre, preLen);
        }
        return false;
    }

    public static async int32 runTakeoverTcp(#Takeover t, #TcpStream s, #int8[] pre, int32 preLen) {
        Takeover tk #= t;
        TcpStream sock #= s;
        int8[] staged #= pre;
        int32 cap = preLen > 8192 ? preLen : 8192;
        AsyncReader reader = heap AsyncReader(sock, cap);
        if (preLen > 0) {
            reader.stage(staged, preLen);
        }
        AsyncWriter writer = heap AsyncWriter(sock);
        tk.attach(sock);
        try {
            tk.run(reader, writer);
        } catch (Exception e) {
        }
        sock.close();
        return 0;
    }

    public static async int32 runTakeoverTls(#Takeover t, #TlsStream s, #int8[] pre, int32 preLen) {
        Takeover tk #= t;
        TlsStream tls #= s;
        int8[] staged #= pre;
        int32 cap = preLen > 8192 ? preLen : 8192;
        AsyncReader reader = heap AsyncReader(tls, cap);
        if (preLen > 0) {
            reader.stage(staged, preLen);
        }
        AsyncWriter writer = heap AsyncWriter(tls);
        tk.attach(tls);
        try {
            tk.run(reader, writer);
        } catch (Exception e) {
        }
        tls.close();
        return 0;
    }

    /** The channel responses go through: the TLS stream under TLS, else the socket. */
    ByteChannel channel() {
        if (this.tls != null) {
            return this.tls;
        }
        return this.conn;
    }

    /** Closes the socket; the buffers go back through `release`. */
    public void close() {
        if (this.closed) {
            return;
        }
        this.closed = true;
        if (this.detached) {
            return;   // the takeover's fiber owns the socket now
        }
        try {
            if (this.tls != null) {
                this.tls.close();
            } else if (this.conn != null) {
                this.conn.close();
            }
        } catch (Exception e) {
        }
    }

    /** Hands the buffers back to `pool` and closes if not yet closed. */
    public void release(ConnectionBuffers pool) {
        this.close();
        if (this.h2 != null) {
            this.h2.release();
        }
        if (this.in != null) {
            ByteBuffer bin #= this.in;
            this.in = null;
            pool.give(#bin);
        }
        if (this.out != null) {
            ByteBuffer bout #= this.out;
            this.out = null;
            pool.give(#bout);
        }
    }
}
