package dev.cajeta.http.h2;

import cajeta.io.net.AsyncWriter;
import cajeta.concurrent.Lock;
import cajeta.concurrent.LockGuard;
import dev.cajeta.http.HttpResponse;

/**
 * The **shared write half** of a concurrent HTTP/2 connection (plan **3.3e**).
 * A single connection has one `AsyncWriter` and one HPACK *encoder*, and both
 * the reader fiber (SETTINGS/PING acks, RST_STREAM, GOAWAY, WINDOW_UPDATE) and
 * every per-stream handler fiber (HEADERS + DATA responses) must write through
 * them. Two constraints make this a guarded object rather than raw fields:
 *
 *  1. **Frame atomicity** — a frame's bytes must reach the socket contiguously;
 *     two fibers interleaving `writeAll` calls would corrupt the stream.
 *  2. **HPACK order** — the encoder's dynamic table is stateful, and the peer's
 *     decoder must see HEADERS blocks in the exact order they were encoded. So
 *     *encode-then-write* must be one atomic critical section.
 *
 * A single [`Lock`](../../../../cajeta/concurrent/Lock.cajeta) covers both:
 * every method here takes it for the whole encode+write, so the reader fiber
 * and N handler fibers serialize cleanly. The lock is held only for the socket
 * write, never across a flow-control park (that lives in
 * [`Http2SendGate`](Http2SendGate.cajeta)), so a stalled stream never blocks
 * another fiber's writes.
 *
 * The `AsyncWriter` is **borrowed** (owned by the connection's caller, which
 * outlives every handler fiber via the serving `scope`); the encoder is owned
 * here.
 */
public final class Http2WriteSide {
    AsyncWriter writer;
    HpackEncoder henc;
    Lock lock;
    int32 promisedId;   // last server-initiated (even) stream id handed out
    int8[] stage;

    public Http2WriteSide(AsyncWriter writer) {
        // `#=` (ownership 3.3.3): record the caller's mode — a lent writer
        // stays lent, `#writer` at the call site transfers it.
        this.writer #= writer;
        this.henc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
        this.lock = heap Lock();
        this.promisedId = 0;
        this.stage = heap int8[16384 + 64];
    }

    /**
     * Reserve the next server-initiated (even, increasing) stream id for a
     * PUSH_PROMISE, under the write lock so concurrent handler fibers never
     * collide (RFC 9113 §5.1.1).
     */
    public int32 nextPromisedId() {
        LockGuard g #= this.lock.acquire();
        this.promisedId = this.promisedId + 2;
        return this.promisedId;
    }

    /**
     * Encode `fields` and write a PUSH_PROMISE on `streamId` reserving
     * `promisedId`, atomically (HPACK order preserved like `writeHeaders`).
     */
    public void writePushPromise(int32 streamId, int32 promisedId,
                                 HpackFieldList fields) {
        LockGuard g #= this.lock.acquire();
        int8[] block #= this.henc.encode(fields);
        int32 blockLen = (int32) block.count();
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2ContentFrames.writePushPromise(fw, streamId, promisedId, block,
                                            blockLen, true, 0);
        int8[] bytes #= fw.toBytes();
        this.writer.writeAll(bytes, 0, (int32) bytes.count());
        this.writer.flush();
    }

    /**
     * Write a pre-built control/response frame buffer (SETTINGS(+ACK), PING ACK,
     * RST_STREAM, GOAWAY, WINDOW_UPDATE) as one atomic socket write.
     */
    public void writeControl(Http2FrameWriter fw) {
        int8[] bytes #= fw.toBytes();
        int32 n = (int32) bytes.count();
        LockGuard g #= this.lock.acquire();
        this.writer.writeAll(bytes, 0, n);
        this.writer.flush();
    }

    /**
     * Encode `fields` and write the resulting HEADERS frame in one critical
     * section, so the encoder's dynamic-table mutation and the frame's position
     * on the wire stay consistent with the peer's decode order.
     */
    public void writeHeaders(int32 sid, HpackFieldList fields, boolean endStream) {
        LockGuard g #= this.lock.acquire();
        int8[] block #= this.henc.encode(fields);
        int32 blockLen = (int32) block.count();
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2ContentFrames.writeHeaders(fw, sid, block, blockLen, endStream,
                                        true, 0);
        int8[] bytes #= fw.toBytes();
        this.writer.writeAll(bytes, 0, (int32) bytes.count());
        this.writer.flush();
    }

    /**
     * Encodes `r`'s head and writes it as HEADERS (plus CONTINUATION past 16384
     * bytes), then, when `withData`, one DATA frame of `body[off .. off+len)`,
     * in one flush. Frames are staged in a buffer reused across calls.
     */
    public void writeResponse(int32 sid, HttpResponse r, boolean headEnds, boolean withData,
                              int8[] body, int32 off, int32 len, boolean last) {
        LockGuard g #= this.lock.acquire();
        HpackWriter hw = this.henc.encodeResponse(r);
        int8[] blk = hw.buffer();
        int32 bl = hw.size();
        int32 frames = 1 + (bl - 1) / 16384;
        if (bl == 0) {
            frames = 1;
        }
        int32 need = bl + 9 * frames;
        if (withData) {
            need = need + 9 + len;
        }
        this.ensure(need);
        int8[] s = this.stage;
        int32 at = 0;
        int32 done = 0;
        int32 k = 0;
        while (k < frames) {
            int32 n = bl - done;
            if (n > 16384) {
                n = 16384;
            }
            int32 type = 9;
            int32 flags = 0;
            if (k == 0) {
                type = 1;
                if (headEnds) {
                    flags = 1;
                }
            }
            if (k == frames - 1) {
                flags = flags | 4;
            }
            Http2WriteSide.frameHeader(s, at, n, type, flags, sid);
            at = Http2WriteSide.copy(s, at + 9, blk, done, n);
            done = done + n;
            k = k + 1;
        }
        if (withData) {
            int32 df = 0;
            if (last) {
                df = 1;
            }
            Http2WriteSide.frameHeader(s, at, len, 0, df, sid);
            at = Http2WriteSide.copy(s, at + 9, body, off, len);
        }
        this.writer.writeAll(s, 0, at);
        this.writer.flush();
    }

    /** Write one DATA frame carrying `body[off .. off+len)`. */
    public void writeData(int32 sid, int8[] body, int32 off, int32 len,
                          boolean last) {
        LockGuard g #= this.lock.acquire();
        this.ensure(9 + len);
        int32 df = 0;
        if (last) {
            df = 1;
        }
        Http2WriteSide.frameHeader(this.stage, 0, len, 0, df, sid);
        int32 at = Http2WriteSide.copy(this.stage, 9, body, off, len);
        this.writer.writeAll(this.stage, 0, at);
        this.writer.flush();
    }

    void ensure(int32 need) {
        if (need > this.stage.count()) {
            this.stage = heap int8[need];
        }
    }

    static void frameHeader(int8[] a, int32 at, int32 len, int32 type, int32 flags, int32 sid) {
        a[at] = (int8) ((len >> 16) & 255);
        a[at + 1] = (int8) ((len >> 8) & 255);
        a[at + 2] = (int8) (len & 255);
        a[at + 3] = (int8) type;
        a[at + 4] = (int8) flags;
        a[at + 5] = (int8) ((sid >> 24) & 127);
        a[at + 6] = (int8) ((sid >> 16) & 255);
        a[at + 7] = (int8) ((sid >> 8) & 255);
        a[at + 8] = (int8) (sid & 255);
    }

    // Copies src[off .. off+n) to dst at `at` and returns the end.
    static int32 copy(int8[] dst, int32 at, int8[] src, int32 off, int32 n) {
        int32 i = 0;
        while (i < n) {
            dst[at + i] = src[off + i];
            i = i + 1;
        }
        return at + n;
    }
}
