package dev.cajeta.http.h2;

/**
 * A forward cursor over an encoded HPACK field block — plan item **3.1**.
 * Borrows the caller's buffer (it must outlive the reader) and exposes the
 * RFC 7541 §5.1 **prefix-integer** decode plus byte reads; the string
 * primitive ([`HpackString`](HpackString.cajeta)) and the decoder
 * ([`HpackDecoder`](HpackDecoder.cajeta)) build on it.
 *
 * Every read is bounds-checked against `limit`; running off the end raises
 * [`HpackException`](HpackException.cajeta) ("truncated"). The integer decode
 * guards the varint continuation against a size-bomb — a value that would
 * exceed the `int32` range, or a continuation longer than the `int64`
 * accumulator, is rejected rather than wrapped.
 */
public final class HpackReader {
    int8[] buf;      // borrowed — the caller owns the backing bytes
    int32 pos;
    int32 limit;

    public HpackReader(int8[] buf, int32 limit) {
        this.buf = buf;
        this.pos = 0;
        this.limit = limit;
    }

    /** Whether any bytes remain. */
    public boolean hasMore() {
        return this.pos < this.limit;
    }

    /** The current read offset. */
    public int32 position() {
        return this.pos;
    }

    /** Read and consume one byte as an unsigned `0..255`. */
    public int32 readByte() {
        if (this.pos >= this.limit) {
            throw heap HpackException("truncated HPACK data");
        }
        int32 b = ((int32) this.buf[this.pos]) & 0xFF;
        this.pos = this.pos + 1;
        return b;
    }

    /** The next byte as an unsigned `0..255` without consuming it. */
    public int32 peekByte() {
        if (this.pos >= this.limit) {
            throw heap HpackException("truncated HPACK data");
        }
        return ((int32) this.buf[this.pos]) & 0xFF;
    }

    /**
     * Decode an integer with an **N-bit prefix** (RFC 7541 §5.1). Consumes the
     * prefix octet (its high bits, e.g. a representation flag, are the caller's
     * to have already peeked) and any `0x80`-continued octets. The result is a
     * non-negative value bounded to `0x7FFFFFFF`; anything larger, or a
     * pathologically long continuation, raises [`HpackException`](HpackException.cajeta).
     */
    public int64 readInteger(int32 prefixBits) {
        int64 max = ((int64) 1 << (int64) prefixBits) - (int64) 1;   // 2^N - 1
        int64 value = ((int64) this.readByte()) & max;
        if (value < max) {
            return value;
        }
        int64 m = 0;
        boolean more = true;
        while (more) {
            int64 b = (int64) this.readByte();
            value = value + ((b & (int64) 127) << m);
            if (value < (int64) 0 || value > (int64) 0x7FFFFFFF) {
                throw heap HpackException("HPACK integer overflow");
            }
            m = m + (int64) 7;
            if (m > (int64) 56) {
                throw heap HpackException("HPACK integer continuation too long");
            }
            if ((b & (int64) 128) == (int64) 0) {
                more = false;
            }
        }
        return value;
    }
}
