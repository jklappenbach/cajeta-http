package dev.cajeta.http.h2;

import cajeta.lang.String;
import cajeta.concurrent.Lock;
import cajeta.concurrent.LockGuard;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.NetException;
import cajeta.io.net.TimedOutException;
import cajeta.io.net.tls.TlsException;
import dev.cajeta.http.HttpException;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.PushEntry;
import dev.cajeta.http.h1.HttpParserLimits;
import dev.cajeta.http.server.ConnectionBuffers;
import cajeta.collection.ArrayList;
import cajeta.concurrent.Channel;
import cajeta.lang.Optional;
import cajeta.concurrent.AtomicInt32;
import cajeta.io.net.ByteBuffer;
import dev.cajeta.http.server.ServerLimits;
import dev.cajeta.http.server.MultipartMode;
import dev.cajeta.http.server.MultipartRoutes;

/**
 * The HTTP/2 server engine for one connection. Frames are read in order, each
 * stream's head is decoded into a pooled stream slot as a request view, and
 * each complete request runs its handler on a fiber of its own with the
 * slot's response, whose head and body leave as HEADERS and DATA frames under
 * flow control. Slots return to the connection when their stream ends.
 */
public final class Http2Connection {
    AsyncReader reader;
    (HttpRequest, HttpResponse) -> void handler;
    ConnectionBuffers bufs;
    HttpParserLimits limits;
    Http2WriteSide ws;
    Http2SendGate gate;
    HpackDecoder hdec;
    Http2Settings local;
    Http2Settings remote;
    Http2FlowController flow;
    int32 pendConnRecv;
    int32 pendStreamRecv;
    int32 pendStreamId;
    int64 maxBody;
    Http2StreamTable streams;
    HeaderBlockAssembler assembler;
    boolean hdrEndStream;
    Http2StreamSlot cur;
    Http2StreamSlot ready;
    Http2SlotPool slots;
    int8[] frameHdr;
    int8[] frameBuf;

    static final int32 RECV_WINDOW = 1048576;
    static final int32 WINDOW_REPLENISH = 524288;

    /** An engine answering with `handler`, taking stream buffers from `bufs`. */
    // Framer-fed mode (request-dispatch Unit 5): bytes arrive through `feed`
    // instead of the reader, control frames go out through `controlNow`, and
    // completed streams wait in `readyList` for the dispatch pool.
    boolean fed;
    int32 fedPhase;            // 0 preface, 1 frame header, 2 payload
    int32 fedLen;
    ArrayList<Http2StreamSlot> readyList;
    public AtomicInt32 streamsInFlight;
    public boolean ended;      // GOAWAY sent or received, or the peer finished
    NowWriter nowWriter;
    // Streaming request bodies (h2-streaming-request-body spec §2.1): a
    // stream opens at head complete when every body streams or its route is
    // a STREAM multipart route. Open slots belong to this list for their
    // whole life; the pool runs their handlers on borrows.
    boolean streamAll;
    MultipartRoutes mpRoutes;
    Http2StreamSlot[] openArr;      // borrows of the open slots, for feeding DATA by stream id
    int32 openN;
    Channel<Http2StreamSlot> finishedOpen;   // titles a worker hands back once its handler returned
    ArrayList<Http2StreamSlot> draining;     // answered with the body still open: discarded up to DRAIN_LIMIT, then reset
    ArrayList<Http2StreamSlot> partSlots;    // PART streams between units: the framer feeds their parsers
    int32 maxPartBytes;
    static final int64 DRAIN_LIMIT = (int64) 262144;

    public Http2Connection(AsyncReader reader, AsyncWriter writer,
                           (HttpRequest, HttpResponse) -> void handler,
                           ConnectionBuffers bufs, HttpParserLimits limits) {
        this.reader #= reader;
        this.handler #= handler;
        this.bufs #= bufs;
        this.limits #= limits;
        this.ws = heap Http2WriteSide(writer);
        this.gate = heap Http2SendGate(Http2.DEFAULT_INITIAL_WINDOW_SIZE);
        this.hdec = heap HpackDecoder(Http2.DEFAULT_HEADER_TABLE_SIZE);
        this.frameHdr = heap int8[9];
        this.frameBuf = heap int8[Http2.DEFAULT_MAX_FRAME_SIZE];
        this.local = heap Http2Settings();
        this.local.maxConcurrentStreams = (int64) 100;
        // Streams start at the default window; a stream held whole is topped
        // up to the receive window at head complete, an open stream to its
        // slab (spec §2.3), so a window never exceeds what can hold it.
        this.local.initialWindowSize = (int64) Http2.DEFAULT_INITIAL_WINDOW_SIZE;
        this.remote = heap Http2Settings();
        this.pendConnRecv = 0;
        this.pendStreamRecv = 0;
        this.pendStreamId = 0;
        this.maxBody = ServerLimits.DEFAULT_MAX_BODY_BYTES;
        this.flow = heap Http2FlowController(Http2.DEFAULT_INITIAL_WINDOW_SIZE, Http2Connection.RECV_WINDOW);
        this.streams = heap Http2StreamTable();
        this.assembler = heap HeaderBlockAssembler();
        this.hdrEndStream = false;
        this.cur = null;
        this.ready = null;
        this.slots = heap Http2SlotPool();
        this.fed = false;
        this.fedPhase = 0;
        this.fedLen = 0;
        this.readyList = heap ArrayList<Http2StreamSlot>();
        this.streamsInFlight = heap AtomicInt32(0);
        this.ended = false;
        this.nowWriter = null;
        this.streamAll = false;
        this.mpRoutes = null;
        this.openArr = heap Http2StreamSlot[16];
        this.openN = 0;
        this.finishedOpen = heap Channel<Http2StreamSlot>(256);
        this.draining = heap ArrayList<Http2StreamSlot>();
        this.partSlots = heap ArrayList<Http2StreamSlot>();
        this.maxPartBytes = 16777216;
    }

    /** The server's body modes: `all` is `streamRequestBody`; `routes` the PART and STREAM routes, or null; `maxPartBytes` bounds a PART. */
    public void streaming(boolean all, MultipartRoutes routes, int32 maxPartBytes) {
        this.streamAll = all;
        this.mpRoutes #= routes;
        this.maxPartBytes = maxPartBytes;
    }

    /** True when `req`'s route takes its multipart body per part (spec §2.7). */
    boolean wantsParts(HttpRequest req) {
        return this.mpRoutes != null && this.mpRoutes.modeFor(req) == MultipartMode.PART;
    }

    /** A unit for the pool or the connection loop: onto the ready list, which either drains. */
    void enqueueReady(#Http2StreamSlot t) {
        this.readyList.add(#t);
    }

    int32 partSlotIndex(int32 sid) {
        int32 i = 0;
        while (i < this.partSlots.count()) {
            if (this.partSlots.get(i).sid == sid) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /**
     * Dispatches the next unit of a PART stream when one is due and none is
     * on a worker: a part once a later part has begun or the closing
     * delimiter is seen (so `multipartLast()` is known), an empty form once,
     * or the failure the parser recorded.
     */
    void offerParts(Http2StreamSlot s) {
        if (s.partBusy) {
            return;
        }
        int32 idx = -3;
        boolean last = false;
        if (s.partFailStatus != 0) {
            idx = -2;
            last = true;
        } else {
            int32 count = s.mp.partCount();
            boolean complete = s.mp.isComplete();
            if (s.mpQueued < count && (s.mpQueued < count - 1 || complete)) {
                idx = s.mpQueued;
                last = complete && s.mpQueued == count - 1;
                s.mpQueued = s.mpQueued + 1;
            } else if (complete && count == 0 && s.mpQueued == 0) {
                idx = -1;
                last = true;
                s.mpQueued = 1;
            }
        }
        if (idx == -3) {
            return;
        }
        int32 pi = this.partSlotIndex(s.sid);
        if (pi < 0) {
            return;
        }
        Http2StreamSlot t #= this.partSlots.removeAt(pi);
        t.partBusy = true;
        t.partIndex = idx;
        t.partLast = last;
        this.enqueueReady(#t);
    }

    /** Whether a stream with a body opens at head complete (spec §2.1). */
    boolean wantsOpen(HttpRequest req) {
        if (this.streamAll) {
            return true;
        }
        return this.mpRoutes != null && this.mpRoutes.modeFor(req) == MultipartMode.STREAM;
    }

    /** Grants `n` bytes of stream credit from the framer. */
    void grantStream(int32 sid, int32 n) {
        if (n <= 0) {
            return;
        }
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeWindowUpdate(fw, sid, n);
        this.control(fw);
    }

    /** The open slot of stream `sid`, or null. */
    Http2StreamSlot openSlot(int32 sid) {
        int32 i = 0;
        while (i < this.openN) {
            if (this.openArr[i].sid == sid) {
                return this.openArr[i];
            }
            i = i + 1;
        }
        return null;
    }

    /** Remembers a borrow of an open slot while its title rides to the pool. */
    void trackOpen(^Http2StreamSlot s) {
        if (this.openN == this.openArr.count()) {
            Http2StreamSlot[] g = heap Http2StreamSlot[this.openN * 2];
            int32 i = 0;
            while (i < this.openN) {
                g[i] = this.openArr[i];
                this.openArr[i] = null;
                i = i + 1;
            }
            this.openArr #= g;
        }
        this.openArr[this.openN] = s;
        this.openN = this.openN + 1;
    }

    void untrackOpen(int32 sid) {
        int32 i = 0;
        while (i < this.openN) {
            if (this.openArr[i].sid == sid) {
                int32 last = this.openN - 1;
                this.openArr[i] = this.openArr[last];
                this.openArr[last] = null;
                this.openN = last;
                return;
            }
            i = i + 1;
        }
    }

    /** The draining slot of stream `sid`, or -1. */
    int32 drainingIndex(int32 sid) {
        int32 i = 0;
        while (i < this.draining.count()) {
            if (this.draining.get(i).sid == sid) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /** Ends a drain: cleanly when the body ended, else with RST_STREAM(NO_ERROR). */
    void endDrain(int32 i, boolean reset) {
        Http2StreamSlot t #= this.draining.removeAt(i);
        if (reset) {
            if (this.streams.has(t.sid)) {
                this.streams.sendRst(t.sid);
            }
            Http2FrameWriter fw = heap Http2FrameWriter();
            Http2Frames.writeRstStream(fw, t.sid, (int64) Http2.NO_ERROR);
            this.control(fw);
        }
        this.giveSlot(#t);
    }

    /**
     * The peer ended an open stream's body (END_STREAM on DATA, or trailers):
     * a body shorter than its content-length is a stream error the reader
     * raises (spec §2.4.2); otherwise the reader returns 0 after what came.
     */
    void finishOpenBody(Http2StreamSlot os) {
        if (os.expectedBody >= (int64) 0 && os.bodyReceived() != os.expectedBody) {
            os.failOpenBody("request body ended before its content-length");
            if (this.streams.has(os.sid)) {
                this.streams.sendRst(os.sid);
            }
            Http2FrameWriter fw = heap Http2FrameWriter();
            Http2Frames.writeRstStream(fw, os.sid, (int64) Http2.PROTOCOL_ERROR);
            this.control(fw);
            return;
        }
        os.endOpenBody();
    }

    /**
     * Frees every open slot whose handler has returned (its title came back
     * through `finishedOpen`). One whose body is still open is cut with
     * RST_STREAM(NO_ERROR) after its response (spec §2.5; the 256 KB drain is
     * the plan's Unit 3). Runs on the framer, or on the connection loop under
     * the old model: the owner of the open list.
     */
    public void reapOpen() {
        boolean more = true;
        while (more) {
            Optional<Http2StreamSlot> o = this.finishedOpen.tryReceive();
            if (!o.isPresent()) {
                more = false;
            } else {
                Http2StreamSlot t #= o.take();
                if (t.partMode) {
                    t.partBusy = false;
                    if (t.partLast || t.partFailStatus < 0) {
                        this.untrackOpen(t.sid);
                        boolean bodyOpen = !t.bodyEnded;
                        t.endParts();
                        if (bodyOpen) {
                            // A 413 or 400 answered while the form still arrives: drain, then cut (spec §2.5).
                            t.drainLeft = Http2Connection.DRAIN_LIMIT;
                            this.grantStream(t.sid, (int32) Http2Connection.DRAIN_LIMIT);
                            this.draining.add(#t);
                        } else {
                            this.giveSlot(#t);
                        }
                    } else {
                        int32 sid = t.sid;
                        this.partSlots.add(#t);
                        Http2StreamSlot again = this.openSlot(sid);
                        if (again != null) {
                            this.offerParts(again);
                        }
                    }
                    continue;
                }
                this.untrackOpen(t.sid);
                if (!t.bodyEnded) {
                    // The handler returned with the body open (spec §2.5): the
                    // body slab goes back now, and the stream drains up to
                    // DRAIN_LIMIT more bytes before a reset cuts it.
                    t.failOpenBody("handler returned before the body ended");
                    t.closeOpen(this.bufs);
                    t.drainLeft = Http2Connection.DRAIN_LIMIT;
                    // The budget is the window: the peer may send this much
                    // more; a body that ends inside it closes cleanly.
                    this.grantStream(t.sid, (int32) Http2Connection.DRAIN_LIMIT);
                    this.draining.add(#t);
                } else {
                    t.closeOpen(this.bufs);
                    this.giveSlot(#t);
                }
            }
        }
    }

    /** Open streams whose handlers are still running or whose bodies are still arriving. */
    public int32 openCount() {
        return this.openN;
    }

    /**
     * A connection a framer feeds (request-dispatch spec §2.4): no reader;
     * `now` is the transport's non-parking write for control frames.
     */
    public static #Http2Connection framed(AsyncWriter writer,
                                          (HttpRequest, HttpResponse) -> void handler,
                                          ConnectionBuffers bufs, HttpParserLimits limits,
                                          int64 maxBodyBytes, ^NowWriter now) {
        Http2Connection c = heap Http2Connection(null, writer, handler, bufs, limits);
        c.maxBody = maxBodyBytes;
        c.fed = true;
        c.nowWriter = now;
        return #c;
    }

    /** A control frame: parking on the connection loop, never parking when framer-fed. */
    void control(Http2FrameWriter fw) {
        if (this.fed) {
            this.ws.controlNow(fw, this.nowWriter);
        } else {
            this.ws.writeControl(fw);
        }
    }

    /**
     * Feeds bytes from a framer's buffer: consumes every complete frame, runs
     * the connection's frame logic on it, and moves completed streams onto
     * `readyList`. Returns the number of streams waiting, or -1 once the
     * connection has ended. Bytes of an incomplete frame stay in `in`.
     */
    public int32 feed(ByteBuffer in) {
        if (this.ended) {
            return -1;
        }
        boolean more = true;
        while (more && !this.ended) {
            if (this.fedPhase == 0) {
                if (in.readable() < 24) {
                    more = false;
                } else {
                    int8[] pf = heap int8[24];
                    in.read(pf, 0, 24);
                    if (!Http2.matchesPreface(pf, 0, 24)) {
                        this.sendGoaway(Http2.PROTOCOL_ERROR);
                        this.ended = true;
                    } else {
                        this.sendOurSettings();
                        this.fedPhase = 1;
                    }
                }
            } else if (this.fedPhase == 1) {
                if (in.readable() < 9) {
                    more = false;
                } else {
                    // Through a local: a wire view built over a FIELD array
                    // read the slot, not the bytes (2026-10-16, the same shape
                    // as the socket-intrinsic defect fixed in the compiler).
                    int8[] hdr = this.frameHdr;
                    in.read(hdr, 0, 9);
                    Http2FrameHeader h #= Http2FrameHeader(hdr);
                    this.fedLen = h.length();
                    if (this.fedLen > (int32) this.local.maxFrameSize) {
                        this.sendGoaway(Http2.FRAME_SIZE_ERROR);
                        this.ended = true;
                    } else {
                        this.fedPhase = 2;
                    }
                }
            } else {
                if (in.readable() < this.fedLen) {
                    more = false;
                } else {
                    if (this.fedLen > this.frameBuf.count()) {
                        this.frameBuf = heap int8[this.fedLen];
                    }
                    int8[] payload = this.frameBuf;
                    if (this.fedLen > 0) {
                        in.read(payload, 0, this.fedLen);
                    }
                    this.fedPhase = 1;
                    int8[] hdr2 = this.frameHdr;
                    boolean cont = this.dispatchHeader(hdr2, payload, this.fedLen);
                    if (!cont) {
                        this.ended = true;
                    }
                    if (this.ready != null) {
                        Http2StreamSlot r #= this.ready;
                        this.ready = null;
                        this.readyList.add(#r);
                    }
                }
            }
        }
        if (this.ended) {
            return -1;
        }
        return this.readyList.count();
    }

    /** The peer finished writing: no more frames can complete; a handler parked on an open body wakes and raises. */
    public void endInput() {
        this.ended = true;
        int32 i = 0;
        while (i < this.openN) {
            Http2StreamSlot s = this.openArr[i];
            if (s.partMode) {
                s.bodyEnded = true;
                s.partFailStatus = -1;
            } else if (!s.bodyEnded) {
                s.failOpenBody("connection closed under the request body");
            }
            i = i + 1;
        }
    }

    public int32 readyCount() {
        return this.readyList.count();
    }

    /** The oldest completed stream, for the pool. */
    public #Http2StreamSlot takeReady() {
        return this.readyList.removeAt(0);
    }

    /** No completed stream waits; the framer tracks the ones on workers. */
    public boolean quiescent() {
        return this.readyList.count() == 0;
    }

    /** The framer puts a taken stream back when the pool refused it; order among streams is not promised. */
    public void putBackReady(#Http2StreamSlot slot) {
        this.readyList.add(#slot);
    }

    /** One stream's turn on a pool worker: the per-stream handler, then the slot goes back. */
    public static int32 runStream(Http2Connection c, #Http2StreamSlot slot) {
        int32 maxFrame = (int32) c.remote.maxFrameSize;
        boolean pushOk = c.remote.pushEnabled();
        int32 initWin = (int32) c.remote.initialWindowSize;
        if (slot.partMode) {
            // One part of a PART stream (spec §2.7): the handler runs with the
            // part bound; the title goes back for the next part or the end.
            int32 psid = slot.sid;
            try {
                Http2Connection.answerPart(c, slot, maxFrame);
            } catch (Exception e) {
            }
            slot.handlerDone.store(1);
            c.finishedOpen.send(#slot);
            return psid;
        }
        if (slot.open) {
            // An open stream: the handler runs here, then the title goes back
            // to the connection, whose framer frees the slot once the body is
            // over (reapOpen) and keeps feeding it until then.
            int32 osid = slot.sid;
            try {
                Http2Connection.answer(c, slot, maxFrame, pushOk, initWin);
            } catch (Exception e) {
            }
            slot.handlerDone.store(1);
            c.finishedOpen.send(#slot);
            return osid;
        }
        int32 sid = 0;
        try {
            sid = Http2Connection.handleStream(c, #slot, maxFrame, pushOk, initWin);
        } catch (Exception e) {
        }
        return sid;
    }

    /** Returns every slot's buffers; the framer calls it when it drops the connection, once nothing is in flight. */
    public void release() {
        while (this.readyList.count() > 0) {
            Http2StreamSlot s #= this.readyList.removeAt(0);
            this.giveSlot(#s);
        }
        this.reapOpen();
        int32 i = 0;
        while (i < this.openN) {
            this.openArr[i] = null;
            i = i + 1;
        }
        this.openN = 0;
        while (this.draining.count() > 0) {
            Http2StreamSlot t #= this.draining.removeAt(0);
            this.giveSlot(#t);
        }
        while (this.partSlots.count() > 0) {
            Http2StreamSlot p #= this.partSlots.removeAt(0);
            p.endParts();
            this.giveSlot(#p);
        }
        this.releaseSlots();
    }

    /** Serves one connection until the peer leaves or a connection error ends it. */
    public static void serve(AsyncReader reader, AsyncWriter writer,
                             (HttpRequest, HttpResponse) -> void handler,
                             ConnectionBuffers bufs, HttpParserLimits limits, int64 maxBodyBytes) {
        Http2Connection.serveWith(reader, writer, handler, bufs, limits, maxBodyBytes, false, null, 16777216);
    }

    /** `serve` with the server's body modes (spec §2.8): the connection loop feeds open and PART streams itself. */
    public static void serveWith(AsyncReader reader, AsyncWriter writer,
                                 (HttpRequest, HttpResponse) -> void handler,
                                 ConnectionBuffers bufs, HttpParserLimits limits, int64 maxBodyBytes,
                                 boolean streamAll, MultipartRoutes routes, int32 maxPartBytes) {
        Http2Connection c = heap Http2Connection(reader, writer, handler, bufs, limits);
        c.maxBody = maxBodyBytes;
        c.streaming(streamAll, routes, maxPartBytes);
        try {
            c.run();
        } catch (Http2Exception e) {
        } catch (NetException e) {
        } catch (TlsException e) {
        }
        c.release();
    }

    /** Open or PART streams in play: the connection loop then reaps between frames (spec §2.8). */
    boolean needsReaping() {
        return this.openN > 0 || this.draining.count() > 0 || this.partSlots.count() > 0;
    }

    /**
     * The connection loop's frame-header read. While open streams are in
     * play it waits in short steps and reaps finished units between them, so
     * a handler that returned early is drained or cut without waiting for the
     * peer's next frame; otherwise it blocks as before.
     */
    int32 readHeader(int8[] hdr) {
        int32 off = 0;
        while (off < 9) {
            int32 g = 0;
            if (this.needsReaping()) {
                boolean timedOut = false;
                try {
                    g = this.reader.readWithin(hdr, off, 9 - off, 50);
                } catch (TimedOutException t) {
                    timedOut = true;
                }
                this.reapOpen();
                if (timedOut) {
                    if (off == 0 && this.readyList.count() > 0) {
                        return 2;   // a reaped unit wants a fiber before the next frame
                    }
                    continue;
                }
            } else {
                g = this.reader.read(hdr, off, 9 - off);
            }
            if (g == 0) {
                if (off == 0) {
                    return 0;
                }
                throw heap Http2Exception("truncated frame at EOF", Http2.PROTOCOL_ERROR);
            }
            off = off + g;
        }
        return 1;
    }

    /** A unit of an open or PART stream on its own fiber under the old model; the title returns through `finishedOpen`. */
    public static async int32 runUnit(Http2Connection c, #Http2StreamSlot slot) {
        return Http2Connection.runStream(c, #slot);
    }

    #Http2StreamSlot takeSlot() {
        return this.slots.take(this.bufs, this.limits, this.ws, this.gate);
    }

    void giveSlot(#Http2StreamSlot s) {
        this.slots.give(#s);
    }

    void releaseSlots() {
        this.slots.releaseAll(this.bufs);
    }

    void run() {
        int8[] pf = heap int8[24];
        if (!this.readFully(pf, 24)) {
            return;
        }
        if (!Http2.matchesPreface(pf, 0, 24)) {
            this.sendGoaway(Http2.PROTOCOL_ERROR);
            return;
        }
        this.sendOurSettings();
        scope {
            boolean running = true;
            while (running) {
                int8[] hdr = this.frameHdr;
                int32 rh = this.readHeader(hdr);
                if (rh == 0) {
                    running = false;
                } else {
                    if (rh == 1) {
                        running = this.readAndDispatch(hdr);
                        this.reapOpen();
                    }
                    if (this.ready != null) {
                        Http2StreamSlot r #= this.ready;
                        this.ready = null;
                        this.readyList.add(#r);
                    }
                    while (this.readyList.count() > 0) {
                        Http2StreamSlot s #= this.readyList.removeAt(0);
                        if (s.open || s.partMode) {
                            spawn runUnit(this, #s);
                        } else {
                            int32 maxFrame = (int32) this.remote.maxFrameSize;
                            boolean pushOk = this.remote.pushEnabled();
                            int32 initWin = (int32) this.remote.initialWindowSize;
                            spawn handleStream(this, #s, maxFrame, pushOk, initWin);
                        }
                    }
                }
            }
            // The peer is done: a handler parked on an open body wakes and raises,
            // and the scope waits for every unit's fiber before the slots go back.
            this.endInput();
        }
        this.reapOpen();
    }

    boolean readAndDispatch(int8[] hdr) {
        Http2FrameHeader h #= Http2FrameHeader(hdr);
        int32 type = h.typeCode();
        int32 flags = h.flags();
        int32 sid = h.streamId();
        int32 len = h.length();
        if (len > (int32) this.local.maxFrameSize) {
            this.sendGoaway(Http2.FRAME_SIZE_ERROR);
            return false;
        }
        if (len > this.frameBuf.count()) {
            this.frameBuf = heap int8[len];
        }
        int8[] payload = this.frameBuf;
        if (len > 0) {
            this.reader.readExact(payload, 0, len);
        }
        return this.dispatchHeader(hdr, payload, len);
    }

    /** Runs one frame whose header and payload are in hand; false when the connection ends. */
    boolean dispatchHeader(int8[] hdr, int8[] payload, int32 len) {
        Http2FrameHeader h #= Http2FrameHeader(hdr);
        int32 type = h.typeCode();
        int32 flags = h.flags();
        int32 sid = h.streamId();
        if (this.assembler.isOpen() && type != Http2.FRAME_CONTINUATION) {
            this.sendGoaway(Http2.PROTOCOL_ERROR);
            return false;
        }
        boolean cont = true;
        try {
            cont = this.dispatchFrame(type, flags, sid, payload, len);
        } catch (Http2Exception e) {
            if (e.isConnectionError()) {
                this.sendGoaway(e.errorCode);
                cont = false;
            } else {
                this.sendRst(e.streamId, e.errorCode);
            }
        }
        return cont;
    }

    boolean dispatchFrame(int32 type, int32 flags, int32 sid, int8[] payload, int32 len) {
        if (type == Http2.FRAME_SETTINGS) {
            this.onSettings(flags, payload, len, sid);
        } else if (type == Http2.FRAME_HEADERS) {
            this.onHeaders(flags, sid, payload, len);
        } else if (type == Http2.FRAME_CONTINUATION) {
            this.onContinuation(flags, sid, payload, len);
        } else if (type == Http2.FRAME_DATA) {
            this.onData(flags, sid, payload, len);
        } else if (type == Http2.FRAME_WINDOW_UPDATE) {
            this.onWindowUpdate(sid, payload, len);
        } else if (type == Http2.FRAME_RST_STREAM) {
            this.onRstStream(sid, payload, len);
        } else if (type == Http2.FRAME_PING) {
            this.onPing(flags, sid, payload, len);
        } else if (type == Http2.FRAME_PRIORITY) {
            Http2Frames.validatePriority(len, sid);
        } else if (type == Http2.FRAME_GOAWAY) {
            return false;
        }
        return true;
    }

    void onSettings(int32 flags, int8[] payload, int32 len, int32 sid) {
        if ((flags & Http2.FLAG_ACK) != 0) {
            return;
        }
        Http2SettingsList list #= Http2Frames.parseSettings(payload, 0, len, flags, sid);
        this.remote.apply(list);
        this.flow.setPeerMaxFrame((int32) this.remote.maxFrameSize);
        this.sendSettingsAck();
    }

    void onHeaders(int32 flags, int32 sid, int8[] payload, int32 len) {
        boolean endStream = (flags & Http2.FLAG_END_STREAM) != 0;
        boolean endHeaders = (flags & Http2.FLAG_END_HEADERS) != 0;
        this.streams.openIfAbsent(sid);
        if (!this.streams.ignoring(sid)) {
            this.gate.openStream(sid, (int32) this.remote.initialWindowSize);
        }
        this.streams.recvHeaders(sid, endStream);
        int64 reg = Http2ContentFrames.headersRegion(payload, len, flags, sid);
        int32 off = (int32) (reg >> 32);
        int32 blen = (int32) (reg & (int64) 0xFFFFFFFF);
        if (endHeaders) {
            this.completeRequest(sid, payload, off, blen, endStream);
        } else {
            this.assembler.begin(sid, payload, off, blen);
            this.hdrEndStream = endStream;
        }
    }

    void onContinuation(int32 flags, int32 sid, int8[] payload, int32 len) {
        boolean endHeaders = (flags & Http2.FLAG_END_HEADERS) != 0;
        this.assembler.continueOn(sid, payload, 0, len);
        if (endHeaders) {
            int32 n = this.assembler.finish();
            this.completeRequest(sid, this.assembler.buffer(), 0, n, this.hdrEndStream);
        }
    }

    void completeRequest(int32 sid, int8[] block, int32 off, int32 blockLen, boolean endStream) {
        int32 n = this.hdec.decodeInto(block, off, blockLen);
        // A second HEADERS on a stream that already has its request is the
        // trailers (the stream machine refused one without END_STREAM): they
        // end the body (spec §2.4.1); their fields are not exposed (§7.1).
        Http2StreamSlot tos = this.openSlot(sid);
        if (tos != null && tos.partMode) {
            tos.feedParts(block, 0, 0, true);
            tos.bodyEnded = true;
            this.offerParts(tos);
            return;
        }
        if (tos != null) {
            this.finishOpenBody(tos);
            return;
        }
        int32 di = this.drainingIndex(sid);
        if (di >= 0) {
            this.endDrain(di, false);
            return;
        }
        if (this.cur != null && this.cur.sid == sid) {
            Http2StreamSlot held #= this.cur;
            this.cur = null;
            held.endBody();
            this.ready = #held;
            return;
        }
        if (this.streams.ignoring(sid)) {
            return;
        }
        if (this.slots.outstanding() >= (int32) this.local.maxConcurrentStreams) {
            this.gate.closeStream(sid);
            this.sendRst(sid, Http2.REFUSED_STREAM);
            return;
        }
        Http2StreamSlot s #= this.takeSlot();
        try {
            s.gate #= this.gate;
            s.begin(sid, this.hdec, n);
        } catch (Exception e) {
            this.giveSlot(#s);
            throw e;
        }
        if (endStream) {
            s.endBody();
            this.ready = #s;
        } else if (this.wantsParts(s.req) && s.beginParts(this.maxPartBytes)) {
            // A PART route (spec §2.7): the framer feeds the parser and the
            // stream flows like a held one; its memory is bounded by
            // maxPartBytes, not a slab. Units follow per completed part.
            this.grantStream(sid, Http2Connection.RECV_WINDOW - Http2.DEFAULT_INITIAL_WINDOW_SIZE);
            this.trackOpen(s);
            this.partSlots.add(#s);
        } else if (this.wantsOpen(s.req)) {
            // Head complete is the hold point (spec §2.1): the slot opens over
            // one more slab, its window becomes that slab, and the connection
            // keeps the title while a borrow rides to the pool.
            s.openBody(this.bufs, s.req.contentLength());
            this.grantStream(sid, s.bodyWindow() - Http2.DEFAULT_INITIAL_WINDOW_SIZE);
            this.trackOpen(s);
            this.ready = #s;
        } else {
            // Held whole: the stream may take the connection's receive window.
            this.grantStream(sid, Http2Connection.RECV_WINDOW - Http2.DEFAULT_INITIAL_WINDOW_SIZE);
            if (this.cur != null) {
                Http2StreamSlot old #= this.cur;
                this.giveSlot(#old);
            }
            this.cur = #s;
        }
    }

    // Charges `len` received bytes to the connection window and returns credit in half-window steps.
    void replenishConn(int32 len) {
        this.flow.connRecv.consume(len);
        if (this.flow.connRecv.available() < 0) {
            throw heap Http2Exception("peer exceeded the connection receive window", Http2.FLOW_CONTROL_ERROR);
        }
        this.pendConnRecv = this.pendConnRecv + len;
        if (this.pendConnRecv >= Http2Connection.WINDOW_REPLENISH) {
            Http2FrameWriter fw = heap Http2FrameWriter();
            Http2Frames.writeWindowUpdate(fw, 0, this.pendConnRecv);
            this.control(fw);
            this.flow.connRecv.increase(this.pendConnRecv, 0);
            this.pendConnRecv = 0;
        }
    }

    void replenish(int32 sid, int32 len, boolean endStream) {
        this.replenishConn(len);
        if (this.pendStreamId != sid) {
            this.pendStreamId = sid;
            this.pendStreamRecv = 0;
        }
        if (endStream) {
            this.pendStreamRecv = 0;
            return;
        }
        this.pendStreamRecv = this.pendStreamRecv + len;
        if (this.pendStreamRecv >= Http2Connection.WINDOW_REPLENISH) {
            Http2FrameWriter sw = heap Http2FrameWriter();
            Http2Frames.writeWindowUpdate(sw, sid, this.pendStreamRecv);
            this.control(sw);
            this.pendStreamRecv = 0;
        }
    }

    void onData(int32 flags, int32 sid, int8[] payload, int32 len) {
        boolean endStream = (flags & Http2.FLAG_END_STREAM) != 0;
        if (!this.streams.has(sid)) {
            if (this.streams.wasClosed(sid)) {
                throw heap Http2Exception("DATA on closed stream", Http2.STREAM_CLOSED);
            }
            throw heap Http2Exception("DATA on unknown stream", Http2.PROTOCOL_ERROR);
        }
        this.streams.recvData(sid, endStream);
        if (this.streams.ignoring(sid)) {
            this.replenishConn(len);
            return;
        }
        int64 reg = Http2ContentFrames.dataRegion(payload, len, flags, sid);
        int32 dOff = (int32) (reg >> 32);
        int32 dLen = (int32) (reg & (int64) 0xFFFFFFFF);
        Http2StreamSlot os = this.openSlot(sid);
        if (os != null && os.partMode) {
            this.replenish(sid, len, endStream);
            os.feedParts(payload, dOff, dLen, endStream);
            if (endStream) {
                os.bodyEnded = true;
            }
            this.offerParts(os);
            return;
        }
        if (os != null) {
            // An open stream: connection credit returns on receipt as for any
            // stream; stream credit returns as the handler consumes (spec §2.3),
            // and `maxBodyBytes` does not bound what the handler reads (§2.6).
            this.replenishConn(len);
            if (os.expectedBody >= (int64) 0 && os.bodyReceived() + (int64) dLen > os.expectedBody) {
                os.failOpenBody("request body longer than its content-length");
                this.sendRst(sid, Http2.PROTOCOL_ERROR);
                return;
            }
            if (!os.feedBody(payload, dOff, dLen)) {
                throw heap Http2Exception("DATA past the stream's window", Http2.FLOW_CONTROL_ERROR, sid);
            }
            if (endStream) {
                this.finishOpenBody(os);
            }
            return;
        }
        int32 di = this.drainingIndex(sid);
        if (di >= 0) {
            // Answered already: the bytes are discarded, credited so the peer
            // can finish a small remainder, and cut past the limit (spec §2.5).
            this.replenishConn(len);
            Http2StreamSlot ds = this.draining.get(di);
            ds.drainLeft = ds.drainLeft - (int64) dLen;
            if (endStream) {
                this.endDrain(di, false);
            } else if (ds.drainLeft <= (int64) 0) {
                this.endDrain(di, true);
            }
            return;
        }
        int32 have = this.cur != null && this.cur.sid == sid ? this.cur.bodyLen : 0;
        if (this.maxBody > 0 && (int64) have + (int64) dLen > this.maxBody) {
            throw heap Http2Exception("request body exceeds maxBodyBytes (" + this.maxBody + ")",
                                      Http2.ENHANCE_YOUR_CALM);
        }
        this.replenish(sid, len, endStream);
        if (this.cur == null || this.cur.sid != sid) {
            return;
        }
        this.cur.append(payload, dOff, dLen);
        if (endStream) {
            Http2StreamSlot s #= this.cur;
            this.cur = null;
            s.endBody();
            this.ready = #s;
        }
    }

    void onWindowUpdate(int32 sid, int8[] payload, int32 len) {
        int32 inc = Http2Frames.parseWindowUpdate(payload, 0, len, sid);
        if (sid == 0) {
            this.flow.connSend.increase(inc, 0);
            this.gate.grantConn(inc);
        } else {
            this.gate.grantStream(sid, inc);
        }
    }

    void onRstStream(int32 sid, int8[] payload, int32 len) {
        int64 code = Http2Frames.parseRstStream(payload, 0, len, sid);
        if (this.streams.has(sid)) {
            this.streams.recvRst(sid);
        }
        this.gate.cancel(sid);
        Http2StreamSlot os = this.openSlot(sid);
        if (os != null && os.partMode) {
            os.bodyEnded = true;
            int32 pi = this.partSlotIndex(sid);
            if (pi >= 0) {
                // Idle between units: gone now. On a worker: freed on its return.
                this.untrackOpen(sid);
                Http2StreamSlot t #= this.partSlots.removeAt(pi);
                t.endParts();
                this.giveSlot(#t);
            } else {
                os.partFailStatus = -1;
            }
        } else if (os != null && !os.bodyEnded) {
            os.failOpenBody("stream reset by the peer");
        }
        int32 di = this.drainingIndex(sid);
        if (di >= 0) {
            Http2StreamSlot t #= this.draining.removeAt(di);
            this.giveSlot(#t);
        }
        if (this.cur != null && this.cur.sid == sid) {
            Http2StreamSlot s #= this.cur;
            this.cur = null;
            this.giveSlot(#s);
        }
    }

    void onPing(int32 flags, int32 sid, int8[] payload, int32 len) {
        Http2Frames.validatePing(len, sid);
        if ((flags & Http2.FLAG_ACK) == 0) {
            Http2FrameWriter fw = heap Http2FrameWriter();
            Http2Frames.writePing(fw, payload, true);
            this.control(fw);
        }
    }

    /** Runs the handler for one complete request, then answers it and returns the slot. */
    public static async int32 handleStream(Http2Connection c, #Http2StreamSlot slot, int32 maxFrame,
                                           boolean pushEnabled, int32 initWin) {
        Http2StreamSlot s #= slot;
        int32 sid = s.sid;
        Http2Connection.answer(c, s, maxFrame, pushEnabled, initWin);
        c.giveSlot(#s);
        return sid;
    }

    /** Runs the handler on the slot's request, writes the response and any pushes, and closes the stream's send side. */
    static void answer(Http2Connection c, Http2StreamSlot s, int32 maxFrame,
                       boolean pushEnabled, int32 initWin) {
        s.maxFrame = maxFrame;
        HttpResponse r = s.res;
        r.reset();
        Http2Connection.callHandler(c, s);
        int32 sid = s.sid;
        if (pushEnabled && r.pushCount() > 0 && !r.isCommitted()) {
            String authority #= Http2Connection.authorityOf(s.req);
            int32 pi = 0;
            while (pi < r.pushCount()) {
                PushEntry p = r.pushAt(pi);
                int32 promId = c.ws.nextPromisedId();
                HpackFieldList prom #= Http2Requests.promisedRequestFields(p.path, authority);
                c.ws.writePushPromise(sid, promId, prom);
                c.gate.openStream(promId, initWin);
                HpackFieldList pf #= Http2Requests.statusOnlyFields(p.status);
                boolean pHasBody = p.bodyLen > 0;
                c.ws.writeHeaders(promId, pf, !pHasBody);
                if (pHasBody) {
                    Http2Connection.streamBody(c.ws, c.gate, promId, p.body, p.bodyLen, maxFrame);
                }
                c.gate.closeStream(promId);
                pi = pi + 1;
            }
        }
        try {
            r.finishStream();
        } catch (Exception e) {
        }
        c.gate.closeStream(sid);
    }

    /** The handler over the slot's request and response, errors mapped to a status unless the response is committed. */
    static void callHandler(Http2Connection c, Http2StreamSlot s) {
        HttpResponse r = s.res;
        (HttpRequest, HttpResponse) -> void fn = c.handler;
        try {
            fn(s.req, r);
        } catch (HttpException e) {
            if (!r.isCommitted()) {
                r.reset();
                r.status(e.httpStatus());
            }
        } catch (Exception e) {
            if (!r.isCommitted()) {
                r.reset();
                r.status(500);
            }
        }
    }

    /**
     * One unit of a PART stream: the handler runs with the part bound (the
     * response is reset only before the first); after the last part, or for
     * the parser's refusal, the response goes out and the stream's send side
     * closes.
     */
    static void answerPart(Http2Connection c, Http2StreamSlot s, int32 maxFrame) {
        s.maxFrame = maxFrame;
        HttpResponse r = s.res;
        if (s.partIndex == -2) {
            r.reset();
            r.status(s.partFailStatus > 0 ? s.partFailStatus : 400);
        } else {
            if (s.partIndex <= 0) {
                r.reset();
            }
            s.req.bindPart(s.partIndex >= 0 ? s.mp.part(s.partIndex) : null,
                           s.partIndex < 0 ? 0 : s.partIndex, s.partLast);
            Http2Connection.callHandler(c, s);
        }
        if (s.partLast || s.partIndex == -2) {
            try {
                r.finishStream();
            } catch (Exception e) {
            }
            c.gate.closeStream(s.sid);
        }
    }

    static void streamBody(Http2WriteSide ws, Http2SendGate gate, int32 streamId,
                           int8[] body, int32 total, int32 maxFrame) {
        int32 off = 0;
        while (off < total) {
            int64 want = (int64) (total - off);
            if (want > (int64) maxFrame) {
                want = (int64) maxFrame;
            }
            int64 g = gate.takeUpTo(streamId, want);
            if (g <= (int64) 0) {
                off = total;
            } else {
                int32 gi = (int32) g;
                boolean last = (off + gi) >= total;
                ws.writeData(streamId, body, off, gi, last);
                off = off + gi;
            }
        }
    }

    static #String authorityOf(HttpRequest r) {
        String h #= r.headerString("host");
        if (h == null) {
            String d = "127.0.0.1";
            return d.substring(0, d.byteLength());
        }
        return #h;
    }

    void sendOurSettings() {
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2SettingsList l #= this.local.toList();
        Http2Frames.writeSettings(fw, l);
        Http2Frames.writeWindowUpdate(fw, 0, Http2Connection.RECV_WINDOW - Http2.DEFAULT_INITIAL_WINDOW_SIZE);
        this.control(fw);
    }

    void sendSettingsAck() {
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeSettingsAck(fw);
        this.control(fw);
    }

    void sendGoaway(int32 errorCode) {
        Http2FrameWriter fw = heap Http2FrameWriter();
        int8[] none = heap int8[0];
        Http2Frames.writeGoaway(fw, this.streams.lastRemoteId(), (int64) errorCode, none, 0);
        this.control(fw);
    }

    void sendRst(int32 sid, int32 errorCode) {
        if (sid != 0 && this.streams.has(sid)) {
            this.streams.sendRst(sid);
        }
        if (this.cur != null && this.cur.sid == sid) {
            Http2StreamSlot s #= this.cur;
            this.cur = null;
            this.giveSlot(#s);
        }
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeRstStream(fw, sid, (int64) errorCode);
        this.control(fw);
    }

    boolean readFully(int8[] buf, int32 n) {
        int32 off = 0;
        while (off < n) {
            int32 g = this.reader.read(buf, off, n - off);
            if (g == 0) {
                if (off == 0) {
                    return false;
                }
                throw heap Http2Exception("truncated frame at EOF", Http2.PROTOCOL_ERROR);
            }
            off = off + g;
        }
        return true;
    }

    static #int8[] slice(int8[] src, int32 off, int32 len) {
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = src[off + i];
            i = i + 1;
        }
        return #out;
    }
}
