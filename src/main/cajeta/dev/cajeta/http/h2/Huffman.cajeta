package dev.cajeta.http.h2;

import cajeta.lang.String;

/**
 * The **HPACK Huffman code** (RFC 7541 Appendix B) — plan item **3.1**. A
 * static canonical prefix code over the 256 octet values plus an `EOS`
 * terminator (symbol 256), derived from the frequency of octets in real HTTP
 * headers. String literals may be sent Huffman-coded (§5.2) when that is
 * shorter than the raw octets.
 *
 * The `code`/`len` tables below are the RFC's verbatim (validated against the
 * Appendix B invariants: 257 entries, Kraft equality, prefix-free, max length
 * 30). Because the code is **canonical in symbol order**, the decode
 * acceleration tables (`blCount`/`firstCode`/`firstSym`/`symSorted`) are
 * derived from `len` alone at construction — the standard canonical-Huffman
 * decode setup — so the code table is the single source of truth.
 *
 * Decoding walks the input bit-by-bit against those tables; per §5.2 an `EOS`
 * symbol appearing in the stream, padding longer than 7 bits, or trailing
 * bits that are not the most-significant bits of `EOS` (all ones) are all
 * decoding errors.
 */
public final class Huffman {
    int64[] codes;      // codes[sym], sym 0..256 (256 = EOS)
    int32[] lens;       // bit length of each symbol's code
    int32   maxLen;

    int32[] blCount;    // [0..maxLen] symbols of each code length
    int64[] firstCode;  // [0..maxLen] first canonical code of each length
    int32[] firstSym;   // [0..maxLen] offset into symSorted where length begins
    int32[] symSorted;  // symbols grouped by (length asc, symbol asc)

    public Huffman() {
