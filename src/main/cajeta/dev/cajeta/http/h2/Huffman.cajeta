    void buildDecodeTables() {
        int32 maxL = this.maxLen;
        int32[] bl = heap int32[maxL + 1];
        int32 s = 0;
        while (s < 257) {
            int32 ln = this.lens[s];
            bl[ln] = bl[ln] + 1;
            s = s + 1;
        }
        int64[] fc = heap int64[maxL + 1];
        int32[] fs = heap int32[maxL + 1];
        int32[] sorted = heap int32[257];
        int64 code = 0;
        int32 k = 0;
        int32 L = 1;
        while (L <= maxL) {
            fc[L] = code;
            fs[L] = k;
            int32 sym = 0;
            while (sym < 257) {
                if (this.lens[sym] == L) {
                    sorted[k] = sym;
                    k = k + 1;
                }
                sym = sym + 1;
            }
            code = (code + (int64) bl[L]) << (int64) 1;
            L = L + 1;
        }
        this.blCount = #bl;
        this.firstCode = #fc;
        this.firstSym = #fs;
        this.symSorted = #sorted;
    }

    /** The number of octets `data[0..len)` would occupy Huffman-coded. */
    public int32 encodedLength(int8[] data, int32 len) {
        int64 bits = 0;
        int32 i = 0;
        while (i < len) {
            bits = bits + (int64) this.lens[((int32) data[i]) & 0xFF];
            i = i + 1;
        }
        return (int32) ((bits + (int64) 7) / (int64) 8);
    }

    /** Huffman-encode `data[0..len)`, padding the final octet with EOS bits. */
    public #int8[] encode(int8[] data, int32 len) {
        HpackWriter w = heap HpackWriter();
        int64 acc = 0;
        int32 nbits = 0;
        int32 i = 0;
        while (i < len) {
            int32 sym = ((int32) data[i]) & 0xFF;
            int64 code = this.codes[sym];
            int32 clen = this.lens[sym];
            acc = (acc << (int64) clen) | code;
            nbits = nbits + clen;
            while (nbits >= 8) {
                nbits = nbits - 8;
                w.writeByte((int32) ((acc >> (int64) nbits) & (int64) 0xFF));
            }
            acc = acc & (((int64) 1 << (int64) nbits) - (int64) 1);
            i = i + 1;
        }
        if (nbits > 0) {
            int32 pad = 8 - nbits;
            int64 padded = (acc << (int64) pad)
                | (((int64) 1 << (int64) pad) - (int64) 1);
            w.writeByte((int32) (padded & (int64) 0xFF));
        }
        return w.toBytes();
    }

    /** Decode Huffman-coded `data[0..len)` back to its octet string. */
    public #String decode(int8[] data, int32 len) {
        HpackWriter w = heap HpackWriter();
        int64 cur = 0;
        int32 curlen = 0;
        int32 i = 0;
        while (i < len) {
            int32 b = ((int32) data[i]) & 0xFF;
            int32 bit = 7;
            while (bit >= 0) {
                int32 v = (b >> bit) & 1;
                cur = (cur << (int64) 1) | (int64) v;
                curlen = curlen + 1;
                if (curlen > this.maxLen) {
                    throw heap HpackException("invalid Huffman code");
                }
                if (this.blCount[curlen] > 0) {
                    int64 idx = cur - this.firstCode[curlen];
                    if (idx >= (int64) 0 && idx < (int64) this.blCount[curlen]) {
                        int32 sym =
                            this.symSorted[this.firstSym[curlen] + (int32) idx];
                        if (sym == 256) {
                            throw heap HpackException("EOS symbol in Huffman stream");
                        }
                        w.writeByte(sym);
                        cur = 0;
                        curlen = 0;
                    }
                }
                bit = bit - 1;
            }
            i = i + 1;
        }
        if (curlen > 7) {
            throw heap HpackException("Huffman padding too long");
        }
        if (curlen > 0) {
            int64 allOnes = ((int64) 1 << (int64) curlen) - (int64) 1;
            if (cur != allOnes) {
                throw heap HpackException("invalid Huffman padding");
            }
        }
        return w.toStringValue();
    }
}
