package dev.cajeta.http.h2;

import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.tls.TlsException;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;

/**
 * A minimal **HTTP/2 client exchange** (plan item **3.4**) — the mirror of
 * [`Http2Connection`](Http2Connection.cajeta) on the client side. Given an
 * already-connected reader/writer (a plaintext socket, or a TLS stream that
 * negotiated `h2` via ALPN) it runs one request/response on stream 1: send the
 * client preface + SETTINGS, encode the [`HttpRequest`](../HttpRequest.cajeta)
 * as HEADERS(+DATA), then read frames until the response stream ends and return
 * the assembled [`HttpResponse`](../HttpResponse.cajeta).
 *
 * v1 scope is one request per connection (what `HttpClient.send` needs); it acks
 * the server SETTINGS, honours END_STREAM on HEADERS or DATA, and leaves the
 * socket for the caller to close. Response bodies larger than the default
 * receive window are fine (the default 64 KiB window is not decremented back to
 * the peer here — a single-exchange client never needs to), and trailers are not
 * surfaced.
 */
public final class Http2Client {

    /** Run one h2 request/response over `reader`/`writer`; returns the response. */
    public static #HttpResponse exchange(AsyncReader reader, AsyncWriter writer,
                                         HttpRequest req, String scheme,
                                         String authority) {
        // -- send: preface + SETTINGS + request HEADERS(+DATA) ---------------
        int8[] pf #= Http2.preface();
        writer.writeAll(pf, 0, 24);

        Http2FrameWriter fw = heap Http2FrameWriter();
        // Disable server push by default (RFC 9113 §8.4); this single-exchange
        // client does not surface pushes, so a promise is a protocol violation.
        Http2SettingsList st = heap Http2SettingsList();
        st.add(Http2.SETTINGS_ENABLE_PUSH, (int64) 0);
        st.add(Http2.SETTINGS_INITIAL_WINDOW_SIZE,
               (int64) Http2Client.RECV_WINDOW);
        Http2Frames.writeSettings(fw, st);
        // SETTINGS sizes streams only. The connection window moves by
        // WINDOW_UPDATE alone (RFC 9113 6.9.2).
        Http2Frames.writeWindowUpdate(fw, 0,
                Http2Client.RECV_WINDOW - Http2.DEFAULT_INITIAL_WINDOW_SIZE);

        HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
        HpackFieldList fl #= Http2Requests.requestFields(req, scheme, authority);
        int8[] block #= enc.encode(fl);
        boolean hasBody = req.hasBody && req.bodyLength() > 0;
        Http2ContentFrames.writeHeaders(fw, 1, block, (int32) block.count(),
                                        !hasBody, true, 0);
        if (hasBody) {
            Http2ContentFrames.writeData(fw, 1, req.body, req.bodyLength(),
                                         true, 0);
        }
        int8[] out #= fw.toBytes();
        writer.writeAll(out, 0, (int32) out.count());
        writer.flush();

        // -- receive: frames until stream 1 ends -----------------------------
        HpackDecoder dec = heap HpackDecoder(Http2.DEFAULT_HEADER_TABLE_SIZE);
        int32 status = -1;
        int8[] body = heap int8[256];
        int32 bodyLen = 0;
        int32 bodyCap = 256;
        boolean sawHeaders = false;
        HpackFieldList respFields = null;
        boolean done = false;
        // Receive-window octets consumed since the last WINDOW_UPDATE, held
        // separately for the connection and the stream because §6.9 charges
        // every DATA frame against both.
        int32 pendConn = 0;
        int32 pendStream = 0;

        try {
        while (!done) {
            int8[] hdr = heap int8[9];
            if (!Http2Client.readFully(reader, hdr, 9)) {
                done = true;
            } else {
                Http2FrameHeader h #= Http2FrameHeader(hdr);
                int32 type = h.typeCode();
                int32 flags = h.flags();
                int32 len = h.length();
                int8[] pl = heap int8[len];
                if (len > 0) {
                    reader.readExact(pl, 0, len);
                }
                int32 sid = h.streamId();
                if (type == Http2.FRAME_SETTINGS) {
                    if ((flags & Http2.FLAG_ACK) == 0) {
                        Http2Client.sendSettingsAck(writer);
                    }
                } else if (type == Http2.FRAME_HEADERS) {
                    Http2Payload reg #= Http2ContentFrames.parseHeaders(pl, len,
                                                                      flags, sid);
                    int8[] blk #= Http2Client.slice(pl, reg.offset, reg.length);
                    respFields #= dec.decode(blk, reg.length);
                    sawHeaders = true;
                    if ((flags & Http2.FLAG_END_STREAM) != 0) {
                        done = true;
                    }
                } else if (type == Http2.FRAME_DATA) {
                    Http2Payload reg #= Http2ContentFrames.parseData(pl, len,
                                                                   flags, sid);
                    if (bodyLen + reg.length > bodyCap) {
                        int32 nc = bodyCap;
                        while (nc < bodyLen + reg.length) {
                            nc = nc * 2;
                        }
                        int8[] nb = heap int8[nc];
                        Http2.blit(nb, 0, body, 0, (int64) bodyLen);
                        body = #nb;
                        bodyCap = nc;
                    }
                    Http2.blit(body, (int64) bodyLen, pl,
                                     (int64) reg.offset, (int64) reg.length);
                    bodyLen = bodyLen + reg.length;
                    // §6.9.1 charges the WHOLE frame length, padding
                    // included, not just the octets we kept.
                    boolean last = (flags & Http2.FLAG_END_STREAM) != 0;
                    pendConn = pendConn + len;
                    pendStream = pendStream + len;
                    if (pendConn >= Http2Client.WINDOW_REPLENISH) {
                        Http2Client.sendWindowUpdate(writer, 0, pendConn);
                        pendConn = 0;
                    }
                    // Nothing more will arrive on a stream that just ended, so
                    // crediting it back would be a frame the peer discards.
                    if (!last && pendStream >= Http2Client.WINDOW_REPLENISH) {
                        Http2Client.sendWindowUpdate(writer, sid, pendStream);
                        pendStream = 0;
                    }
                    if (last) {
                        done = true;
                    }
                } else if (type == Http2.FRAME_PUSH_PROMISE) {
                    // We advertised SETTINGS_ENABLE_PUSH = 0; a PUSH_PROMISE is
                    // a connection error (RFC 9113 §8.4 / §6.6).
                    throw heap Http2Exception(
                        "PUSH_PROMISE received with push disabled",
                        Http2.PROTOCOL_ERROR);
                } else if (type == Http2.FRAME_GOAWAY) {
                    done = true;
                }
            }
        }
        } catch (TlsException e) {
            // A TLS teardown race (peer reset instead of a clean close_notify).
            // If the full response already arrived, use it; otherwise it is a
            // real failure.
            if (!sawHeaders) {
                throw #e;
            }
        }

        if (!sawHeaders) {
            throw heap Http2Exception("no response HEADERS received",
                                      Http2.PROTOCOL_ERROR);
        }
        HttpResponse resp #= Http2Requests.responseFromFields(respFields);
        if (bodyLen > 0) {
            resp.body(body, bodyLen);
        }
        return #resp;
    }

    /**
     * The receive window this client advertises, connection and stream alike.
     * The 65535 default caps a transfer at one window per round trip.
     */
    static final int32 RECV_WINDOW = 8388608;

    /** Hand back consumed octets once half the advertised window is spent. */
    static final int32 WINDOW_REPLENISH = 4194304;

    /**
     * Give the peer back `inc` octets of receive window (RFC 9113 §6.9).
     * `streamId` 0 is the connection-level window.
     *
     * Without this a response larger than the initial window stops dead: the
     * peer spends its credit, stops sending because it correctly has none
     * left, and both ends sit idle forever. Measured against a 351 MB GitHub
     * release asset, which stopped after one 65535-octet window.
     */
    static void sendWindowUpdate(AsyncWriter writer, int32 streamId,
                                 int32 inc) {
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeWindowUpdate(fw, streamId, inc);
        int8[] b #= fw.toBytes();
        writer.writeAll(b, 0, (int32) b.count());
        writer.flush();
    }

    static void sendSettingsAck(AsyncWriter writer) {
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeSettingsAck(fw);
        int8[] b #= fw.toBytes();
        writer.writeAll(b, 0, (int32) b.count());
        writer.flush();
    }

    // A generous per-read deadline so a stalled or half-open peer surfaces as
    // a clean error rather than an unbounded block. TLS honours it too.
    static final int32 READ_TIMEOUT_MS = 15000;

    static boolean readFully(AsyncReader reader, int8[] buf, int32 n) {
        int32 off = 0;
        while (off < n) {
            int32 g = reader.readWithin(buf, off, n - off,
                                        Http2Client.READ_TIMEOUT_MS);
            if (g <= 0) {
                if (off == 0) {
                    return false;
                }
                throw heap Http2Exception("truncated frame at EOF",
                                          Http2.PROTOCOL_ERROR);
            }
            off = off + g;
        }
        return true;
    }

    static #int8[] slice(int8[] src, int32 off, int32 len) {
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = src[off + i];
            i = i + 1;
        }
        return #out;
    }
}
