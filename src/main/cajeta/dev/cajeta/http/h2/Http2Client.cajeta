package dev.cajeta.http.h2;

import cajeta.lang.String;
import cajeta.lang.Slice;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.AsyncWriter;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.tls.TlsException;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientRequest;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HeadScanner;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.server.ConnectionBuffers;

/**
 * One HTTP/2 exchange on a fresh connection: the preface and settings, the
 * request on stream 1, and the response read into a pooled buffer that the
 * `ClientResponse` takes over, so the response is the same view HTTP/1.1
 * gives. Push is disabled.
 */
public final class Http2Client {
    static final int32 RECV_WINDOW = 8388608;
    static final int32 WINDOW_REPLENISH = 4194304;
    static final int32 READ_TIMEOUT_MS = 15000;

    /** Sends `req` over `reader` and `writer` and fills `resp` with the answer. */
    public static void exchange(AsyncReader reader, AsyncWriter writer, ClientRequest req,
                                ClientResponse resp, String scheme, String authority,
                                ConnectionBuffers bufs) {
        int8[] pf #= Http2.preface();
        writer.writeAll(pf, 0, 24);
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2SettingsList st = heap Http2SettingsList();
        st.add(Http2.SETTINGS_ENABLE_PUSH, (int64) 0);
        st.add(Http2.SETTINGS_INITIAL_WINDOW_SIZE, (int64) Http2Client.RECV_WINDOW);
        Http2Frames.writeSettings(fw, st);
        Http2Frames.writeWindowUpdate(fw, 0, Http2Client.RECV_WINDOW - Http2.DEFAULT_INITIAL_WINDOW_SIZE);
        HpackEncoder enc = heap HpackEncoder(Http2.DEFAULT_HEADER_TABLE_SIZE, true);
        HpackFieldList fl #= Http2Requests.requestFields(req, scheme, authority);
        int8[] block #= enc.encode(fl);
        boolean hasBody = req.bodyLength() > 0;
        Http2ContentFrames.writeHeaders(fw, 1, block, (int32) block.count(), !hasBody, true, 0);
        if (hasBody) {
            int8[] body #= Bytes.copyOf(req.body());
            Http2ContentFrames.writeData(fw, 1, body, req.bodyLength(), true, 0);
        }
        int8[] out #= fw.toBytes();
        writer.writeAll(out, 0, (int32) out.count());
        writer.flush();

        HpackDecoder dec = heap HpackDecoder(Http2.DEFAULT_HEADER_TABLE_SIZE);
        ByteBuffer buf #= bufs.take();
        int32 headLen = -1;
        int32 bodyLen = 0;
        int8[] big = null;
        boolean done = false;
        int32 pendConn = 0;
        int32 pendStream = 0;
        try {
            while (!done) {
                int8[] hdr = heap int8[9];
                if (!Http2Client.readFully(reader, hdr, 9)) {
                    done = true;
                } else {
                    Http2FrameHeader h #= Http2FrameHeader(hdr);
                    int32 type = h.typeCode();
                    int32 flags = h.flags();
                    int32 len = h.length();
                    int8[] pl = heap int8[len];
                    if (len > 0) {
                        reader.readExact(pl, 0, len);
                    }
                    int32 sid = h.streamId();
                    if (type == Http2.FRAME_SETTINGS) {
                        if ((flags & Http2.FLAG_ACK) == 0) {
                            Http2Client.sendSettingsAck(writer);
                        }
                    } else if (type == Http2.FRAME_HEADERS) {
                        Http2Payload reg #= Http2ContentFrames.parseHeaders(pl, len, flags, sid);
                        int8[] blk #= Http2Client.slice(pl, reg.offset, reg.length);
                        int32 n = dec.decodeInto(blk, reg.length);
                        if (headLen < 0) {
                            headLen = Http2Client.writeHead(dec, n, buf);
                        }
                        if ((flags & Http2.FLAG_END_STREAM) != 0) {
                            done = true;
                        }
                    } else if (type == Http2.FRAME_DATA) {
                        Http2Payload reg #= Http2ContentFrames.parseData(pl, len, flags, sid);
                        if (headLen >= 0) {
                            if (big == null && headLen + bodyLen + reg.length <= buf.capacity()) {
                                Http2.blit(buf.array(), (int64) (headLen + bodyLen), pl, (int64) reg.offset, (int64) reg.length);
                            } else {
                                if (big == null) {
                                    big = heap int8[(bodyLen + reg.length) * 2];
                                    Http2.blit(big, 0, buf.array(), (int64) headLen, (int64) bodyLen);
                                } else if (bodyLen + reg.length > big.count()) {
                                    int32 nc = big.count() * 2;
                                    while (nc < bodyLen + reg.length) {
                                        nc = nc * 2;
                                    }
                                    int8[] nb = heap int8[nc];
                                    Http2.blit(nb, 0, big, 0, (int64) bodyLen);
                                    big #= nb;
                                }
                                Http2.blit(big, (int64) bodyLen, pl, (int64) reg.offset, (int64) reg.length);
                            }
                            bodyLen = bodyLen + reg.length;
                        }
                        boolean last = (flags & Http2.FLAG_END_STREAM) != 0;
                        pendConn = pendConn + len;
                        pendStream = pendStream + len;
                        if (pendConn >= Http2Client.WINDOW_REPLENISH) {
                            Http2Client.sendWindowUpdate(writer, 0, pendConn);
                            pendConn = 0;
                        }
                        if (!last && pendStream >= Http2Client.WINDOW_REPLENISH) {
                            Http2Client.sendWindowUpdate(writer, sid, pendStream);
                            pendStream = 0;
                        }
                        if (last) {
                            done = true;
                        }
                    } else if (type == Http2.FRAME_PUSH_PROMISE) {
                        throw heap Http2Exception("PUSH_PROMISE received with push disabled",
                                                  Http2.PROTOCOL_ERROR);
                    } else if (type == Http2.FRAME_GOAWAY) {
                        done = true;
                    }
                }
            }
        } catch (TlsException e) {
            if (headLen < 0) {
                bufs.give(#buf);
                throw #e;
            }
        } catch (Exception e) {
            bufs.give(#buf);
            throw e;
        }
        if (headLen < 0) {
            bufs.give(#buf);
            throw heap Http2Exception("no response HEADERS received", Http2.PROTOCOL_ERROR);
        }
        try {
            HeadScanner.parseResponse(buf.array(), 0, headLen, resp);
        } catch (Exception e) {
            bufs.give(#buf);
            throw e;
        }
        if (big != null) {
            resp.replaceBody(#big, bodyLen);
        } else {
            resp.bindBody(headLen, bodyLen);
        }
        resp.adopt(#buf);
    }

    static int32 put(ByteBuffer b, int32 at, Slice<int8> s) {
        int64 n = s.count();
        if ((int64) at + n + 4 > (int64) b.capacity()) {
            throw heap Http2Exception("response head exceeds the buffer", Http2.PROTOCOL_ERROR);
        }
        int8[] a = b.array();
        int64 i = 0;
        while (i < n) {
            a[at + (int32) i] = s[i];
            i = i + 1;
        }
        return at + (int32) n;
    }

    static int32 writeHead(HpackDecoder dec, int32 n, ByteBuffer buf) {
        int32 status = -1;
        int32 i = 0;
        while (i < n) {
            if (Bytes.equals(dec.fieldName(i), ":status")) {
                status = i;
            }
            i = i + 1;
        }
        if (status < 0) {
            throw heap Http2Exception("response HEADERS without :status", Http2.PROTOCOL_ERROR);
        }
        buf.clear();
        int8[] a = buf.array();
        int32 p = HttpResponse.put(a, 0, "HTTP/2 ");
        p = Http2Client.put(buf, p, dec.fieldValue(status));
        p = HttpResponse.put(a, p, " \r\n");
        i = 0;
        while (i < n) {
            Slice<int8> name = dec.fieldName(i);
            if (name.count() == 0 || name[0] != (int8) 58) {
                p = Http2Client.put(buf, p, name);
                p = HttpResponse.put(a, p, ": ");
                p = Http2Client.put(buf, p, dec.fieldValue(i));
                p = HttpResponse.put(a, p, "\r\n");
            }
            i = i + 1;
        }
        p = HttpResponse.put(a, p, "\r\n");
        buf.advanceWrite(p);
        return p;
    }

    static void sendWindowUpdate(AsyncWriter writer, int32 streamId, int32 inc) {
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeWindowUpdate(fw, streamId, inc);
        int8[] b #= fw.toBytes();
        writer.writeAll(b, 0, (int32) b.count());
        writer.flush();
    }

    static void sendSettingsAck(AsyncWriter writer) {
        Http2FrameWriter fw = heap Http2FrameWriter();
        Http2Frames.writeSettingsAck(fw);
        int8[] b #= fw.toBytes();
        writer.writeAll(b, 0, (int32) b.count());
        writer.flush();
    }

    static boolean readFully(AsyncReader reader, int8[] buf, int32 n) {
        int32 off = 0;
        while (off < n) {
            int32 g = reader.readWithin(buf, off, n - off, Http2Client.READ_TIMEOUT_MS);
            if (g <= 0) {
                if (off == 0) {
                    return false;
                }
                throw heap Http2Exception("truncated frame at EOF", Http2.PROTOCOL_ERROR);
            }
            off = off + g;
        }
        return true;
    }

    static #int8[] slice(int8[] src, int32 off, int32 len) {
        int8[] out = heap int8[len];
        int32 i = 0;
        while (i < len) {
            out[i] = src[off + i];
            i = i + 1;
        }
        return #out;
    }
}
