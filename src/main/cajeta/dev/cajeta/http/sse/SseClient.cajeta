package dev.cajeta.http.sse;

import cajeta.concurrent.Tasks;
import cajeta.io.net.IpAddress;
import cajeta.io.net.NetException;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.dns.Dns;
import cajeta.io.net.dns.ResolveFamily;
import cajeta.io.net.TcpStream;
import cajeta.io.net.uri.Uri;
import cajeta.lang.String;
import cajeta.io.net.AsyncReader;
import cajeta.io.net.ByteBuffer;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.HeadScanner;
import dev.cajeta.http.h1.BodyFraming;
import dev.cajeta.http.h1.BodyReader;
import dev.cajeta.http.h1.HttpParserLimits;

/**
 * A **Server-Sent Events client** (plan item **4.4c**) — subscribe to a
 * `text/event-stream` endpoint and receive [`SseEvent`](SseEvent.cajeta)s as
 * they arrive, with the WHATWG reconnection behaviour built in:
 *
 *   - [`subscribe`](#subscribe) opens the stream and delivers each event to a
 *     callback; when the stream drops (a normal EOF *or* a transport reset —
 *     SSE streams are meant to be reconnected, not treated as errors) it
 *     **reconnects** after the reconnection delay, replaying the last seen id
 *     as `Last-Event-ID` so the server resumes where it left off.
 *   - the reconnection delay is the server's `retry:` value once seen, else
 *     [`defaultRetryMillis`](#defaultRetryMillis) (WHATWG default 3 s here).
 *   - [`stop`](#stop) ends the loop from another fiber; [`subscribeOnce`](#subscribeOnce)
 *     rides a single connection with no reconnect.
 *   - a non-`200` status or a non-`text/event-stream` content type is a
 *     **terminal** [`SseException`](SseException.cajeta) (not a reconnect).
 *
 * The decode + reconnection **state** lives in an [`SseDecoder`](SseDecoder.cajeta)
 * (last id, retry), so [`requestHead`](#requestHead) /
 * [`checkHead`](#checkHead) / [`reconnectDelayMillis`](#reconnectDelayMillis)
 * are pure and testable without a socket. v1 is **plaintext** (`http`); TLS
 * (`https`) SSE is a follow-up.
 */
public final class SseClient {
    Uri uri;
    String host;
    int32 port;
    SseDecoder decoder;
    int32 defaultRetryMs;
    boolean stopped;

    /** Subscribe to `url` (an `http://…` event-stream endpoint). */
    public SseClient(String url) {
        Uri u #= Uri.parse(url);
        this.uri = #u;
        String h #= this.uri.getHost();
        this.host #= h.substring(0, h.byteLength());
        int32 p = this.uri.getPort();
        if (p <= 0) {
            p = 80;
        }
        this.port = p;
        this.decoder = heap SseDecoder();
        this.defaultRetryMs = 3000;
        this.stopped = false;
    }

    /** Override the fallback reconnection delay (ms) used until a `retry:`. */
    public SseClient defaultRetryMillis(int32 ms) {
        this.defaultRetryMs = ms;
        return this;
    }

    /** Seed `Last-Event-ID` for the first request (resume a prior stream). */
    public SseClient resumeFrom(String lastEventId) {
        this.decoder.seedLastId(lastEventId);
        return this;
    }

    // -- pure policy (socket-free) -----------------------------------------

    /** The GET request head, carrying `Last-Event-ID` once an id has been seen. */
    public #String requestHead() {
        String path = this.uri.getPath();
        String target = "/";
        if (path != null && path.byteLength() > 0) {
            target = path;
        }
        String query = this.uri.getQuery();
        String head = "GET " + target;
        if (query != null && query.byteLength() > 0) {
            head = head + "?" + query;
        }
        head = head + " HTTP/1.1\r\nHost: " + this.host + ":" + this.port
            + "\r\nAccept: text/event-stream\r\nCache-Control: no-cache\r\n";
        String last = this.decoder.lastEventId();
        if (last != null) {
            head = head + "Last-Event-ID: " + last + "\r\n";
        }
        return head + "\r\n";
    }

    /** Throws `SseException` unless `resp` is a 200 `text/event-stream`. */
    public void checkHead(ClientResponse resp) {
        if (resp.status() != 200) {
            throw heap SseException("SSE: non-200 response (" + resp.status() + ")");
        }
        if (!resp.hasHeader("Content-Type")
                || !Bytes.startsWith(resp.header("Content-Type"), "text/event-stream")) {
            throw heap SseException("SSE: response is not text/event-stream");
        }
    }

    /** The current reconnection delay (server `retry:` if seen, else default). */
    public int32 reconnectDelayMillis() {
        int32 r = this.decoder.retryMillis();
        if (r >= 0) {
            return r;
        }
        return this.defaultRetryMs;
    }

    /** The last event id seen (replayed on reconnect), or null. */
    public String lastEventId() {
        return this.decoder.lastEventId();
    }

    /** Ask the [`subscribe`](#subscribe) loop to end after the current pass. */
    public void stop() {
        this.stopped = true;
    }

    /** Whether [`stop`](#stop) has been requested. */
    public boolean isStopped() {
        return this.stopped;
    }

    // -- live subscription --------------------------------------------------

    /**
     * Open the stream and deliver each event to `onEvent`, reconnecting on
     * drop (after [`reconnectDelayMillis`](#reconnectDelayMillis), replaying
     * `Last-Event-ID`) until [`stop`](#stop). A terminal
     * [`SseException`](SseException.cajeta) (bad status/type) propagates out.
     */
    public void subscribe((SseEvent) -> void onEvent) {
        this.stopped = false;
        boolean going = true;
        while (going) {
            try {
                this.runOnce(onEvent);
            } catch (SseException se) {
                throw se;
            } catch (NetException ne) {
                // Transport drop / connect failure: reconnect below.
            }
            if (this.stopped) {
                going = false;
            } else {
                Tasks.sleepMillis((int64) this.reconnectDelayMillis());
            }
        }
    }

    /** Ride a single connection: deliver events until the stream ends. */
    public void subscribeOnce((SseEvent) -> void onEvent) {
        this.stopped = false;
        this.runOnce(onEvent);
    }

    // One connection: GET, validate, then pump the body into the decoder.
    void runOnce((SseEvent) -> void onEvent) {
        TcpStream conn #= SseClient.connect(this.host, this.port);
        try {
            String head #= this.requestHead();
            int8[] hb #= head.toBytes();
            conn.writeAllAsync(hb, (int64) 0, (int64) head.byteLength());
            AsyncReader reader = heap AsyncReader(conn);
            HttpParserLimits limits = heap HttpParserLimits();
            ByteBuffer hbuf #= HeadScanner.readHead(reader, limits);
            ClientResponse resp = heap ClientResponse();
            HeadScanner.parseResponse(hbuf.array(), 0, hbuf.readable(), resp);
            resp.adopt(#hbuf);
            this.checkHead(resp);
            BodyFraming framing #= SseClient.framingOf(resp);
            BodyReader body #= BodyReader.forFraming(framing);
            this.pumpBody(body, reader, onEvent);
        } finally {
            conn.close();
        }
    }

    static #BodyFraming framingOf(ClientResponse resp) {
        if (resp.headerHasToken("Transfer-Encoding", "chunked")) {
            return BodyFraming.chunked(false);
        }
        if (resp.hasHeader("Content-Length")) {
            return BodyFraming.contentLength(resp.headerInt64("Content-Length", (int64) 0), false);
        }
        return BodyFraming.closeDelimited();
    }

    void pumpBody(BodyReader body, AsyncReader reader, (SseEvent) -> void onEvent) {
        int8[] scratch = heap int8[8192];
        boolean going = true;
        while (going) {
            if (body.isComplete() || this.stopped) {
                going = false;
            } else {
                int32 n = reader.read(scratch, 0, 8192);
                if (n <= 0) {
                    body.endInput();
                } else {
                    body.feed(scratch, n);
                }
                this.drainToEvents(body, onEvent);
            }
        }
    }

    void drainToEvents(BodyReader body, (SseEvent) -> void onEvent) {
        int8[] piece #= body.drain();
        int32 pl = piece.count();
        if (pl > 0) {
            this.decoder.feed(piece, pl);
        }
        while (this.decoder.hasEvent()) {
            SseEvent e #= this.decoder.nextEvent();
            onEvent(e);
        }
    }

    // Resolve `host` (IPv4) and open a blocking-friendly connection to `port`.
    static #TcpStream connect(String host, int32 port) {
        SocketAddress[] addrs #= Dns.resolve(host, port, ResolveFamily.V4_ONLY);
        SocketAddress a0 = addrs[0];
        IpAddress ip = a0.getIp();
        int8[] oct = ip.getOctets();
        int32 olen = 16;
        if (ip.isV4()) {
            olen = 4;
        }
        IpAddress ipCopy #= IpAddress.fromOctets(oct, olen);
        SocketAddress connAddr #= SocketAddress.of(#ipCopy, port);
        return TcpStream.connectAsync(#connAddr);
    }
}
