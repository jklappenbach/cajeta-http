package dev.cajeta.http.body;

import cajeta.io.net.AsyncReader;
import dev.cajeta.http.MediaType;

/** A message body that is streamed rather than held in the connection's buffer. */
public interface Body {
    /** Decoded length in bytes, or -1 when unknown. */
    int64 contentLength();

    /** The declared media type, or null when none was declared. */
    MediaType contentType();

    /** The reader positioned at the start of the content, owned by the body. */
    AsyncReader reader();

    /** Stops the producer when the peer can no longer take the body. */
    void abort();
}
