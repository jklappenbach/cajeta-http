package dev.cajeta.http.body;

import cajeta.io.net.AsyncReader;
import dev.cajeta.http.MediaType;

/**
 * An `application/x-www-form-urlencoded` [`Body`](Body.cajeta)
 * (`http:1.3b`): ordered name/value pairs, encoded per the URL
 * urlencoded-serializing rules — unreserved `[A-Za-z0-9*-._]`
 * verbatim, space as `+`, every other UTF-8 byte as uppercase `%XX`;
 * pairs joined `n=v` with `&`, insertion order preserved.
 *
 * Build with [`of`](#of) + [`add`](#add) (fluent), or decode with
 * [`parse`](#parse). The encoding is (re)built lazily — `add`
 * invalidates and the next `encoded()`/`contentLength()`/`reader()`
 * re-encodes — so adds are O(1).
 *
 * Stored names/values are **owned copies** of the caller's Strings;
 * the accessors hand out borrows of those copies.
 */
public final class FormBody extends Body {

    String[] names;
    String[] values;
    int32 pairs;
    int32 cap;

    int8[] data;          // lazily built encoding (null = stale)
    int32 len;
    MediaType type;
    BytesChannel channel;
    AsyncReader rdr;

    FormBody() {
        this.names = null;
        this.values = null;
        this.pairs = 0;
        this.cap = 0;
        this.data = null;
        this.len = 0;
        this.type = null;
        this.channel = null;
        this.rdr = null;
    }

    /** An empty form. */
    public static #FormBody of() {
        FormBody f = heap FormBody();
        f.cap = 8;
        String[] ns = heap String[8];
        String[] vs = heap String[8];
        f.names = #ns;
        f.values = #vs;
        MediaType t = MediaType.applicationFormUrlencoded();
        f.type = #t;
        return #f;
    }

    /** Copy `s` into a fresh owned String. */
    static #String copyOf(String s) {
        int32 n = s.byteLength();
        int8[] b = s.toBytes();
        String out = heap String(#b, n);
        return #out;
    }

    /** Append a pair (insertion order kept; names repeat freely). */
    public FormBody add(String name, String value) {
        if (this.pairs == this.cap) {
            int32 newCap = this.cap * 2;
            String[] ns = heap String[newCap];
            String[] vs = heap String[newCap];
            int32 i = 0;
            while (i < this.pairs) {
                ns[i] = #(this.names[i]);
                vs[i] = #(this.values[i]);
                i = i + 1;
            }
            this.names #= ns;
            this.values #= vs;
            this.cap = newCap;
        }
        String n2 = FormBody.copyOf(name);
        String v2 = FormBody.copyOf(value);
        this.names[this.pairs] = #n2;
        this.values[this.pairs] = #v2;
        this.pairs = this.pairs + 1;
        this.data = null;   // encoding is stale
        return this;
    }

    /** Number of pairs. */
    public int32 count() {
        return this.pairs;
    }

    /** Name of pair `i` (borrow). */
    public String name(int32 i) {
        return this.names[i];
    }

    /** Value of pair `i` (borrow). */
    public String valueAt(int32 i) {
        return this.values[i];
    }

    /** Value of the FIRST pair named `name`, or null. */
    public String value(String name) {
        int32 i = 0;
        while (i < this.pairs) {
            if (this.names[i].equals(name)) {
                return this.values[i];
            }
            i = i + 1;
        }
        return null;
    }

    // ---- encoding --------------------------------------------------------

    static boolean unreserved(int32 b) {
        if (b >= 65 && b <= 90) { return true; }    // A-Z
        if (b >= 97 && b <= 122) { return true; }   // a-z
        if (b >= 48 && b <= 57) { return true; }    // 0-9
        if (b == 42 || b == 45 || b == 46 || b == 95) { return true; } // * - . _
        return false;
    }

    static int8 hexDigit(int32 v) {
        if (v < 10) {
            return (int8) (48 + v);
        }
        return (int8) (65 + (v - 10));              // uppercase
    }

    /** Worst-case encoded size of `s` (every byte %XX). */
    static int32 encodedMax(String s) {
        return s.byteLength() * 3;
    }

    /** Encode `s` into `out` at `at`; returns the new offset. */
    static int32 encodeInto(String s, int8[] out, int32 at) {
        int32 n = s.byteLength();
        int32 i = 0;
        int32 o = at;
        while (i < n) {
            int32 b = ((int32) s.byteAt(i)) & 0xFF;
            if (FormBody.unreserved(b)) {
                out[o] = (int8) b;
                o = o + 1;
            } else if (b == 32) {
                out[o] = (int8) 43;                 // '+'
                o = o + 1;
            } else {
                out[o] = (int8) 37;                 // '%'
                out[o + 1] = FormBody.hexDigit(b / 16);
                out[o + 2] = FormBody.hexDigit(b % 16);
                o = o + 3;
            }
            i = i + 1;
        }
        return o;
    }

    /** (Re)build the cached encoding + channel + reader. */
    void ensureEncoded() {
        if (this.data != null) {
            return;
        }
        int32 max = 0;
        int32 i = 0;
        while (i < this.pairs) {
            max = max + FormBody.encodedMax(this.names[i])
                      + FormBody.encodedMax(this.values[i]) + 2;  // '=' + '&'
            i = i + 1;
        }
        if (max == 0) {
            max = 1;                                // heap int8[0] stays legal but be safe
        }
        int8[] out = heap int8[max];
        int32 o = 0;
        i = 0;
        while (i < this.pairs) {
            if (i > 0) {
                out[o] = (int8) 38;                 // '&'
                o = o + 1;
            }
            o = FormBody.encodeInto(this.names[i], out, o);
            out[o] = (int8) 61;                     // '='
            o = o + 1;
            o = FormBody.encodeInto(this.values[i], out, o);
            i = i + 1;
        }
        this.data = #out;
        this.len = o;
        BytesChannel ch = heap BytesChannel(this.data, (int64) this.len);
        this.channel = #ch;
        AsyncReader r = heap AsyncReader(this.channel);
        this.rdr = #r;
    }

    /** The encoded form as a String (fresh copy). */
    public #String encoded() {
        this.ensureEncoded();
        int8[] copy = heap int8[this.len];
        int32 i = 0;
        while (i < this.len) {
            copy[i] = this.data[i];
            i = i + 1;
        }
        String s = heap String(#copy, this.len);
        return #s;
    }

    // ---- decoding --------------------------------------------------------

    static int32 hexVal(int32 ch) {
        if (ch >= 48 && ch <= 57) { return ch - 48; }
        if (ch >= 65 && ch <= 70) { return ch - 65 + 10; }
        if (ch >= 97 && ch <= 102) { return ch - 97 + 10; }
        return -1;
    }

    /** Decode `s[from..to)` (percent + plus rules) into a fresh String. */
    static #String decodeSlice(String s, int32 from, int32 to) {
        int8[] out = heap int8[(to - from) + 1];
        int32 o = 0;
        int32 i = from;
        while (i < to) {
            int32 b = ((int32) s.byteAt(i)) & 0xFF;
            if (b == 43) {                          // '+'
                out[o] = (int8) 32;
                o = o + 1;
                i = i + 1;
            } else if (b == 37 && i + 2 < to) {     // '%XX' fully inside the slice
                int32 hi = FormBody.hexVal(((int32) s.byteAt(i + 1)) & 0xFF);
                int32 lo = FormBody.hexVal(((int32) s.byteAt(i + 2)) & 0xFF);
                if (hi >= 0 && lo >= 0) {
                    out[o] = (int8) (hi * 16 + lo);
                    o = o + 1;
                    i = i + 3;
                } else {
                    out[o] = (int8) b;              // stray '%': keep verbatim
                    o = o + 1;
                    i = i + 1;
                }
            } else {
                out[o] = (int8) b;
                o = o + 1;
                i = i + 1;
            }
        }
        int8[] exact = heap int8[o];
        int32 k = 0;
        while (k < o) { exact[k] = out[k]; k = k + 1; }
        String d = heap String(#exact, o);
        return #d;
    }

    /** Decode an urlencoded string into a FormBody. */
    public static #FormBody parse(String s) {
        FormBody f = FormBody.of();
        int32 n = s.byteLength();
        int32 start = 0;
        while (start < n) {
            int32 end = start;
            while (end < n && ((((int32) s.byteAt(end)) & 0xFF) != 38)) {  // '&'
                end = end + 1;
            }
            int32 eq = start;
            while (eq < end && ((((int32) s.byteAt(eq)) & 0xFF) != 61)) {  // '='
                eq = eq + 1;
            }
            String name = FormBody.decodeSlice(s, start, eq);
            // Value slice start: past the '=' when present, else the empty
            // slice [end, end). A single adopting init-decl — assigning an
            // owned return inside a branch would borrow a dying temp.
            int32 vFrom = end;
            if (eq < end) {
                vFrom = eq + 1;
            }
            String value = FormBody.decodeSlice(s, vFrom, end);
            f.add(name, value);
            start = end + 1;
        }
        return #f;
    }

    // ---- Body ------------------------------------------------------------

    public int64 contentLength() {
        this.ensureEncoded();
        return (int64) this.len;
    }

    public MediaType contentType() {
        return this.type;
    }

    public AsyncReader reader() {
        this.ensureEncoded();
        return this.rdr;
    }
}
