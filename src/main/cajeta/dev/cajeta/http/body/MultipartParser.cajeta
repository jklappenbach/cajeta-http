package dev.cajeta.http.body;

import cajeta.io.net.Headers;
import dev.cajeta.http.MalformedMessageException;
import dev.cajeta.http.MediaType;
import dev.cajeta.http.PayloadTooLargeException;
import dev.cajeta.http.UnexpectedEofException;

/** Incremental multipart/form-data parser (http:1.3d). */
public final class MultipartParser {

    /** Default ceiling on the number of parts in one body. */
    public static final int32 DEFAULT_MAX_PARTS = 1024;
    /** Default ceiling on a single part's decoded content, in bytes (16 MiB). */
    public static final int32 DEFAULT_MAX_PART_BYTES = 16777216;

    /** Before the first delimiter (preamble). */
    static final int32 ST_PREAMBLE = 0;
    /** Accumulating a part's header block. */
    static final int32 ST_HEADERS  = 1;
    /** Scanning a part's content for its terminating delimiter. */
    static final int32 ST_CONTENT  = 2;
    /** Buffer starts at `--boundary`; resolving close-vs-next-part. */
    static final int32 ST_DELIM    = 3;
    /** Closing delimiter seen; further bytes are epilogue. */
    static final int32 ST_DONE     = 4;

    String bound;
    int32 boundLen;

    int8[] buf;
    int32 len;
    int32 cap;

    int32 state;
    int32 headerStart;      // index of the CRLF ending the delimiter line
    int32 contentStart;     // first content byte of the current part
    int32 scanFrom;         // resume point for the delimiter search

    /** Headers of the part being read; moved into the part on emit. */
    Headers pendingHeaders;

    MultipartPart[] parts;
    int32 partN;
    int32 partCap;

    int32 maxParts;
    int32 maxPartBytes;

    MultipartParser() {
        this.bound = null;
        this.boundLen = 0;
        this.buf = null;
        this.len = 0;
        this.cap = 0;
        this.state = 0;
        this.headerStart = 0;
        this.contentStart = 0;
        this.scanFrom = 0;
        this.pendingHeaders = null;
        this.parts = null;
        this.partN = 0;
        this.partCap = 0;
        this.maxParts = 0;
        this.maxPartBytes = 0;
    }

    // ---- construction ----------------------------------------------------

    /** A parser for `boundary` at the default limits. */
    public static #MultipartParser forBoundary(String boundary) {
        return MultipartParser.forBoundaryWithLimits(
            boundary,
            MultipartParser.DEFAULT_MAX_PARTS,
            MultipartParser.DEFAULT_MAX_PART_BYTES);
    }

    // ---- feeding ---------------------------------------------------------

    /**
     * Append `data[0..length)` and advance the state machine. Returns
     * `true` once the closing delimiter has been seen (further feeds are
     * epilogue and are discarded).
     */
    public boolean feed(int8[] data, int32 length) {
        if (this.state == MultipartParser.ST_DONE) {
            return true;
        }
        this.ensureCapacity(this.len + length);
        int32 i = 0;
        while (i < length) {
            this.buf[this.len] = data[i];
            this.len = this.len + 1;
            i = i + 1;
        }
        this.advance();
        return this.state == MultipartParser.ST_DONE;
    }

    /** Run the state machine until no step can make further progress. */
    void advance() {
        boolean progress = true;
        while (progress && this.state != MultipartParser.ST_DONE) {
            progress = false;
            if (this.state == MultipartParser.ST_PREAMBLE) {
                progress = this.stepPreamble();
            } else if (this.state == MultipartParser.ST_HEADERS) {
                progress = this.stepHeaders();
            } else if (this.state == MultipartParser.ST_CONTENT) {
                progress = this.stepContent();
            } else if (this.state == MultipartParser.ST_DELIM) {
                progress = this.stepDelim();
            }
        }
    }

    /**
     * Find the FIRST delimiter. It may sit at offset 0 (no preamble) or
     * be CRLF-preceded; everything before it is discarded.
     */
    boolean stepPreamble() {
        if (MultipartScan.isDashBoundaryAt(this.buf, this.len, this.bound, 0)) {
            this.state = MultipartParser.ST_DELIM;   // buffer starts at the delimiter
            return true;
        }
        int32 d = MultipartScan.findDelimiter(this.buf, this.len, this.bound, 0);
        if (d < 0) {
            // Retain only what could still be a delimiter prefix.
            int32 keep = this.len - (this.boundLen + 4);
            if (keep > 0) {
                this.compact(keep);
            }
            return false;
        }
        // Drop the preamble and the delimiter's leading CRLF; the buffer
        // now starts at `--boundary`, which ST_DELIM resolves.
        this.compact(d + 2);
        this.state = MultipartParser.ST_DELIM;
        return true;
    }

    /** The buffer starts at `--boundary`: resolve the delimiter line. */
    boolean stepDelim() {
        if (this.len < 2 + this.boundLen) {
            return false;
        }
        return this.openPart(2 + this.boundLen);
    }

    /**
     * A delimiter's `--boundary` ends at `after`. Resolve what follows:
     * the closing `--`, or transport-padding then the CRLF that opens the
     * next part's headers.
     *
     * Returns false **without changing state** whenever the answer is not
     * yet decidable from the bytes on hand — a lone `-` could be the first
     * byte of the close delimiter, so the decision waits for its
     * successor. That re-entrancy is what makes a delimiter split across
     * feeds parse identically to one-shot input.
     */
    boolean openPart(int32 after) {
        int32 e = after;
        if (e >= this.len) {
            return false;                       // need the byte after the boundary
        }
        if (((int32) this.buf[e] & 0xFF) == 45) {            // '-'
            if (e + 1 >= this.len) {
                return false;                   // undecidable: wait for its pair
            }
            if (((int32) this.buf[e + 1] & 0xFF) == 45) {
                this.state = MultipartParser.ST_DONE;        // close-delimiter
                return true;
            }
        }
        // transport-padding = *( SP / HTAB ), then the CRLF ending the line.
        while (e < this.len) {
            int32 b = ((int32) this.buf[e] & 0xFF);
            if (b == 32 || b == 9) {
                e = e + 1;
            } else {
                if (this.partN >= this.maxParts) {
                    throw heap PayloadTooLargeException(
                        "multipart body exceeds maxParts",
                        (int64) this.maxParts, (int64) (this.partN + 1));
                }
                this.compact(e);
                this.headerStart = 0;
                this.scanFrom = 0;
                this.state = MultipartParser.ST_HEADERS;
                return true;
            }
        }
        return false;                           // all padding so far; need more
    }

    /** Accumulate the part's header block up to CRLFCRLF, then parse it. */
    boolean stepHeaders() {
        int32 m = MultipartScan.findBlankLine(this.buf, this.len, this.headerStart);
        if (m < 0) {
            return false;
        }
        // The delimiter line's own CRLF opens the block; the match's
        // first CRLF closes the last header line.
        Headers hb #= this.parseHeaderBlock(this.headerStart + 2, m + 2);
        this.pendingHeaders #= hb;
        this.contentStart = m + 4;
        this.scanFrom = this.contentStart;
        this.state = MultipartParser.ST_CONTENT;
        return true;
    }

    /** Scan for the delimiter that ends the current part's content. */
    boolean stepContent() {
        // Early 413: what is already buffered cannot fit the ceiling even
        // if the delimiter is the very next thing we see.
        int32 have = this.len - this.contentStart - (this.boundLen + 4);
        if (have > this.maxPartBytes) {
            throw heap PayloadTooLargeException(
                "multipart part exceeds maxPartBytes",
                (int64) this.maxPartBytes, (int64) have);
        }
        int32 start = this.scanFrom;
        if (start < this.contentStart) {
            start = this.contentStart;
        }
        int32 m = MultipartScan.findDelimiter(this.buf, this.len, this.bound, start);
        if (m < 0) {
            // Resume where a split delimiter could still begin.
            int32 back = this.len - (this.boundLen + 4);
            if (back < this.contentStart) {
                back = this.contentStart;
            }
            this.scanFrom = back;
            return false;
        }
        int32 contentLen = m - this.contentStart;
        if (contentLen > this.maxPartBytes) {
            throw heap PayloadTooLargeException(
                "multipart part exceeds maxPartBytes",
                (int64) this.maxPartBytes, (int64) contentLen);
        }
        this.emitPart(contentLen);
        // Drop the emitted content AND the delimiter's leading CRLF. The
        // buffer now starts at `--boundary`; ST_DELIM resolves it once
        // enough bytes arrive, so a delimiter split across feeds can never
        // re-emit the part we just handed out.
        this.compact(m + 2);
        this.state = MultipartParser.ST_DELIM;
        return true;
    }

    // ---- part construction -----------------------------------------------

    /** Materialize the current part from `buf[contentStart .. +n)`. */
    void emitPart(int32 n) {
        int8[] content = heap int8[n];
        int32 i = 0;
        while (i < n) {
            content[i] = this.buf[this.contentStart + i];
            i = i + 1;
        }
        Headers h #= this.pendingHeaders;
        this.pendingHeaders = null;
        String disp #= h.get("content-disposition");
        String name #= MultipartScan.dispositionParam(disp, "name");
        String filename #= MultipartScan.dispositionParam(disp, "filename");
        String ctype #= h.get("content-type");
        MediaType mt #= MediaType.parse(ctype);
        BytesBody bb #= BytesBody.of(#content, n, #mt);
        Body body = #bb;
        MultipartPart p #= MultipartPart.of(#h, #name, #filename, #body);
        this.addPart(#p);
    }

    /** Parse `buf[from..to)` as CRLF-delimited `name: value` lines. */
    #Headers parseHeaderBlock(int32 from, int32 to) {
        Headers h = heap Headers();
        int32 pos = from;
        while (pos < to) {
            int32 end = pos;
            while (end + 1 < to && !MultipartScan.isCrlfAt(this.buf, this.len, end)) {
                end = end + 1;
            }
            if (end > pos) {
                int32 colon = pos;
                while (colon < end && ((int32) this.buf[colon] & 0xFF) != 58) {
                    colon = colon + 1;
                }
                if (colon >= end) {
                    throw heap MalformedMessageException(
                        "multipart part header line has no ':' separator",
                        (int64) pos);
                }
                String name #= this.sliceString(pos, colon);
                String value #= this.sliceString(colon + 1, end);
                h.add(name, value);
            }
            pos = end + 2;
        }
        return #h;
    }

    /** A fresh owned String over `buf[from..to)`. */
    #String sliceString(int32 from, int32 to) {
        int32 n = to - from;
        if (n < 0) {
            n = 0;
        }
        int8[] out = heap int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = this.buf[from + i];
            i = i + 1;
        }
        String s = heap String(#out, n);
        return #s;
    }

    void addPart(#MultipartPart p) {
        if (this.partN == this.partCap) {
            int32 newCap = this.partCap * 2;
            MultipartPart[] ps = heap MultipartPart[newCap];
            int32 i = 0;
            while (i < this.partN) {
                ps[i] = #(this.parts[i]);
                i = i + 1;
            }
            this.parts #= ps;
            this.partCap = newCap;
        }
        this.parts[this.partN] = #p;
        this.partN = this.partN + 1;
    }

    // ---- buffer ----------------------------------------------------------

    /** Drop `[0, from)` and rebase every index onto the shifted buffer. */
    void compact(int32 from) {
        if (from <= 0) {
            return;
        }
        int32 i = from;
        int32 o = 0;
        while (i < this.len) {
            this.buf[o] = this.buf[i];
            o = o + 1;
            i = i + 1;
        }
        this.len = o;
        this.headerStart = this.headerStart - from;
        this.contentStart = this.contentStart - from;
        this.scanFrom = this.scanFrom - from;
        if (this.headerStart < 0) { this.headerStart = 0; }
        if (this.contentStart < 0) { this.contentStart = 0; }
        if (this.scanFrom < 0) { this.scanFrom = 0; }
    }

    void ensureCapacity(int32 need) {
        if (need <= this.cap) {
            return;
        }
        int32 newCap = this.cap * 2;
        while (newCap < need) {
            newCap = newCap * 2;
        }
        int8[] dst = heap int8[newCap];
        int32 i = 0;
        while (i < this.len) {
            dst[i] = this.buf[i];
            i = i + 1;
        }
        this.buf #= dst;
        this.cap = newCap;
    }

    // ---- results ---------------------------------------------------------

    /**
     * Assert end-of-stream. A body whose closing delimiter never arrived
     * is truncated — raise
     * [`UnexpectedEofException`](../UnexpectedEofException.cajeta).
     */
    public void endInput() {
        if (this.state != MultipartParser.ST_DONE) {
            throw heap UnexpectedEofException(
                "stream ended before the multipart closing delimiter",
                (int64) this.partN);
        }
    }

    /** True once the closing delimiter has been parsed. */
    public boolean isComplete() {
        return this.state == MultipartParser.ST_DONE;
    }

    /** Number of parts decoded so far. */
    public int32 partCount() {
        return this.partN;
    }

    /** Part `i` (borrow; valid while the parser lives). */
    public MultipartPart part(int32 i) {
        return this.parts[i];
    }

    /** A parser for `boundary` with explicit abuse ceilings. */
    // ---- construction (declared LAST on purpose) -------------------------
    //
    // These two statics must stay BELOW the instance methods. With them
    // declared up by `forBoundary`, this class's later instance methods
    // (`feed` first among them) drop out of the compiler's method index and
    // every call site fails with CAJETA_ERROR_MEMBER_NOT_FOUND, even though
    // the file parses and the method is plainly there. Moving them here is
    // the whole fix; the bodies are unchanged. Reproduced repeatedly on
    // cajeta 0.9.3 (080171da) — it did not reduce to a small standalone
    // case, so the reproducer is this file's own history (http:1.3d in
    // plan/http-plan.md). Re-check on a future toolchain before reordering.

    /** A parser for `boundary` with explicit abuse ceilings. */
    public static #MultipartParser forBoundaryWithLimits(String boundary,
                                                         int32 maxParts,
                                                         int32 maxPartBytes) {
        MultipartParser p = heap MultipartParser();
        String b #= MultipartPart.copyOf(boundary);
        p.bound = #b;
        p.boundLen = boundary.byteLength();
        p.cap = 1024;
        int8[] bb = heap int8[1024];
        p.buf = #bb;
        p.partCap = 8;
        MultipartPart[] ps = heap MultipartPart[8];
        p.parts = #ps;
        p.maxParts = maxParts;
        p.maxPartBytes = maxPartBytes;
        return #p;
    }

    /**
     * The `boundary` parameter of a `multipart/*` media type, or null
     * when the type is null or declares none. Quoted forms
     * (`boundary="a b"`) unquote — [`MediaType`](../MediaType.cajeta)
     * already strips a quoted-string's delimiters.
     */
    public static #String boundaryOf(MediaType type) {
        if (type == null) {
            return null;
        }
        String v #= type.parameter("boundary");
        return #v;
    }
}
