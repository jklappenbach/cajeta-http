package dev.cajeta.http;

import cajeta.lang.String;

/**
 * An HTTP **status** (spec §Core types) — the three-digit code plus its
 * reason phrase, with the RFC 9110 §15 class predicates.
 *
 * ```cajeta
 * Status s = Status.of(404);
 * s.reason();            // "Not Found" (the registry's canonical phrase)
 * s.isClientError();     // true
 * ```
 *
 * [`of(code)`](#of) stamps the registry's canonical reason;
 * [`of(code, reason)`](#of) keeps a caller-supplied phrase (the reason is
 * advisory on the wire — RFC 9112 §4 — so an unregistered code simply
 * carries an empty phrase rather than an invented one). The registry table
 * is the single source the serializer-side
 * [`HttpResponse.reasonFor`](HttpResponse.cajeta) mirrors; consolidating
 * the two is part of adopting the core types across the message model.
 */
public final class Status {
    int32 statusCode;
    String reasonPhrase;

    Status(int32 code, String reason) {
        this.statusCode = code;
        this.reasonPhrase = reason.substring(0, reason.byteLength());
    }

    /** A status with the registry's canonical reason (empty if unregistered). */
    public static #Status of(int32 code) {
        return heap Status(code, Status.reasonFor(code));
    }

    /** A status with an explicit reason phrase (kept verbatim). */
    public static #Status of(int32 code, String reason) {
        return heap Status(code, reason);
    }

    /** The three-digit code. */
    public int32 code() {
        return this.statusCode;
    }

    /** The reason phrase — canonical, caller-supplied, or empty. */
    public String reason() {
        return this.reasonPhrase;
    }

    /** 1xx — informational. */
    public boolean isInformational() {
        return this.statusCode >= 100 && this.statusCode < 200;
    }

    /** 2xx — success. */
    public boolean isSuccess() {
        return this.statusCode >= 200 && this.statusCode < 300;
    }

    /** 3xx — redirection. */
    public boolean isRedirection() {
        return this.statusCode >= 300 && this.statusCode < 400;
    }

    /** 4xx — client error. */
    public boolean isClientError() {
        return this.statusCode >= 400 && this.statusCode < 500;
    }

    /** 5xx — server error. */
    public boolean isServerError() {
        return this.statusCode >= 500 && this.statusCode < 600;
    }

    /**
     * The RFC 9110 §15 canonical reason phrase for `code`, or the empty
     * string for a code outside the registry. (`418 I'm a teapot` is
     * deliberately absent: RFC 9110 reserves 418 as unused.)
     */
    public static #String reasonFor(int32 code) {
        if (code == 100) { return Status.lit("Continue"); }
        if (code == 101) { return Status.lit("Switching Protocols"); }

        if (code == 200) { return Status.lit("OK"); }
        if (code == 201) { return Status.lit("Created"); }
        if (code == 202) { return Status.lit("Accepted"); }
        if (code == 203) { return Status.lit("Non-Authoritative Information"); }
        if (code == 204) { return Status.lit("No Content"); }
        if (code == 205) { return Status.lit("Reset Content"); }
        if (code == 206) { return Status.lit("Partial Content"); }

        if (code == 300) { return Status.lit("Multiple Choices"); }
        if (code == 301) { return Status.lit("Moved Permanently"); }
        if (code == 302) { return Status.lit("Found"); }
        if (code == 303) { return Status.lit("See Other"); }
        if (code == 304) { return Status.lit("Not Modified"); }
        if (code == 305) { return Status.lit("Use Proxy"); }
        if (code == 307) { return Status.lit("Temporary Redirect"); }
        if (code == 308) { return Status.lit("Permanent Redirect"); }

        if (code == 400) { return Status.lit("Bad Request"); }
        if (code == 401) { return Status.lit("Unauthorized"); }
        if (code == 402) { return Status.lit("Payment Required"); }
        if (code == 403) { return Status.lit("Forbidden"); }
        if (code == 404) { return Status.lit("Not Found"); }
        if (code == 405) { return Status.lit("Method Not Allowed"); }
        if (code == 406) { return Status.lit("Not Acceptable"); }
        if (code == 407) { return Status.lit("Proxy Authentication Required"); }
        if (code == 408) { return Status.lit("Request Timeout"); }
        if (code == 409) { return Status.lit("Conflict"); }
        if (code == 410) { return Status.lit("Gone"); }
        if (code == 411) { return Status.lit("Length Required"); }
        if (code == 412) { return Status.lit("Precondition Failed"); }
        if (code == 413) { return Status.lit("Content Too Large"); }
        if (code == 414) { return Status.lit("URI Too Long"); }
        if (code == 415) { return Status.lit("Unsupported Media Type"); }
        if (code == 416) { return Status.lit("Range Not Satisfiable"); }
        if (code == 417) { return Status.lit("Expectation Failed"); }
        if (code == 421) { return Status.lit("Misdirected Request"); }
        if (code == 422) { return Status.lit("Unprocessable Content"); }
        if (code == 426) { return Status.lit("Upgrade Required"); }
        if (code == 428) { return Status.lit("Precondition Required"); }
        if (code == 429) { return Status.lit("Too Many Requests"); }
        if (code == 431) { return Status.lit("Request Header Fields Too Large"); }
        if (code == 451) { return Status.lit("Unavailable For Legal Reasons"); }

        if (code == 500) { return Status.lit("Internal Server Error"); }
        if (code == 501) { return Status.lit("Not Implemented"); }
        if (code == 502) { return Status.lit("Bad Gateway"); }
        if (code == 503) { return Status.lit("Service Unavailable"); }
        if (code == 504) { return Status.lit("Gateway Timeout"); }
        if (code == 505) { return Status.lit("HTTP Version Not Supported"); }

        return Status.lit("");
    }

    /** A caller-owned copy of a literal (literals are borrowed constants). */
    static #String lit(String s) {
        return s.substring(0, s.byteLength());
    }
}
