package dev.cajeta.http.client;

import cajeta.lang.String;
import cajeta.io.net.ByteChannel;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.dns.Dns;
import cajeta.io.net.dns.ResolveFamily;
import cajeta.io.net.tls.TlsStream;
import cajeta.io.net.uri.Uri;
import cajeta.io.net.NetException;
import cajeta.io.net.TimedOutException;
import cajeta.concurrent.Tasks;
import cajeta.time.Clock;
import cajeta.time.Instant;
import dev.cajeta.http.Method;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.TooManyRedirectsException;
import dev.cajeta.http.h1.HttpParser;
import dev.cajeta.http.h1.HttpSerializer;
import dev.cajeta.http.h1.BodyReader;
import dev.cajeta.http.h1.BodyFraming;
import dev.cajeta.http.h1.KeepAlive;
import cajeta.io.net.Headers;

/**
 * The **HTTP/1.1 client** — plan item **NET-8.1**. It drives one
 * request/response exchange over an **async, TLS-or-plaintext** byte
 * channel, composing the layers below it with no new wire code of its own:
 *
 *   1. **resolve** the target host (NET-2 [`Dns`](../dns/Dns.cajeta) — numeric
 *      literals and names both),
 *   2. **connect** a non-blocking [`TcpStream`](../TcpStream.cajeta)
 *      (NET-3.3, fiber-parking),
 *   3. for `https://`, **wrap** it in a verifying
 *      [`TlsStream`](../tls/TlsStream.cajeta) (NET-5) offering ALPN
 *      `http/1.1`,
 *   4. **serialize** the request ([`HttpSerializer`](HttpSerializer.cajeta),
 *      NET-7.5) through a buffered [`AsyncWriter`](../AsyncWriter.cajeta),
 *   5. **parse** the response ([`HttpParser`](HttpParser.cajeta) +
 *      [`BodyReader`](BodyReader.cajeta), NET-7.3/7.4) off a buffered
 *      [`AsyncReader`](../AsyncReader.cajeta).
 *
 * The plaintext-vs-TLS choice is invisible to steps 4–5: both transports
 * satisfy [`ByteChannel`](../ByteChannel.cajeta), so the buffered reader/
 * writer — and therefore the whole exchange — are byte-for-byte identical
 * over `http://` and `https://`. That seam is the NET-8.1/NET-9.5 keystone.
 *
 * ```cajeta
 * HttpClient client = heap HttpClient();
 * HttpResponse resp = client.get("https://example.test/path");
 * // resp.statusCode(), resp.getHeaders(), resp.body ...
 * ```
 *
 * ## Trust
 *
 * By default a `https://` request verifies the peer against the
 * **operating-system** CA store
 * ([`TlsStream.clientSystemTrust`](../tls/TlsStream.cajeta#clientSystemTrust),
 * NET-5.3) — the real-world public-PKI path. A private CA or a
 * self-signed test server is supported by pinning an explicit anchor with
 * [`trustAnchor`](#trustAnchor) (PEM bytes), which switches the handshake
 * to [`TlsStream.client`](../tls/TlsStream.cajeta#client).
 *
 * ## Scope (NET-8.1)
 *
 * This is the **core single exchange**: connect, send, receive, close. The
 * connection pool + keep-alive reuse is NET-8.2, redirect following NET-8.3,
 * per-request deadlines NET-8.4, streaming bodies NET-8.5, the
 * `getJson`/`downloadTo` convenience NET-8.6 — each layers over this method.
 * v1 stamps `Connection: close` (one exchange per socket) and buffers the
 * response body in memory.
 */
public class HttpClient {
    /** The keep-alive connection pool (`http:1.4a`); plaintext origins. */
    ConnectionPool pool;
    /** Explicit trust-anchor PEM bytes, or `null` to use the OS trust store. */
    int8[] trustPem;
    /** Length of [`trustPem`](#trustPem) (meaningful when `hasTrustAnchor`). */
    int32 trustLen;
    /** True once [`trustAnchor`](#trustAnchor) pinned an explicit anchor. */
    boolean hasTrustAnchor;
    /** Per-exchange budget, millis; `0` = unbounded (http:1.4c). */
    int32 exchangeTimeoutMs;
    /** Auto-retry cap — extra attempts after the first (http:1.4c). */
    int32 maxRetries;
    /** Millis slept between attempts. */
    int32 retryBackoffMs;

    /**
     * Maximum number of 3xx redirects [`sendFollowing`](#sendFollowing)
     * takes before raising
     * [`TooManyRedirectsException`](../TooManyRedirectsException.cajeta).
     * Bounds redirect loops (`A → B → A …`), which look exactly like a
     * long chain from the client's side.
     */
    public static final int32 MAX_REDIRECTS = 10;

    /**
     * A client trusting the OS CA store (the default public-PKI path).
     *
     * @EntryPoint
     */
    public HttpClient() {
        ConnectionPool cp = ConnectionPool.of();
        this.pool = #cp;
        int8[] e = heap int8[0];
        this.trustPem = #e;
        this.trustLen = 0;
        this.hasTrustAnchor = false;
        this.exchangeTimeoutMs = 0;
        this.maxRetries = 1;
        this.retryBackoffMs = 100;
    }

    /**
     * Per-exchange budget in milliseconds (http:1.4c) — the whole
     * plaintext exchange (every response-read park) must finish inside
     * it or the send raises
     * [`TimedOutException`](../../../../cajeta/io/net/TimedOutException.cajeta).
     * The deadline is computed ONCE per `send` (monotonic — retries and
     * multi-read bodies share it, nothing resets it). `0` (the default)
     * = unbounded. Rides `TcpStream.readWithin`, so TLS exchanges are
     * NOT yet budgeted (no `TlsStream.readWithin` in the stdlib — see
     * the plan note), and neither are writes or the dial. Returns `this`.
     */
    public HttpClient exchangeTimeout(int32 ms) {
        this.exchangeTimeoutMs = ms;
        return this;
    }

    /**
     * Auto-retry policy (http:1.4c): up to `maxRetries` extra attempts,
     * sleeping `backoffMs` (fiber-parking `Tasks.sleepMillis`) between
     * them. A retry happens only when ALL of these hold: the request
     * method is **idempotent** ([`Method.isIdempotent`](../Method.cajeta)
     * — a POST never auto-retries), the fault is a **transport** fault
     * that precedes a usable response (connection refused / reset /
     * aborted, host or network unreachable, broken pipe — see
     * [`retryableKind`](#retryableKind); never a `TimedOutException`,
     * whose budget is already spent, and never a parse fault), and the
     * exchange budget (when set) has time left. Defaults: 1 retry,
     * 100 ms backoff. `retryPolicy(0, 0)` disables. Returns `this`.
     */
    public HttpClient retryPolicy(int32 maxRetries, int32 backoffMs) {
        this.maxRetries = maxRetries;
        this.retryBackoffMs = backoffMs;
        return this;
    }

    /**
     * Replace the pool with one at explicit limits (`http:1.4a`):
     * `maxPerOrigin` caps concurrent connections per origin (an over-cap
     * `send` parks its fiber until a lease frees); `idleMaxMs` bounds how
     * long an idle connection may wait before the next acquire discards
     * it. Returns `this`. Call before the first `send` — swapping pools
     * mid-flight closes the old pool's idle sockets but cannot recall
     * leased ones.
     */
    public HttpClient poolLimits(int32 maxPerOrigin, int32 idleMaxMs) {
        ConnectionPool cp = ConnectionPool.withLimits(maxPerOrigin, idleMaxMs);
        this.pool #= cp;
        return this;
    }

    /**
     * Pin an explicit trust anchor (PEM bytes) for `https://` verification,
     * replacing the OS trust store — the private-CA / self-signed test-server
     * path. A fresh owned copy of `pem[0..len)` is kept. Returns `this`.
     */
    public HttpClient trustAnchor(int8[] pem, int32 len) {
        int8[] copy = heap int8[len];
        int32 i = 0;
        while (i < len) {
            copy[i] = pem[i];
            i = i + 1;
        }
        this.trustPem = #copy;
        this.trustLen = len;
        this.hasTrustAnchor = true;
        return this;
    }

    // ----- the exchange ----------------------------------------------------

    /**
     * Send `req` to `uri`'s authority and return the parsed response.
     * Resolves + connects (TLS for `https`), serializes `req`, reads the
     * full response (head + buffered body). The request-target comes from
     * `req` (origin-form); a missing `Host` header is filled from `uri`.
     * `Connection: close` is stamped (NET-8.1 is one exchange per socket).
     *
     * @EntryPoint
     */
    public #HttpResponse send(Uri uri, HttpRequest req) {
        // The budget is computed ONCE — retries and every read of the
        // winning attempt share the same absolute deadline (monotonic
        // discipline, mirroring readWithin's own).
        int64 deadline = 0;
        if (this.exchangeTimeoutMs > 0) {
            Instant t0 = Clock.now();
            deadline = t0.toEpochMilli() + (int64) this.exchangeTimeoutMs;
        }
        boolean idem = req.methodType().isIdempotent();
        int32 attempt = 0;
        while (true) {
            try {
                HttpResponse r = this.sendOnce(uri, req, deadline);
                return #r;
            } catch (NetException e) {
                boolean again = attempt < this.maxRetries
                    && idem
                    && HttpClient.retryableKind(e.kind)
                    && HttpClient.budgetLeft(deadline);
                if (!again) {
                    throw e;
                }
            }
            attempt = attempt + 1;
            if (this.retryBackoffMs > 0) {
                Tasks.sleepMillis((int64) this.retryBackoffMs);
            }
        }
    }

    /** One attempt: resolve, connect, exchange — no retry, no rewrite. */
    #HttpResponse sendOnce(Uri uri, HttpRequest req, int64 deadline) {
        boolean https = HttpClient.isHttps(uri.getScheme());
        String host = uri.getHost();
        int32 port = uri.getPort();
        if (port < 0) {
            port = https ? 443 : 80;
        }
        HttpClient.ensureHost(req, uri);

        if (https) {
            // TLS stays dial-per-exchange (the pool's revive probe needs
            // the raw socket; see ConnectionPool's scope note) — so keep
            // advertising close, which is honest about what happens. The
            // exchange budget does NOT bound this path yet: TlsStream has
            // no readWithin (stdlib gap, noted in the plan).
            req.setHeader("Connection", "close");
            TcpStream sock = HttpClient.connectAny(host, port);
            int8[] hostBytes = host.toBytes();
            int32 hostLen = host.byteLength();
            TlsStream tls = HttpClient.wrapTls(#sock, hostBytes, hostLen,
                                               this.trustPem, this.trustLen,
                                               this.hasTrustAnchor);
            int8[] alpn = HttpClient.alpnHttp11();
            tls.offerAlpn(alpn, 9);
            tls.handshake();
            HttpResponse rtls = HttpClient.exchange(tls, req);
            tls.close();
            return #rtls;
        }

        // Plaintext rides the pool (1.4a): lease (parks at the origin
        // cap), revive-or-dial, exchange, then park the connection idle
        // when both sides' headers and the response framing permit reuse.
        // No `Connection: close` stamp — pooling supersedes it; HTTP/1.1
        // defaults to keep-alive. A raise mid-exchange evicts the
        // connection AND frees the lease (1.4c structured cleanup) — the
        // socket's state is unknowable, so it never re-enters the pool.
        PooledConnection pc = this.leaseFor(host, port);
        try {
            HttpResponse rplain = HttpClient.exchangeTimed(pc.stream, req, deadline);
            boolean reuse = HttpClient.exchangeAllowsReuse(req, rplain);
            this.pool.release(#pc, reuse);
            return #rplain;
        } catch (NetException e) {
            this.pool.release(#pc, false);
            throw e;
        }
    }

    /**
     * A leased connection for `host:port`: a pool-revived idle one when
     * available, else a fresh dial under the same lease. A dial that
     * RAISES frees the lease permit before propagating (the 1.4a gap,
     * closed here) — without it the origin's budget leaks a slot per
     * failed dial and eventually parks every caller forever.
     */
    #PooledConnection leaseFor(String host, int32 port) {
        PooledConnection idle = this.pool.acquire(host, port);
        if (idle != null) {
            return #idle;
        }
        try {
            TcpStream sock = HttpClient.connectAny(host, port);
            return this.pool.adopt(#sock, host, port);
        } catch (NetException e) {
            this.pool.releaseFailed(host, port);
            throw e;
        }
    }

    /** Transport faults worth a second attempt (see [`retryPolicy`](#retryPolicy)). */
    static boolean retryableKind(int32 kind) {
        return kind == NetException.KIND_CONNECTION_REFUSED
            || kind == NetException.KIND_CONNECTION_RESET
            || kind == NetException.KIND_CONNECTION_ABORTED
            || kind == NetException.KIND_HOST_UNREACHABLE
            || kind == NetException.KIND_NETWORK_UNREACHABLE
            || kind == NetException.KIND_BROKEN_PIPE;
    }

    /** True while the exchange budget (if any) has time left. */
    static boolean budgetLeft(int64 deadline) {
        if (deadline == (int64) 0) {
            return true;
        }
        Instant now = Clock.now();
        return now.toEpochMilli() < deadline;
    }

    /**
     * May the connection that carried this exchange be pooled? Both
     * sides' headers must permit it (`KeepAlive.canReuse`) AND the
     * response framing must self-terminate — a close-delimited body
     * (no `Content-Length`, no `Transfer-Encoding`) ends only with the
     * connection, so there is nothing left to reuse.
     */
    static boolean exchangeAllowsReuse(HttpRequest req, HttpResponse resp) {
        boolean headersOk = KeepAlive.canReuse(
            req.getVersion(), req.getHeaders(),
            resp.getVersion(), resp.getHeaders());
        if (!headersOk) {
            return false;
        }
        return HttpClient.framingSelfTerminates(resp);
    }

    /** True iff the response body's framing ends without a close. */
    static boolean framingSelfTerminates(HttpResponse resp) {
        int32 st = resp.statusCode();
        if ((st >= 100 && st < 200) || st == 204 || st == 304) {
            return true;                        // definitionally bodyless
        }
        Headers h = resp.getHeaders();
        String te = h.get("transfer-encoding");
        if (te != null) {
            return true;                        // chunked self-terminates
        }
        String cl = h.get("content-length");
        return cl != null;
    }

    /**
     * `GET url` — parse `url` to a [`Uri`](../uri/Uri.cajeta), build the
     * origin-form request (with `Host`), and follow redirects via
     * [`sendFollowing`](#sendFollowing) (NET-8.3 → http:1.4b). This is
     * required for real-world download URLs — e.g. GitHub
     * `releases/.../download/...` 302s to a signed CDN URL.
     *
     * @EntryPoint
     */
    public #HttpResponse get(String url) {
        Uri uri = Uri.parse(url);
        HttpRequest req = HttpRequest.fromUri("GET", uri);
        HttpResponse resp = this.sendFollowing(uri, req);
        return #resp;
    }

    // ----- redirect following (http:1.4b) ----------------------------------

    /**
     * [`send`](#send) `req` to `uri`, then **follow 3xx redirects** up to
     * [`MAX_REDIRECTS`](#MAX_REDIRECTS) hops — past the cap (which is how a
     * redirect loop surfaces) it raises
     * [`TooManyRedirectsException`](../TooManyRedirectsException.cajeta). A
     * 3xx without a `Location` header is unfollowable and is returned as-is.
     *
     * Per hop:
     *
     *   - **`Location` resolution** — relative references resolve against
     *     the redirecting URL via the stdlib RFC 3986
     *     [`Uri.resolve`](../uri/Uri.cajeta#resolve) (merge-path + dot
     *     segments), not just origin rebasing.
     *   - **Method rewrite** — `303` turns everything but `HEAD` into `GET`;
     *     `301`/`302` turn `POST`/`PUT` into `GET` (the de-facto table every
     *     mainstream client ships); `307`/`308` never rewrite.
     *   - **Body** — forwarded only on `307`/`308` (`303` drops it by
     *     definition; on `301`/`302` mainstream clients drop it too). When
     *     dropped, `Content-Type` goes with it.
     *   - **Headers** — the *original* request's headers are re-applied to
     *     every hop, except `Host` (regenerated from the hop's target),
     *     `Content-Length` (re-derived from the forwarded body), and
     *     `Authorization`, which is only forwarded when the hop's target is
     *     the **same origin** (scheme + host + effective port) the caller
     *     addressed — a cross-origin hop must not leak credentials.
     *
     * @EntryPoint
     */
    public #HttpResponse sendFollowing(Uri uri, HttpRequest req) {
        HttpResponse first = this.send(uri, req);
        String loc = HttpClient.locationOf(first);
        if (loc == null) {
            return #first;
        }

        // The origin the caller addressed — the Authorization anchor.
        boolean origHttps = HttpClient.isHttps(uri.getScheme());
        String origHost = uri.getHost();
        int32 origPort = uri.getPort();
        if (origPort < 0) {
            origPort = origHttps ? 443 : 80;
        }

        // Loop state is owned (or scalar) so reassignment is a plain move.
        String m0 = req.getMethod();
        String method = m0.substring(0, m0.byteLength());
        boolean keepBody = req.hasBody;
        String baseUrl = uri.toString();
        int32 lastStatus = first.statusCode();
        int32 hops = 0;
        while (true) {
            if (hops >= HttpClient.MAX_REDIRECTS) {
                throw heap TooManyRedirectsException("too many redirects", hops);
            }
            String m2 = HttpClient.redirectMethod(lastStatus, method);
            method = #m2;
            keepBody = keepBody && HttpClient.redirectKeepsBody(lastStatus);

            Uri base = Uri.parse(baseUrl);
            Uri next = Uri.resolve(base, loc);
            boolean sameOrig = HttpClient.originMatches(next, origHttps,
                                                        origHost, origPort);
            HttpRequest hopReq = HttpClient.redirectedRequest(
                req, method, keepBody, next, sameOrig);
            HttpResponse resp = this.send(next, hopReq);
            hops = hops + 1;

            String loc2 = HttpClient.locationOf(resp);
            if (loc2 == null) {
                return #resp;
            }
            loc = #loc2;
            lastStatus = resp.statusCode();
            String nb = next.toString();
            baseUrl = #nb;
        }
    }

    /** True for the redirect status codes [`sendFollowing`](#sendFollowing) follows. */
    static boolean isRedirect(int32 status) {
        return status == 301 || status == 302 || status == 303
            || status == 307 || status == 308;
    }

    /**
     * `resp`'s `Location` when it is a followable redirect, else null —
     * one owned pass-through so callers never assign a header borrow
     * inside a branch.
     */
    static #String locationOf(HttpResponse resp) {
        if (!HttpClient.isRedirect(resp.statusCode())) {
            return null;
        }
        return resp.getHeaders().get("Location");
    }

    /**
     * The method a `status` hop forwards `m` as (owned copy): `303` →
     * `GET` for everything but `HEAD`; `301`/`302` → `GET` for
     * `POST`/`PUT`; `307`/`308` (and anything else) keep `m`.
     */
    static #String redirectMethod(int32 status, String m) {
        boolean toGet = false;
        if (status == 303) {
            toGet = !m.equals("HEAD");
        }
        if (status == 301 || status == 302) {
            toGet = m.equals("POST") || m.equals("PUT");
        }
        if (toGet) {
            String g = "GET";
            return g.substring(0, g.byteLength());
        }
        return m.substring(0, m.byteLength());
    }

    /** Does a `status` hop forward the request body? Only 307/308 do. */
    static boolean redirectKeepsBody(int32 status) {
        return status == 307 || status == 308;
    }

    /**
     * Is `next` on the origin `(https, host, port)` the caller addressed?
     * Effective ports compare (an absent port takes the scheme default),
     * so `http://h/` and `http://h:80/` are one origin.
     */
    static boolean originMatches(Uri next, boolean https, String host, int32 port) {
        boolean nHttps = HttpClient.isHttps(next.getScheme());
        if (nHttps != https) {
            return false;
        }
        if (!next.getHost().equals(host)) {
            return false;
        }
        int32 np = next.getPort();
        if (np < 0) {
            np = nHttps ? 443 : 80;
        }
        return np == port;
    }

    /**
     * Build hop N's request from the **original**: `method` verbatim (the
     * caller already applied the rewrite table), target + `Host` from
     * `target` via [`HttpRequest.fromUri`](../HttpRequest.cajeta#fromUri),
     * then the original headers minus the per-hop set (see
     * [`dropOnRedirect`](#dropOnRedirect)), and the original body iff
     * `keepBody`.
     */
    static #HttpRequest redirectedRequest(HttpRequest original, String method,
                                          boolean keepBody, Uri target,
                                          boolean sameOrigin) {
        HttpRequest r = HttpRequest.fromUri(method, target);
        Headers src = original.getHeaders();
        Headers dst = r.getHeaders();
        int32 n = src.count();
        int32 i = 0;
        while (i < n) {
            String name = src.nameAt(i);
            if (!HttpClient.dropOnRedirect(name, keepBody, sameOrigin)) {
                dst.add(name, src.valueAt(i));
            }
            i = i + 1;
        }
        if (keepBody && original.hasBody) {
            r.body(original.body, original.bodyLength());
        }
        return #r;
    }

    /**
     * Headers a redirect hop does NOT copy from the original request.
     * Stored names are lowercased by [`Headers`](../../Headers.cajeta).
     */
    static boolean dropOnRedirect(String name, boolean keepBody, boolean sameOrigin) {
        if (name.equals("host")) {
            return true;                    // regenerated from the hop target
        }
        if (name.equals("content-length")) {
            return true;                    // re-derived from the forwarded body
        }
        if (!keepBody && name.equals("content-type")) {
            return true;                    // no body, no body type
        }
        if (!sameOrigin && name.equals("authorization")) {
            return true;                    // never leak credentials cross-origin
        }
        return false;
    }

    // ----- transport wiring (static; no captured `this`) -------------------

    /**
     * Wrap an owned, connected `sock` as a verifying TLS client for `host`:
     * an explicit pinned anchor ([`TlsStream.client`](../tls/TlsStream.cajeta#client))
     * when `hasAnchor`, else the OS trust store
     * ([`clientSystemTrust`](../tls/TlsStream.cajeta#clientSystemTrust)).
     * Consumes `sock`.
     */
    static #TlsStream wrapTls(#TcpStream sock, int8[] host, int32 hostLen,
                              int8[] trustPem, int32 trustLen, boolean hasAnchor) {
        if (hasAnchor) {
            return TlsStream.client(#sock, host, hostLen, trustPem, trustLen);
        }
        return TlsStream.clientSystemTrust(#sock, host, hostLen);
    }

    /**
     * Write `req` to `ch`, then read + parse the response off the same
     * channel. `ch` is borrowed (the caller owns + closes the transport).
     *
     * This drives the [`ByteChannel`](../ByteChannel.cajeta) **directly** with
     * a local scratch buffer — `ch.writeAllAsync` for the serialized request,
     * `ch.readAsync` into a local for the response — rather than going through
     * the buffered [`AsyncReader`](../AsyncReader.cajeta)/[`AsyncWriter`](../AsyncWriter.cajeta).
     * The pure [`HttpParser`](HttpParser.cajeta) already buffers/streams the
     * head + body across arbitrary feed splits (NET-7.3), so a local read loop
     * is all the client needs, and it keeps the hot path on the direct,
     * stateless interface calls.
     */
    static #HttpResponse exchange(ByteChannel ch, HttpRequest req) {
        int8[] reqBytes = HttpSerializer.request(req);
        int32 reqLen = reqBytes.count();
        ch.writeAllAsync(reqBytes, (int64) 0, (int64) reqLen);
        return HttpClient.readResponse(ch);
    }

    /**
     * The plaintext twin of [`exchange`](#exchange), deadline-aware
     * (http:1.4c): every response read parks at most until `deadline`
     * (absolute epoch millis; `0` = unbounded) via
     * [`TcpStream.readWithin`](../../../../cajeta/io/net/TcpStream.cajeta#readWithin),
     * raising `TimedOutException` when the budget runs dry. Takes the
     * concrete `TcpStream` — `readWithin` is not on the `ByteChannel`
     * seam (and `TlsStream` doesn't have it), which is why the TLS path
     * still rides the untimed `exchange`. The request write stays
     * unbudgeted (no `writeWithin` in the stdlib yet — plan note).
     */
    static #HttpResponse exchangeTimed(TcpStream s, HttpRequest req, int64 deadline) {
        int8[] reqBytes = HttpSerializer.request(req);
        int32 reqLen = reqBytes.count();
        s.writeAllAsync(reqBytes, (int64) 0, (int64) reqLen);
        return HttpClient.readResponseTimed(s, deadline);
    }

    /**
     * Read one HTTP/1.1 response off `ch`: pull chunks into a local scratch
     * buffer with [`ByteChannel.readAsync`](../ByteChannel.cajeta#readAsync),
     * feeding each to the incremental [`HttpParser`](HttpParser.cajeta) until
     * the head terminates, then drive a [`BodyReader`](BodyReader.cajeta) for
     * the parser's [`BodyFraming`](BodyFraming.cajeta) decision (seeded with the
     * parser leftover, then pulling more) until the body completes or the peer
     * closes. The decoded body is attached to the detached response.
     */
    static #HttpResponse readResponse(ByteChannel ch) {
        HttpParser parser = HttpParser.forResponse();
        int8[] scratch = heap int8[8192];
        while (!parser.isComplete()) {
            int64 n = ch.readAsync(scratch, (int64) 0, (int64) 8192);
            int32 got = (int32) n;
            if (got <= 0) {
                parser.endInput();      // truncated head -> UnexpectedEof
                break;
            }
            parser.feed(scratch, got);
        }

        HttpResponse response = parser.takeResponse();
        BodyFraming framing = parser.getFraming();

        BodyReader body = BodyReader.forFraming(framing);
        int8[] leftover = parser.leftover();
        int32 leftoverLen = parser.leftoverLength();
        if (leftoverLen > 0) {
            body.feed(leftover, leftoverLen);
        }
        while (!body.isComplete()) {
            int64 n = ch.readAsync(scratch, (int64) 0, (int64) 8192);
            int32 got = (int32) n;
            if (got <= 0) {
                body.endInput();        // KIND_CLOSE completes; others -> UnexpectedEof
                break;
            }
            body.feed(scratch, got);
        }
        int8[] decoded = body.drain();
        int32 decodedLen = decoded.count();
        if (decodedLen > 0) {
            response.body(decoded, decodedLen);
        }
        return #response;
    }

    /**
     * Deadline-aware twin of [`readResponse`](#readResponse) — the same
     * head-then-body drive with every read going through
     * [`readBudgeted`](#readBudgeted). Kept as a separate loop rather
     * than a lambda-parameterized one: capturing lambdas still carry the
     * open double-free wrinkle, and the duplication is two small loops.
     */
    static #HttpResponse readResponseTimed(TcpStream s, int64 deadline) {
        HttpParser parser = HttpParser.forResponse();
        int8[] scratch = heap int8[8192];
        while (!parser.isComplete()) {
            int64 n = HttpClient.readBudgeted(s, scratch, deadline);
            int32 got = (int32) n;
            if (got <= 0) {
                parser.endInput();      // truncated head -> UnexpectedEof
                break;
            }
            parser.feed(scratch, got);
        }

        HttpResponse response = parser.takeResponse();
        BodyFraming framing = parser.getFraming();

        BodyReader body = BodyReader.forFraming(framing);
        int8[] leftover = parser.leftover();
        int32 leftoverLen = parser.leftoverLength();
        if (leftoverLen > 0) {
            body.feed(leftover, leftoverLen);
        }
        while (!body.isComplete()) {
            int64 n = HttpClient.readBudgeted(s, scratch, deadline);
            int32 got = (int32) n;
            if (got <= 0) {
                body.endInput();        // KIND_CLOSE completes; others -> UnexpectedEof
                break;
            }
            body.feed(scratch, got);
        }
        int8[] decoded = body.drain();
        int32 decodedLen = decoded.count();
        if (decodedLen > 0) {
            response.body(decoded, decodedLen);
        }
        return #response;
    }

    /**
     * One budgeted read: unbounded `readAsync` when `deadline` is `0`,
     * else `readWithin` with the REMAINING budget (raising
     * `TimedOutException` here when it is already spent, so a
     * many-small-reads body cannot overshoot the deadline by one park).
     */
    static int64 readBudgeted(TcpStream s, int8[] scratch, int64 deadline) {
        if (deadline == (int64) 0) {
            return s.readAsync(scratch, (int64) 0, (int64) 8192);
        }
        Instant now = Clock.now();
        int64 remaining = deadline - now.toEpochMilli();
        if (remaining <= (int64) 0) {
            throw heap TimedOutException("exchange budget exhausted");
        }
        return s.readWithin(scratch, (int64) 0, (int64) 8192, (int32) remaining);
    }

    // ----- resolution ------------------------------------------------------

    /**
     * Resolve `host` (numeric literal or name, via NET-2
     * [`Dns`](../dns/Dns.cajeta)) to its endpoints on `port` and connect a
     * fiber-parking [`TcpStream`](../TcpStream.cajeta) to the **first that
     * accepts**, trying each in turn on a connect failure — the minimal
     * try-all-addresses behavior that lets a dual-stack name
     * (`localhost` → `::1` + `127.0.0.1`) connect regardless of which family
     * the peer is actually listening on. Each candidate
     * [`SocketAddress`](../SocketAddress.cajeta) is rebuilt from the resolved
     * octets so it owns its bytes independently of the (dropped) resolve
     * array. Raises a [`NetException`](../NetException.cajeta) if every
     * resolved address fails to connect.
     */
    static #TcpStream connectAny(String host, int32 port) {
        // v1: resolve IPv4 and connect to the first endpoint. (The
        // try-all-addresses fallback over a `try`/`catch` around the parking
        // `connectAsync` is deferred — exception unwinding across a fiber park
        // is fragile in the current JIT; a non-throwing connect-result probe is
        // the right primitive for happy-eyeballs and is a follow-up.)
        SocketAddress[] addrs = Dns.resolve(host, port, ResolveFamily.V4_ONLY);
        SocketAddress a0 = addrs[0];
        IpAddress ip = a0.getIp();
        // `getOctets` returns the raw 16-byte backing buffer regardless of
        // family (IPv4 lives in `octets[0..4)`), so the family-relevant length
        // must come from the address family — NOT `oct.count()`, which is
        // always 16 and would re-interpret a V4 address as V6 (`fromOctets`
        // selects the family from `len`). Mirrors the DnsCache rebuild idiom.
        int8[] oct = ip.getOctets();
        int32 olen = 16;
        if (ip.isV4()) {
            olen = 4;
        }
        IpAddress ipCopy = IpAddress.fromOctets(oct, olen);
        SocketAddress connAddr = SocketAddress.of(#ipCopy, port);
        return TcpStream.connectAsync(#connAddr);
    }

    // ----- small helpers ---------------------------------------------------

    /**
     * Fill `req`'s `Host` header from `uri`'s authority when the request
     * doesn't already carry one (a hand-built request might not). Uses the
     * same host[:port] rule as [`HttpRequest.fromUri`](HttpRequest.cajeta).
     */
    static void ensureHost(HttpRequest req, Uri uri) {
        if (req.getHeaders().contains("Host")) {
            return;
        }
        if (!uri.hasAuthority) {
            return;
        }
        req.setHeader("Host", uri.getHost());
    }

    /** True iff `scheme` is `"https"` (case already lowered by `Uri`). */
    static boolean isHttps(String scheme) {
        if (scheme.byteLength() != 5) {
            return false;
        }
        int8[] b = scheme.toBytes();
        return b[0] == (int8) 104    // 'h'
            && b[1] == (int8) 116    // 't'
            && b[2] == (int8) 116    // 't'
            && b[3] == (int8) 112    // 'p'
            && b[4] == (int8) 115;   // 's'
    }

    /**
     * The ALPN wire list offering a single `http/1.1` protocol:
     * `\x08http/1.1` (a one-byte length `8` then the 8 token bytes). 9 bytes.
     */
    static #int8[] alpnHttp11() {
        int8[] a = heap int8[9];
        a[0] = (int8) 8;
        a[1] = (int8) 104;   // 'h'
        a[2] = (int8) 116;   // 't'
        a[3] = (int8) 116;   // 't'
        a[4] = (int8) 112;   // 'p'
        a[5] = (int8) 47;    // '/'
        a[6] = (int8) 49;    // '1'
        a[7] = (int8) 46;    // '.'
        a[8] = (int8) 49;    // '1'
        return #a;
    }
}
