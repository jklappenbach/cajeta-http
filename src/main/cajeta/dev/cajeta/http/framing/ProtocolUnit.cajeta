package dev.cajeta.http.framing;

/** One complete unit of a developer-framed protocol: its kind and its bytes, owned by the unit. */
public final class ProtocolUnit {
    int32 kindN;
    int8[] data;
    int32 len;

    public ProtocolUnit() {
        this.kindN = 0;
        this.data = heap int8[256];
        this.len = 0;
    }

    /** Makes this unit `kind` with a copy of `src[off, off + n)`, reusing the buffer when it fits. */
    public void fill(int32 kind, int8[] src, int32 off, int32 n) {
        if ((int64) n > this.data.count()) {
            this.data = heap int8[n];
        }
        int32 i = 0;
        while (i < n) {
            this.data[i] = src[off + i];
            i = i + 1;
        }
        this.kindN = kind;
        this.len = n;
    }

    public int32 kind() {
        return this.kindN;
    }

    /** The unit's bytes, valid for the handler call; `length()` of them are the unit. */
    public int8[] bytes() {
        return this.data;
    }

    public int32 length() {
        return this.len;
    }
}
