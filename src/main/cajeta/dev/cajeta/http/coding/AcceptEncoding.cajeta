package dev.cajeta.http.coding;

import cajeta.lang.String;

/**
 * `Accept-Encoding` negotiation: the registered coding a response should use.
 * Each listed coding carries a quality (`q`, default 1, and 0 forbids it), and
 * `*` supplies the quality of any coding not listed. The highest quality wins,
 * and a tie goes to the coding registered first, so gzip beats deflate. An
 * alias counts toward its coding. With nothing acceptable the answer is
 * `identity`, which is always a valid response. Qualities are integer
 * milli-units, so no float is parsed on the request path.
 */
public final class AcceptEncoding {

    /** The coding to encode a response with for this `Accept-Encoding` value, or `identity`. */
    public static String best(String header) {
        if (header == null) {
            return "identity";
        }
        String h #= header.toLowerCase();
        int32 starQ = AcceptEncoding.milliQ(h, "*");
        String chosen = "identity";
        int32 chosenQ = 0;
        int32 n = ContentCodings.count();
        int32 i = 0;
        while (i < n) {
            String primary = ContentCodings.primaryAt(i);
            if (!primary.equals("identity") && ContentCodings.tokenAt(i).equals(primary)) {
                int32 q = AcceptEncoding.qualityOf(h, primary, starQ);
                if (q > chosenQ) {
                    chosen = primary;
                    chosenQ = q;
                }
            }
            i = i + 1;
        }
        return chosen;
    }

    // The quality of `primary`: the best of its own token and its aliases, else `*`'s.
    static int32 qualityOf(String h, String primary, int32 starQ) {
        int32 q = -1;
        int32 n = ContentCodings.count();
        int32 i = 0;
        while (i < n) {
            if (ContentCodings.primaryAt(i).equals(primary)) {
                int32 t = AcceptEncoding.milliQ(h, ContentCodings.tokenAt(i));
                if (t > q) {
                    q = t;
                }
            }
            i = i + 1;
        }
        if (q < 0) {
            return starQ;
        }
        return q;
    }

    /** Milli-quality (0..1000) for `token` in `h`, or `-1` if not listed. */
    static int32 milliQ(String h, String token) {
        int32 n = h.byteLength();
        int32 start = 0;
        while (start < n) {
            int64 c = h.indexOfFrom(",", (int64) start);
            int32 end = n;
            if (c >= (int64) 0) {
                end = (int32) c;
            }
            String seg #= h.substring(start, end).trim();
            int32 q = AcceptEncoding.segMatch(seg, token);
            if (q >= 0) {
                return q;
            }
            if (c < (int64) 0) {
                start = n;
            } else {
                start = (int32) c + 1;
            }
        }
        return -1;
    }

    /** If `seg` (`"gzip"` / `"gzip;q=0.5"`) names `token`, its milli-q; else -1. */
    static int32 segMatch(String seg, String token) {
        int64 sc = seg.indexOf(";");
        String name = seg;
        if (sc >= (int64) 0) {
            name #= seg.substring(0, (int32) sc).trim();
        }
        if (!name.equals(token)) {
            return -1;
        }
        if (sc < (int64) 0) {
            return 1000;
        }
        String params #= seg.substring((int32) sc + 1, seg.byteLength());
        int64 qi = params.indexOf("q=");
        if (qi < (int64) 0) {
            return 1000;
        }
        String qv #= params.substring((int32) qi + 2, params.byteLength()).trim();
        return AcceptEncoding.parseMilli(qv);
    }

    /** Parse `"0.5"` / `"1"` / `"0"` → milli-units (0..1000); lenient. */
    static int32 parseMilli(String qv) {
        int32 n = qv.byteLength();
        if (n == 0) {
            return 0;
        }
        int8[] b #= qv.toBytes();
        int32 intPart = 0;
        int32 i = 0;
        while (i < n && b[i] != (int8) 46) {
            int32 d = ((int32) b[i]) - 48;
            if (d < 0 || d > 9) {
                return 0;
            }
            intPart = intPart * 10 + d;
            i = i + 1;
        }
        int32 milli = intPart * 1000;
        if (i < n && b[i] == (int8) 46) {
            i = i + 1;
            int32 scale = 100;
            while (i < n && scale > 0) {
                int32 d = ((int32) b[i]) - 48;
                if (d < 0 || d > 9) {
                    i = n;
                } else {
                    milli = milli + d * scale;
                    scale = scale / 10;
                    i = i + 1;
                }
            }
        }
        if (milli > 1000) {
            milli = 1000;
        }
        return milli;
    }
}
