package dev.cajeta.http.coding;

import cajeta.lang.String;
import cajeta.wire.Compressor;
import cajeta.wire.Decompressor;
import cajeta.wire.DecompressionLimitException;

/**
 * Encode and decode by content-coding token, through the codings registered in
 * `ContentCodings`. Every failure (malformed input, output over the cap, an
 * unknown token) raises `ContentCodingException`, an `HttpException`.
 */
public final class ContentCoding {

    /** True when `token` names a registered coding. */
    public static boolean isSupported(String token) {
        return ContentCodings.isSupported(token);
    }

    /** Encodes `data[0 .. len)` under `token` at level 1, the fast level a request path wants. */
    public static #int8[] encode(String token, int8[] data, int32 len) {
        return ContentCoding.encode(token, data, len, 1);
    }

    /** Encodes `data[0 .. len)` under `token` at `level` (1 fastest to 9 smallest). */
    public static #int8[] encode(String token, int8[] data, int32 len, int32 level) {
        Compressor c = ContentCodings.compressor(token);
        if (c == null) {
            throw heap ContentCodingException("unsupported content-coding: " + token);
        }
        return c.compress(data, (int64) len, level);
    }

    /** Decodes `data[0 .. len)` under `token`, rejecting more than `maxOut` bytes of output. */
    public static #int8[] decode(String token, int8[] data, int32 len, int64 maxOut) {
        Decompressor d = ContentCodings.decompressor(token);
        if (d == null) {
            throw heap ContentCodingException("unsupported content-coding: " + token);
        }
        try {
            return d.decompress(data, (int64) len, maxOut);
        } catch (DecompressionLimitException e) {
            throw heap ContentCodingException("decoded body exceeds the decode cap");
        }
    }
}
