package dev.cajeta.http.middleware;

import cajeta.lang.String;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;

class Link {
    Middleware layer;
    (HttpRequest, HttpResponse) -> void next;
    (HttpRequest, HttpResponse) -> void entry;

    Link() {
    }
}

/**
 * An ordered list of middleware composed around one handler.
 *
 * `build` composes the layers once, and `run` enters the outermost layer.
 * The first layer added runs first. Running allocates nothing, because the
 * composition is made at registration and kept by the chain.
 */
public class MiddlewareChain {
    Middleware[] mws;
    int32 count;
    Link[] links;
    (HttpRequest, HttpResponse) -> void terminal;

    /** An empty chain. */
    public MiddlewareChain() {
        this.mws = heap Middleware[4];
        this.count = 0;
        this.links = null;
    }

    /** Number of layers. */
    public int32 size() {
        return this.count;
    }

    /** Adds a layer inside the ones already added. */
    public MiddlewareChain use(#Middleware m) {
        if (this.count >= this.mws.count()) {
            Middleware[] grown = heap Middleware[this.mws.count() * 2];
            int32 j = 0;
            while (j < this.count) {
                grown[j] #= this.mws[j];
                j = j + 1;
            }
            this.mws #= grown;
        }
        this.mws[this.count] = #m;
        this.count = this.count + 1;
        return this;
    }

    /** Composes the layers around `handler`, which must outlive the chain. */
    public void build((HttpRequest, HttpResponse) -> void handler) {
        this.terminal #= handler;
        if (this.count == 0) {
            return;
        }
        this.links = heap Link[this.count];
        (HttpRequest, HttpResponse) -> void next = this.terminal;
        int32 i = this.count - 1;
        while (i >= 0) {
            this.links[i] = heap Link();
            Link lk = this.links[i];
            lk.layer #= this.mws[i];
            lk.next #= next;
            (HttpRequest, HttpResponse) -> void entry = (HttpRequest q, HttpResponse r) -> {
                (HttpRequest, HttpResponse, (HttpRequest, HttpResponse) -> void) -> void f = lk.layer.fn;
                (HttpRequest, HttpResponse) -> void n = lk.next;
                f(q, r, n);
            };
            lk.entry #= entry;
            next = this.links[i].entry;
            i = i - 1;
        }
    }

    /** Runs the composed chain. `build` must have been called. */
    public void run(HttpRequest q, HttpResponse r) {
        if (this.count == 0) {
            (HttpRequest, HttpResponse) -> void t = this.terminal;
            t(q, r);
            return;
        }
        (HttpRequest, HttpResponse) -> void h = this.links[0].entry;
        h(q, r);
    }
}
