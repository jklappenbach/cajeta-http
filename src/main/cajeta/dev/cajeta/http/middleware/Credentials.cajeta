package dev.cajeta.http.middleware;

import cajeta.lang.String;

/**
 * Credential-comparison helpers for the auth middlewares (http:2.2d).
 *
 * [`constantTimeEquals`](#constantTimeEquals) compares two secrets in time
 * that does **not** depend on where they first differ — a naive `equals`
 * returns on the first mismatched byte, leaking, over many probes, how long a
 * guessed prefix was correct. A verifier lambda comparing a supplied token to
 * an expected one should use this, not `==`/`equals`.
 *
 * The library stores **no** credentials itself; this is only the safe
 * primitive a caller-supplied verifier reaches for.
 */
public final class Credentials {

    /**
     * Constant-time (in the shorter length) byte-equality of two strings.
     * Length difference is folded into the result, so unequal-length inputs
     * compare `false` without an early return.
     */
    public static boolean constantTimeEquals(String a, String b) {
        int8[] ba #= a.toBytes();
        int8[] bb #= b.toBytes();
        int32 la = ba.count();
        int32 lb = bb.count();
        int32 diff = la ^ lb;
        int32 n = la;
        if (lb < n) {
            n = lb;
        }
        int32 i = 0;
        while (i < n) {
            diff = diff | (((int32) ba[i]) ^ ((int32) bb[i]));
            i = i + 1;
        }
        return diff == 0;
    }
}
