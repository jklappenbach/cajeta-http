package dev.cajeta.http.middleware;

import cajeta.lang.String;

/**
 * The **path jail** for [`StaticFile`](StaticFile.cajeta) (http:2.2e) — the
 * security floor. Turns a raw request target into a **safe relative path**
 * under the served root, or **rejects** it. Pure and filesystem-free, so the
 * traversal fuzz runs deterministically.
 *
 * ## What [`jail`](#jail) does
 *
 *   1. **Percent-decode first**, so `%2e%2e` (`..`) and `%2f` (`/`) can't
 *      smuggle traversal past the segment walk — a decoded `/` simply becomes
 *      another separator, never a hidden path element.
 *   2. **Reject** control bytes / NUL (truncation and log-injection tricks)
 *      and **backslashes** (Windows-style separators that a naive `/`-split
 *      would miss).
 *   3. **Walk segments** on `/`: drop `.` and empty parts; on `..` pop the
 *      accumulated stack, and if it would pop **above** the root, reject the
 *      whole request — no `..` ever escapes.
 *   4. Rejoin the survivors into a root-relative path (empty = the root
 *      itself, which the caller maps to an index file).
 *
 * This blocks `..`, `%2e%2e`, `%2f`, backslashes, and absolute paths lexically
 * — before any filesystem call. [`StaticFile`](StaticFile.cajeta) layers a
 * **canonical-path** check on top to also defeat symlink escape.
 */
public final class StaticPath {

    /** Max path segments; a deeper path is rejected rather than grown. */
    static final int32 MAX_SEGMENTS = 64;

    /** Safe root-relative path for `urlPath`, or null if it must be rejected. */
    public static #String jail(String urlPath) {
        String decoded = StaticPath.percentDecode(urlPath);
        if (decoded == null) {
            return null;
        }
        int32 n = decoded.byteLength();
        int32 ci = 0;
        while (ci < n) {
            int32 cv = ((int32) decoded.byteAt(ci)) & 0xFF;
            if (cv < 32) {
                return null;
            }
            if (cv == 92) {
                return null;
            }
            ci = ci + 1;
        }

        String[] segs = heap String[64];
        int32 segCount = 0;
        int32 start = 0;
        int32 i = 0;
        while (i <= n) {
            boolean atSep = i == n || decoded.byteAt(i) == (int8) 47;
            if (atSep) {
                if (i > start) {
                    String seg = decoded.substring(start, i);
                    if (seg.equals(".")) {
                        // current dir — drop
                    } else if (seg.equals("..")) {
                        if (segCount == 0) {
                            return null;
                        }
                        segCount = segCount - 1;
                    } else {
                        if (segCount >= StaticPath.MAX_SEGMENTS) {
                            return null;
                        }
                        segs[segCount] = #seg;
                        segCount = segCount + 1;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }

        if (segCount == 0) {
            String e = "";
            return e.substring(0, 0);
        }
        String out = segs[0].substring(0, segs[0].byteLength());
        int32 j = 1;
        while (j < segCount) {
            out = out + "/" + segs[j];
            j = j + 1;
        }
        return #out;
    }

    /** Percent-decode `s`, or null on a truncated/invalid `%XX`. */
    static #String percentDecode(String s) {
        int32 n = s.byteLength();
        int8[] out = heap int8[n];
        int32 oi = 0;
        int32 i = 0;
        while (i < n) {
            int8 ch = s.byteAt(i);
            if (ch == (int8) 37) {
                if (i + 2 >= n) {
                    return null;
                }
                int32 hi = StaticPath.hexVal(s.byteAt(i + 1));
                int32 lo = StaticPath.hexVal(s.byteAt(i + 2));
                if (hi < 0 || lo < 0) {
                    return null;
                }
                out[oi] = (int8) (hi * 16 + lo);
                oi = oi + 1;
                i = i + 3;
            } else {
                out[oi] = ch;
                oi = oi + 1;
                i = i + 1;
            }
        }
        int8[] trimmed = heap int8[oi];
        int32 k = 0;
        while (k < oi) {
            trimmed[k] = out[k];
            k = k + 1;
        }
        return heap String(#trimmed, oi);
    }

    /** Hex digit value of an ASCII byte, or -1. */
    static int32 hexVal(int8 b) {
        int32 v = ((int32) b) & 0xFF;
        if (v >= 48 && v <= 57) {
            return v - 48;
        }
        if (v >= 97 && v <= 102) {
            return v - 97 + 10;
        }
        if (v >= 65 && v <= 70) {
            return v - 65 + 10;
        }
        return -1;
    }
}
