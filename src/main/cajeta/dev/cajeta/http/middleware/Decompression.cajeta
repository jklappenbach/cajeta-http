package dev.cajeta.http.middleware;

import cajeta.lang.String;
import cajeta.lang.Slice;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.coding.ContentCoding;

/**
 * Decodes a request body sent with `Content-Encoding`. The handler sees the
 * decoded body with the encoding header removed and the length updated. An
 * unknown coding answers 415, a body over the cap 413, and a corrupt one 400.
 */
public class Decompression {
    int64 maxBytes;

    /** A decoder capped at 10 MiB of output. */
    public Decompression() {
        this.maxBytes = (int64) 10485760;
    }

    /** A decoder capped at 10 MiB of output. */
    public static #Decompression create() {
        return heap Decompression();
    }

    /** Caps the decoded body at `n` bytes. */
    public Decompression maxSize(int64 n) {
        this.maxBytes = n;
        return this;
    }

    /** Builds the middleware for `cfg`, which must outlive the chain. */
    public static #Middleware middleware(Decompression cfg) {
        (HttpRequest, HttpResponse, (HttpRequest, HttpResponse) -> void) -> void f =
            (HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> Decompression.apply(cfg, q, r, next);
        return Middleware.of(#f);
    }

    static void apply(Decompression cfg, HttpRequest q, HttpResponse r,
                      (HttpRequest, HttpResponse) -> void next) {
        if (!q.hasHeader("Content-Encoding") || q.bodyLength() == 0) {
            next(q, r);
            return;
        }
        Slice<int8> ce = Bytes.trim(q.header("Content-Encoding"));
        if (Bytes.equalsIgnoreCase(ce, "identity")) {
            next(q, r);
            return;
        }
        String coding #= Bytes.toString(ce).toLowerCase();
        if (!ContentCoding.isSupported(coding)) {
            r.status(415);
            return;
        }
        try {
            int8[] raw #= Bytes.copyOf(q.body());
            int8[] decoded #= ContentCoding.decode(coding, raw, raw.count(), cfg.maxBytes);
            int32 dn = decoded.count();
            q.replaceBody(#decoded, dn);
            q.removeHeader("Content-Encoding");
            q.setHeader("Content-Length", "" + dn);
        } catch (Exception e) {
            String m = e.getMessage();
            r.status(m != null && m.contains("cap") ? 413 : 400);
            return;
        }
        next(q, r);
    }
}
