package dev.cajeta.http.middleware;

import cajeta.lang.String;
import cajeta.io.file.File;
import cajeta.io.file.Path;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.middleware.Middleware;
import dev.cajeta.http.middleware.StaticPath;

/**
 * **StaticFile** middleware — plan item **2.2e**. Serves files from a
 * root-jailed directory: `GET`/`HEAD` resolve to a file under the root (an
 * index file for a directory), everything else falls through to `next`.
 *
 * ```
 * StaticFile sf = StaticFile.create("public").indexFile("index.html");
 * chain.use(StaticFile.middleware(sf));
 * ```
 *
 * ## The jail is two layers
 *
 *   1. **Lexical** ([`StaticPath.jail`](StaticPath.cajeta)) — percent-decode
 *      then walk segments, rejecting `..`/`%2e%2e`/`%2f`/backslashes/absolute
 *      before touching the disk. A rejected path is **`403`**.
 *   2. **Canonical** — `Path.canonical()` (realpath) the resolved file and
 *      require it to stay **under the canonical root**. This is what defeats a
 *      **symlink** pointing outside the root (which survives the lexical pass —
 *      it's a normal-looking name). Escape is **`403`**.
 *
 * A path that resolves cleanly but names nothing (or a non-file) is **`404`**.
 * `Content-Type` comes from the extension; `HEAD` returns the headers with no
 * body.
 *
 * v1 reads the whole file into memory ([`File.readAllBytes`](../../../io/file/File.cajeta));
 * range requests and streamed sends of huge files are a later increment.
 */
public class StaticFile {
    String rootStr;
    String rootCanon;
    boolean canonReady;
    String index;

    public StaticFile(String root) {
        this.rootStr #= root.substring(0, root.byteLength());
        this.rootCanon = null;
        this.canonReady = false;
        this.index = "index.html";
    }

    /** A server rooted at `root` (a directory path). */
    public static #StaticFile create(String root) {
        return heap StaticFile(root);
    }

    /** Set the directory index filename (default `index.html`). */
    public StaticFile indexFile(String name) {
        this.index #= name.substring(0, name.byteLength());
        return this;
    }

    /** Build the middleware from config `cfg` (captured by the lambda). */
    public static #Middleware middleware(StaticFile cfg) {
        (HttpRequest, (HttpRequest) -> #HttpResponse) -> #HttpResponse f =
            (req, next) -> StaticFile.apply(cfg, req, next);
        return Middleware.of(#f);
    }

    static #HttpResponse apply(StaticFile cfg, HttpRequest req,
                               (HttpRequest) -> #HttpResponse next) {
        String method = req.getMethod();
        boolean head = method.equals("HEAD");
        if (!method.equals("GET") && !head) {
            return next(req);
        }

        String pathOnly #= StaticFile.stripQuery(req.getTarget());
        String rel #= StaticPath.jail(pathOnly);
        if (rel == null) {
            return HttpResponse.of(403);
        }

        String serveFull #= StaticFile.joinRoot(cfg.rootStr, rel);
        Path p #= Path.of(serveFull);
        if (p.isDir()) {
            serveFull = serveFull + "/" + cfg.index;
            p #= Path.of(serveFull);
        }
        if (!p.exists() || !p.isFile()) {
            return HttpResponse.of(404);
        }

        String canonRoot = cfg.canonRoot();
        if (canonRoot == null) {
            return HttpResponse.of(404);
        }
        String canonFile #= StaticFile.canonStr(serveFull);
        if (canonFile == null || !StaticFile.underRoot(canonFile, canonRoot)) {
            return HttpResponse.of(403);
        }

        int8[] bytes = File.readAllBytes(serveFull);
        int32 blen = bytes.count();
        HttpResponse resp #= HttpResponse.ok();
        resp.setHeader("Content-Type", StaticFile.contentTypeFor(serveFull));
        if (head) {
            resp.setHeader("Content-Length", "" + blen);
            return #resp;
        }
        resp.body(bytes, blen);
        return #resp;
    }

    /** Everything before a `?`, if any. */
    static #String stripQuery(String target) {
        int64 q = target.indexOf("?");
        if (q < (int64) 0) {
            return target.substring(0, target.byteLength());
        }
        return target.substring(0, (int32) q);
    }

    /** `root` joined with a (possibly empty) safe relative path. */
    static #String joinRoot(String root, String rel) {
        if (rel.byteLength() == 0) {
            return root.substring(0, root.byteLength());
        }
        return root + "/" + rel;
    }

    /** Canonical root (realpath), computed once; null if the root is missing. */
    String canonRoot() {
        if (!this.canonReady) {
            Path rp #= Path.of(this.rootStr);
            if (rp.exists()) {
                this.rootCanon #= StaticFile.canonStr(this.rootStr);
            }
            this.canonReady = true;
        }
        return this.rootCanon;
    }

    /** realpath(`full`) as a string, or null if it can't be canonicalized. */
    static #String canonStr(String full) {
        try {
            Path c = Path.of(full).canonical();
            int8[] b = c.bytes;
            int32 n = b.count();
            int8[] copy = heap int8[n];
            int32 i = 0;
            while (i < n) {
                copy[i] = b[i];
                i = i + 1;
            }
            return heap String(#copy, n);
        } catch (Exception e) {
            return null;
        }
    }

    /** True iff `file` is `root` itself or a path strictly beneath it. */
    static boolean underRoot(String file, String root) {
        if (!file.startsWith(root)) {
            return false;
        }
        int32 rn = root.byteLength();
        if (file.byteLength() == rn) {
            return true;
        }
        return file.byteAt(rn) == (int8) 47;
    }

    /** Media type for the file's extension, or `application/octet-stream`. */
    static String contentTypeFor(String path) {
        Path p #= Path.of(path);
        String ext #= p.extension();
        String e #= ext.toLowerCase();
        if (e.equals("html") || e.equals("htm")) {
            return "text/html; charset=utf-8";
        }
        if (e.equals("css")) {
            return "text/css; charset=utf-8";
        }
        if (e.equals("js") || e.equals("mjs")) {
            return "application/javascript";
        }
        if (e.equals("json")) {
            return "application/json";
        }
        if (e.equals("txt")) {
            return "text/plain; charset=utf-8";
        }
        if (e.equals("svg")) {
            return "image/svg+xml";
        }
        if (e.equals("png")) {
            return "image/png";
        }
        if (e.equals("jpg") || e.equals("jpeg")) {
            return "image/jpeg";
        }
        if (e.equals("gif")) {
            return "image/gif";
        }
        if (e.equals("ico")) {
            return "image/x-icon";
        }
        if (e.equals("wasm")) {
            return "application/wasm";
        }
        return "application/octet-stream";
    }
}
