package dev.cajeta.http.middleware;

import cajeta.lang.String;
import cajeta.concurrent.AtomicInt32;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;

/**
 * Gives every request a correlation id: an inbound `X-Request-Id` is kept,
 * otherwise a `req-<n>` id is set on the request, and the id is echoed on the
 * response. A client-supplied id costs no allocation.
 */
public class RequestId {
    /** The propagated and echoed header name. */
    public static final String HEADER = "X-Request-Id";

    static AtomicInt32 counter;

    /** Builds the middleware. */
    public static #Middleware middleware() {
        (HttpRequest, HttpResponse, (HttpRequest, HttpResponse) -> void) -> void f =
            (HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> RequestId.apply(q, r, next);
        return Middleware.of(#f);
    }

    static void apply(HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) {
        if (!q.hasHeader("X-Request-Id")) {
            String id #= RequestId.generate();
            q.setHeader("X-Request-Id", id);
        }
        next(q, r);
        if (!r.isCommitted()) {
            r.setHeaderBytes("X-Request-Id", q.header("X-Request-Id"));
        }
    }

    static #String generate() {
        if (RequestId.counter == null) {
            RequestId.counter = heap AtomicInt32(0);
        }
        int32 n = RequestId.counter.fetchAdd(1);
        return "req-" + n;
    }
}
