package dev.cajeta.http.middleware;

import cajeta.lang.String;
import cajeta.time.Clock;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;

/** Writes one `METHOD target status Nms` line per request to a `LogSink`. */
public class Logging {
    /** Builds the middleware writing to `sink`, which must outlive the chain. */
    public static #Middleware middleware(LogSink sink) {
        (HttpRequest, HttpResponse, (HttpRequest, HttpResponse) -> void) -> void f =
            (HttpRequest q, HttpResponse r, (HttpRequest, HttpResponse) -> void next) -> Logging.apply(sink, q, r, next);
        return Middleware.of(#f);
    }

    static void apply(LogSink sink, HttpRequest q, HttpResponse r,
                      (HttpRequest, HttpResponse) -> void next) {
        int64 start = Clock.now().toEpochMilli();
        next(q, r);
        int64 dur = Clock.now().toEpochMilli() - start;
        String line #= Bytes.toString(q.methodBytes()) + " " + q.targetString() + " "
                    + r.status() + " " + dur + "ms";
        sink.line(#line);
    }
}
