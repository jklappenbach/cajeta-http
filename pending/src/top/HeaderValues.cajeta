package dev.cajeta.http;

import cajeta.lang.String;
import cajeta.io.net.Headers;
import dev.cajeta.http.MediaType;

/**
 * **Typed reads over a header map** (spec §Core types' `contentLength()` /
 * `contentType()` accessors). The `Headers` map itself is the stdlib's
 * (`cajeta.io.net.Headers`), so the typed layer lives here, library-side;
 * [`HttpRequest`](HttpRequest.cajeta) and
 * [`HttpResponse`](HttpResponse.cajeta) expose these as instance
 * accessors, and this class is the shared implementation.
 *
 * Absence and malformedness both answer the sentinel (`-1` / `null`)
 * rather than throwing: a typed read is a *query*, and the wire-level
 * validation (a malformed `Content-Length` being a 400) already lives in
 * [`HttpParser`](h1/HttpParser.cajeta).
 */
public final class HeaderValues {

    /**
     * The `Content-Length` value as a length, or `-1` when the header is
     * absent, empty, or not a pure digit run (no sign, no whitespace —
     * RFC 9110 §8.6's `1*DIGIT`).
     */
    public static int64 contentLength(Headers headers) {
        if (headers == null) {
            return (int64) -1;
        }
        String v #= headers.get("Content-Length");
        if (v == null) {
            return (int64) -1;
        }
        int32 n = v.byteLength();
        if (n == 0) {
            return (int64) -1;
        }
        int64 total = 0;
        int32 i = 0;
        while (i < n) {
            int32 b = ((int32) v.byteAt(i)) & 0xff;
            if (b < 48 || b > 57) {          // not '0'..'9'
                return (int64) -1;
            }
            total = total * 10 + (int64) (b - 48);
            i = i + 1;
        }
        return total;
    }

    /**
     * The `Content-Type` header parsed as a [`MediaType`](MediaType.cajeta),
     * or `null` when absent or not `type "/" subtype` shaped.
     */
    public static #MediaType contentType(Headers headers) {
        if (headers == null) {
            return null;
        }
        String v #= headers.get("Content-Type");
        if (v == null) {
            return null;
        }
        return MediaType.parse(v);
    }
}
