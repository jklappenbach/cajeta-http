package dev.cajeta.http.test;

import cajeta.io.net.Server;
import cajeta.io.net.TcpStream;
import cajeta.io.net.uri.Uri;
import cajeta.time.Duration;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.TooManyRedirectsException;
import dev.cajeta.http.client.HttpClient;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;

/**
 * http:1.4b — redirect following. `HttpClient.sendFollowing` against a
 * loopback server whose `/final` echoes `method|authorization|body`, so
 * one assertion pins the whole per-hop rewrite:
 *
 *   - 301/302: POST → GET, body dropped (the de-facto table); auth kept
 *     on the same origin.
 *   - 303: → GET, body dropped.
 *   - 307/308: method + body preserved.
 *   - relative `Location` (no leading slash) resolves against the
 *     redirecting URL's path (RFC 3986 merge, via the stdlib `Uri`).
 *   - a self-redirect trips the hop cap → `TooManyRedirectsException`.
 *   - a cross-origin hop strips `Authorization`; a same-origin
 *     absolute-URL hop keeps it.
 *
 * Accept accounting as in ClientPoolTests: same-origin chains ride ONE
 * pooled connection (the server accepts once per scenario, and every
 * await completes only if that held).
 */
public final class RedirectTests {

    /** Own-origin port for the absolute same-origin Location. */
    static int32 ownPort = 0;
    /** The second origin's port (cross-origin strip test). */
    static int32 xPort = 0;

    public static void run(Check c) {
        System.stdout.println("-- client redirects: rewrite table --");
        sameOriginTable(c);
        System.stdout.println("-- client redirects: hop cap --");
        hopCapTrips(c);
        System.stdout.println("-- client redirects: cross-origin auth --");
        crossOriginAuthStrip(c);
    }

    // ---- the loopback redirect server -----------------------------------

    /**
     * Redirect responses carry a small body so their framing
     * self-terminates (`content-length` stamped) and the chain rides one
     * keep-alive connection.
     */
    static #HttpResponse redirectTo(int32 code, String loc) {
        String moved = "moved";
        HttpResponse resp2 #= HttpResponse.of(code);
        resp2.setHeader("Location", loc);
        resp2.body(moved.toBytes(), moved.byteLength());
        return #resp2;
    }

    /** `/final` echo: `method|authorization-or-dash|body`. */
    static #HttpResponse finalEcho(HttpRequest req) {
        String auth #= req.getHeaders().get("authorization");
        String a = "-";
        if (auth != null) {
            a = auth;
        }
        String b #= RedirectTests.bodyText(req);
        String out = req.getMethod() + "|" + a + "|" + b;
        HttpResponse resp0 #= HttpResponse.ok();
        resp0.body(out.toBytes(), out.byteLength());
        return #resp0;
    }

    static #String bodyText(HttpRequest req) {
        int32 n = req.bodyLength();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = req.body[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    public static #HttpResponse handle(HttpRequest req) {
        String t #= req.getTarget();
        if (t.equals("/r/301")) { return RedirectTests.redirectTo(301, "/final"); }
        if (t.equals("/r/302")) { return RedirectTests.redirectTo(302, "/final"); }
        if (t.equals("/r/303")) { return RedirectTests.redirectTo(303, "/final"); }
        if (t.equals("/r/307")) { return RedirectTests.redirectTo(307, "/final"); }
        if (t.equals("/r/308")) { return RedirectTests.redirectTo(308, "/final"); }
        if (t.equals("/dir/hop")) {
            // relative reference — resolves against /dir/hop → /dir/target
            return RedirectTests.redirectTo(302, "target");
        }
        if (t.equals("/dir/target")) {
            String rd = "reldir";
            HttpResponse resp1 #= HttpResponse.ok();
            resp1.body(rd.toBytes(), rd.byteLength());
            return #resp1;
        }
        if (t.equals("/chain/1")) { return RedirectTests.redirectTo(302, "/chain/2"); }
        if (t.equals("/chain/2")) { return RedirectTests.redirectTo(302, "/final"); }
        if (t.equals("/loop")) { return RedirectTests.redirectTo(302, "/loop"); }
        if (t.equals("/abs")) {
            String loc = "http://127.0.0.1:" + RedirectTests.ownPort + "/final";
            return RedirectTests.redirectTo(302, loc);
        }
        if (t.equals("/x")) {
            String loc = "http://127.0.0.1:" + RedirectTests.xPort + "/final";
            return RedirectTests.redirectTo(302, loc);
        }
        if (t.equals("/final")) { return RedirectTests.finalEcho(req); }
        return HttpResponse.notFound();
    }

    // ---- client fibers ---------------------------------------------------

    /**
     * Accept and dispatch until the listener closes; returns how many
     * connections were served.
     *
     * The single-accept version this replaces returned after ONE connection,
     * so the moment a client dialled a second nobody accepted it and the
     * client waited forever for a response that could not come — an infinite
     * hang where a plain failure belonged. MEASURED on Windows: one client
     * fiber cycling PARKED -> READY -> PARKED forever inside
     * `Reactor.pollPark`, every carrier asleep — a healthy scheduler
     * faithfully running a wait nothing would ever satisfy.
     *
     * Looping keeps the client unblocked; the returned COUNT keeps the
     * guarantee. A suite that means "these legs rode one connection each"
     * still asserts exactly that, and a regression reports the number
     * instead of wedging the run.
     *
     * Await it only AFTER closing the listener: `acceptNext` answers NULL on
     * a closed listener rather than raising, and that NULL is what ends the
     * loop.
     */
    public static async int32 acceptLoop(Server core) {
        int32 n = 0;
        boolean going = true;
        while (going) {
            TcpStream conn #= core.acceptNext();
            if (conn == null) {
                going = false;      // listener closed — the test is finished
            } else {
                // `dispatch` SPAWNS the connection fiber and returns at
                // once (Server.dispatch), so accepts overlap and a scenario
                // that needs two connections in flight still works.
                //
                // Do NOT wrap this call in a `try`: a try block is a scope
                // frame, and a statement-position spawn is joined at its
                // enclosing frame's exit. Wrapping it therefore joins each
                // connection before the next accept — serializing them, and
                // deadlocking any scenario whose first handler is waiting on
                // something the second one delivers. Measured: it wedged
                // `timeoutReleasesLease` until the deadline elapsed.
                core.dispatch(#conn);
                n = n + 1;
            }
        }
        return n;
    }

    /**
     * POST `path` with body "data" + an Authorization header, follow
     * redirects, and compare the `/final` echo against `expect`.
     */
    public static async int32 followPost(int32 port, String path, String expect) {
        HttpClient client #= heap HttpClient();
        Uri uri #= Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path(path)
            .build();
        HttpRequest req #= HttpRequest.fromUri("POST", uri);
        String data = "data";
        req.body(data.toBytes(), data.byteLength());
        req.setHeader("Authorization", "Bearer tok");
        HttpResponse resp #= client.sendFollowing(uri, req);
        if (resp.statusCode() != 200) { return -1; }
        String got #= RedirectTests.respText(resp);
        if (!got.equals(expect)) {
            System.stdout.println("  (redirect echo: '{}')", got);
            return -2;
        }
        return 1;
    }

    /** GET `path` (with auth iff `withAuth`), follow, compare the echo. */
    public static async int32 followGet(int32 port, String path,
                                        boolean withAuth, String expect) {
        HttpClient client #= heap HttpClient();
        Uri uri #= Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path(path)
            .build();
        HttpRequest req #= HttpRequest.fromUri("GET", uri);
        if (withAuth) {
            req.setHeader("Authorization", "Bearer tok");
        }
        HttpResponse resp #= client.sendFollowing(uri, req);
        if (resp.statusCode() != 200) { return -1; }
        String got #= RedirectTests.respText(resp);
        if (!got.equals(expect)) {
            System.stdout.println("  (redirect echo: '{}')", got);
            return -2;
        }
        return 1;
    }

    /** A self-redirect must trip the hop cap with the typed exception. */
    public static async int32 loopTrips(int32 port) {
        HttpClient client #= heap HttpClient();
        Uri uri #= Uri.builder()
            .scheme("http").host("127.0.0.1").port(port).path("/loop")
            .build();
        HttpRequest req #= HttpRequest.fromUri("GET", uri);
        try {
            HttpResponse resp #= client.sendFollowing(uri, req);
            return -1;                       // followed forever?
        } catch (TooManyRedirectsException e) {
            return 1;
        }
    }

    static #String respText(HttpResponse resp) {
        int32 n = resp.bodyLength();
        int8[] copy = heap int8[n];
        int32 i = 0;
        while (i < n) {
            copy[i] = resp.body[i];
            i = i + 1;
        }
        return heap String(#copy, n);
    }

    // ---- scenarios -------------------------------------------------------

    /**
     * One server; each client fiber gets its own pool, so each scenario
     * is exactly one accepted connection no matter how many hops rode it.
     */
    static void sameOriginTable(Check c) {
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse h =
                (req) -> RedirectTests.handle(req);
            b.handler(h);
            HttpServer srv #= b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();
            RedirectTests.ownPort = port;

            // ONE accept loop for all nine legs. Spawning a fresh
            // single-accept server per leg hung the moment a leg dialled
            // twice; the loop serves every dial and the total below is what
            // still pins "one connection per leg".
            Task<int32> s = spawn acceptLoop(core);

            Task<int32> t1 = spawn followPost(port, "/r/301", "GET|Bearer tok|");
            c.eqInt((int64) await t1, 1, "301 rewrites POST to GET and drops the body");

            Task<int32> t2 = spawn followPost(port, "/r/302", "GET|Bearer tok|");
            c.eqInt((int64) await t2, 1, "302 rewrites POST to GET and drops the body");

            Task<int32> t3 = spawn followPost(port, "/r/303", "GET|Bearer tok|");
            c.eqInt((int64) await t3, 1, "303 rewrites POST to GET and drops the body");

            Task<int32> t4 = spawn followPost(port, "/r/307", "POST|Bearer tok|data");
            c.eqInt((int64) await t4, 1, "307 preserves method and body");

            Task<int32> t5 = spawn followPost(port, "/r/308", "POST|Bearer tok|data");
            c.eqInt((int64) await t5, 1, "308 preserves method and body");

            Task<int32> t6 = spawn followGet(port, "/r/301", false, "GET|-|");
            c.eqInt((int64) await t6, 1, "301 leaves a GET a GET");

            Task<int32> t7 = spawn followGet(port, "/dir/hop", false, "reldir");
            c.eqInt((int64) await t7, 1, "relative Location resolves against the base path");

            Task<int32> t8 = spawn followGet(port, "/chain/1", false, "GET|-|");
            c.eqInt((int64) await t8, 1, "a two-hop chain lands");

            Task<int32> t9 = spawn followGet(port, "/abs", true, "GET|Bearer tok|");
            c.eqInt((int64) await t9, 1, "same-origin absolute hop keeps Authorization");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "redirect-table connections drained");
            // Close first: the NULL from `acceptNext` is what ends the loop.
            core.listener.close();
            c.eqInt((int64) await s, 9, "each of the nine legs rode one connection");
        }
    }

    static void hopCapTrips(Check c) {
        scope {
            HttpServerBuilder b #= HttpServer.builder();
            b.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse h =
                (req) -> RedirectTests.handle(req);
            b.handler(h);
            HttpServer srv #= b.build();
            Server core = srv.server;
            int32 port = core.listener.boundPort();

            Task<int32> s1 = spawn acceptLoop(core);
            Task<int32> t1 = spawn loopTrips(port);
            c.eqInt((int64) await t1, 1,
                "a redirect loop raises TooManyRedirectsException at the cap");

            boolean drained = core.drainInflight(Duration.ofSeconds(5));
            c.that(drained, "hop-cap connection drained");
            // Close first: the NULL from `acceptNext` ends the loop.
            core.listener.close();
            c.eqInt((int64) await s1, 1, "loop exchanges rode one connection");
        }
    }

    /**
     * Two origins (two listeners): `/x` on A 302s to `/final` on B.
     * The hop is cross-origin, so Authorization must NOT arrive at B.
     */
    static void crossOriginAuthStrip(Check c) {
        scope {
            HttpServerBuilder ba #= HttpServer.builder();
            ba.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse ha =
                (req) -> RedirectTests.handle(req);
            ba.handler(ha);
            HttpServer srvA #= ba.build();
            Server coreA = srvA.server;
            int32 portA = coreA.listener.boundPort();

            HttpServerBuilder bb #= HttpServer.builder();
            bb.bind("127.0.0.1:0");
            (HttpRequest) -> #HttpResponse hb =
                (req) -> RedirectTests.handle(req);
            bb.handler(hb);
            HttpServer srvB #= bb.build();
            Server coreB = srvB.server;
            int32 portB = coreB.listener.boundPort();
            RedirectTests.xPort = portB;

            Task<int32> sa = spawn acceptLoop(coreA);
            Task<int32> sb = spawn acceptLoop(coreB);
            Task<int32> t = spawn followGet(portA, "/x", true, "GET|-|");
            c.eqInt((int64) await t, 1, "cross-origin hop strips Authorization");
            boolean drainedA = coreA.drainInflight(Duration.ofSeconds(5));
            boolean drainedB = coreB.drainInflight(Duration.ofSeconds(5));
            c.that(drainedA, "origin A drained");
            c.that(drainedB, "origin B drained");
            coreA.listener.close();
            coreB.listener.close();
            c.eqInt((int64) await sa, 1, "origin A accepted once");
            c.eqInt((int64) await sb, 1, "origin B accepted once");
        }
    }
}
