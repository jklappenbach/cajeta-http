{
    // cajeta-http — HTTP/1.1·2·3 + WebSocket + Server-Sent Events, client and
    // server, built ON the stdlib transport layer `cajeta.io.net` (sockets,
    // TCP/UDP, the cross-platform reactor, TLS).
    //
    // HTTP is an APPLICATION protocol, not transport: HTTP/1.1+2 ride TCP,
    // HTTP/3 rides QUIC over UDP — so it sits ABOVE `cajeta.io.net` and ships
    // as a LIBRARY, not in the language stdlib. Programs that only speak raw
    // TCP/UDP never pull it in. Frameworks (e.g. primavera) layer their
    // web/REST policy on top of this library.
    //
    // A LIBRARY project: no `entry-method`, compiles to a reusable `.cja`.

    "details": {
        "name":               "dev.cajeta.http",
        "version":            "0.1.2",
        "description":        "cajeta-http — HTTP/1.1·2·3 + WebSocket + SSE client/server over cajeta.io.net",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // The compiler build this library is developed against. Distinct from
        // `details.cajeta-lang-version` above: that pins the LANGUAGE/stdlib
        // API surface (major.minor, "will this source compile?"), this pins
        // the exact COMPILER BUILD ("will this produce the same bytes?").
        // 0.10.0 is the FLOOR, and it is a correctness requirement, not a
        // preference. Earlier milestones this pin used to record: 0.9.0's
        // scoped bare-name resolution fix (extraction unit 0.2), and 0.9.3's
        // per-fiber arenas that killed the ~5%/run loopback flake (http:0.11,
        // cajeta 84ebcec4) — tags <= v0.9.2 regress that.
        //
        // What forces 0.10.0: every release through v0.9.5 predates cajeta
        // `f74298c4` — "a borrowed function-typed local must not drop the
        // closure record". Without it, a function-typed local that merely
        // ALIASES an existing closure (`f = other`, `h = srv.handler`) gets a
        // SECOND drop entry for the one shared heap record, so both fire and
        // free it twice. Under v0.9.5 the suite aborts DETERMINISTICALLY
        // (10/10) with `free(): invalid pointer` in `middleware bundle: live
        // server (2.2a)`; the fix commit's own message names this blocker
        // ("wiring middleware into a live HttpServer, cajeta-http 2.1/2.2").
        // Proven not to be ours: an identical binary against the pre-native
        // codec 0.6.0 aborts the same way (5/5), and both go green on 0.10.0.
        // `distribution` defaults to "official" and `fetch` to "auto".
        "toolchain": {
            "version": "0.10.0"
        },

        // Uses the network transport stack (sockets + TLS via cajeta.io.net).
        "capabilities": ["network"],

        // The core stdlib (cajeta.lang, cajeta.io, cajeta.io.net, cajeta.codec,
        // cajeta.hash, …) is built into the toolchain — not declared, not
        // fetched — and only the parts used are linked (dead-code elimination).
        // dev.cajeta.codec (olla store) supplies DEFLATE/gzip/zlib for HTTP
        // content-coding (http:1.6a). 0.7.0 is the first build carrying the
        // NATIVE zlib backend (drop-in, same API, zlib-speed) — see
        // ../cajeta-codec/agents/native-libz-plan.md unit 7. Linking it needs
        // the extract-bridge in ./run-tests.sh (the toolchain does not yet
        // auto-extract native/ from a classpath .cja); a plain `cajeta test`
        // still builds and falls back to the pure-cajeta DEFLATE path.
        "dependencies": {
            "dev.cajeta.codec": "0.7.1"
        },

        "dev-dependencies": {
            "cajeta.testkit": "1.0.*"
        },

        // The live Olla registry. `repo.cajeta.org` was carried here from the
        // scaffold and has never resolved (NXDOMAIN) — dependency resolution
        // only ever worked because ~/.olla was seeded by hand. CI publishes to
        // olla.cajeta.dev (cajeta/.github/actions/olla-publish), so that is the
        // name to fetch from.
        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` — this is a library; the build emits a .cja.
        "build": {
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            // The designed src/test/cajeta + cajeta.testkit pipeline is not
            // in the toolchain yet (no test-source-root support; testkit
            // unpublished), so the suite is an ordinary self-checking binary:
            // test/src compiled against the built .cja via --classpath.
            "description": "Build + run the library's unit tests",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" },
                { "action": "exec", "command": "cajeta",
                  "args": [ "dev.cajeta.http.test.TestMain::main",
                            "test/src", "build/test",
                            "--emit=exe",
                            "--classpath=${art.path},/home/julian/.olla/dev.cajeta.codec/0.7.0/dev.cajeta.codec-0.7.0.cja",
                            "-o", "build/test/http-tests" ] },
                { "action": "test", "input": "build/test/http-tests" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
